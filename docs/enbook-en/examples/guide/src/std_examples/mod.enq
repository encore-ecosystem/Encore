//! Source-backed examples for standard library chapters.

// ANCHOR: default
import std::default::Default
struct Configuration {
    retries: usize
}
impl Default for Configuration {
    fn default() -> Self {
        ret Self {
            3_usize
        }
    }
}
// ANCHOR_END: default

// ANCHOR: dict
import std::dict::Dict
pub fn dictionary() -> Dict[str, u32] {
    ret Dict[str, u32]::new().insert("answer", 42_u32)
}
// ANCHOR_END: dict

// ANCHOR: fs
import std::fs::exists
pub fn path_exists(path: str) -> bool {
    ret exists(path)
}
// ANCHOR_END: fs

// ANCHOR: http
import std::http::{HttpRequest, Url}
pub fn request_text() -> str {
    match Url::parse("https://example.com/") {
        Ok(url) => {
            ret HttpRequest::get(url).encode()
        }
        Err(message) => {
            ret message
        }
    }
}
// ANCHOR_END: http

// ANCHOR: io
import std::io::println
pub fn print_message(message: str) -> i32 {
    ret println(message)
}
// ANCHOR_END: io

// ANCHOR: math
import std::math::{clamp, sin}
pub fn normalized_sine(value: f32) -> f32 {
    ret clamp(sin(value), - 1.0_f32, 1.0_f32)
}
// ANCHOR_END: math

// ANCHOR: net
import std::net::socket_addr
pub fn loopback(port: usize) -> str {
    ret socket_addr("127.0.0.1", port)
}
// ANCHOR_END: net

// ANCHOR: os
import std::os::{args, os_name}
pub fn environment_summary() -> str {
    ret f "{os_name()}: {args().len()} args"
}
// ANCHOR_END: os

// ANCHOR: path
import std::path::Path
pub fn normalized_path(root: str) -> str {
    ret Path::new(root).join("src").normalize().as_str()
}
// ANCHOR_END: path

// ANCHOR: process
import std::process::Command
pub fn command_description(program: str) -> Command {
    ret Command::new(program).arg("--version")
}
// ANCHOR_END: process

// ANCHOR: random
import std::random::Random
pub fn random_below(seed: u64, upper: u64) -> u64 {
    ret Random::new(seed).next_range(upper).1
}
// ANCHOR_END: random

// ANCHOR: string
import std::string::String
pub fn owned_string(value: str) -> String {
    ret String::from_str(value).trim()
}
// ANCHOR_END: string

// ANCHOR: thread
import std::thread::available_parallelism
pub fn hardware_threads() -> usize {
    ret available_parallelism()
}
// ANCHOR_END: thread

// ANCHOR: time
import std::time::perf_counter_ns
pub fn timestamp() -> u64 {
    ret perf_counter_ns()
}
// ANCHOR_END: time

// ANCHOR: tls
import std::tls::TlsClientConfig
pub fn tls_config() -> TlsClientConfig {
    ret TlsClientConfig::system().with_timeout_ms(5000_usize)
}
// ANCHOR_END: tls

// ANCHOR: vec
import std::vec::{Vec, append}
pub fn joined_vectors() -> Vec[u32] {
    ret append(Vec[u32]::singleton(20_u32), Vec[u32]::singleton(22_u32))
}
// ANCHOR_END: vec
