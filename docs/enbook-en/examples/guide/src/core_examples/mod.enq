//! Source-backed examples for core library chapters.

// ANCHOR: call
#attr(decorator)
pub fn invoke[Args](func: Callable[Args, u32], args: Args) -> u32 {
    ret func(args)
}
// ANCHOR_END: call

// ANCHOR: cast
pub fn widen(value: u16) -> u64 {
    ret value as u64
}
// ANCHOR_END: cast

// ANCHOR: fmt
import core::fmt::Debug
pub fn debug_value(value: u32) -> str {
    ret Debug::fmt(value)
}
// ANCHOR_END: fmt

// ANCHOR: future
import core::future::{Ready, ready}
pub fn ready_value(value: u32) -> Ready[u32] {
    ret ready(value)
}
// ANCHOR_END: future

// ANCHOR: iter
import core::iter::range_inclusive
pub fn inclusive_total() -> usize {
    let mut total = 0_usize
    for value in range_inclusive(1_usize, 3_usize) {
        total += value
    }
    ret total
}
// ANCHOR_END: iter

// ANCHOR: ops
pub fn arithmetic(lhs: u32, rhs: u32) -> u32 {
    ret lhs + rhs
}
// ANCHOR_END: ops

// ANCHOR: option
import core::option::Option
pub fn optional(enabled: bool) -> Option[u32] {
    if enabled {
        ret Option::Some(42_u32)
    }
    ret Option::None
}
// ANCHOR_END: option

// ANCHOR: panic
import core::panic::panic
pub fn require(condition: bool) ->() {
    if !condition {
        panic("requirement failed")
    }
    ret()
}
// ANCHOR_END: panic

// ANCHOR: result
import core::result::Result
pub fn checked(enabled: bool) -> Result[u32, str] {
    if enabled {
        ret Result::Ok(42_u32)
    }
    ret Result::Err("disabled")
}
// ANCHOR_END: result

// ANCHOR: testing
import core::testing::assert
pub fn assertion_example() -> bool {
    ret assert(40_u32 + 2_u32 == 42_u32)
}
// ANCHOR_END: testing

// ANCHOR: vec
import core::vec::Vec
pub fn vector_example() -> Vec[u32] {
    let mut values = Vec[u32]::with_capacity(2_usize)
    values.push(20_u32)
    values.push(22_u32)
    ret values
}
// ANCHOR_END: vec
