// ANCHOR: comments
//! Documents this module.

/// Returns the documented value.
pub fn documented() -> u32 { ret 42_u32 }
// ANCHOR_END: comments

// ANCHOR: imports
import core::option::Option as Opt
import core::result::{Result, is_ok}

pub fn imported_api() -> bool {
    let value = Result[u32, str]::Ok(42_u32)
    ret is_ok(value) && Opt[u32]::Some(1_u32).is_some()
}
// ANCHOR_END: imports

// ANCHOR: bindings
static DEFAULT_LIMIT: usize = 8_usize

pub fn bindings() -> usize {
    let immutable = DEFAULT_LIMIT
    let mut total = immutable
    total += 1_usize
    ret total
}
// ANCHOR_END: bindings

// ANCHOR: literals
pub fn literals() -> (u32, f32, bool, str) {
    let mask = 0xff_u32
    let ratio = 1.5_f32
    ret (mask, ratio, true, "Encore")
}
// ANCHOR_END: literals

// ANCHOR: strings
pub fn greeting(name: str, count: u32) -> str {
    ret f"Hello, {name}; count={count}"
}
// ANCHOR_END: strings

// ANCHOR: formatting
pub fn formatted(value: u32) -> str {
    ret format!("value={} named={value}", value)
}
// ANCHOR_END: formatting

// ANCHOR: collections
import core::vec::Vec

pub fn collections() -> u32 {
    let pair = (20_u32, 22_u32)
    let fixed = [pair.0, pair.1]
    let mut dynamic = Vec[u32]::new()
    dynamic.push(fixed[0_usize])
    dynamic.push(fixed[1_usize])
    ret dynamic.get(0_usize).unwrap_or(0_u32) + dynamic.get(1_usize).unwrap_or(0_u32)
}
// ANCHOR_END: collections

// ANCHOR: operators
pub fn operators(value: u16) -> u64 {
    let widened = value as u64
    ret (widened << 1_u64) + 2_u64 ** 3_u32
}
// ANCHOR_END: operators

// ANCHOR: functions
pub fn identity[T](value: T) -> T { ret value }

pub fn add(lhs: u32, rhs: u32) -> u32 {
    ret identity(lhs) + rhs
}
// ANCHOR_END: functions

// ANCHOR: attributes
#cfg(unix)
pub fn platform_name() -> str { ret "unix" }

#cfg(windows)
pub fn platform_name() -> str { ret "windows" }

#attr(test)
fn attribute_smoke() -> bool { ret add(20_u32, 22_u32) == 42_u32 }
// ANCHOR_END: attributes

// ANCHOR: decorators
struct Profiler {}

impl for Profiler {
    #attr(decorator)
    fn profile[Args](self: Self, func: Callable[Args, u32], args: Args, label: str) -> u32 {
        let result = func(args)
        if label == "draw_frame" { ret result }
        ret result
    }
}

static RENDER_PROFILE: Profiler = Profiler{}

@RENDER_PROFILE.profile("draw_frame")
pub fn decorated(value: u32) -> u32 { ret value }
// ANCHOR_END: decorators

// ANCHOR: closures
trait Handler {
    fn handle(self: Self, value: u32) -> u32
}

pub fn closure_capture(base: u32) -> dyn Handler {
    ret |value| base + value
}
// ANCHOR_END: closures

// ANCHOR: structs
struct Point { x: f32 y: f32 }

pub fn stack_and_heap() -> (Point, Point<H>) {
    let stack = Point{1.0_f32, 2.0_f32}
    let heap = Point<H>{3.0_f32, 4.0_f32}
    ret (stack, heap)
}
// ANCHOR_END: structs

// ANCHOR: methods
struct Counter { value: u32 }

impl for Counter {
    pub fn increment(self: mut Self, amount: u32) -> () {
        self.value += amount
        ret ()
    }

    pub fn current(self: Self) -> u32 { ret self.value }
}
// ANCHOR_END: methods

// ANCHOR: enums
enum Message { Quit Value(u32) }

pub fn message_value(message: Message) -> u32 {
    match message {
        Message::Quit => { ret 0_u32 }
        Message::Value(value) => { ret value }
    }
}
// ANCHOR_END: enums

// ANCHOR: traits
trait Area { fn area(self: Self) -> u32 }
struct Square { side: u32 }

impl Area for Square {
    fn area(self: Square) -> u32 { ret self.side * self.side }
}

pub fn dynamic_area(shape: dyn Area) -> u32 { ret shape.area() }
// ANCHOR_END: traits

// ANCHOR: control_flow
pub fn classify(value: i32) -> str {
    if value < 0_i32 { ret "negative" }
    elif value == 0_i32 { ret "zero" }
    else { ret "positive" }
}
// ANCHOR_END: control_flow

// ANCHOR: loops
pub fn sum(limit: usize) -> usize {
    let mut total = 0_usize
    for value in 0..limit { total += value }
    ret total
}
// ANCHOR_END: loops

// ANCHOR: context
import core::ops::ContextManager

struct Resource { open: bool }

impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self { ret self }
    fn with_exit(self: Self) -> bool { ret true }
}

pub fn scoped_resource() -> bool {
    with Resource{true} as resource { ret resource.open }
}
// ANCHOR_END: context

// ANCHOR: result
fn parse_positive(value: i32) -> Result[u32, str] {
    if value < 0_i32 { ret Result::Err("negative") }
    ret Result::Ok(value as u32)
}

pub fn doubled(value: i32) -> Result[u32, str] {
    let parsed = parse_positive(value)?
    ret Result::Ok(parsed * 2_u32)
}
// ANCHOR_END: result

// ANCHOR: async
import std::future::block_on

async fn async_increment(value: u32) -> u32 { ret value + 1_u32 }

pub fn run_async() -> u32 {
    let future = async_increment(41_u32)
    ret block_on[u32, __encore_future_async_increment](future)
}
// ANCHOR_END: async

// ANCHOR: spawn
fn worker(value: u32) -> u32 { ret value + 1_u32 }

pub fn run_worker() -> u32 {
    let pending = spawn worker(41_u32)
    ret pending.join()
}
// ANCHOR_END: spawn

// ANCHOR: macros
macro_rules! add_one {
    ($value:expr) => ($value + 1_u32);
}

pub fn expanded() -> u32 { ret add_one!(41_u32) }
// ANCHOR_END: macros

// ANCHOR: unsafe
extern fn encore_clock_ms(kind: u8) -> u64

pub fn native_clock() -> u64 {
    unsafe { ret encore_clock_ms(1_u8) }
}
// ANCHOR_END: unsafe

#attr(test)
fn book_feature_examples() -> bool {
    let values = literals()
    ret documented() == 42_u32 && imported_api() && bindings() == 9_usize
        && values.0 == 255_u32 && greeting("reader", 2_u32) == "Hello, reader; count=2"
        && collections() == 42_u32 && operators(3_u16) == 14_u64
        && add(20_u32, 22_u32) == 42_u32 && decorated(7_u32) == 7_u32
        && message_value(Message::Value(42_u32)) == 42_u32
        && classify(-1_i32) == "negative" && sum(4_usize) == 6_usize
        && doubled(21_i32).unwrap_or(0_u32) == 42_u32
        && run_async() == 42_u32 && run_worker() == 42_u32 && expanded() == 42_u32
}
