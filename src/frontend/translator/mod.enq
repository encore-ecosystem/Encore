/// Removes declarations disabled by target and feature configuration.
pub fn filter_ast_for_target(ast: Vec[Statement], target: TargetSpec, features: Vec[str]) -> Vec[Statement]
{
    let mut out = Vec[Statement]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                if function_is_active(item, target, features) {
                    out.push(Statement::Function(without_cfg_attrs(item)))
                }
            }
            Statement::Impl(item) => {
                let mut methods = Vec[FunctionItem]::new()
                for method in item.methods {
                    if function_is_active(method, target, features) {
                        methods.push(without_cfg_attrs(method))
                    }
                }
                out.push(Statement::Impl(ImplStmt {
                            item.documentation, item.generics, item.trait_name, item.trait_args, item.target,
                            methods, item.source_name, item.line, item.column
                        }
                        ,
                    ))
            }
            Statement::Trait(item) => {
                let mut methods = Vec[FunctionItem]::new()
                for method in item.methods {
                    if function_is_active(method, target, features) {
                        methods.push(without_cfg_attrs(method))
                    }
                }
                out.push(Statement::Trait(TraitStmt {
                            item.is_public, item.name, item.documentation, item.generics, item.bases,
                            methods, item.source_name, item.line, item.column
                        }
                        ,
                    ))
            }
            _ => {
                out.push(statement)
            }
        }
    }
    ret out
}

fn without_cfg_attrs(item: FunctionItem) -> FunctionItem {
    let mut attrs = Vec[str]::new()
    for attr in item.attrs {
        if !starts_with(attr, "cfg:") {
            attrs.push(attr)
        }
    }
    ret FunctionItem {
        attrs, item.decorators, item.is_public, item.is_extern, item.is_async, item.name, item.documentation, item.generics,
        item.params, item.ret_type, item.returns_sending, item.returns_frozen, item.body,
        item.source_name, item.line, item.column
    }
}

/// Translates a flat AST to EHIR for the host target.
pub fn translate_to_ehir(ast: Vec[Statement]) -> str {
    ret translate_to_ehir_for_target(ast, host_target())
}

/// Translates a flat AST to EHIR for an explicit target.
pub fn translate_to_ehir_for_target(ast: Vec[Statement], target: TargetSpec) -> str {
    ret translate_to_ehir_for_target_and_features(ast, target, Vec[str]::new())
}

/// Translates a flat AST using an explicit target and enabled features.
pub fn translate_to_ehir_for_target_and_features(ast: Vec[Statement], target: TargetSpec, features: Vec[str])
-> str {
    ret translate_ast_to_ehir(ast, Vec[TranslationModule]::new(), target, features)
}

/// Translates a modified flat AST while retaining the resolved module
/// identities and import graph of its workspace.
pub fn translate_ast_with_modules_to_ehir(ast: Vec[Statement], modules: Vec[TranslationModule],
    target: TargetSpec,) -> str {
    ret translate_ast_to_ehir(ast, modules, target, Vec[str]::new())
}

/// Translates resolved modules into one flattened EHIR program.
pub fn translate_modules_to_ehir(modules: Vec[TranslationModule], target: TargetSpec) -> str {
    let mut ast = Vec[Statement]::new()
    for module in modules {
        ast.extend(module.ast)
    }
    let mut ctx = collect_context(ast, modules, target, Vec[str]::new())
    let mut builder = EhirTextBuilder::new()
    for module in modules {
        ctx.features = module.features
        let body = translate_ast_with_context(ctx, module.ast, target, module.features).finish()
        builder = builder.append_str(qualify_module_type_collisions(ctx, module, body))
    }
    let text = builder.finish()
    free_translation_indexes(ctx)
    ret text
}

/// Translates resolved modules into a virtual EHIR module bundle.
pub fn translate_modules_to_ehir_bundle(modules: Vec[TranslationModule], target: TargetSpec, entry_module:
    str,) -> str {
    ret translate_modules_to_ehir_bundle_parallel(modules, target, entry_module, 1_usize)
}

/// Translates resolved modules across the frontend-neutral EHIR boundary.
///
/// The textual function remains available for portable incremental artifacts,
/// but compiler stages that stay in-process should consume this typed bundle.
/// EHIR owns the `ModuleBundle` definition; Encore only constructs it through
/// the public frontend API and never becomes a dependency of the EHIR library.
pub fn translate_modules_to_ehir_bundle_typed(modules: Vec[TranslationModule], target: TargetSpec,
    entry_module: str,) -> ModuleBundle {
    let text = translate_modules_to_ehir_bundle_parallel(modules, target, entry_module, 1_usize)
    ret parse_module_bundle_text(entry_module, text)
}

/// Translates resolved modules in parallel while preserving their resolved
/// order in the resulting virtual EHIR bundle.
pub fn translate_modules_to_ehir_bundle_parallel(modules: Vec[TranslationModule], target: TargetSpec,
    entry_module: str, requested_jobs: usize,) -> str {
    let _requested_jobs = requested_jobs
    // The former worker implementation reparsed every source module and
    // rebuilt the complete declaration context once per worker. On Graphene,
    // 16 jobs took 104.5 s versus 49.6 s for the single shared context while
    // consuming far more memory. Keep semantic checking parallel, but lower
    // against one context until workers can share a compact immutable index.
    ret translate_modules_to_ehir_bundle_serial(modules, target, entry_module)
}

fn translate_modules_to_ehir_bundle_serial(modules: Vec[TranslationModule], target: TargetSpec,
    entry_module: str,) -> str {
    let mut selected = Vec[usize]::new()
    let mut index = 0_usize
    while index < modules.len() {
        selected.push(index) index += 1_usize
    }
    let chunks = translate_selected_modules_to_ehir_chunks(modules, target, selected)
    ret assemble_ehir_module_bundle(chunks, modules.len(), entry_module)
}

/// Lowers only the selected module bodies while constructing the shared
/// declaration/type context once. Unselected chunks can be restored from a
/// persistent project cache and combined with the result.
pub fn translate_selected_modules_to_ehir_chunks(modules: Vec[TranslationModule], target: TargetSpec,
    selected: Vec[usize],) -> Vec[TranslatedModuleChunk] {
    let mut ast = Vec[Statement]::new()
    for module in modules {
        ast.extend(module.ast)
    }
    let mut ctx = collect_context(ast, modules, target, Vec[str]::new())
    let mut chunks = Vec[TranslatedModuleChunk]::new()
    let mut module_index = 0_usize
    for module in modules {
        if contains_module_index(selected, module_index) {
            let started = perf_counter_ms()
            chunks.push(translate_module_chunk(ctx, module, target, module_index))
            if env("ENCORE_FRONTEND_PROFILE").is_some() {
                eprintln("frontend-time " + module.module_id + ": " +
                    Debug::fmt(perf_counter_ms() - started) + " ms")
            }
        }
        module_index += 1_usize
    }
    free_translation_indexes(ctx)
    ret chunks
}

/// Assembles cached and freshly lowered chunks in resolved module order.
pub fn assemble_ehir_module_bundle(chunks: Vec[TranslatedModuleChunk], module_count: usize, entry_module:
    str,)
-> str {
    let mut bundle = EhirTextBuilder::new()
    bundle = bundle.line("entry " + entry_module)
    bundle = bundle.empty_line()
    let mut module_index = 0_usize
    while module_index < module_count {
        for chunk in chunks {
            if chunk.index == module_index {
                bundle = bundle.append_str(chunk.text)
            }
        }
        module_index += 1_usize
    }
    ret bundle.finish()
}

fn contains_module_index(indices: Vec[usize], needle: usize) -> bool {
    for index in indices {
        if index == needle {
            ret true
        }
    }
    ret false
}

fn min_translation_jobs(requested: usize, count: usize) -> usize {
    let jobs = if requested == 0_usize {
        1_usize
    } else {
        requested
    }
    if count == 0_usize || jobs < count {
        ret jobs
    }
    ret count
}

fn schedule_translation_modules(modules: Vec[TranslationModule]) -> Vec[TranslationModuleJob] {
    let mut jobs = Vec[TranslationModuleJob]::new()
    let mut index = 0_usize
    for module in modules {
        let weight = if module.work_weight == 0_usize {
            1_usize
        } else {
            module.work_weight
        }
        jobs.push(TranslationModuleJob {
                index, weight
            }
            ,
        )
        index += 1_usize
    }
    index = 1_usize
    while index < jobs.len() {
        let mut position = index
        while position > 0_usize {
            let mut swap = false
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            swap = right.weight > left.weight ||
                            (right.weight == left.weight && right.index < left.index)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            if !swap {
                break
            }
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            jobs.set(position - 1_usize, right)
                            jobs.set(position, left)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            position -= 1_usize
        }
        index += 1_usize
    }
    ret jobs
}

fn translation_sources_available(modules: Vec[TranslationModule]) -> bool {
    if modules.len() == 0_usize {
        ret false
    }
    for module in modules {
        if module.source == "" {
            ret false
        }
    }
    ret true
}

fn translation_source_modules(modules: Vec[TranslationModule]) -> Vec[TranslationSourceModule] {
    let mut out = Vec[TranslationSourceModule]::new()
    for module in modules {
        out.push(TranslationSourceModule {
                module.module_id,
                module.source_name,
                module.source,
                module.documentation,
                module.imports,
                module.features,
                module.work_weight
            }
            ,)
    }
    ret out
}

fn parse_translation_source_modules(sources: Vec[TranslationSourceModule], target: TargetSpec)
-> Vec[TranslationModule] {
    let mut modules = Vec[TranslationModule]::new()
    for source in sources {
        let mut lexer = Lexer::new()
        let mut parser = Parser::new_for_source(source.source_name)
        let ast = filter_ast_for_target(parser.parse(lexer.tokenize(source.source)), target, source.features)
        modules.push(TranslationModule {
                source.module_id,
                source.source_name,
                source.source,
                source.documentation,
                source.imports,
                ast,
                source.features,
                source.work_weight
            }
            ,)
    }
    ret modules
}

fn translate_source_module_batch(sources: Vec[TranslationSourceModule], jobs: Vec[TranslationModuleJob],
    target: TargetSpec, worker_index: usize, worker_count: usize,) -> Vec[TranslatedModuleChunk] {
    let modules = parse_translation_source_modules(sources, target)
    let mut ast = Vec[Statement]::new()
    for module in modules {
        ast.extend(module.ast)
    }
    let mut ctx = collect_context(ast, modules, target, Vec[str]::new())
    let mut chunks = Vec[TranslatedModuleChunk]::new()
    let mut job_index = worker_index
    while job_index < jobs.len() {
        match jobs.get(job_index) {
            Some(job) => {
                match modules.get(job.index) {
                    Some(module) => {
                        chunks.push(translate_module_chunk(ctx, module, target, job.index))
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        job_index += worker_count
    }
    free_translation_indexes(ctx)
    ret chunks
}

fn translate_module_chunk(ctx: mut TranslatorContext, module: TranslationModule, target: TargetSpec,
    index: usize,) -> TranslatedModuleChunk {
    ctx.features = module.features
    let mut builder = EhirTextBuilder::new()
    builder = builder.line("module " + module.module_id + " {")
    builder = append_ehir_documentation(builder, module.documentation, "//!")
    for imported in module.imports {
        builder = builder.line("import " + imported)
    }
    if module.imports.len() > 0_usize {
        builder = builder.empty_line()
    }
    let body = translate_ast_with_context(ctx, module.ast, target, module.features).finish()
    builder = builder.append_str(qualify_module_type_collisions(ctx, module, body))
    builder = builder.line("}")
    builder = builder.empty_line()
    ret TranslatedModuleChunk {
        index, builder.finish()
    }
}

// EHIR modules are independently named compilation units, but named EHIR
// types are still represented as strings. Give only colliding declarations a
// stable module-qualified identity before a bundle is flattened for LLVM.
// Keeping non-colliding names unchanged preserves the language ABI for core
// intrinsics while preventing unrelated `Output`, `Div`, and similar source
// declarations from becoming one LLVM `%Output` or one trait contract.
fn qualify_module_type_collisions(ctx: mut TranslatorContext, module: TranslationModule, text: str)
-> str {
    let mut out = text
    for name in ctx.type_collisions {
        if contains_substring(out, name) {
            let replacement = resolved_type_collision(ctx, module, name)
            if replacement != "" {
                out = replace_ehir_identifier(out, name, replacement)
            }
        }
    }
    ret out
}

fn resolved_type_collision(ctx: mut TranslatorContext,
    module: TranslationModule, name: str,) -> str {
    let owner = resolve_type_declaration_module(ctx, module, name)
    ret if owner == "" {
        ""
    } else {
        "__encore_t" + encode_module_identity(owner) + "__" + name
    }
}

fn declaration_type_name(statement: Statement) -> str {
    match statement {
        Statement::Struct(item) => {
            ret item.name
        }
        Statement::EnumItem(item) => {
            ret item.name
        }
        Statement::Trait(item) => {
            ret item.name
        }
        _ => {
        }
    }
    ret ""
}

fn module_declares_type(module: TranslationModule, name: str) -> bool {
    for statement in module.ast {
        if declaration_type_name(statement) == name {
            ret true
        }
    }
    ret false
}

fn declaration_type_count(modules: Vec[TranslationModule], name: str) -> usize {
    let mut count = 0_usize
    for module in modules {
        if module_declares_type(module, name) {
            count += 1_usize
        }
    }
    ret count
}

fn build_type_collision_names(modules: Vec[TranslationModule]) -> Vec[str] {
    let mut collisions = Vec[str]::new()
    let seen = unsafe {
        encore_strset_new()
    }
    for module in modules {
        for statement in module.ast {
            let name = declaration_type_name(statement)
            if name != "" && !unsafe {
                encore_strset_contains(seen, name)
            }
            {
                let _inserted = unsafe {
                    encore_strset_insert(seen, name)
                }
                if declaration_type_count(modules, name) > 1_usize {
                    collisions.push(name)
                }
            }
        }
    }
    unsafe {
        encore_strset_free(seen)
    }
    ret collisions
}

fn resolve_type_declaration_module(ctx: mut TranslatorContext, current: TranslationModule, name: str)
-> str {
    if module_declares_type(current, name) {
        ret current.module_id
    }

    let mut direct = ""
    for candidate in ctx.modules {
        if candidate.module_id != current.module_id && module_declares_type(candidate, name) &&
        contains_str(current.imports, candidate.module_id) {
            match direct_import_allows(ctx, current.source_name, candidate.module_id, name) {
                Some(allowed) => {
                    if allowed {
                        if direct != "" && direct != candidate.module_id {
                            ret ""
                        }
                        direct = candidate.module_id
                    }
                }
                _ => {
                }
            }
        }
    }
    if direct != "" {
        ret direct
    }

    let mut visible = ""
    for candidate in ctx.modules {
        if candidate.module_id != current.module_id && module_declares_type(candidate, name) &&
        unsafe {
            encore_strset_contains(ctx.visibility_index,
                current.module_id + "\n" + candidate.module_id,)
        }
        {
            if visible != "" && visible != candidate.module_id {
                ret ""
            }
            visible = candidate.module_id
        }
    }
    ret visible
}

// Replace an EHIR identifier without touching quoted program strings or
// documentation/comments. `replace_type_token` is intentionally unsuitable
// here because changing a literal such as "Output" would change behavior.
fn replace_ehir_identifier(value: str, token: str, replacement: str) -> str {
    if token == "" {
        ret value
    }
    ret unsafe {
        encore_compiler_replace_ehir_identifier(value, token, replacement)
    }
}

/// Runs the complete lowering-time semantic validator without retaining EHIR
/// text. This preserves the mature checks for generics, traits, ownership,
/// async control flow and exhaustiveness while the shared query engine adopts
/// them incrementally.
pub fn validate_translation_modules(modules: Vec[TranslationModule], target: TargetSpec, entry_module:
    str,) ->() {
    suppress_text_builder_output(true)
    let _discarded = translate_modules_to_ehir_bundle(modules, target, entry_module)
    suppress_text_builder_output(false)
    ret()
}

/// Validation-only counterpart for a standalone source AST.
pub fn validate_ast_for_target(ast: Vec[Statement], target: TargetSpec) ->() {
    suppress_text_builder_output(true)
    let _discarded = translate_to_ehir_for_target(ast, target)
    suppress_text_builder_output(false)
    ret()
}

fn translate_ast_to_ehir(ast: Vec[Statement], modules: Vec[TranslationModule], target: TargetSpec, features:
    Vec[str],) -> str {
    let mut ctx = collect_context(ast, modules, target, features)
    let text = translate_ast_with_context(ctx, ast, target, features).finish()
    free_translation_indexes(ctx)
    ret text
}

fn free_translation_indexes(ctx: TranslatorContext) ->() {
    unsafe {
        encore_strmap_free(ctx.module_index)
        encore_strset_free(ctx.visibility_index)
        encore_strset_free(ctx.direct_import_index)
        encore_strmap_free(ctx.function_heads)
        encore_strmap_free(ctx.function_overload_counts)
        encore_strmap_free(ctx.type_index)
        encore_strmap_free(ctx.field_index)
        encore_strset_free(ctx.owning_type_index)
    }
    ret()
}

fn translate_ast_with_context(ctx: mut TranslatorContext, ast: Vec[Statement], target: TargetSpec, features:
    Vec[str],) -> EhirTextBuilder {
    reset_generated_closure_declarations(ctx)
    let mut builder = EhirTextBuilder::new()
    for stmt in ast {
        match stmt {
            Statement::Import(imp_item) => {
                let _ignored = imp_item
            }
            Statement::Struct(struct_item) => {
                builder = builder.append(translate_struct(struct_item))
            }
            Statement::EnumItem(enum_item) => {
                builder = builder.append(translate_enum(enum_item))
            }
            Statement::Trait(trait_item) => {
                builder = builder.append(translate_trait(ctx, trait_item))
            }
            Statement::Impl(impl_item) => {
                builder = builder.append(translate_impl(ctx, impl_item))
            }
            Statement::Function(fn_item) => {
                if function_is_active(fn_item, target, features) {
                    if !function_is_decorator_definition(fn_item) {
                        builder = builder.append(translate_function(ctx, fn_item))
                    }
                }
            }
            _ => {
            }
        }
        builder = builder.empty_line()
    }
    for declaration in ctx.extern_functions {
        if starts_with(declaration, "__encore_generated_closure__") {
            builder = builder.append_str(declaration.slice(28_usize, declaration.len() - 28_usize))
            builder = builder.empty_line()
        }
    }
    ret builder
}

fn reset_generated_closure_declarations(ctx: mut TranslatorContext) ->() {
    let mut retained = Vec[str]::new()
    for item in ctx.extern_functions {
        if !starts_with(item, "__encore_generated_closure__") {
            retained.push(item)
        }
    }
    ctx.extern_functions = retained
    ret()
}

fn generated_closure_count(ctx: mut TranslatorContext) -> usize {
    let mut count = 0_usize
    for item in ctx.extern_functions {
        if starts_with(item, "__encore_generated_closure__") {
            count += 1_usize
        }
    }
    ret count
}

fn collect_context(ast: Vec[Statement], modules: Vec[TranslationModule], target: TargetSpec, features:
    Vec[str],) -> TranslatorContext {
    let module_visibility = build_module_visibility(modules)
    let direct_import_index = build_direct_import_index(modules)
    let module_index = unsafe {
        encore_strmap_new()
    }
    let mut module_prefixes = Vec[str]::new()
    let mut module_position = 0_usize
    for module in modules {
        index_module_source_alias(module_index, module.source_name, module_position)
        // A workspace path and the parser's source name may use different
        // normalized spellings. Index the declaration sources as canonical
        // aliases so test and bundled compilation preserve module identity.
        for statement in module.ast {
            match statement {
                Statement::Function(item) => {
                    index_module_source_alias(module_index, item.source_name, module_position)
                }
                Statement::Impl(item) => {
                    index_module_source_alias(module_index, item.source_name, module_position)
                    for method in item.methods {
                        index_module_source_alias(module_index, method.source_name, module_position)
                    }
                }
                Statement::Trait(item) => {
                    index_module_source_alias(module_index, item.source_name, module_position)
                    for method in item.methods {
                        index_module_source_alias(module_index, method.source_name, module_position)
                    }
                }
                _ => {
                }
            }
        }
        module_prefixes.push("__encore_m" + encode_module_identity(module.module_id) + "__")
        module_position = module_position + 1_usize
    }
    let visibility_index = unsafe {
        encore_strset_new()
    }
    for edge in module_visibility {
        let _inserted = unsafe {
            encore_strset_insert(visibility_index, edge.0 + "\n" + edge.1)
        }
    }
    let type_collisions = build_type_collision_names(modules)
    let mut ctx = TranslatorContext {
        Vec[VarType]::new(), Vec[VarType]::new(), Vec[FunctionType]::new(), modules, module_visibility,
        module_index, module_prefixes, visibility_index, direct_import_index, unsafe {
            encore_strmap_new()
        }
        , unsafe {
            encore_strmap_new()
        }
        , Vec[usize]::new(), unsafe {
            encore_strmap_new()
        }
        ,
        Vec[str]::new(), type_collisions, Vec[TraitType]::new(),
        Vec[TraitImplType]::new(), Vec[GenericCallable]::new(), Vec[DecoratorType]::new(),
        Vec[StructFieldType]::new(),
        unsafe {
            encore_strmap_new()
        }
        , unsafe {
            encore_strset_new()
        }
        , Vec[EnumVariantType]::new(), Vec[LoopTargetType]::new(),
        Vec[VarType]::new(), Vec[str]::new(), Vec[str]::new(), Vec[str]::new(), "", "void", "", false, false,
        Vec[GenericParam]::new(), target, features, false, "", "", "", "", "", Vec[str]::new(),
        Vec[str]::new(), Vec[VariableRegion]::new(), Vec[usize]::new(), Vec[usize]::new(),
        Vec[usize]::new(), Vec[usize]::new(), Vec[str]::new(), Vec[str]::new(),
        Vec[str]::new(), Vec[str]::new(), Vec[str]::new(), 1_usize
    }
    // Struct/enum syntax nodes intentionally carry no source path. In a
    // resolved workspace, collect them through their owning module so two
    // same-named declarations receive distinct field and variant identities.
    if modules.len() > 0_usize {
        for module in modules {
            collect_module_type_declarations(ctx, module)
        }
    }
    for stmt in ast {
        match stmt {
            Statement::Function(fn_item) => {
                if function_is_active(fn_item, target, features) {
                    if function_is_decorator_definition(fn_item) {
                        ctx.decorators.push(DecoratorType {
                                "", fn_item
                            }
                            ,
                        )
                        continue
                    }
                    if fn_item.is_extern {
                        ctx.extern_functions.push(fn_item.name)
                    }
                    if function_has_attr(fn_item, "borrowed_return") {
                        ctx.borrowed_return_functions.push(fn_item.name)
                    }
                    let output_type = function_ret_type(fn_item)
                    let callable_type = if fn_item.is_async {
                        async_future_type(ctx_next_emitted_name(ctx, fn_item.source_name, fn_item.name),
                            fn_item.generics,)
                    } else {
                        output_type
                    }
                    ctx_add_function(ctx, fn_item.source_name, fn_item.name, callable_type, function_param_types(fn_item),
                        function_param_sending(fn_item), function_param_frozen(fn_item), false,
                        generic_param_names(fn_item.generics), fn_item.is_extern,
                        fn_item.is_async, output_type, fn_item.returns_sending, fn_item.returns_frozen,)
                    if fn_item.is_async {
                        remember_async_future(ctx, fn_item, callable_type)
                    }
                    remember_generic_callable(ctx, fn_item.name, fn_item.generics)
                }
            }
            Statement::Struct(struct_item) => {
                if ctx.modules.len() == 0_usize {
                    remember_type(ctx, struct_item.name)
                    collect_struct_fields(ctx, struct_item, "")
                }
            }
            Statement::EnumItem(enum_item) => {
                if ctx.modules.len() == 0_usize {
                    collect_enum_declaration(ctx, enum_item, "")
                }
            }
            Statement::Trait(trait_item) => {
                remember_type(ctx, trait_item.name)
                remember_trait(ctx, trait_item.name, trait_item.generics, trait_item.bases, trait_item.methods,
                    trait_item.source_name, trait_item.line, trait_item.column,)
                let trait_generics = generic_param_names(trait_item.generics)
                for method in trait_item.methods {
                    let mut method_generics = copy_str_vec(trait_generics)
                    for generic_name in generic_param_names(method.generics) {
                        method_generics.push(generic_name)
                    }
                    let output_type = function_ret_type_for_owner(method, trait_item.name)
                    let callable_name = trait_item.name + "::" + method.name
                    if function_has_attr(method, "borrowed_self") {
                        ctx.borrowed_self_functions.push(callable_name)
                    }
                    if function_has_attr(method, "borrowed_return") {
                        ctx.borrowed_return_functions.push(callable_name)
                    }
                    let callable_type = if method.is_async {
                        async_future_type(ctx_next_emitted_name(ctx, method.source_name, callable_name),
                            combined_generic_params(trait_item.generics, method.generics),)
                    } else {
                        output_type
                    }
                    ctx_add_function(ctx, method.source_name, trait_item.name + "::" + method.name, callable_type,
                        function_param_types_for_owner(method, trait_item.name), function_param_sending(method),
                        function_param_frozen(method), function_receiver_is_readonly(method),
                        method_generics, false, method.is_async, output_type,
                        method.returns_sending, method.returns_frozen,)
                    if method.is_async {
                        remember_async_future_output(ctx, method, callable_type, output_type)
                    }
                    remember_generic_callable(ctx, trait_item.name + "::" + method.name, combined_generic_params(trait_item.generics,
                            method.generics,))
                }
            }
            Statement::Impl(impl_item) => {
                remember_trait_impl(ctx, impl_item)
                for method in impl_item.methods {
                    if function_is_active(method, target, features) {
                        if function_is_decorator_definition(method) {
                            ctx.decorators.push(DecoratorType {
                                    base_type_name(impl_item.target), method
                                }
                                ,
                            )
                            continue
                        }
                        let mut method_name = method.name
                        match impl_item.trait_name {
                            Some(trait_name) => {
                                if trait_name == "Pow" && method.name == "op" {
                                    method_name = "pow"
                                }
                            }
                            None => {
                            }
                        }
                        let mut method_generics = generic_param_names(impl_item.generics)
                        for generic_name in generic_param_names(method.generics) {
                            method_generics.push(generic_name)
                        }
                        let output_type = function_ret_type_for_owner(method, impl_item.target)
                        let callable_name = base_type_name(impl_item.target) + "::" + method_name
                        if function_has_attr(method, "borrowed_self") {
                            ctx.borrowed_self_functions.push(callable_name)
                        }
                        if function_has_attr(method, "borrowed_return") {
                            ctx.borrowed_return_functions.push(callable_name)
                        }
                        let callable_type = if method.is_async {
                            async_future_type(ctx_next_emitted_name(ctx, method.source_name, callable_name),
                                combined_generic_params(impl_item.generics, method.generics),)
                        } else {
                            output_type
                        }
                        ctx_add_function(ctx, method.source_name, callable_name, callable_type, function_param_types_for_owner(method,
                                impl_item.target,), function_param_sending(method), function_param_frozen(method),
                            function_receiver_is_readonly(method), method_generics, false, method.is_async, output_type,
                            method.returns_sending, method.returns_frozen,)
                        if method.is_async {
                            remember_async_future_output(ctx, method, callable_type, output_type)
                        }
                        remember_generic_callable(ctx, base_type_name(impl_item.target) + "::" + method_name,
                            combined_generic_params(impl_item.generics, method.generics),)
                    }
                }
            }
            _ => {
            }
        }
    }
    validate_trait_declarations(ctx)
    ret ctx
}

fn canonical_source_identity(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        } else {
            out = out + ch
        }
        index += 1_usize
    }
    ret out
}

fn index_module_source_alias(index: usize, source_name: str, module_position: usize) ->() {
    unsafe {
        encore_strmap_put(index, canonical_source_identity(source_name), module_position + 1_usize)
    }
    ret()
}

fn lookup_module_source_alias(index: usize, source_name: str) -> usize {
    ret unsafe {
        encore_strmap_get(index, canonical_source_identity(source_name))
    }
}

fn collect_module_type_declarations(ctx: mut TranslatorContext, module: TranslationModule) ->() {
    for statement in module.ast {
        match statement {
            Statement::Struct(item) => {
                let owner = qualified_type_for_source(ctx, module.source_name, item.name)
                remember_type(ctx, owner)
                collect_struct_fields(ctx, item, module.source_name)
            }
            Statement::EnumItem(item) => {
                collect_enum_declaration(ctx, item, module.source_name)
            }
            _ => {
            }
        }
    }
    ret()
}

fn collect_enum_declaration(ctx: mut TranslatorContext, item: EnumStmt, source_name: str) ->() {
    let owner = if source_name == "" {
        item.name
    } else {
        qualified_type_for_source(ctx, source_name, item.name)
    }
    remember_type(ctx, owner)
    for variant in item.variants {
        let mut payload_type = "void"
        match variant.tuple_fields.get(0_usize) {
            Some(found) => {
                payload_type = if source_name == "" {
                    found
                } else {
                    qualified_type_for_source(ctx, source_name, found)
                }
            }
            None => {
            }
        }
        match variant.named_fields.get(0_usize) {
            Some(found) => {
                payload_type = if source_name == "" {
                    found.typ
                } else {
                    qualified_type_for_source(ctx, source_name, found.typ)
                }
            }
            None => {
            }
        }
        ctx.enum_variants.push(EnumVariantType {
                owner + "::" + variant.name, owner, payload_type, generic_param_names(item.generics)
            }
            ,)
        let _inserted = unsafe {
            encore_strset_insert(ctx.owning_type_index, owner)
        }
    }
    ret()
}

fn remember_type(ctx: mut TranslatorContext, name: str) ->() {
    if unsafe {
        encore_strmap_get(ctx.type_index, name)
    }
    != 0_usize {
        ret()
    }
    ctx.types.push(name)
    unsafe {
        encore_strmap_put(ctx.type_index, name, ctx.types.len())
    }
    ret()
}

// Resolve colliding named types in the lexical module that owns `source_name`.
// The qualified spelling is propagated through inferred values and field
// metadata, so a consumer can simultaneously hold values returned by two
// modules that both define (for example) `Output`.
fn qualified_type_for_source(ctx: mut TranslatorContext, source_name: str, typ: str) -> str {
    let encoded = lookup_module_source_alias(ctx.module_index, source_name)
    if encoded == 0_usize {
        ret canonical_type(typ)
    }
    let current = match ctx.modules.get(encoded - 1_usize) {
        Some(module) => module
        None => {
            ret canonical_type(typ)
        }
    }
    let mut out = canonical_type(typ)
    for name in ctx.type_collisions {
        if contains_substring(out, name) {
            let replacement = resolved_type_collision(ctx, current, name)
            if replacement != "" {
                out = replace_type_token(out, name, replacement)
            }
        }
    }
    ret out
}

fn remember_trait(ctx: mut TranslatorContext, name: str, generics: Vec[GenericParam], bases: Vec[str],
    methods: Vec[FunctionItem], source_name: str, line: usize, column: usize,) ->() {
    for known in ctx.traits {
        if known.name == name && known.source_name == source_name {
            ret()
        }
    }
    ctx.traits.push(TraitType {
            name, generics, bases, methods, source_name, line, column
        }
        ,
    )
    ret()
}

fn validate_trait_declarations(ctx: mut TranslatorContext) ->() {
    for trait_item in ctx.traits {
        for base in trait_item.bases {
            let base_name = base_type_name(base)
            match lookup_trait(ctx, base_name) {
                None => {
                    translation_error_at(trait_item.source_name, trait_item.line, trait_item.column,
                        "unknown-supertrait", "trait '" + trait_item.name + "' inherits from unknown trait '"
                        + base_name + "'",)
                }
                Some(base_trait) => {
                    let actual_arity = generic_args_from_path(base).len()
                    if actual_arity != base_trait.generics.len() {
                        translation_error_at(trait_item.source_name, trait_item.line, trait_item.column,
                            "supertrait-generic-arity-mismatch", "supertrait '" + base_name + "' expects "
                            + Debug::fmt(base_trait.generics.len()) + " generic argument(s), got " +
                            Debug::fmt(actual_arity),)
                    }
                }
            }
        }
        if trait_reaches(ctx, trait_item.name, trait_item.name, Vec[str]::new()) {
            translation_error_at(trait_item.source_name, trait_item.line, trait_item.column, "cyclic-supertrait",
                "cyclic supertrait dependency involving '" + trait_item.name + "'",)
        }
    }
    ret()
}

fn trait_reaches(ctx: mut TranslatorContext, current: str, target: str, visited: Vec[str]) -> bool {
    if contains_str(visited, current) {
        ret false
    }
    let mut next_visited = copy_str_vec(visited)
    next_visited.push(current)
    match lookup_trait(ctx, current) {
        Some(contract) => {
            for base in contract.bases {
                let base_name = base_type_name(base)
                if base_name == target {
                    ret true
                }
                if trait_reaches(ctx, base_name, target, next_visited) {
                    ret true
                }
            }
        }
        None => {
        }
    }
    ret false
}

fn remember_trait_impl(ctx: mut TranslatorContext, item: ImplStmt) ->() {
    match item.trait_name {
        Option[str]::None => {
            ret()
        }
        Option[str]::Some(trait_name) => {
            let key = trait_name + "[" + join_strs(item.trait_args, ", ") + "] for " + canonical_type(item.target)
            for known in ctx.trait_impls {
                if trait_impl_key(known) == key {
                    translation_error_at(item.source_name, item.line, item.column, "conflicting-trait-impl",
                        "conflicting implementation of '" + key + "'",)
                }
            }
            ctx.trait_impls.push(TraitImplType {
                    trait_name, item.trait_args, canonical_type(item.target), item.generics
                }
                ,
            )
        }
    }
    ret()
}

fn trait_impl_key(item: TraitImplType) -> str {
    ret item.trait_name + "[" + join_strs(item.trait_args, ", ") + "] for " + canonical_type(item.target)
}

fn combined_generic_params(owner: Vec[GenericParam], method: Vec[GenericParam]) -> Vec[GenericParam]
{
    let mut out = Vec[GenericParam]::new()
    for generic in owner {
        out.push(generic)
    }
    for generic in method {
        out.push(generic)
    }
    ret out
}

fn remember_generic_callable(ctx: mut TranslatorContext, name: str, params: Vec[GenericParam]) ->() {
    if params.len() == 0_usize {
        ret()
    }
    ctx.generic_callables.push(GenericCallable {
            name, params
        }
        ,
    )
    ret()
}

fn ctx_add_field(ctx: mut TranslatorContext, field: StructFieldType) ->() {
    ctx.fields.push(field)
    let encoded = ctx.fields.len()
    unsafe {
        encore_strmap_put(ctx.field_index, field.owner + "\n" + field.field, encoded)
        encore_strmap_put(ctx.field_index, leaf_type_name(field.owner) + "\n" + field.field, encoded)
        encore_strmap_put(ctx.field_index, field.owner + "\n#" + field.index, encoded)
        encore_strmap_put(ctx.field_index, leaf_type_name(field.owner) + "\n#" + field.index, encoded)
    }
    let _inserted = unsafe {
        encore_strset_insert(ctx.owning_type_index, field.owner)
    }
    ret()
}

fn collect_struct_fields(ctx: mut TranslatorContext, item: StructStmt, source_name: str) ->() {
    let owner = if source_name == "" {
        item.name
    } else {
        qualified_type_for_source(ctx, source_name, item.name)
    }
    if item.is_tuple {
        let mut index = 0_usize
        for typ in item.tuple_fields {
            ctx_add_field(ctx, StructFieldType {
                    owner, Debug::fmt(index),
                    if source_name == "" {
                        typ
                    } else {
                        qualified_type_for_source(ctx, source_name, typ)
                    }
                    ,
                    Debug::fmt(index)
                }
                ,
            )
            index = index + 1_usize
        }
        ret()
    }

    let mut index = 0_usize
    for field in item.named_fields {
        ctx_add_field(ctx, StructFieldType {
                owner, field.name,
                if source_name == "" {
                    field.typ
                } else {
                    qualified_type_for_source(ctx, source_name, field.typ)
                }
                ,
                Debug::fmt(index)
            }
            ,
        )
        index = index + 1_usize
    }
    ret()
}

fn async_future_base_name(name: str) -> str {
    let mut out = "__encore_future_"
    let mut index = 0_usize
    while index < name.len() {
        let byte = name.byte_at(index)
        if (byte >= 48_u8 && byte <= 57_u8) ||(byte >= 65_u8 && byte <= 90_u8) ||(byte >= 97_u8 && byte
            <= 122_u8) || byte == 95_u8 {
            out = out + name.slice(index, 1_usize)
        } else {
            out = out + "_"
        }
        index = index + 1_usize
    }
    ret out
}

fn async_future_type(name: str, generics: Vec[GenericParam]) -> str {
    let base = async_future_base_name(name)
    let names = generic_param_names(generics)
    if names.len() == 0_usize {
        ret base
    }
    ret base + "[" + join_strs(names, ", ") + "]"
}

fn remember_async_future(ctx: mut TranslatorContext, item: FunctionItem, typ: str) ->() {
    remember_async_future_output(ctx, item, typ, function_ret_type(item))
    ret()
}

fn remember_async_future_output(ctx: mut TranslatorContext, item: FunctionItem, typ: str, output_type:
    str,) ->() {
    let owner = base_type_name(typ)
    remember_type(ctx, owner)
    ctx_add_field(ctx, StructFieldType {
            owner, "state", "usize", "0"
        }
        ,
    )
    let mut index = 0_usize
    for param in item.params {
        ctx_add_field(ctx, StructFieldType {
                owner, param.name, unwrap_type_or_usize(param.typ), Debug::fmt(index + 1_usize)
            }
            ,
        )
        index = index + 1_usize
    }
    let mut trait_args = Vec[str]::new()
    trait_args.push(output_type)
    ctx.trait_impls.push(TraitImplType {
            "Future", trait_args, typ, item.generics
        }
        ,
    )
    ret()
}

fn future_output_type(ctx: mut TranslatorContext, future_type: str, source_name: str, line: usize, column:
    usize,) -> str {
    for implementation in ctx.trait_impls {
        if implementation.trait_name == "Future" && base_type_name(implementation.target) == base_type_name(future_type)
        {
            match implementation.trait_args.get(0_usize) {
                Some(output) => {
                    ret canonical_type(output)
                }
                None => {
                }
            }
        }
    }
    translation_error_at(source_name, line, column, "invalid-await-operand", "await expects a Future, got '"
        + canonical_type(future_type) + "'",)
    ret "void"
}

fn ctx_add_function(ctx: mut TranslatorContext, source_name: str, name: str, ret_type: str, params: Vec[str],
    sending_params: Vec[bool], frozen_params: Vec[bool], readonly_self: bool,
    generics: Vec[str], is_extern: bool, is_async: bool, output_type: str,
    returns_sending: bool, returns_frozen: bool,) ->() {
    let overload_key = source_name + "\n" + name
    let encoded_overload_count = unsafe {
        encore_strmap_get(ctx.function_overload_counts, overload_key)
    }
    let overload_index = if encoded_overload_count == 0_usize {
        0_usize
    } else {
        encoded_overload_count - 1_usize
    }
    let local_name = if overload_index == 0_usize {
        name
    } else {
        name + "__overload_" + Debug::fmt(overload_index)
    }
    let is_member = last_scope_index(name) < name.len()
    let emitted_name = if is_extern || name == "main" || is_member {
        local_name
    } else {
        module_symbol_prefix(ctx, source_name) + local_name
    }
    let previous_head = unsafe {
        encore_strmap_get(ctx.function_heads, name)
    }
    ctx.function_next.push(previous_head)
    let owner = function_owner_name(name)
    let trait_contract = owner != "" && source_declares_trait(ctx, source_name, owner)
    let resolved_ret_type = if trait_contract {
        canonical_type(ret_type)
    } else {
        qualified_type_for_source(ctx, source_name, ret_type)
    }
    let resolved_output_type = if trait_contract {
        canonical_type(output_type)
    } else {
        qualified_type_for_source(ctx, source_name, output_type)
    }
    let mut resolved_params = Vec[str]::new()
    for param in params {
        resolved_params.push(if trait_contract {
                canonical_type(param)
            } else {
                qualified_type_for_source(ctx, source_name, param)
            }
        )
    }
    ctx.functions.push(FunctionType {
            name, emitted_name, source_name, resolved_ret_type, resolved_params, sending_params, frozen_params, readonly_self,
            generics, is_extern, is_async, resolved_output_type, returns_sending, returns_frozen
        }
        ,
    )
    unsafe {
        encore_strmap_put(ctx.function_heads, name, ctx.functions.len())
    }
    unsafe {
        encore_strmap_put(ctx.function_overload_counts, overload_key, overload_index + 2_usize)
    }
    ret()
}

fn source_declares_trait(ctx: mut TranslatorContext, source_name: str, name: str) -> bool {
    let encoded = lookup_module_source_alias(ctx.module_index, source_name)
    if encoded == 0_usize {
        ret false
    }
    match ctx.modules.get(encoded - 1_usize) {
        Some(module) => {
            for statement in module.ast {
                match statement {
                    Statement::Trait(item) => {
                        if item.name == name {
                            ret true
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        None => {
        }
    }
    ret false
}

fn module_identity_for_source(ctx: mut TranslatorContext, source_name: str) -> str {
    let encoded = lookup_module_source_alias(ctx.module_index, source_name)
    if encoded > 0_usize {
        match ctx.modules.get(encoded - 1_usize) {
            Some(module) => {
                ret module.module_id
            }
            None => {
            }
        }
    }
    ret canonical_source_identity(source_name)
}

fn hex_digit(value: u8) -> str {
    let digits = "0123456789abcdef"
    ret digits.slice(value as usize, 1_usize)
}

fn encode_module_identity(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let byte = value.byte_at(index)
        out = out + hex_digit(byte / 16_u8) + hex_digit(byte % 16_u8)
        index = index + 1_usize
    }
    ret out
}

fn module_symbol_prefix(ctx: mut TranslatorContext, source_name: str) -> str {
    let encoded = lookup_module_source_alias(ctx.module_index, source_name)
    if encoded > 0_usize {
        match ctx.module_prefixes.get(encoded - 1_usize) {
            Some(prefix) => {
                ret prefix
            }
            None => {
            }
        }
    }
    ret "__encore_m" + encode_module_identity(canonical_source_identity(source_name)) + "__"
}

fn ctx_next_emitted_name(ctx: mut TranslatorContext, source_name: str, name: str) -> str {
    let encoded_overload_count = unsafe {
        encore_strmap_get(ctx.function_overload_counts, source_name + "\n" + name)
    }
    let overload_index = if encoded_overload_count == 0_usize {
        0_usize
    } else {
        encoded_overload_count - 1_usize
    }
    let local_name = if overload_index == 0_usize {
        name
    } else {
        name + "__overload_" + Debug::fmt(overload_index)
    }
    let is_member = last_scope_index(name) < name.len()
    ret if name == "main" || is_member {
        local_name
    } else {
        module_symbol_prefix(ctx, source_name) + local_name
    }
}

fn resolve_async_future_aliases(ctx: mut TranslatorContext, source_name: str, typ: str) -> str {
    let mut value = canonical_type(typ)
    for function in ctx.functions {
        if function.is_async && function.source_name == source_name {
            let alias = async_future_base_name(function.name)
            value = replace_type_token(value, alias, base_type_name(function.ret_type))
        }
    }
    ret canonical_type(value)
}

fn ctx_add_var(ctx: mut TranslatorContext, name: str, typ: str) ->() {
    ctx_add_var_emitted(ctx, name, name, typ)
    ret()
}

fn ctx_bind_fresh_region(ctx: mut TranslatorContext, name: str) ->() {
    if !strict_thread_capabilities() {
        ret()
    }
    let region = ctx.next_region
    ctx.next_region += 1_usize
    while ctx.region_parents.len() <= region {
        ctx.region_parents.push(ctx.region_parents.len())
    }
    ctx_set_var_region(ctx, name, region)
    ret()
}

fn ctx_region_root(ctx: mut TranslatorContext, region: usize) -> usize {
    if !strict_thread_capabilities() {
        ret 0_usize
    }
    if region == 0_usize {
        ret 0_usize
    }
    let mut current = region
    loop {
        match ctx.region_parents.get(current) {
            Some(parent) => {
                if parent == current {
                    ret current
                }
                current = parent
            }
            None => {
                ret current
            }
        }
    }
}

fn ctx_set_var_region(ctx: mut TranslatorContext, name: str, region: usize) ->() {
    if !strict_thread_capabilities() {
        ret()
    }
    let mut kept = Vec[VariableRegion]::new()
    for binding in ctx.variable_regions {
        if binding.name != name {
            kept.push(binding)
        }
    }
    kept.push(VariableRegion {
            name, region
        }
        ,
    )
    ctx.variable_regions = kept
    ret()
}

fn ctx_lookup_var_region(ctx: mut TranslatorContext, name: str) -> usize {
    if !strict_thread_capabilities() {
        ret 0_usize
    }
    let mut index = ctx.variable_regions.len()
    while index > 0_usize {
        index -= 1_usize
        match ctx.variable_regions.get(index) {
            Some(binding) => {
                if binding.name == name {
                    ret ctx_region_root(ctx, binding.region)
                }
            }
            None => {
            }
        }
    }
    ret 0_usize
}

fn ctx_live_region_alias_count(ctx: mut TranslatorContext, region: usize) -> usize {
    let root = ctx_region_root(ctx, region)
    if root == 0_usize {
        ret 0_usize
    }
    let mut count = 0_usize
    for binding in ctx.variable_regions {
        if ctx_region_root(ctx, binding.region) == root {
            match ctx_lookup_var(ctx, binding.name) {
                Some(_) => {
                    count += 1_usize
                }
                None => {
                }
            }
        }
    }
    ret count
}

fn ctx_mark_region_connected(ctx: mut TranslatorContext, region: usize) ->() {
    let root = ctx_region_root(ctx, region)
    if root == 0_usize || contains_usize(ctx.connected_regions, root) {
        ret()
    }
    ctx.connected_regions.push(root)
    ret()
}

fn ctx_region_is_connected(ctx: mut TranslatorContext, region: usize) -> bool {
    ret contains_usize(ctx.connected_regions, ctx_region_root(ctx, region))
}

fn ctx_merge_regions(ctx: mut TranslatorContext, left: usize, right: usize) -> usize {
    let left_root = ctx_region_root(ctx, left)
    let right_root = ctx_region_root(ctx, right)
    if left_root == 0_usize {
        ret right_root
    }
    if right_root == 0_usize || left_root == right_root {
        ret left_root
    }
    let right_connected = contains_usize(ctx.connected_regions, right_root)
    let right_borrowed = contains_usize(ctx.borrowed_input_regions, right_root)
    let right_frozen = contains_usize(ctx.frozen_regions, right_root)
    ctx.region_parents.set(right_root, left_root)
    if right_connected {
        ctx_mark_region_connected(ctx, left_root)
    }
    if right_borrowed && !contains_usize(ctx.borrowed_input_regions, left_root) {
        ctx.borrowed_input_regions.push(left_root)
    }
    if right_frozen {
        ctx_mark_region_frozen(ctx, left_root)
    }
    ret left_root
}

fn ctx_mark_region_frozen(ctx: mut TranslatorContext, region: usize) ->() {
    let root = ctx_region_root(ctx, region)
    if root != 0_usize && !contains_usize(ctx.frozen_regions, root) {
        ctx.frozen_regions.push(root)
    }
    ret()
}

fn ctx_path_is_frozen(ctx: mut TranslatorContext, path: str) -> bool {
    ret path != "" && contains_usize(ctx.frozen_regions, ctx_lookup_var_region(ctx, path))
}

fn ctx_mark_value_frozen(ctx: mut TranslatorContext, value: str) ->() {
    if !strict_thread_capabilities() {
        ret()
    }
    if value != "" && !contains_str(ctx.frozen_values, value) {
        ctx.frozen_values.push(value)
    }
    ret()
}

fn ctx_value_is_frozen(ctx: mut TranslatorContext, value: str) -> bool {
    if !strict_thread_capabilities() {
        ret false
    }
    ret value != "" && contains_str(ctx.frozen_values, value)
}

fn contains_usize(values: Vec[usize], wanted: usize) -> bool {
    for value in values {
        if value == wanted {
            ret true
        }
    }
    ret false
}

fn ctx_add_var_emitted(ctx: mut TranslatorContext, name: str, emitted_name: str, typ: str) ->() {
    let mut index = 0_usize
    while index < ctx.vars.len() {
        match ctx.vars.get(index) {
            Option[VarType]::Some(item) => {
                if item.name == name {
                    ctx.vars.set(index, VarType {
                            name, emitted_name, typ
                        }
                        ,
                    )
                    ctx_bind_fresh_region(ctx, name)
                    ret()
                }
            }
            Option[VarType]::None => {
            }
        }
        index = index + 1_usize
    }
    ctx.vars.push(VarType {
            name, emitted_name, typ
        }
        ,
    )
    ctx_bind_fresh_region(ctx, name)
    ret()
}

fn ctx_type_needs_ownership(ctx: mut TranslatorContext, typ: str) -> bool {
    let value = canonical_type(typ)
    if value == "str" {
        ret true
    }
    if starts_with(value, "__tuple_") {
        ret true
    }
    if starts_with(value, "dyn ") {
        ret true
    }
    if ends_with(value, "<H>") || ends_with(value, "<S>") || ends_with(value, "&") {
        ret true
    }
    if starts_with(value, "mut ") || ends_with(value, "*") {
        ret false
    }
    if value == "void" || value == "()" || value == "bool" || is_numeric_type(value) {
        ret false
    }
    let owner = base_type_name(value)
    if unsafe {
        encore_strset_contains(ctx.owning_type_index, owner)
    }
    {
        ret true
    }
    // Generic and not-yet-resolved nominal types may have descriptive names
    // such as `Iter`, not only single-letter names such as `T`. Their concrete
    // specialization can own data, so lowering must preserve borrowed copies.
    if owner.len() > 0_usize {
        let first = owner.byte_at(0_usize)
        if first >= 65_u8 && first <= 90_u8 {
            ret true
        }
    }
    ret false
}

fn thread_type_is_send(ctx: mut TranslatorContext, typ: str, seen: Vec[str]) -> bool {
    if seen.len() > 0_usize {
        ret thread_type_is_send_inner(ctx, typ, seen)
    }
    let key = canonical_type(typ)
    if contains_str(ctx.send_types, key) {
        ret true
    }
    if contains_str(ctx.nonsend_types, key) {
        ret false
    }
    let result = thread_type_is_send_inner(ctx, key, seen)
    if result {
        ctx.send_types.push(key)
    } else {
        ctx.nonsend_types.push(key)
    }
    ret result
}

fn thread_type_is_send_inner(ctx: mut TranslatorContext, typ: str, seen: Vec[str]) -> bool {
    let raw = canonical_type(typ)
    if starts_with(raw, "mut ") || ends_with(raw, "*") || ends_with(raw, "<H>") || ends_with(raw, "<S>")
    || ends_with(raw, "&")
    || starts_with(raw, "dyn ") {
        ret false
    }
    let value = canonical_type(value_type_name(raw))
    if value == "str" || value == "()" || value == "void" || value == "bool" || is_numeric_type(value)
    {
        ret true
    }
    let owner = base_type_name(value)
    if owner == "JoinHandle" {
        ret false
    }
    if owner == "Vec" && strict_thread_capabilities() {
        ret false
    }
    if owner == "Vec" || starts_with(owner, "__tuple_") || starts_with(owner, "__array_") {
        for generic in generic_args_from_path(value) {
            if !thread_type_is_send(ctx, generic, seen) {
                ret false
            }
        }
        ret true
    }
    if contains_str(seen, value) {
        ret true
    }
    let mut next_seen = copy_str_vec(seen)
    next_seen.push(value)
    let mut found = false
    for field in ctx.fields {
        if field.owner == owner || leaf_type_name(field.owner) == leaf_type_name(owner) {
            found = true
            if !thread_type_is_send(ctx, direct_generic_hint(field.typ, generic_args_from_path(value)),
                next_seen,) {
                ret false
            }
        }
    }
    for variant in ctx.enum_variants {
        if variant.owner == owner || leaf_type_name(variant.owner) == leaf_type_name(owner) {
            found = true
            if variant.payload_type != "" && !thread_type_is_send(ctx, direct_generic_hint(variant.payload_type,
                    generic_args_from_path(value),), next_seen) {
                ret false
            }
        }
    }
    // Fieldless value types are safe to move. Unknown pointer-like forms were
    // rejected above, so an unresolved nominal type remains a value aggregate.
    ret true
}

fn thread_type_is_transferable_region(ctx: mut TranslatorContext, typ: str) -> bool {
    let key = canonical_type(typ)
    if contains_str(ctx.transferable_region_types, key) {
        ret true
    }
    if contains_str(ctx.nontransferable_region_types, key) {
        ret false
    }
    if thread_type_is_send(ctx, typ, Vec[str]::new()) {
        ctx.nontransferable_region_types.push(key)
        ret false
    }
    let result = thread_type_is_transferable_region_inner(ctx, typ, Vec[str]::new())
    if result {
        ctx.transferable_region_types.push(key)
    } else {
        ctx.nontransferable_region_types.push(key)
    }
    ret result
}

fn thread_type_is_transferable_region_inner(ctx: mut TranslatorContext, typ: str, seen: Vec[str]) -> bool {
    let raw = canonical_type(value_type_name(typ))
    if starts_with(raw, "mut ") || ends_with(raw, "*") || ends_with(raw, "<S>") ||
    ends_with(raw, "&") || starts_with(raw, "dyn ") {
        ret false
    }
    if thread_type_is_send(ctx, raw, Vec[str]::new()) {
        ret true
    }
    let owner = base_type_name(raw)
    if owner == "Vec" {
        for generic in generic_args_from_path(raw) {
            if !thread_type_is_transferable_region_inner(ctx, generic, seen) {
                ret false
            }
        }
        ret true
    }
    if contains_str(seen, raw) {
        ret true
    }
    let mut next_seen = copy_str_vec(seen)
    next_seen.push(raw)
    let mut found = false
    for field in ctx.fields {
        if field.owner == owner || leaf_type_name(field.owner) == leaf_type_name(owner) {
            found = true
            if !thread_type_is_transferable_region_inner(ctx,
                direct_generic_hint(field.typ, generic_args_from_path(raw)), next_seen,) {
                ret false
            }
        }
    }
    for variant in ctx.enum_variants {
        if variant.owner == owner || leaf_type_name(variant.owner) == leaf_type_name(owner) {
            found = true
            if variant.payload_type != "" && !thread_type_is_transferable_region_inner(ctx,
                direct_generic_hint(variant.payload_type, generic_args_from_path(raw)), next_seen,) {
                ret false
            }
        }
    }
    ret found
}

fn thread_type_is_freezable_region(ctx: mut TranslatorContext, typ: str) -> bool {
    ret thread_type_is_transferable_region(ctx, typ)
}

fn validate_sending_argument(ctx: mut TranslatorContext, typ: str, path: str, source_name: str,
    line: usize, column: usize,) -> bool {
    if thread_type_is_send(ctx, typ, Vec[str]::new()) {
        ret false
    }
    if !thread_type_is_transferable_region(ctx, typ) {
        translation_error_at(source_name, line, column, "non-transferable-region",
            "type '" + canonical_type(typ) + "' is neither Sendable nor a supported isolated region",)
        ret false
    }
    if path == "" {
        // A freshly produced temporary has no source-level aliases and its
        // one owner is transferred directly into the call.
        ret false
    }
    let region = ctx_lookup_var_region(ctx, path)
    if region == 0_usize {
        translation_error_at(source_name, line, column, "sending-path-required",
            "sending an owned region requires a local path or a fresh value",)
        ret false
    }
    if ctx_region_is_connected(ctx, region) {
        translation_error_at(source_name, line, column, "connected-region-transfer",
            "cannot send '" + path + "' because its region may be reachable through an unknown call or store",)
        ret false
    }
    let aliases = ctx_live_region_alias_count(ctx, region)
    if aliases != 1_usize {
        translation_error_at(source_name, line, column, "aliased-region-transfer",
            "cannot send '" + path + "' while " + Debug::fmt(aliases) + " live aliases reach its region",)
        ret false
    }
    ret true
}

fn validate_thread_send_type(ctx: mut TranslatorContext, typ: str, source_name: str, line: usize, column:
    usize, role: str,) ->() {
    if !thread_type_is_send(ctx, typ, Vec[str]::new()) {
        translation_error_at(source_name, line, column, "thread-unsafe-type", role + " type '" + canonical_type(typ)
            + "' cannot cross a thread boundary",)
    }
    ret()
}

fn ctx_add_owned_var(ctx: mut TranslatorContext, name: str, emitted_name: str, typ: str) ->() {
    if is_mutable_handle_slot(typ) {
        ctx.owned_vars.push(VarType {
                name, emitted_name, typ
            }
            ,
        )
        ret()
    }
    let ownership_type = if starts_with(typ, "mut ") {
        value_type_name(typ)
    } else {
        typ
    }
    if !ctx_type_needs_ownership(ctx, ownership_type) {
        ret()
    }
    // This is a cleanup stack, not a symbol table. Shadowed declarations have
    // distinct storage and both values must be released when the scope exits.
    ctx.owned_vars.push(VarType {
            name, emitted_name, typ
        }
        ,
    )
    ret()
}

fn ctx_move_owned_var(ctx: mut TranslatorContext, name: str) ->() {
    if name == "" {
        ret()
    }
    let mut kept = Vec[VarType]::new()
    for variable in ctx.owned_vars {
        if variable.name != name {
            kept.push(variable)
        }
    }
    ctx.owned_vars = kept
    ret()
}

fn append_owned_drops(ctx: mut TranslatorContext, builder: EhirTextBuilder, exclude_name: str, prefix:
    str,) -> EhirTextBuilder {
    ret append_owned_drops_from(ctx, builder, exclude_name, prefix, 0_usize)
}

fn append_owned_drops_from(ctx: mut TranslatorContext, builder: EhirTextBuilder, exclude_name: str, prefix:
    str, start: usize,) -> EhirTextBuilder {
    let mut out = builder
    let mut index = ctx.owned_vars.len()
    while index > start {
        index = index - 1_usize
        match ctx.owned_vars.get(index) {
            Option[VarType]::Some(item) => {
                if item.name != exclude_name {
                    if is_mutable_handle_slot(item.typ) {
                        let handle_type = mutable_handle_slot_type(item.typ)
                        let bits = prefix + "_drop_handle_bits_" + Debug::fmt(index)
                        let handle = prefix + "_drop_handle_" + Debug::fmt(index)
                        out = out.instr(bits + ": usize = load " + item.emitted_name)
                        out = out.instr(handle + ": " + handle_type + " = pcast " +
                            bits + ": usize, " + handle_type,)
                        out = out.instr("drop " + handle + ": " + handle_type)
                    } elif starts_with(item.typ, "mut ") {
                        let value_type = value_type_name(item.typ)
                        let loaded = prefix + "_drop_load_" + Debug::fmt(index)
                        out = out.instr(loaded + ": " + value_type + " = load " + item.emitted_name)
                        out = out.instr("drop " + loaded + ": " + value_type)
                    } else {
                        out = out.instr("drop " + item.emitted_name + ": " + item.typ)
                    }
                }
            }
            Option[VarType]::None => {
            }
        }
    }
    ret out
}

fn restore_owned_vars(ctx: mut TranslatorContext, size: usize) ->() {
    while ctx.owned_vars.len() > size {
        ctx.owned_vars.pop()
    }
    ret()
}

fn move_var_out_of_context(ctx: mut TranslatorContext, name: str) ->() {
    if name == "" {
        ret()
    }
    let mut remaining_vars = Vec[VarType]::new()
    for variable in ctx.vars {
        if variable.name != name {
            remaining_vars.push(variable)
        }
    }
    ctx.vars = remaining_vars
    let mut remaining_owned = Vec[VarType]::new()
    for variable in ctx.owned_vars {
        if variable.name != name {
            remaining_owned.push(variable)
        }
    }
    ctx.owned_vars = remaining_owned
    let mut remaining_regions = Vec[VariableRegion]::new()
    for binding in ctx.variable_regions {
        if binding.name != name {
            remaining_regions.push(binding)
        }
    }
    ctx.variable_regions = remaining_regions
    ret()
}

fn ctx_lookup_value_name(ctx: mut TranslatorContext, name: str) -> str {
    let mut index = ctx.vars.len()
    while index > 0_usize {
        index = index - 1_usize
        match ctx.vars.get(index) {
            Option[VarType]::Some(item) => {
                if item.name == name {
                    ret item.emitted_name
                }
            }
            Option[VarType]::None => {
            }
        }
    }
    ret name
}

fn ctx_lookup_var(ctx: mut TranslatorContext, name: str) -> Option[str] {
    let mut index = ctx.vars.len()
    while index > 0_usize {
        index = index - 1_usize
        match ctx.vars.get(index) {
            Option[VarType]::Some(item) => {
                if item.name == name {
                    ret Option[str]::Some(item.typ)
                }
            }
            Option[VarType]::None => {
            }
        }
    }
    ret Option[str]::None
}

fn ctx_path_is_mutable(ctx: mut TranslatorContext, name: str) -> bool {
    if name == "" {
        ret false
    }
    match ctx_lookup_var(ctx, name) {
        Some(typ) => {
            ret starts_with(typ, "mut ") || is_mutable_handle_slot(typ)
        }
        None => {
            ret false
        }
    }
    ret false
}

fn ctx_lookup_function(ctx: mut TranslatorContext, name: str) -> Option[str] {
    let base_name = base_type_name(name)
    let mut item_index = ctx.functions.len()
    while item_index > 0_usize {
        item_index = item_index - 1_usize
        match ctx.functions.get(item_index) {
            Some(item) => {
                if item.name == name || item.name == base_name {
                    ret Option[str]::Some(item.ret_type)
                }
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn function_type_matches(template: str, actual: str, generics: Vec[str]) -> bool {
    let expected = trim_spaces(canonical_type(value_type_name(template)))
    let found = trim_spaces(canonical_type(value_type_name(actual)))
    if expected == found {
        ret true
    }
    for generic in generics {
        if expected == generic {
            ret true
        }
    }
    if base_type_name(expected) != base_type_name(found) {
        ret false
    }
    let expected_args = generic_args_from_path(expected)
    let found_args = generic_args_from_path(found)
    if expected_args.len() == 0_usize || expected_args.len() != found_args.len() {
        ret false
    }
    let mut index = 0_usize
    while index < expected_args.len() {
        match expected_args.get(index) {
            Some(expected_arg) => {
                match found_args.get(index) {
                    Some(found_arg) => {
                        if !function_type_matches(expected_arg, found_arg, generics) {
                            ret false
                        }
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret false
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn function_matches_args(function: FunctionType, actual_types: Vec[str]) -> bool {
    if function.params.len() != actual_types.len() {
        ret false
    }
    let mut index = 0_usize
    while index < function.params.len() {
        match function.params.get(index) {
            Option[str]::Some(expected) => {
                match actual_types.get(index) {
                    Option[str]::Some(actual) => {
                        if !function_type_matches(expected, actual, function.generics) {
                            ret false
                        }
                    }
                    Option[str]::None => {
                        ret false
                    }
                }
            }
            Option[str]::None => {
                ret false
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn ctx_lookup_function_for_args(ctx: mut TranslatorContext, source_name: str, name: str, actual_types:
    Vec[str],) -> Option[FunctionType] {
    let base = base_type_name(name)
    let member = enum_variant_name(base)
    let scope = last_scope_index(base)
    if scope < base.len() {
        let requested_module = base.slice(0_usize, scope)
        let mut qualified = unsafe {
            encore_strmap_get(ctx.function_heads, member)
        }
        while qualified > 0_usize {
            let index = qualified - 1_usize
            match ctx.functions.get(index) {
                Option[FunctionType]::Some(function) => {
                    let function_module = module_import_path(module_identity_for_source(ctx, function.source_name))
                    if function.name == member && function_module == requested_module &&
                    function_matches_args(function, actual_types) {
                        ret Option[FunctionType]::Some(function)
                    }
                }
                Option[FunctionType]::None => {
                }
            }
            match ctx.function_next.get(index) {
                Some(next) => {
                    qualified = next
                }
                None => {
                    qualified = 0_usize
                }
            }
        }
    }
    let mut encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base)
    }
    while encoded > 0_usize {
        let index = encoded - 1_usize
        match ctx.functions.get(index) {
            Option[FunctionType]::Some(function) => {
                if function.source_name == source_name && function.name == base && function_matches_args(function,
                    actual_types,) {
                    ret Option[FunctionType]::Some(function)
                }
            }
            Option[FunctionType]::None => {
            }
        }
        match ctx.function_next.get(index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base)
    }
    // Prefer an explicitly selected import over other visible functions with
    // the same unqualified name.
    while encoded > 0_usize {
        let index = encoded - 1_usize
        match ctx.functions.get(index) {
            Option[FunctionType]::Some(function) => {
                if function.name == base && function_matches_args(function, actual_types) &&
                function_directly_imported(ctx, source_name, function.source_name, function.name) {
                    ret Option[FunctionType]::Some(function)
                }
            }
            Option[FunctionType]::None => {
            }
        }
        match ctx.function_next.get(index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base)
    }
    while encoded > 0_usize {
        let index = encoded - 1_usize
        match ctx.functions.get(index) {
            Option[FunctionType]::Some(function) => {
                if function.name == base && function_matches_args(function, actual_types) && function_visible_from(ctx,
                    source_name, function.source_name, function.name,) {
                    ret Option[FunctionType]::Some(function)
                }
            }
            Option[FunctionType]::None => {
            }
        }
        match ctx.function_next.get(index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    if member == base {
        ret Option[FunctionType]::None
    }
    encoded = unsafe {
        encore_strmap_get(ctx.function_heads, member)
    }
    while encoded > 0_usize {
        let index = encoded - 1_usize
        match ctx.functions.get(index) {
            Option[FunctionType]::Some(function) => {
                if function.name == member && function_matches_args(function, actual_types) && function_visible_from(ctx,
                    source_name, function.source_name, function.name,) {
                    ret Option[FunctionType]::Some(function)
                }
            }
            Option[FunctionType]::None => {
            }
        }
        match ctx.function_next.get(index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    ret Option[FunctionType]::None
}

fn function_visible_from(ctx: mut TranslatorContext, caller_source: str,
    function_source: str, function_name: str,) -> bool {
    if caller_source == function_source {
        ret true
    }
    if ctx.modules.len() == 0_usize {
        ret true
    }
    let caller = module_identity_for_source(ctx, caller_source)
    let target = module_identity_for_source(ctx, function_source)
    // Synthetic/legacy flat AST nodes are not always owned by a resolved
    // TranslationModule. Preserve their historical flat-program visibility;
    // resolved workspace declarations still take the strict import path.
    if caller == caller_source || target == function_source {
        ret true
    }
    match direct_import_allows(ctx, caller_source, target, function_name) {
        Option[bool]::Some(allowed) => {
            if allowed {
                ret true
            }
        }
        Option[bool]::None => {
        }
    }
    ret unsafe {
        encore_strset_contains(ctx.visibility_index, caller + "\n" + target)
    }
}

fn function_directly_imported(ctx: mut TranslatorContext, caller_source: str,
    function_source: str, function_name: str,) -> bool {
    if caller_source == function_source || ctx.modules.len() == 0_usize {
        ret false
    }
    let caller = module_identity_for_source(ctx, caller_source)
    let target = module_identity_for_source(ctx, function_source)
    if caller == caller_source || target == function_source {
        ret false
    }
    match direct_import_allows(ctx, caller_source, target, function_name) {
        Option[bool]::Some(allowed) => {
            ret allowed
        }
        Option[bool]::None => {
        }
    }
    ret false
}

fn direct_import_allows(ctx: mut TranslatorContext, caller_source: str,
    target_module: str, function_name: str,) -> Option[bool] {
    let caller = module_identity_for_source(ctx, caller_source)
    let prefix = caller + "\n" + target_module + "\n"
    if !unsafe {
        encore_strset_contains(ctx.direct_import_index, prefix + "#edge")
    }
    {
        ret Option[bool]::None
    }
    let scope = find_char(function_name, "::", 0_usize)
    let imported_name = if scope < function_name.len() {
        function_name.slice(0_usize, scope)
    } else {
        function_name
    }
    if unsafe {
        encore_strset_contains(ctx.direct_import_index, prefix + "*") ||
        encore_strset_contains(ctx.direct_import_index, prefix + imported_name)
    }
    {
        ret Option[bool]::Some(true)
    }
    let decision = prefix + "#symbol:" + imported_name
    if unsafe {
        encore_strset_contains(ctx.direct_import_index, decision + ":denied")
    }
    {
        ret Option[bool]::Some(false)
    }
    // Keep the precomputed index as the fast path, but validate a cache miss
    // against the parsed import. This covers nested/aliased import spellings
    // without putting an AST walk on every function lookup.
    for module in ctx.modules {
        if module.source_name == caller_source && contains_str(module.imports, target_module) {
            for statement in module.ast {
                match statement {
                    Statement::Import(item) => {
                        if import_path_allows(item.path, module_import_path(target_module), function_name)
                        {
                            let _allowed = unsafe {
                                encore_strset_insert(ctx.direct_import_index, prefix + imported_name)
                            }
                            ret Option[bool]::Some(true)
                        }
                    }
                    _ => {
                    }
                }
            }
            let _denied = unsafe {
                encore_strset_insert(ctx.direct_import_index, decision + ":denied")
            }
            ret Option[bool]::Some(false)
        }
    }
    ret Option[bool]::Some(false)
}

fn build_direct_import_index(modules: Vec[TranslationModule]) -> usize {
    let index = unsafe {
        encore_strset_new()
    }
    for module in modules {
        for target in module.imports {
            let prefix = module.module_id + "\n" + target + "\n"
            let _edge = unsafe {
                encore_strset_insert(index, prefix + "#edge")
            }
            let target_path = module_import_path(target)
            for statement in module.ast {
                match statement {
                    Statement::Import(item) => {
                        remember_import_permissions(index, prefix, target_path, item.path)
                    }
                    _ => {
                    }
                }
            }
        }
    }
    ret index
}

fn remember_import_permissions(index: usize, prefix: str, target: str, raw: str) ->() {
    let path = trim_spaces(raw)
    if path == target || path == target + "::*" {
        let _inserted = unsafe {
            encore_strset_insert(index, prefix + "*")
        }
        ret()
    }
    let selected_prefix = target + "::{"
    if starts_with(path, selected_prefix) && ends_with(path, "}") {
        let inner = path.slice(selected_prefix.len(), path.len() - selected_prefix.len() - 1_usize)
        let mut start = 0_usize
        let mut position = 0_usize
        while position <= inner.len() {
            if position == inner.len() || inner.slice(position, 1_usize) == "," {
                let name = trim_spaces(inner.slice(start, position - start))
                if name != "" {
                    let _inserted = unsafe {
                        encore_strset_insert(index, prefix + name)
                    }
                }
                start = position + 1_usize
            }
            position = position + 1_usize
        }
        ret()
    }
    let direct_prefix = target + "::"
    if starts_with(path, direct_prefix) {
        let name = path.slice(direct_prefix.len(), path.len() - direct_prefix.len())
        if name != "" && find_char(name, "::", 0_usize) >= name.len() {
            let _inserted = unsafe {
                encore_strset_insert(index, prefix + name)
            }
        }
    }
    ret()
}

fn module_import_path(module_id: str) -> str {
    let separator = find_char(module_id, "@", 0_usize)
    if separator >= module_id.len() {
        ret module_id
    }
    let owner = module_id.slice(0_usize, separator)
    let mut relative = module_id.slice(separator + 1_usize,
        module_id.len() - separator - 1_usize,)
    if relative == "lib.enq" || relative == "main.enq" {
        ret owner
    }
    if ends_with(relative, "/mod.enq") {
        relative = relative.slice(0_usize, relative.len() - 8_usize)
    } elif ends_with(relative, ".enq") {
        relative = relative.slice(0_usize, relative.len() - 4_usize)
    }
    let mut result = owner + "::"
    let mut index = 0_usize
    while index < relative.len() {
        let character = relative.slice(index, 1_usize)
        result += if character == "/" || character == "\\" {
            "::"
        } else {
            character
        }
        index += 1_usize
    }
    ret result
}

fn import_path_allows(raw: str, target: str, function_name: str) -> bool {
    let path = trim_spaces(raw)
    let scope = find_char(function_name, "::", 0_usize)
    let imported_name = if scope < function_name.len() {
        function_name.slice(0_usize, scope)
    } else {
        function_name
    }
    if path == target || path == target + "::*" ||
    path == target + "::" + imported_name {
        ret true
    }
    let prefix = target + "::{"
    if !starts_with(path, prefix) || !ends_with(path, "}") {
        ret false
    }
    let inner = path.slice(prefix.len(), path.len() - prefix.len() - 1_usize)
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= inner.len() {
        if index == inner.len() || inner.slice(index, 1_usize) == "," {
            let item = trim_spaces(inner.slice(start, index - start))
            if item == imported_name || item == "*" {
                ret true
            }
            start = index + 1_usize
        }
        index += 1_usize
    }
    ret false
}

fn build_module_visibility(modules: Vec[TranslationModule]) -> Vec[(str, str)] {
    // Never traverse `modules` in the transitive-closure loop. A
    // TranslationModule owns its complete parsed AST; materializing it from
    // Vec for every origin/target pair creates and drops O(M^2) roots into the
    // same large graph, forcing synchronous ERN trial deletion repeatedly.
    // Visibility only needs these two small fields.
    let mut compact = Vec[VisibilityModule]::new()
    let module_index = unsafe {
        encore_strmap_new()
    }
    for module in modules {
        let mut imports = Vec[str]::new()
        imports.extend(module.imports)
        unsafe {
            encore_strmap_put(module_index, module.module_id, compact.len() + 1_usize)
        }
        compact.push(VisibilityModule {
                module.module_id, imports
            }
            ,
        )
    }
    let mut out = Vec[(str, str)]::new()
    for origin in compact {
        // Vec values intentionally alias one graph node.  The visibility
        // traversal needs a private work queue: mutating origin.imports here
        // would otherwise mutate the resolved module graph and, during
        // parallel lowering, the source graph shared by every worker.
        let mut queue = Vec[str]::new()
        queue.extend(origin.imports)
        let visited = unsafe {
            encore_strset_new()
        }
        let mut index = 0_usize
        while index < queue.len() {
            match queue.get(index) {
                Option[str]::Some(module_id) => {
                    if unsafe {
                        encore_strset_insert(visited, module_id)
                    }
                    {
                        let encoded = unsafe {
                            encore_strmap_get(module_index, module_id)
                        }
                        if encoded > 0_usize {
                            match compact.get(encoded - 1_usize) {
                                Option[VisibilityModule]::Some(target) => {
                                    out.push((origin.module_id, target.module_id))
                                    for imported in target.imports {
                                        if !unsafe {
                                            encore_strset_contains(visited, imported)
                                        }
                                        {
                                            queue.push(imported)
                                        }
                                    }
                                }
                                Option[VisibilityModule]::None => {
                                }
                            }
                        }
                    }
                }
                Option[str]::None => {
                }
            }
            index = index + 1_usize
        }
        unsafe {
            encore_strset_free(visited)
        }
    }
    unsafe {
        encore_strmap_free(module_index)
    }
    ret out
}

fn contains_visibility_edge(edges: Vec[(str, str)], expected:(str, str)) -> bool {
    for edge in edges {
        if edge.0 == expected.0 && edge.1 == expected.1 {
            ret true
        }
    }
    ret false
}

fn plain_function_argument_error(ctx: mut TranslatorContext, source_name: str, name: str, actual_types:
    Vec[str],)
-> Option[str] {
    if last_scope_index(name) < name.len() {
        ret Option[str]::None
    }
    let base = base_type_name(name)
    let mut found = false
    let mut expected_count = 0_usize
    for function in ctx.functions {
        if function.source_name == source_name && function.name == base {
            found = true
            expected_count = function.params.len()
            if function.params.len() == actual_types.len() {
                if function.generics.len() > 0_usize {
                    ret Option[str]::None
                }
                ret Option[str]::Some("arguments to '" + name + "' have types [" + join_strs(actual_types,
                        ", ",) + "], expected [" + join_strs(function.params, ", ") + "]")
            }
        }
    }
    if found {
        ret Option[str]::Some("call to '" + name + "' expects " + Debug::fmt(expected_count) + " argument(s), got "
            + Debug::fmt(actual_types.len()))
    }
    for function in ctx.functions {
        if function.name == base && function_visible_from(ctx, source_name,
            function.source_name, function.name,) {
            found = true
            expected_count = function.params.len()
            if function.params.len() == actual_types.len() {
                if function.generics.len() > 0_usize {
                    ret Option[str]::None
                }
                ret Option[str]::Some("arguments to '" + name + "' have types [" + join_strs(actual_types,
                        ", ",) + "], expected [" + join_strs(function.params, ", ") + "]")
            }
        }
    }
    if found {
        ret Option[str]::Some("call to '" + name + "' expects " + Debug::fmt(expected_count) + " argument(s), got "
            + Debug::fmt(actual_types.len()))
    }
    ret Option[str]::None
}

fn ctx_emitted_declaration_name(ctx: mut TranslatorContext, source_name: str, name: str, params: Vec[str])
-> str {
    match ctx_lookup_function_for_args(ctx, source_name, name, params) {
        Option[FunctionType]::Some(function) => {
            ret function.emitted_name
        }
        Option[FunctionType]::None => {
            ret name
        }
    }
}

fn ctx_lookup_function_param(ctx: mut TranslatorContext, source_name: str, name: str, index: usize, generic_args:
    Vec[str],) -> Option[str] {
    let base_name = base_type_name(name)
    let mut encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base_name)
    }
    while encoded > 0_usize {
        let item_index = encoded - 1_usize
        match ctx.functions.get(item_index) {
            Some(item) => {
                if item.source_name == source_name &&(item.name == name || item.name == base_name) {
                    match item.params.get(index) {
                        Option[str]::Some(typ) => {
                            ret Option[str]::Some(specialize_named_type(typ, item.generics, generic_args))
                        }
                        Option[str]::None => {
                            ret Option[str]::None
                        }
                    }
                }
            }
            None => {
            }
        }
        match ctx.function_next.get(item_index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base_name)
    }
    while encoded > 0_usize {
        let item_index = encoded - 1_usize
        match ctx.functions.get(item_index) {
            Some(item) => {
                if (item.name == name || item.name == base_name) && function_visible_from(ctx, source_name,
                    item.source_name, item.name,) {
                    match item.params.get(index) {
                        Option[str]::Some(typ) => {
                            ret Option[str]::Some(specialize_named_type(typ, item.generics, generic_args))
                        }
                        Option[str]::None => {
                            ret Option[str]::None
                        }
                    }
                }
            }
            None => {
            }
        }
        match ctx.function_next.get(item_index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    // Re-exported nominal types keep their defining method name while the
    // caller's source module sees only the public alias. Dispatch resolution
    // already uses that canonical method name; recover the same signature so
    // mutable receivers are lowered as places rather than loaded values.
    let mut fallback_index = ctx.functions.len()
    while fallback_index > 0_usize {
        fallback_index -= 1_usize
        match ctx.functions.get(fallback_index) {
            Some(item) => {
                if item.name == name {
                    match item.params.get(index) {
                        Some(typ) => {
                            ret Option[str]::Some(specialize_named_type(typ, item.generics, generic_args))
                        }
                        None => {
                            ret Option[str]::None
                        }
                    }
                }
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn ctx_lookup_method_return(ctx: mut TranslatorContext, method_name: str) -> Option[str] {
    let suffix = "::" + method_name
    let mut item_index = ctx.functions.len()
    while item_index > 0_usize {
        item_index = item_index - 1_usize
        match ctx.functions.get(item_index) {
            Some(item) => {
                if ends_with(item.name, suffix) {
                    ret Option[str]::Some(item.ret_type)
                }
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn ctx_function_is_extern(ctx: mut TranslatorContext, name: str) -> bool {
    let base = base_type_name(name)
    for item in ctx.extern_functions {
        if item == name || item == base {
            ret true
        }
    }
    ret false
}

fn ctx_function_returns_borrowed(ctx: mut TranslatorContext, name: str) -> bool {
    let base = base_type_name(name)
    for item in ctx.borrowed_return_functions {
        if item == name || item == base {
            ret true
        }
    }
    ret false
}

fn ctx_function_borrows_self(ctx: mut TranslatorContext, name: str) -> bool {
    let base = base_type_name(name)
    for item in ctx.borrowed_self_functions {
        if item == name || item == base {
            ret true
        }
    }
    ret false
}

fn resolve_loop_target(ctx: mut TranslatorContext, label: Option[str], fallback: Option[str], is_continue:
    bool,) -> Option[str] {
    match label {
        Some(name) => {
            let mut index = ctx.loop_targets.len()
            while index > 0_usize {
                index = index - 1_usize
                match ctx.loop_targets.get(index) {
                    Some(target) => {
                        if target.name == name {
                            ret Option[str]::Some(if is_continue {
                                    target.continue_target
                                } else {
                                    target.break_target
                                }
                            )
                        }
                    }
                    None => {
                    }
                }
            }
        }
        None => {
        }
    }
    ret fallback
}

fn loop_cleanup_start(ctx: mut TranslatorContext, label: Option[str]) -> usize {
    let mut index = ctx.loop_targets.len()
    while index > 0_usize {
        index = index - 1_usize
        match ctx.loop_targets.get(index) {
            Some(target) => {
                match label {
                    Some(name) => {
                        if target.name == name {
                            ret target.owned_start
                        }
                    }
                    None => {
                        ret target.owned_start
                    }
                }
            }
            None => {
            }
        }
    }
    ret ctx.owned_vars.len()
}

fn loop_label_name(label: Option[str]) -> str {
    match label {
        Some(name) => {
            ret name
        }
        None => {
        }
    }
    ret ""
}

fn generic_param_names(params: Vec[GenericParam]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for parameter in params {
        out.push(parameter.name)
    }
    ret out
}

fn specialize_function_return(ctx: mut TranslatorContext, name: str, generic_args: Vec[str], fallback:
    str,) -> str {
    let base_name = base_type_name(name)
    let mut item_index = ctx.functions.len()
    while item_index > 0_usize {
        item_index = item_index - 1_usize
        match ctx.functions.get(item_index) {
            Some(item) => {
                if item.name == name || item.name == base_name {
                    if generic_args.len() > 0_usize && item.generics.len() == 0_usize {
                        continue
                    }
                    if generic_args.len() == 0_usize && item.generics.len() > 0_usize {
                        continue
                    }
                    ret specialize_named_type(item.ret_type, item.generics, generic_args)
                }
            }
            None => {
            }
        }
    }
    ret fallback
}

fn specialize_named_type(typ: str, params: Vec[str], args: Vec[str]) -> str {
    let mut specialized = typ
    let mut index = 0_usize
    while index < params.len() {
        match params.get(index) {
            Option[str]::Some(param_name) => {
                match args.get(index) {
                    Option[str]::Some(arg_type) => {
                        specialized = replace_type_token(specialized, param_name, canonical_type(arg_type))
                    }
                    Option[str]::None => {
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index = index + 1_usize
    }
    if params.len() == 0_usize && args.len() == 1_usize && typ.len() == 1_usize {
        let first = typ.byte_at(0_usize)
        if first >= 65_u8 && first <= 90_u8 {
            match args.get(0_usize) {
                Option[str]::Some(arg_type) => {
                    ret canonical_type(arg_type)
                }
                Option[str]::None => {
                }
            }
        }
    }
    ret canonical_type(specialized)
}

fn replace_type_token(value: str, token: str, replacement: str) -> str {
    if token.len() == 0_usize {
        ret value
    }
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        if index + token.len() <= value.len() && value.slice(index, token.len()) == token {
            let left_ok = index == 0_usize || !is_type_name_char(value.byte_at(index - 1_usize))
            let right_index = index + token.len()
            let right_ok = right_index >= value.len() || !is_type_name_char(value.byte_at(right_index))
            if left_ok && right_ok {
                out = out + replacement
                index = right_index
                continue
            }
        }
        out = out + value.slice(index, 1_usize)
        index = index + 1_usize
    }
    ret out
}

fn is_type_name_char(value: u8) -> bool {
    if value >= 48_u8 && value <= 57_u8 {
        ret true
    }
    if value >= 65_u8 && value <= 90_u8 {
        ret true
    }
    if value >= 97_u8 && value <= 122_u8 {
        ret true
    }
    ret value == 95_u8
}

fn function_param_types(item: FunctionItem) -> Vec[str] {
    let mut out = Vec[str]::new()
    for parameter in item.params {
        out.push(canonical_type(unwrap_type_or_usize(parameter.typ)))
    }
    ret out
}

fn function_param_sending(item: FunctionItem) -> Vec[bool] {
    let mut out = Vec[bool]::new()
    for parameter in item.params {
        out.push(strict_thread_capabilities() && parameter.is_sending)
    }
    ret out
}

fn function_param_frozen(item: FunctionItem) -> Vec[bool] {
    let mut out = Vec[bool]::new()
    for parameter in item.params {
        out.push(strict_thread_capabilities() && parameter.is_frozen)
    }
    ret out
}

fn function_receiver_is_readonly(item: FunctionItem) -> bool {
    if !strict_thread_capabilities() {
        ret false
    }
    for parameter in item.params {
        if parameter.name == "self" {
            ret !starts_with(canonical_type(unwrap_type_or_usize(parameter.typ)), "mut ")
        }
    }
    ret false
}

fn function_param_types_for_owner(item: FunctionItem, owner: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    for parameter in item.params {
        out.push(owner_context_type(owner, unwrap_type_or_usize(parameter.typ)))
    }
    ret out
}

fn ctx_lookup_field(ctx: mut TranslatorContext, owner: str, field: str) -> Option[str] {
    let owner_base = base_type_name(owner)
    let owner_leaf = leaf_type_name(owner_base)
    if starts_with(owner_base, "__tuple_") {
        ret tuple_field_type(owner, field)
    }
    if starts_with(owner_base, "__array_") {
        ret Option[str]::Some(nth_generic_type(owner, 0_usize))
    }
    let mut encoded = unsafe {
        encore_strmap_get(ctx.field_index, owner_base + "\n" + field)
    }
    if encoded == 0_usize {
        encoded = unsafe {
            encore_strmap_get(ctx.field_index, owner_leaf + "\n" + field)
        }
    }
    if encoded > 0_usize {
        match ctx.fields.get(encoded - 1_usize) {
            Some(item) => {
                let owner_generics = generic_args_from_path(owner)
                if item.owner == owner_base && owner_generics.len() > 0_usize {
                    ret Option[str]::Some(direct_generic_hint(item.typ, owner_generics))
                }
                ret Option[str]::Some(item.typ)
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn ctx_lookup_field_at_position(ctx: mut TranslatorContext, owner: str, position: str) -> Option[str]
{
    let owner_base = base_type_name(owner)
    let owner_leaf = leaf_type_name(owner_base)
    let mut encoded = unsafe {
        encore_strmap_get(ctx.field_index, owner_base + "\n#" + position)
    }
    if encoded == 0_usize {
        encoded = unsafe {
            encore_strmap_get(ctx.field_index, owner_leaf + "\n#" + position)
        }
    }
    if encoded > 0_usize {
        match ctx.fields.get(encoded - 1_usize) {
            Some(item) => {
                ret Option[str]::Some(direct_generic_hint(item.typ, generic_args_from_path(owner)))
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn ctx_lookup_field_index(ctx: mut TranslatorContext, owner: str, field: str) -> str {
    let owner_base = base_type_name(owner)
    let owner_leaf = leaf_type_name(owner_base)
    let mut encoded = unsafe {
        encore_strmap_get(ctx.field_index, owner_base + "\n" + field)
    }
    if encoded == 0_usize {
        encoded = unsafe {
            encore_strmap_get(ctx.field_index, owner_leaf + "\n" + field)
        }
    }
    if encoded > 0_usize {
        match ctx.fields.get(encoded - 1_usize) {
            Some(item) => {
                ret item.index
            }
            None => {
            }
        }
    }
    ret field
}

fn ctx_enum_variant_owner(ctx: mut TranslatorContext, path: str) -> Option[str] {
    let scope = last_scope_index(path)
    if scope >= path.len() {
        ret Option[str]::None
    }
    let requested_owner = path.slice(0_usize, scope)
    let requested_base = base_type_name(requested_owner)
    // `Opt` is the conventional prelude alias for Option. Import statements
    // are flattened before bootstrap translation, so preserve this alias at
    // the type boundary until module-scoped name resolution is introduced.
    let resolved_base = if requested_base == "Opt" {
        "Option"
    } else {
        requested_base
    }
    let mut resolved_owner = resolved_base
    let generic_start = find_char(requested_owner, "[", 0_usize)
    if generic_start < requested_owner.len() {
        resolved_owner = resolved_base + requested_owner.slice(generic_start, requested_owner.len() -
            generic_start,)
    }
    let requested_variant = path.slice(scope + 2_usize, path.len() - scope - 2_usize)
    for item in ctx.enum_variants {
        if enum_variant_name(item.path) == requested_variant && item.owner == resolved_base {
            ret Option[str]::Some(resolved_owner)
        }
    }
    ret Option[str]::None
}

fn tuple_field_type(owner: str, field: str) -> Option[str] {
    let index = decimal_usize(field)
    if index < generic_args_from_path(owner).len() {
        ret Option[str]::Some(nth_generic_type(owner, index))
    }
    ret Option[str]::None
}

fn base_type_name(name: str) -> str {
    let value = value_type_name(name)
    let mut out = ""
    let mut depth = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "[" {
            depth += 1_usize
        } elif ch == "]" {
            if depth > 0_usize {
                depth -= 1_usize
            }
        } elif depth == 0_usize {
            out += ch
        }
        index += 1_usize
    }
    ret out
}

fn value_type_name(name: str) -> str {
    let mut value = name
    if starts_with(value, "mut ") {
        value = value.slice(4_usize, value.len() - 4_usize)
    }
    if ends_with(value, "<H>") || ends_with(value, "<S>") {
        ret value.slice(0_usize, value.len() - 3_usize)
    }
    if ends_with(value, "&") {
        ret value.slice(0_usize, value.len() - 1_usize)
    }
    if ends_with(value, "*") {
        ret value.slice(0_usize, value.len() - 1_usize)
    }
    ret value
}

fn is_node_handle_type_text(name: str) -> bool {
    let value = canonical_type(name)
    ret ends_with(value, "<S>") || ends_with(value, "<H>") || ends_with(value, "&")
}

fn mutable_handle_slot_type(name: str) -> str {
    let marker = "mut_handle "
    if starts_with(name, marker) {
        ret name.slice(marker.len(), name.len() - marker.len())
    }
    ret ""
}

fn is_mutable_handle_slot(name: str) -> bool {
    ret mutable_handle_slot_type(name) != ""
}

fn leaf_type_name(name: str) -> str {
    let mut index = name.len()
    while index > 0_usize {
        index = index - 1_usize
        if index > 0_usize && name.slice(index - 1_usize, 2_usize) == "::" {
            ret name.slice(index + 1_usize, name.len() - index - 1_usize)
        }
    }
    ret name
}

fn method_owner_name(receiver_type: str) -> str {
    ret leaf_type_name(base_type_name(receiver_type))
}

fn method_return_type(receiver_type: str, method_name: str, source_name: str, line: usize, column: usize)
-> str {
    if receiver_type == "Iter" && method_name == "next" {
        ret "__tuple_2[Iter, Option[T]]"
    }
    if starts_with(receiver_type, "dyn ") {
        let resolved = dyn_method_return_type(receiver_type, method_name)
        if resolved != "" {
            ret resolved
        }
        translation_error_at(source_name, line, column, "unknown-method", "type '" + receiver_type +
            "' has no method '" + method_name + "'",)
    }
    let owner = method_owner_name(receiver_type)
    if owner == "Iter" && method_name == "next" {
        ret "__tuple_2[Iter, Option[T]]"
    }
    if owner == "Vec" {
        let resolved = vec_method_return_type(receiver_type, method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "VecIter" {
        let resolved = vec_iter_method_return_type(receiver_type, method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "Option" {
        let resolved = option_method_return_type(receiver_type, method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "Result" {
        let resolved = result_method_return_type(receiver_type, method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "String" {
        let resolved = string_method_return_type(method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "str" {
        let resolved = str_method_return_type(method_name)
        if resolved != "" {
            ret resolved
        }
    }
    if owner == "Path" {
        let resolved = path_method_return_type(method_name)
        if resolved != "" {
            ret resolved
        }
    }
    translation_error_at(source_name, line, column, "unknown-method", "type '" + receiver_type + "' has no method '"
        + method_name + "'",)
    ret "void"
}

fn dyn_method_return_type(receiver_type: str, method_name: str) -> str {
    let trait_name = receiver_type.slice(4_usize, receiver_type.len() - 4_usize)
    if trait_name == "LogSink" && method_name == "write" {
        ret "i32"
    }
    if trait_name == "Writable" && method_name == "write" {
        ret "i32"
    }
    ret ""
}

fn vec_method_return_type(receiver_type: str, method_name: str) -> str {
    if method_name == "as_ptr" || method_name == "as_mut_ptr" {
        ret first_generic_type(receiver_type) + "*"
    }
    if method_name == "len" {
        ret "usize"
    }
    if method_name == "capacity" {
        ret "usize"
    }
    if method_name == "is_empty" {
        ret "bool"
    }
    if method_name == "reserve" {
        ret "()"
    }
    if method_name == "push" {
        ret "()"
    }
    if method_name == "set" {
        ret "()"
    }
    if method_name == "get" {
        ret "Option[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "first" {
        ret "Option[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "last" {
        ret "Option[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "clear" {
        ret "()"
    }
    if method_name == "pop" {
        ret "Option[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "extend" {
        ret "()"
    }
    if method_name == "free" {
        ret "bool"
    }
    if method_name == "iter" {
        ret "VecIter[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "into_iter" {
        ret "VecIter[" + first_generic_type(receiver_type) + "]"
    }
    if method_name == "fmt" {
        ret "str"
    }
    ret ""
}

fn vec_iter_method_return_type(receiver_type: str, method_name: str) -> str {
    if method_name == "iter" {
        ret receiver_type
    }
    if method_name == "next" {
        ret "__tuple_2[" + receiver_type + ", Option[" + first_generic_type(receiver_type) + "]]"
    }
    if method_name == "into_iter" {
        ret receiver_type
    }
    ret ""
}

fn option_method_return_type(receiver_type: str, method_name: str) -> str {
    if method_name == "is_some" {
        ret "bool"
    }
    if method_name == "is_none" {
        ret "bool"
    }
    if method_name == "unwrap_or" {
        ret first_generic_type(receiver_type)
    }
    ret ""
}

fn result_method_return_type(receiver_type: str, method_name: str) -> str {
    if method_name == "is_ok" {
        ret "bool"
    }
    if method_name == "is_err" {
        ret "bool"
    }
    if method_name == "unwrap_or" {
        ret nth_generic_type(receiver_type, 0_usize)
    }
    if method_name == "unwrap_err_or" {
        ret nth_generic_type(receiver_type, 1_usize)
    }
    ret ""
}

fn string_method_return_type(method_name: str) -> str {
    if method_name == "len" {
        ret "usize"
    }
    if method_name == "byte_at" {
        ret "Option[u8]"
    }
    ret ""
}

fn str_method_return_type(method_name: str) -> str {
    if method_name == "len" {
        ret "usize"
    }
    if method_name == "byte_len" || method_name == "char_len" {
        ret "usize"
    }
    if method_name == "byte_at" {
        ret "u8"
    }
    if method_name == "get" {
        ret "Option[str]"
    }
    if method_name == "get_byte" || method_name == "get_byte_at" {
        ret "Option[u8]"
    }
    if method_name == "slice" || method_name == "slice_bytes" || method_name == "slice_chars" || method_name
    == "concat" {
        ret "str"
    }
    ret ""
}

fn path_method_return_type(method_name: str) -> str {
    if method_name == "as_str" {
        ret "str"
    }
    if method_name == "exists" {
        ret "bool"
    }
    if method_name == "read_text" {
        ret "str"
    }
    ret ""
}

fn first_generic_type(receiver_type: str) -> str {
    ret nth_generic_type(receiver_type, 0_usize)
}

fn nth_generic_type(receiver_type: str, target_index: usize) -> str {
    let value = value_type_name(receiver_type)
    let open = find_char(value, "[", 0_usize)
    if open >= value.len() {
        translation_invariant_error("unable to resolve a generic argument for type '" + value + "'")
        ret "void"
    }

    let mut index = open + 1_usize
    let mut depth = 0_usize
    let mut paren_depth = 0_usize
    let mut generic_index = 0_usize
    let mut start = open + 1_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "[" {
            depth = depth + 1_usize
        } elif ch == "(" {
            paren_depth = paren_depth + 1_usize
        } elif ch == ")" {
            if paren_depth > 0_usize {
                paren_depth = paren_depth - 1_usize
            }
        } else {
            if ch == "]" {
                if depth == 0_usize {
                    if generic_index == target_index {
                        ret canonical_type(value.slice(start, index - start))
                    }
                    translation_invariant_error("generic argument index is out of range for type '" +
                        value + "'")
                    ret "void"
                }
                depth = depth - 1_usize
            } else {
                if ch == "," && depth == 0_usize && paren_depth == 0_usize {
                    if generic_index == target_index {
                        ret canonical_type(value.slice(start, index - start))
                    }
                    generic_index = generic_index + 1_usize
                    start = index + 1_usize
                    if start < value.len() && value.slice(start, 1_usize) == " " {
                        start = start + 1_usize
                    }
                }
            }
        }
        index = index + 1_usize
    }

    translation_invariant_error("unterminated generic argument list in canonical type '" + value + "'")
    ret "void"
}

fn path_value_type(ctx: mut TranslatorContext, name: str) -> str {
    match ctx_lookup_var(ctx, name) {
        Option[str]::Some(found) => {
            ret found
        }
        Option[str]::None => {
        }
    }

    let last_scope = last_scope_index(name)
    if last_scope < name.len() {
        ret name.slice(0_usize, last_scope)
    }
    ret "usize"
}

fn enum_variant_owner_type(name: str) -> str {
    let scope = last_scope_index(name)
    if scope >= name.len() {
        ret "usize"
    }
    ret canonical_type(name.slice(0_usize, scope))
}

fn enum_variant_name(name: str) -> str {
    let scope = last_scope_index(name)
    if scope >= name.len() {
        ret name
    }
    ret name.slice(scope + 2_usize, name.len() - scope - 2_usize)
}

fn enum_variant_init(name: str) -> str {
    ret enum_variant_owner_type(name) + "::" + enum_variant_name(name)
}

fn canonical_scoped_name(name: str) -> str {
    let scope = last_scope_index(name)
    if scope >= name.len() {
        ret name
    }
    let owner = name.slice(0_usize, scope)
    let member = name.slice(scope + 2_usize, name.len() - scope - 2_usize)
    ret canonical_type(owner) + "::" + member
}

fn is_known_enum_variant_name(variant: str) -> bool {
    if variant == "Some" {
        ret true
    }
    if variant == "None" {
        ret true
    }
    if variant == "Ok" {
        ret true
    }
    if variant == "Err" {
        ret true
    }
    if variant == "Null" {
        ret true
    }
    if variant == "Bool" {
        ret true
    }
    if variant == "Number" {
        ret true
    }
    if variant == "String" {
        ret true
    }
    if variant == "Array" {
        ret true
    }
    if variant == "Object" {
        ret true
    }
    if variant == "Default" {
        ret true
    }
    if variant == "Black" {
        ret true
    }
    if variant == "Red" {
        ret true
    }
    if variant == "Green" {
        ret true
    }
    if variant == "Yellow" {
        ret true
    }
    if variant == "Blue" {
        ret true
    }
    if variant == "Magenta" {
        ret true
    }
    if variant == "Cyan" {
        ret true
    }
    if variant == "White" {
        ret true
    }
    if variant == "BrightBlack" {
        ret true
    }
    if variant == "BrightRed" {
        ret true
    }
    if variant == "BrightGreen" {
        ret true
    }
    if variant == "BrightYellow" {
        ret true
    }
    if variant == "BrightBlue" {
        ret true
    }
    if variant == "BrightMagenta" {
        ret true
    }
    if variant == "BrightCyan" {
        ret true
    }
    if variant == "BrightWhite" {
        ret true
    }
    if variant == "Normal" {
        ret true
    }
    if variant == "Bold" {
        ret true
    }
    if variant == "Dim" {
        ret true
    }
    if variant == "Italic" {
        ret true
    }
    if variant == "Underline" {
        ret true
    }
    if variant == "Blink" {
        ret true
    }
    if variant == "Reverse" {
        ret true
    }
    if variant == "Hidden" {
        ret true
    }
    if variant == "Strikethrough" {
        ret true
    }
    if variant == "Dots" {
        ret true
    }
    if variant == "Line" {
        ret true
    }
    if variant == "Arc" {
        ret true
    }
    if variant == "Trace" {
        ret true
    }
    if variant == "Debug" {
        ret true
    }
    if variant == "Info" {
        ret true
    }
    if variant == "Warn" {
        ret true
    }
    if variant == "Error" {
        ret true
    }
    if variant == "Fatal" {
        ret true
    }
    ret false
}

fn is_enum_variant_path(name: str) -> bool {
    let scope = last_scope_index(name)
    if scope >= name.len() {
        ret false
    }
    ret is_known_enum_variant_name(enum_variant_name(name))
}

fn last_scope_index(value: str) -> usize {
    if value.len() < 2_usize {
        ret value.len()
    }
    let mut index = value.len() - 1_usize
    while index > 0_usize {
        if value.slice(index - 1_usize, 2_usize) == "::" {
            ret index - 1_usize
        }
        index = index - 1_usize
    }
    ret value.len()
}

fn translate_struct(item: StructStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = append_ehir_documentation(builder, item.documentation, "///")
    let mut header = "struct " + item.name
    if item.generics.len() > 0_usize {
        header = header + "[" + translate_generic_params(item.generics) + "]"
    }
    builder = builder.line(header + " {")
    if item.is_tuple {
        let mut i = 0_usize
        for field_t in item.tuple_fields {
            builder = builder.line("  _" + Debug::fmt(i) + ": " + canonical_type(field_t))
            i = i + 1_usize
        }
    } else {
        for field in item.named_fields {
            builder = builder.line("  " + field.name + ": " + canonical_type(field.typ))
        }
    }
    builder = builder.line("}")
    ret builder
}

fn translate_enum(item: EnumStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = append_ehir_documentation(builder, item.documentation, "///")
    let mut header = "enum " + item.name
    if item.generics.len() > 0_usize {
        header = header + "[" + translate_generic_params(item.generics) + "]"
    }
    builder = builder.line(header + " {")
    for variant in item.variants {
        if variant.is_unit {
            builder = builder.line("  " + variant.name)
        } elif variant.is_tuple {
            let mut tuple_fields = Vec[str]::new()
            for field_t in variant.tuple_fields {
                tuple_fields.push(canonical_type(field_t))
            }
            builder = builder.line("  " + variant.name + "(" + join_strs(tuple_fields, ", ") + ")")
        } else {
            let mut fields = Vec[str]::new()
            for field in variant.named_fields {
                fields.push(canonical_type(field.typ))
            }
            builder = builder.line("  " + variant.name + "(" + join_strs(fields, ", ") + ")")
        }
    }
    builder = builder.line("}")
    ret builder
}

fn translate_trait(ctx: mut TranslatorContext, item: TraitStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = append_ehir_documentation(builder, item.documentation, "///")
    let mut header = "trait " + item.name
    if item.generics.len() > 0_usize {
        header = header + "[" + translate_generic_params(item.generics) + "]"
    }
    builder = builder.line(header + " {")
    for base in item.bases {
        let prefix = base_type_name(base) + "::"
        for function in ctx.functions {
            if starts_with(function.name, prefix) {
                let method_name = function.name.slice(prefix.len(), function.name.len() - prefix.len())
                let mut params = Vec[str]::new()
                let mut param_index = 0_usize
                for param_type in function.params {
                    let param_name = if param_index == 0_usize {
                        "self"
                    } else {
                        "arg" + Debug::fmt(param_index)
                    }
                    params.push(param_name + ": " + replace_type_token(param_type, base_type_name(base),
                            item.name,))
                    param_index = param_index + 1_usize
                }
                builder = builder.line("  fn " + method_name + "(" + join_strs(params, ", ") + ") -> "
                    + replace_type_token(function.ret_type, base_type_name(base), item.name))
            }
        }
    }
    for method in item.methods {
        builder = builder.line("  fn " + method.name + "(" + translate_params(method) + ") -> " + function_ret_type(method))
    }
    builder = builder.line("}")
    ret builder
}

fn inline_expr_node(node: ExprNode < H >) -> ExprNode {
    ret ExprNode {
        node.value, node.line, node.column, node.length, node.source_name
    }
}

fn decorator_named(ctx: mut TranslatorContext, name: str, owner: str, source_name: str,
    line: usize, column: usize,) -> DecoratorType {
    let mut found = Option[DecoratorType]::None
    for candidate in ctx.decorators {
        if candidate.item.name == name &&(owner == "" || candidate.owner == owner) {
            match found {
                Some(_) => {
                    translation_error_at(source_name, line, column, "ambiguous-decorator",
                        "decorator '" + name + "' is ambiguous; qualify it through its owner",)
                }
                None => {
                    found = Option[DecoratorType]::Some(candidate)
                }
            }
        }
    }
    match found {
        Some(value) => {
            ret value
        }
        None => {
            translation_error_at(source_name, line, column, "unknown-decorator",
                "unknown decorator '" + name + "'",)
        }
    }
    ret DecoratorType {
        "", FunctionItem {
            Vec[str]::new(), Vec[DecoratorApplication]::new(), false,
            false, false, "", Option[Documentation]::None, Vec[GenericParam]::new(),
            Vec[FunctionParam]::new(), Option[str]::None, false, false, Option[ParsedBlock]::None,
            source_name, line, column
        }
    }
}

fn decorator_receiver_owner(ctx: mut TranslatorContext, receiver: ExprNode) -> str {
    match receiver.value {
        Expr::Path(name) => {
            match ctx_lookup_var(ctx, name) {
                Some(typ) => {
                    ret base_type_name(value_type_name(typ))
                }
                None => {
                }
            }
            match ctx_lookup_function_for_args(ctx, receiver.source_name, name, Vec[str]::new()) {
                Some(function) => {
                    ret base_type_name(value_type_name(function.ret_type))
                }
                None => {
                }
            }
        }
        Expr::StructInit(item) => {
            ret base_type_name(item.path)
        }
        Expr::Parenthesized(inner) => {
            ret decorator_receiver_owner(ctx, inline_expr_node(inner))
        }
        _ => {
        }
    }
    ret ""
}

fn resolve_decorator(ctx: mut TranslatorContext, application: DecoratorApplication) -> ResolvedDecorator {
    let expression = application.expression
    match expression.value {
        Expr::Call(call) => {
            let name = expr_h_path_or_empty(call.callee)
            let definition = decorator_named(ctx, base_type_name(name), "", expression.source_name,
                expression.line, expression.column,)
            ret ResolvedDecorator {
                "", definition.item, Option[ExprNode]::None, call.args
            }
        }
        Expr::MethodCall(call) => {
            let receiver = inline_expr_node(call.receiver)
            let owner = decorator_receiver_owner(ctx, receiver)
            let definition = decorator_named(ctx, call.method, owner, expression.source_name,
                expression.line, expression.column,)
            ret ResolvedDecorator {
                definition.owner, definition.item,
                Option[ExprNode]::Some(receiver), call.args
            }
        }
        Expr::Path(name) => {
            let definition = decorator_named(ctx, base_type_name(name), "", expression.source_name,
                expression.line, expression.column,)
            ret ResolvedDecorator {
                "", definition.item, Option[ExprNode]::None, Vec[ExprNode]::new()
            }
        }
        _ => {
            translation_error_at(expression.source_name, expression.line, expression.column,
                "invalid-decorator", "decorator application must be a function or method call",)
        }
    }
    ret ResolvedDecorator {
        "", FunctionItem {
            Vec[str]::new(), Vec[DecoratorApplication]::new(), false,
            false, false, "", Option[Documentation]::None, Vec[GenericParam]::new(),
            Vec[FunctionParam]::new(), Option[str]::None, false, false, Option[ParsedBlock]::None,
            expression.source_name, expression.line, expression.column
        }
        , Option[ExprNode]::None,
        Vec[ExprNode]::new()
    }
}

fn decorator_hidden_name(item: FunctionItem, layer: usize) -> str {
    let identity = item.source_name + "::" + item.name + ":" + Debug::fmt(item.line) + ":" +
    Debug::fmt(item.column) + ":" + Debug::fmt(layer)
    ret "__encore_decorated_" + Debug::fmt(identity.hash()) + "_" + item.name
}

fn decorator_wrapper_params(item: FunctionItem) -> Vec[FunctionParam] {
    let mut params = Vec[FunctionParam]::new()
    let mut index = 0_usize
    for param in item.params {
        params.push(FunctionParam {
                "__decorated_arg_" + Debug::fmt(index), param.typ,
                param.is_sending, param.is_frozen
            }
            ,)
        index += 1_usize
    }
    ret params
}

fn decorator_wrapper_param_names(params: Vec[FunctionParam]) -> Vec[str] {
    let mut names = Vec[str]::new()
    for param in params {
        names.push(param.name)
    }
    ret names
}

fn required_decorator_param(item: FunctionItem, index: usize, source_name: str, line: usize,
    column: usize,) -> FunctionParam {
    match item.params.get(index) {
        Some(param) => {
            ret param
        }
        None => {
            translation_error_at(source_name, line, column, "invalid-decorator-signature",
                "decorator '" + item.name + "' does not declare its required compiler parameters",)
        }
    }
    ret FunctionParam {
        "", Option[str]::None, false, false
    }
}

fn decorator_wrapper_body(resolved: ResolvedDecorator, target: FunctionItem) -> ParsedBlock {
    let method_offset = if resolved.owner == "" {
        0_usize
    } else {
        1_usize
    }
    let config_start = method_offset + 2_usize
    if resolved.item.params.len() < config_start {
        translation_error_at(target.source_name, target.line, target.column,
            "invalid-decorator-signature", "decorator '" + resolved.item.name +
            "' must declare func and args compiler parameters",)
    }
    let expected_args = resolved.item.params.len() - config_start
    if expected_args != resolved.args.len() {
        translation_error_at(target.source_name, target.line, target.column,
            "decorator-argument-mismatch", "decorator '" + resolved.item.name + "' expects " +
            Debug::fmt(expected_args) + " argument(s), got " + Debug::fmt(resolved.args.len()),)
    }
    let mut statements = Vec[Statement]::new()
    if resolved.owner != "" {
        let receiver_param = required_decorator_param(resolved.item, 0_usize, target.source_name,
            target.line, target.column,)
        match resolved.receiver {
            Some(receiver) => {
                let receiver_type = match receiver_param.typ {
                    Some(typ) => Option[str]::Some(owner_context_type(resolved.owner, typ))
                    None => Option[str]::None
                }
                statements.push(Statement::Let(LetStmt {
                            receiver_param.name, receiver_type,
                            receiver, false
                        }
                        ,))
            }
            None => {
                translation_error_at(target.source_name, target.line, target.column,
                    "invalid-decorator-receiver", "method decorator requires a receiver",)
            }
        }
    }
    let mut index = 0_usize
    while index < resolved.args.len() {
        match resolved.args.get(index) {
            Some(argument) => {
                let parameter = required_decorator_param(resolved.item, config_start + index,
                    target.source_name, target.line, target.column,)
                statements.push(Statement::Let(LetStmt {
                            parameter.name, parameter.typ, argument, false
                        }
                        ,
                    ))
            }
            None => {
            }
        }
        index += 1_usize
    }
    match resolved.item.body {
        Some(body) => {
            statements.extend(body.statements)
        }
        None => {
            translation_error_at(target.source_name, target.line, target.column,
                "decorator-without-body", "decorator '" + resolved.item.name + "' must have a body",)
        }
    }
    ret ParsedBlock {
        statements
    }
}

fn register_decorator_layer(ctx: mut TranslatorContext, item: FunctionItem, logical_name: str) -> str {
    let output_type = function_ret_type(item)
    let emitted = ctx_next_emitted_name(ctx, item.source_name, logical_name)
    let callable_type = if item.is_async {
        async_future_type(emitted, item.generics)
    } else {
        output_type
    }
    ctx_add_function(ctx, item.source_name, logical_name, callable_type, function_param_types(item),
        function_param_sending(item), function_param_frozen(item), false,
        generic_param_names(item.generics), false, item.is_async,
        output_type, item.returns_sending, item.returns_frozen,)
    if item.is_async {
        remember_async_future(ctx, item, callable_type)
    }
    ret ctx_emitted_declaration_name(ctx, item.source_name, logical_name, function_param_types(item))
}

fn translate_decorated_function(ctx: mut TranslatorContext, item: FunctionItem,
    emitted_name: str,) -> EhirTextBuilder {
    if item.is_extern {
        translation_error_at(item.source_name, item.line, item.column, "decorated-extern",
            "extern functions cannot be decorated",)
    }
    let raw_name = decorator_hidden_name(item, item.decorators.len())
    let raw_item = FunctionItem {
        Vec[str]::new(), Vec[DecoratorApplication]::new(), false, false,
        item.is_async, raw_name, Option[Documentation]::None, item.generics, item.params,
        item.ret_type, item.returns_sending, item.returns_frozen, item.body, item.source_name,
        item.line, item.column
    }
    let raw_emitted = register_decorator_layer(ctx, raw_item, raw_name)
    let mut builder = translate_function_named(ctx, raw_item, raw_emitted, function_ret_type(item),
        Vec[GenericParam]::new(),)
    let mut next_name = raw_name
    let mut layer = item.decorators.len()
    while layer > 0_usize {
        layer -= 1_usize
        let application = match item.decorators.get(layer) {
            Some(value) => value
            None => DecoratorApplication {
                ExprNode {
                    Expr::Path(""), item.line, item.column, 0_usize,
                    item.source_name
                }
            }
        }
        let resolved = resolve_decorator(ctx, application)
        if resolved.item.is_async != item.is_async {
            translation_error_at(item.source_name, item.line, item.column,
                "decorator-async-mismatch", "decorator '" + resolved.item.name + "' and target '" +
                item.name + "' must both be sync or both be async",)
        }
        let method_offset = if resolved.owner == "" {
            0_usize
        } else {
            1_usize
        }
        let func_param = required_decorator_param(resolved.item, method_offset, item.source_name,
            item.line, item.column,)
        let args_param = required_decorator_param(resolved.item, method_offset + 1_usize,
            item.source_name, item.line, item.column,)
        let wrapper_params = decorator_wrapper_params(item)
        let wrapper_name = if layer == 0_usize {
            item.name
        } else {
            decorator_hidden_name(item, layer)
        }
        let wrapper_item = FunctionItem {
            item.attrs, Vec[DecoratorApplication]::new(),
            layer == 0_usize && item.is_public, false, item.is_async, wrapper_name,
            if layer == 0_usize {
                item.documentation
            } else {
                Option[Documentation]::None
            }
            ,
            item.generics, wrapper_params, item.ret_type, item.returns_sending, item.returns_frozen,
            Option[ParsedBlock]::Some(decorator_wrapper_body(resolved, item)), item.source_name,
            item.line, item.column
        }
        let wrapper_emitted = if layer == 0_usize {
            emitted_name
        } else {
            register_decorator_layer(ctx, wrapper_item, wrapper_name)
        }
        ctx.decorator_callable_name = func_param.name
        ctx.decorator_args_name = args_param.name
        ctx.decorator_target_name = next_name
        ctx.decorator_target_source_name = item.source_name
        ctx.decorator_target_params = decorator_wrapper_param_names(wrapper_item.params)
        ctx.decorator_target_generics = generic_param_names(item.generics)
        builder = builder.empty_line().append(translate_function_named(ctx, wrapper_item,
                wrapper_emitted, function_ret_type(item), Vec[GenericParam]::new(),))
        ctx.decorator_callable_name = ""
        ctx.decorator_args_name = ""
        ctx.decorator_target_name = ""
        ctx.decorator_target_source_name = ""
        ctx.decorator_target_params = Vec[str]::new()
        ctx.decorator_target_generics = Vec[str]::new()
        next_name = wrapper_name
    }
    ret builder
}

fn translate_function(ctx: mut TranslatorContext, fn_item: FunctionItem) -> EhirTextBuilder {
    if fn_item.is_async && fn_item.is_extern {
        translation_error_at(fn_item.source_name, fn_item.line, fn_item.column, "async-extern", "extern functions cannot be async")
    }
    let emitted_name = if fn_item.is_extern {
        fn_item.name
    } else {
        ctx_emitted_declaration_name(ctx, fn_item.source_name, fn_item.name, function_param_types(fn_item))
    }
    if fn_item.decorators.len() > 0_usize {
        ret translate_decorated_function(ctx, fn_item, emitted_name)
    }
    if fn_item.is_async {
        ret translate_async_function(ctx, fn_item, emitted_name)
    }
    ret translate_function_named(ctx, fn_item, emitted_name, function_ret_type(fn_item), Vec[GenericParam]::new())
}

fn translate_async_function(ctx: mut TranslatorContext, fn_item: FunctionItem, emitted_name: str) ->
EhirTextBuilder {
    ret translate_function_named(ctx, fn_item, emitted_name, function_ret_type(fn_item), Vec[GenericParam]::new())
}

fn translate_function_named(ctx: mut TranslatorContext, fn_item: FunctionItem, emitted_name: str, ret_type:
    str, scope_generics: Vec[GenericParam],) -> EhirTextBuilder {
    if fn_item.is_async && fn_item.is_extern {
        translation_error_at(fn_item.source_name, fn_item.line, fn_item.column, "async-extern", "extern functions cannot be async")
    }
    ctx.vars = Vec[VarType]::new()
    ctx.owned_vars = Vec[VarType]::new()
    ctx.variable_regions = Vec[VariableRegion]::new()
    ctx.region_parents = Vec[usize]::new()
    ctx.region_parents.push(0_usize)
    ctx.connected_regions = Vec[usize]::new()
    ctx.borrowed_input_regions = Vec[usize]::new()
    ctx.frozen_regions = Vec[usize]::new()
    ctx.frozen_values = Vec[str]::new()
    ctx.next_region = 1_usize
    ctx.return_type = qualified_type_for_source(ctx, fn_item.source_name, ret_type)
    ctx.return_is_sending = fn_item.returns_sending
    ctx.return_is_frozen = fn_item.returns_frozen
    if fn_item.returns_sending && fn_item.returns_frozen {
        translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
            "conflicting-return-capabilities", "a return type cannot be both sending and frozen",)
    }
    if fn_item.is_extern && fn_item.returns_frozen {
        translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
            "frozen-extern-return", "extern functions cannot declare frozen returns",)
    }
    ctx.in_async_function = fn_item.is_async
    ctx.async_poll_future_type = ""
    ctx.active_generics = combined_generic_params(scope_generics, fn_item.generics)
    let mut signature_generics = generic_param_names(ctx.active_generics)
    for generic in generic_args_from_path(ctx.self_type) {
        if !contains_str(signature_generics, generic) {
            signature_generics.push(generic)
        }
    }
    ensure_known_signature_type(ctx, ctx.return_type, signature_generics, fn_item.source_name, fn_item.line,
        fn_item.column,)
    ensure_object_safe_type(ctx, ctx.return_type, fn_item.source_name, fn_item.line, fn_item.column)
    for param in fn_item.params {
        let raw_param_type = unwrap_type_or_usize(param.typ)
        let param_type = qualified_type_for_source(ctx, fn_item.source_name,
            self_context_type(ctx, raw_param_type),)
        ensure_known_signature_type(ctx, param_type, signature_generics, fn_item.source_name, fn_item.line,
            fn_item.column,)
        ensure_object_safe_type(ctx, param_type, fn_item.source_name, fn_item.line, fn_item.column)
        if param.is_sending {
            if fn_item.is_extern {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "sending-extern-parameter", "extern functions cannot declare sending parameters",)
            }
            if param.name == "self" || starts_with(param_type, "mut ") {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "invalid-sending-parameter", "sending parameters must be owned values, not mutable places or self",)
            }
            if !thread_type_is_send(ctx, param_type, Vec[str]::new()) &&
            !thread_type_is_transferable_region(ctx, param_type) {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "non-transferable-region", "sending parameter type '" + canonical_type(param_type) +
                    "' is not a supported transferable region",)
            }
        }
        if param.is_frozen {
            if fn_item.is_extern {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "frozen-extern-parameter", "extern functions cannot declare frozen parameters",)
            }
            if param.is_sending || param.name == "self" || starts_with(param_type, "mut ") {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "invalid-frozen-parameter", "frozen parameters must be owned non-self values and cannot also be sending",)
            }
            if !ends_with(canonical_type(param_type), "*") &&
            !thread_type_is_send(ctx, param_type, Vec[str]::new()) &&
            !thread_type_is_freezable_region(ctx, param_type) {
                translation_error_at(fn_item.source_name, fn_item.line, fn_item.column,
                    "non-freezable-region", "frozen parameter type '" + canonical_type(param_type) +
                    "' is not a supported immutable region",)
            }
        }
        ctx_add_var(ctx, param.name, param_type)
        if param.is_frozen {
            ctx_mark_region_frozen(ctx, ctx_lookup_var_region(ctx, param.name))
            ctx_mark_value_frozen(ctx, ctx_lookup_value_name(ctx, param.name))
        } elif !param.is_sending && thread_type_is_transferable_region(ctx, param_type) {
            // An ordinary incoming region may still be reachable by its caller.
            // It cannot be published as a new frozen root.
            ctx.borrowed_input_regions.push(ctx_lookup_var_region(ctx, param.name))
        }
        // A local-place parameter aliases caller-owned storage. Every node
        // handle parameter, including `T&`, owns its incoming graph edge.
        if (!starts_with(param_type, "mut ") || ends_with(canonical_type(param_type), "&")) &&
        !(param.name == "self" &&
            function_has_attr(fn_item, "borrowed_self"))
        {
            ctx_add_owned_var(ctx, param.name, param.name, abi_parameter_type(param_type))
        }
    }
    let mut builder = EhirTextBuilder::new()
    builder = append_ehir_documentation(builder, fn_item.documentation, "///")
    let mut header = if fn_item.is_extern {
        "extern fn " + emitted_name
    } else {
        "fn " + emitted_name
    }
    if fn_item.is_async {
        header = "async fn " + emitted_name
    }
    if fn_item.generics.len() > 0_usize {
        header = header + "[" + translate_generic_params(fn_item.generics) + "]"
    }
    if fn_item.is_extern {
        ret builder.line(header + "(" + translate_params_in_context(ctx, fn_item) + ") -> " + ret_type)
    }
    builder = builder.line(header + "(" + translate_params_in_context(ctx, fn_item) + ") -> " + ret_type
        + " {")
    builder = builder.label("entry")

    match fn_item.body {
        Option[ParsedBlock]::Some(body) => {
            builder = builder.append(translate_statements(
                    ctx,
                    body.statements,
                    ctx.return_type,
                    "entry",
                    Option[str]::None,
                    Option[str]::None,
                ))
        }
        Option[ParsedBlock]::None => {
            builder = builder.append(translate_default_ret(ctx.return_type))
        }
    }

    builder = builder.line("}")
    ret builder
}

fn ensure_known_signature_type(ctx: mut TranslatorContext, typ: str, generics: Vec[str], source_name:
    str,
    line: usize, column: usize,) ->() {
    let mut value = trim_spaces(canonical_type(value_type_name(typ)))
    if starts_with(value, "dyn ") {
        value = trim_spaces(value.slice(4_usize, value.len() - 4_usize))
    }
    let base = base_type_name(value)
    if base == "" || base == "()" || base == "void" || base == "Self" || base == "bool" || base == "u1"
    || base == "str" || base == "usize" || base == "isize" || is_numeric_type(base) || starts_with(base,
        "__tuple_",) || starts_with(base, "__array_") {
        ret()
    }
    if contains_str(generics, base) {
        ret()
    }
    let known = unsafe {
        encore_strmap_get(ctx.type_index, base)
    }
    != 0_usize
    if !known {
        translation_error_at(source_name, line, column, "unknown-type", "unknown type '" + base + "'")
    }
    for argument in generic_args_from_path(value) {
        ensure_known_signature_type(ctx, argument, generics, source_name, line, column)
    }
    ret()
}

fn ensure_object_safe_type(ctx: mut TranslatorContext, typ: str, source_name: str, line: usize, column:
    usize,) ->() {
    let value = canonical_type(typ)
    if !starts_with(value, "dyn ") {
        ret()
    }
    let trait_name = value.slice(4_usize, value.len() - 4_usize)
    let prefix = trait_name + "::"
    for function in ctx.functions {
        if starts_with(function.name, prefix) && base_type_name(function.ret_type) == trait_name {
            translation_error_at(source_name, line, column, "object-unsafe-trait", "trait '" + trait_name
                + "' is not object-safe because method '" + function.name.slice(prefix.len(), function.name.len()
                    - prefix.len(),) + "' returns Self",)
        }
    }
    ret()
}

fn self_context_type(ctx: mut TranslatorContext, typ: str) -> str {
    if ctx.self_type == "" {
        ret typ
    }
    if typ == "Self&" {
        ret ctx.self_type + "&"
    }
    if typ == "mut Self&" {
        ret "mut " + ctx.self_type + "&"
    }
    if typ == "Self<H>" {
        ret ctx.self_type + "<H>"
    }
    if typ == "Self<S>" {
        ret ctx.self_type + "<S>"
    }
    if typ == "mut Self" {
        ret "mut " + ctx.self_type
    }
    if typ == "Self" {
        ret ctx.self_type
    }
    // Preserve the parameter mode while specializing Self. Exact matching
    // used to turn `Self&` into plain `Self`, producing an opaque `%Self*`
    // receiver in LLVM instead of a borrow of the concrete impl target.
    ret canonical_type(replace_type_token(typ, "Self", ctx.self_type))
}

fn owner_context_type(owner: str, typ: str) -> str {
    ret canonical_type(replace_type_token(typ, "Self", canonical_type(owner)))
}

fn translate_impl(ctx: mut TranslatorContext, item: ImplStmt) -> EhirTextBuilder {
    validate_trait_impl(ctx, item)
    let mut builder = EhirTextBuilder::new()
    builder = append_ehir_documentation(builder, item.documentation, "///")
    let mut header = "impl"
    if item.generics.len() > 0_usize {
        header = header + "[" + translate_generic_params(item.generics) + "]"
    }
    match item.trait_name {
        Option[str]::Some(trait_name) => {
            let mut trait_ref = trait_name
            if item.trait_args.len() > 0_usize {
                let mut args = Vec[str]::new()
                for arg in item.trait_args {
                    args.push(canonical_type(arg))
                }
                trait_ref = trait_ref + "[" + join_strs(args, ", ") + "]"
            }
            header = header + " " + trait_ref + " for " + canonical_type(item.target)
        }
        Option[str]::None => {
            header = header + " " + canonical_type(item.target)
        }
    }
    builder = builder.line(header + " {")
    // Keep owned copies: impl targets come from borrowed AST fields and are
    // used across translation of every method in the block.
    let old_self_type = ctx.self_type + ""
    ctx.self_type = qualified_type_for_source(ctx, item.source_name, item.target)
    for method in item.methods {
        if function_is_active(method, ctx.target, ctx.features) {
            // Decorator definitions are compile-time templates. They are
            // registered while collecting the translation context and must
            // never become runtime methods (their Callable/Args parameters
            // intentionally have no EHIR representation).
            if function_is_decorator_definition(method) {
                continue
            }
            let ret_type = function_ret_type_for_owner(method, item.target)
            let mut emitted_method_name = method.name
            match item.trait_name {
                Some(trait_name) => {
                    if trait_name == "Pow" && method.name == "op" {
                        emitted_method_name = "pow"
                    }
                }
                None => {
                }
            }
            if method.decorators.len() > 0_usize {
                builder = builder.append(translate_decorated_method(ctx, method,
                        emitted_method_name, ret_type, item.target, item.generics,))
            } else {
                builder = builder.append(translate_function_named(ctx, method, emitted_method_name,
                        ret_type, item.generics,))
            }
        }
    }
    ctx.self_type = old_self_type
    builder = builder.line("}")
    ret builder
}

fn register_decorator_method_layer(ctx: mut TranslatorContext, item: FunctionItem, owner: str,
    impl_generics: Vec[GenericParam],) ->() {
    let logical_name = base_type_name(owner) + "::" + item.name
    let output_type = function_ret_type_for_owner(item, owner)
    let all_generics = combined_generic_params(impl_generics, item.generics)
    let callable_type = if item.is_async {
        async_future_type(logical_name, all_generics)
    } else {
        output_type
    }
    ctx_add_function(ctx, item.source_name, logical_name, callable_type,
        function_param_types_for_owner(item, owner), function_param_sending(item),
        function_param_frozen(item), function_receiver_is_readonly(item),
        generic_param_names(all_generics), false, item.is_async, output_type,
        item.returns_sending, item.returns_frozen,)
    if item.is_async {
        remember_async_future_output(ctx, item, callable_type, output_type)
    }
    ret()
}

/// Expands a decorated method inside its original impl. Every layer remains a
/// normal statically dispatched method: the raw body and intermediate layers
/// receive private compiler-generated names, while the outer layer keeps the
/// source-visible method name. No closure, callable object, vtable or heap
/// allocation survives lowering.
fn translate_decorated_method(ctx: mut TranslatorContext, item: FunctionItem,
    emitted_method_name: str, ret_type: str, owner: str, impl_generics: Vec[GenericParam],) ->
EhirTextBuilder {
    if item.is_extern {
        translation_error_at(item.source_name, item.line, item.column, "decorated-extern",
            "extern functions cannot be decorated",)
    }
    let raw_name = decorator_hidden_name(item, item.decorators.len())
    let raw_item = FunctionItem {
        Vec[str]::new(), Vec[DecoratorApplication]::new(), false, false,
        item.is_async, raw_name, Option[Documentation]::None, item.generics, item.params,
        item.ret_type, item.returns_sending, item.returns_frozen, item.body, item.source_name,
        item.line, item.column
    }
    register_decorator_method_layer(ctx, raw_item, owner, impl_generics)
    let mut builder = translate_function_named(ctx, raw_item, raw_name, ret_type, impl_generics)
    let owner_base = base_type_name(owner)
    let mut next_name = owner_base + "::" + raw_name
    let mut layer = item.decorators.len()
    while layer > 0_usize {
        layer -= 1_usize
        let application = match item.decorators.get(layer) {
            Some(value) => value
            None => DecoratorApplication {
                ExprNode {
                    Expr::Path(""), item.line, item.column, 0_usize,
                    item.source_name
                }
            }
        }
        let resolved = resolve_decorator(ctx, application)
        if resolved.item.is_async != item.is_async {
            translation_error_at(item.source_name, item.line, item.column,
                "decorator-async-mismatch", "decorator '" + resolved.item.name + "' and target '" +
                item.name + "' must both be sync or both be async",)
        }
        let method_offset = if resolved.owner == "" {
            0_usize
        } else {
            1_usize
        }
        let func_param = required_decorator_param(resolved.item, method_offset, item.source_name,
            item.line, item.column,)
        let args_param = required_decorator_param(resolved.item, method_offset + 1_usize,
            item.source_name, item.line, item.column,)
        let wrapper_params = decorator_wrapper_params(item)
        let wrapper_name = if layer == 0_usize {
            item.name
        } else {
            decorator_hidden_name(item, layer)
        }
        let wrapper_item = FunctionItem {
            item.attrs, Vec[DecoratorApplication]::new(),
            layer == 0_usize && item.is_public, false, item.is_async, wrapper_name,
            if layer == 0_usize {
                item.documentation
            } else {
                Option[Documentation]::None
            }
            ,
            item.generics, wrapper_params, item.ret_type, item.returns_sending, item.returns_frozen,
            Option[ParsedBlock]::Some(decorator_wrapper_body(resolved, item)), item.source_name,
            item.line, item.column
        }
        if layer > 0_usize {
            register_decorator_method_layer(ctx, wrapper_item, owner, impl_generics)
        }
        ctx.decorator_callable_name = func_param.name
        ctx.decorator_args_name = args_param.name
        ctx.decorator_target_name = next_name
        ctx.decorator_target_source_name = item.source_name
        ctx.decorator_target_params = decorator_wrapper_param_names(wrapper_item.params)
        ctx.decorator_target_generics = generic_param_names(combined_generic_params(impl_generics,
                item.generics,))
        builder = builder.empty_line().append(translate_function_named(ctx, wrapper_item,
                if layer == 0_usize {
                    emitted_method_name
                } else {
                    wrapper_name
                }
                , ret_type,
                impl_generics,))
        ctx.decorator_callable_name = ""
        ctx.decorator_args_name = ""
        ctx.decorator_target_name = ""
        ctx.decorator_target_source_name = ""
        ctx.decorator_target_params = Vec[str]::new()
        ctx.decorator_target_generics = Vec[str]::new()
        next_name = owner_base + "::" + wrapper_name
    }
    ret builder
}

fn validate_trait_impl(ctx: mut TranslatorContext, item: ImplStmt) ->() {
    match item.trait_name {
        Option[str]::None => {
            ret()
        }
        Option[str]::Some(trait_name) => {
            let trait_contract = lookup_trait(ctx, trait_name)
            match trait_contract {
                Option[TraitType]::None => {
                    translation_error_at(item.source_name, item.line, item.column, "unknown-trait", "unknown trait '"
                        + trait_name + "'",)
                }
                Option[TraitType]::Some(contract) => {
                    if contract.generics.len() != item.trait_args.len() {
                        translation_error_at(item.source_name, item.line, item.column, "trait-generic-arity-mismatch",
                            "trait '" + trait_name + "' expects " + Debug::fmt(contract.generics.len())
                            +
                            " generic argument(s), got " + Debug::fmt(item.trait_args.len()),)
                    }
                    validate_trait_argument_bounds(ctx, contract, item)
                }
            }
            let prefix = trait_name + "::"
            for method in item.methods {
                let contract = trait_method_contract(ctx, trait_name, method.name)
                match contract {
                    Option[FunctionType]::None => {
                        translation_error_at(method.source_name, method.line, method.column, "unknown-trait-method",
                            "method '" + method.name + "' is not declared by trait '" + trait_name +
                            "'",)
                    }
                    Option[FunctionType]::Some(expected) => {
                        let actual_params = function_param_types_for_owner(method, item.target)
                        if expected.params.len() != actual_params.len() {
                            translation_error_at(method.source_name, method.line, method.column, "trait-method-signature-mismatch",
                                "method '" + method.name + "' has " + Debug::fmt(actual_params.len())
                                + " parameter(s), but trait '"
                                + trait_name + "' requires " + Debug::fmt(expected.params.len()),)
                        }
                        let contract_owner = function_owner_name(expected.name)
                        let mut trait_generic_count = 0_usize
                        match lookup_trait(ctx, contract_owner) {
                            Some(owner_trait) => {
                                trait_generic_count = owner_trait.generics.len()
                            }
                            None => {
                            }
                        }
                        let expected_method_generics = if expected.generics.len() >= trait_generic_count
                        {
                            expected.generics.len() - trait_generic_count
                        } else {
                            0_usize
                        }
                        if expected_method_generics != method.generics.len() {
                            translation_error_at(method.source_name, method.line, method.column, "trait-method-generic-arity-mismatch",
                                "method '" + method.name + "' declares " + Debug::fmt(method.generics.len())
                                + " generic parameter(s), but trait '" + contract_owner + "' requires "
                                +
                                Debug::fmt(expected_method_generics),)
                        }
                        match trait_method_declaration(ctx, trait_name, method.name) {
                            Some(declaration) => {
                                validate_trait_method_bounds(ctx, declaration, method)
                            }
                            None => {
                            }
                        }
                        let mut specialization_args = trait_args_for_owner(ctx, trait_name, item.trait_args,
                            contract_owner,)
                        for generic_name in generic_param_names(method.generics) {
                            specialization_args.push(generic_name)
                        }
                        validate_trait_method_types(expected, actual_params, function_ret_type_for_owner(method,
                                item.target,), item.target, specialization_args, method)
                    }
                }
            }
            ensure_trait_methods_implemented(ctx, item, trait_name, trait_name)
        }
    }
    ret()
}

fn validate_trait_argument_bounds(ctx: mut TranslatorContext, contract: TraitType, item: ImplStmt) ->()
{
    let mut index = 0_usize
    while index < contract.generics.len() && index < item.trait_args.len() {
        match contract.generics.get(index) {
            Some(parameter) => {
                match item.trait_args.get(index) {
                    Some(argument) => {
                        for bound in parameter.bounds {
                            if !type_satisfies_trait_bound(ctx, item.generics, argument, bound.path)
                            {
                                translation_error_at(item.source_name, item.line, item.column, "trait-bound-not-satisfied",
                                    "type '" + canonical_type(argument) + "' does not satisfy bound '"
                                    +
                                    bound.path + "' for generic parameter '" + parameter.name + "' of trait '"
                                    + contract.name + "'",)
                            }
                        }
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret()
}

fn type_satisfies_trait_bound(ctx: mut TranslatorContext, impl_generics: Vec[GenericParam], typ: str,
    required_trait: str,) -> bool {
    let canonical = canonical_type(typ)
    for generic in impl_generics {
        if generic.name == canonical {
            for bound in generic.bounds {
                if trait_inherits_from(ctx, base_type_name(bound.path), base_type_name(required_trait))
                {
                    ret true
                }
            }
            ret false
        }
    }
    for implementation in ctx.trait_impls {
        if trait_impl_target_matches(ctx, implementation, canonical) {
            if trait_inherits_from(ctx, implementation.trait_name, base_type_name(required_trait)) {
                ret true
            }
        }
    }
    ret false
}

fn trait_impl_target_matches(ctx: mut TranslatorContext, implementation: TraitImplType, concrete: str)
-> bool {
    let template = canonical_type(implementation.target)
    if template == concrete {
        ret true
    }
    if base_type_name(template) != base_type_name(concrete) {
        ret false
    }
    let template_args = generic_args_from_path(template)
    let concrete_args = generic_args_from_path(concrete)
    if template_args.len() != concrete_args.len() {
        ret false
    }
    let mut index = 0_usize
    while index < template_args.len() {
        match template_args.get(index) {
            Some(template_arg) => {
                match concrete_args.get(index) {
                    Some(concrete_arg) => {
                        let mut matched_generic = false
                        for generic in implementation.generics {
                            if generic.name == template_arg {
                                matched_generic = true
                                for bound in generic.bounds {
                                    if !type_satisfies_trait_bound(ctx, Vec[GenericParam]::new(), concrete_arg,
                                        bound.path,) {
                                        ret false
                                    }
                                }
                            }
                        }
                        if !matched_generic && canonical_type(template_arg) != canonical_type(concrete_arg)
                        {
                            ret false
                        }
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret false
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn trait_inherits_from(ctx: mut TranslatorContext, candidate: str, required: str) -> bool {
    if candidate == required {
        ret true
    }
    match lookup_trait(ctx, candidate) {
        Some(contract) => {
            for base in contract.bases {
                if trait_inherits_from(ctx, base_type_name(base), required) {
                    ret true
                }
            }
        }
        None => {
        }
    }
    ret false
}

fn lookup_trait(ctx: mut TranslatorContext, name: str) -> Option[TraitType] {
    for trait_item in ctx.traits {
        if trait_item.name == name {
            ret Option[TraitType]::Some(trait_item)
        }
    }
    ret Option[TraitType]::None
}

fn function_owner_name(name: str) -> str {
    let scope = last_scope_index(name)
    if scope < name.len() {
        ret name.slice(0_usize, scope)
    }
    ret ""
}

fn trait_args_for_owner(ctx: mut TranslatorContext, root_trait: str, root_args: Vec[str], owner: str)
-> Vec[str] {
    if root_trait == owner {
        ret root_args
    }
    match lookup_trait(ctx, root_trait) {
        Some(contract) => {
            let root_params = generic_param_names(contract.generics)
            for base in contract.bases {
                let base_name = base_type_name(base)
                let mut base_args = Vec[str]::new()
                for arg in generic_args_from_path(base) {
                    base_args.push(specialize_named_type(arg, root_params, root_args))
                }
                if base_name == owner {
                    ret base_args
                }
                let nested = trait_args_for_owner(ctx, base_name, base_args, owner)
                if nested.len() > 0_usize {
                    ret nested
                }
            }
        }
        None => {
        }
    }
    ret Vec[str]::new()
}

fn trait_method_contract(ctx: mut TranslatorContext, trait_name: str, method_name: str) -> Option[FunctionType]
{
    let name = trait_name + "::" + method_name
    match lookup_trait(ctx, trait_name) {
        Some(contract) => {
            // An inherent method on a same-named struct is not part of this
            // trait. Resolve the synthesized callable through the trait's
            // declaration source instead of the global short-name bucket.
            for function in ctx.functions {
                if function.name == name && function.source_name == contract.source_name {
                    ret Option[FunctionType]::Some(function)
                }
            }
            for base in contract.bases {
                match trait_method_contract(ctx, base_type_name(base), method_name) {
                    Some(found) => {
                        ret Option[FunctionType]::Some(found)
                    }
                    None => {
                    }
                }
            }
        }
        None => {
        }
    }
    ret Option[FunctionType]::None
}

fn trait_method_declaration(ctx: mut TranslatorContext, trait_name: str, method_name: str) -> Option[FunctionItem]
{
    match lookup_trait(ctx, trait_name) {
        Some(contract) => {
            for method in contract.methods {
                if method.name == method_name {
                    ret Option[FunctionItem]::Some(method)
                }
            }
            for base in contract.bases {
                match trait_method_declaration(ctx, base_type_name(base), method_name) {
                    Some(found) => {
                        ret Option[FunctionItem]::Some(found)
                    }
                    None => {
                    }
                }
            }
        }
        None => {
        }
    }
    ret Option[FunctionItem]::None
}

fn validate_trait_method_bounds(ctx: mut TranslatorContext, expected: FunctionItem, actual: FunctionItem)
->() {
    let mut index = 0_usize
    while index < actual.generics.len() && index < expected.generics.len() {
        match actual.generics.get(index) {
            Some(actual_generic) => {
                match expected.generics.get(index) {
                    Some(expected_generic) => {
                        for actual_bound in actual_generic.bounds {
                            let mut implied = false
                            for expected_bound in expected_generic.bounds {
                                if trait_inherits_from(ctx, base_type_name(expected_bound.path), base_type_name(actual_bound.path))
                                {
                                    implied = true
                                }
                            }
                            if !implied {
                                translation_error_at(actual.source_name, actual.line, actual.column,
                                    "trait-method-bound-mismatch", "generic parameter '" + actual_generic.name
                                    + "' of method '" + actual.name + "' adds bound '" + actual_bound.path
                                    + "' not required by the trait",)
                            }
                        }
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret()
}

fn ensure_trait_methods_implemented(ctx: mut TranslatorContext, item: ImplStmt, trait_name: str, root_trait_name:
    str,) ->() {
    match lookup_trait(ctx, trait_name) {
        Some(contract) => {
            for expected in contract.methods {
                if !impl_declares_method(item, expected.name) {
                    translation_error_at(item.source_name, item.line, item.column, "missing-trait-method",
                        "implementation of trait '" + root_trait_name + "' for '" + item.target +
                        "' is missing method '" + expected.name + "'",)
                }
            }
            for base in contract.bases {
                ensure_trait_methods_implemented(ctx, item, base_type_name(base), root_trait_name)
            }
        }
        None => {
        }
    }
    ret()
}

fn impl_declares_method(item: ImplStmt, name: str) -> bool {
    for method in item.methods {
        if method.name == name {
            ret true
        }
    }
    ret false
}

fn validate_trait_method_types(expected: FunctionType, actual_params: Vec[str], actual_ret: str, target:
    str, specialization_args: Vec[str], method: FunctionItem,) ->() {
    if expected.is_async != method.is_async {
        let expected_kind = if expected.is_async {
            "async"
        } else {
            "synchronous"
        }
        let actual_kind = if method.is_async {
            "async"
        } else {
            "synchronous"
        }
        translation_error_at(method.source_name, method.line, method.column, "trait-method-async-mismatch",
            "method '" + method.name + "' is " + actual_kind + ", but the trait requires " + expected_kind,)
    }
    if expected.readonly_self && !function_receiver_is_readonly(method) {
        translation_error_at(method.source_name, method.line, method.column, "trait-method-readonly-mismatch",
            "method '" + method.name + "' must use an immutable self receiver because the trait promises a read-only receiver",)
    }
    let actual_sending = function_param_sending(method)
    let actual_frozen = function_param_frozen(method)
    let mut capability_index = 0_usize
    while capability_index < expected.params.len() {
        let expected_sending = expected.sending_params.get(capability_index).unwrap_or(false)
        let expected_frozen = expected.frozen_params.get(capability_index).unwrap_or(false)
        let method_sending = actual_sending.get(capability_index).unwrap_or(false)
        let method_frozen = actual_frozen.get(capability_index).unwrap_or(false)
        if expected_sending != method_sending || expected_frozen != method_frozen {
            let expected_capability = if expected_sending {
                "sending"
            } elif expected_frozen {
                "frozen"
            } else {
                "ordinary"
            }
            let actual_capability = if method_sending {
                "sending"
            } elif method_frozen {
                "frozen"
            } else {
                "ordinary"
            }
            translation_error_at(method.source_name, method.line, method.column, "trait-method-capability-mismatch",
                "parameter " + Debug::fmt(capability_index + 1_usize) + " of method '" + method.name +
                "' is " + actual_capability + ", but the trait requires " + expected_capability,)
        }
        capability_index += 1_usize
    }
    if expected.returns_sending != method.returns_sending ||
    expected.returns_frozen != method.returns_frozen {
        let expected_capability = if expected.returns_sending {
            "sending"
        } elif expected.returns_frozen {
            "frozen"
        } else {
            "ordinary"
        }
        let actual_capability = if method.returns_sending {
            "sending"
        } elif method.returns_frozen {
            "frozen"
        } else {
            "ordinary"
        }
        translation_error_at(method.source_name, method.line, method.column, "trait-method-return-capability-mismatch",
            "method '" + method.name + "' returns a " + actual_capability +
            " value, but the trait requires a " + expected_capability + " return",)
    }
    let contract_owner = function_owner_name(expected.name)
    let mut index = 0_usize
    while index < expected.params.len() {
        match expected.params.get(index) {
            Some(raw_expected) => {
                match actual_params.get(index) {
                    Some(actual) => {
                        let specialized = replace_type_token(specialize_named_type(raw_expected, expected.generics,
                                specialization_args,), contract_owner, canonical_type(target))
                        if canonical_type(specialized) != canonical_type(actual) {
                            translation_error_at(method.source_name, method.line, method.column, "trait-method-signature-mismatch",
                                "parameter " + Debug::fmt(index + 1_usize) + " of method '" + method.name
                                + "' has type '" + canonical_type(actual) + "', expected '" + canonical_type(specialized)
                                + "'",)
                        }
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    let expected_ret = replace_type_token(specialize_named_type(expected.output_type, expected.generics,
            specialization_args,), contract_owner, canonical_type(target))
    if canonical_type(expected_ret) != canonical_type(actual_ret) {
        translation_error_at(method.source_name, method.line, method.column, "trait-method-signature-mismatch",
            "method '" + method.name + "' returns '" + canonical_type(actual_ret) + "', expected '" +
            canonical_type(expected_ret)
            + "'",)
    }
    ret()
}

fn translate_statements(
    ctx: mut TranslatorContext,
    statements: Vec[Statement],
    ret_type: str,
    prefix: str,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let mut saw_ret = false
    let mut i = 0_usize
    for stmt in statements {
        match stmt {
            Statement::Ret(expr) => {
                builder = builder.append(translate_owned_ret_expr(ctx, expr, ret_type, prefix + "_ret_"
                        + Debug::fmt(i),))
                saw_ret = true
                break
            }
            Statement::If(if_stmt) => {
                let always_returns = if_stmt_always_returns(if_stmt)
                builder = builder.append(translate_if_stmt(ctx, if_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    saw_ret = true
                    break
                }
            }
            Statement::While(while_stmt) => {
                builder = builder.append(translate_while_stmt(ctx, while_stmt, ret_type, prefix, i))
            }
            Statement::Loop(loop_stmt) => {
                builder = builder.append(translate_loop_stmt(ctx, loop_stmt, ret_type, prefix, i))
            }
            Statement::DoWhile(do_stmt) => {
                builder = builder.append(translate_do_while_stmt(ctx, do_stmt, ret_type, prefix, i))
            }
            Statement::For(for_stmt) => {
                builder = builder.append(translate_for_stmt(ctx, for_stmt, ret_type, prefix, i))
            }
            Statement::With(with_stmt) => {
                builder = builder.append(translate_with_stmt(ctx, with_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
            }
            Statement::Let(let_stmt) => {
                builder = builder.append(translate_let_stmt(ctx, let_stmt, prefix, i))
            }
            Statement::Assignment(assign_stmt) => {
                builder = builder.append(translate_assignment_stmt(ctx, assign_stmt, prefix, i))
            }
            Statement::Expr(expr_stmt) => {
                builder = builder.append(translate_expr_stmt(ctx, expr_stmt, prefix, i))
            }
            Statement::Ehir(ehir_stmt) => {
                builder = builder.append(translate_ehir_stmt(ctx, ehir_stmt))
            }
            Statement::Unsafe(block) => {
                let always_returns = block_always_returns(block)
                builder = builder.append(translate_unsafe_stmt(ctx, block, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    saw_ret = true
                    break
                }
            }
            Statement::Match(match_stmt) => {
                let always_returns = match_stmt_always_returns(match_stmt)
                builder = builder.append(translate_match_stmt(ctx, match_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    saw_ret = true
                    break
                }
            }
            Statement::Break(label) => {
                builder = builder.append(translate_with_cleanups(ctx, prefix + "_break_cleanup_" + Debug::fmt(i)))
                builder = append_owned_drops_from(ctx, builder, "", prefix + "_break_scope_" + Debug::fmt(i),
                    loop_cleanup_start(ctx, label),)
                match resolve_loop_target(ctx, label, break_label, false) {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {
                    }
                }
            }
            Statement::Continue(label) => {
                builder = builder.append(translate_with_cleanups(ctx, prefix + "_continue_cleanup_" +
                        Debug::fmt(i),))
                builder = append_owned_drops_from(ctx, builder, "", prefix + "_continue_scope_" + Debug::fmt(i),
                    loop_cleanup_start(ctx, label),)
                match resolve_loop_target(ctx, label, continue_label, true) {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1_usize
    }
    if !saw_ret {
        builder = append_owned_drops(ctx, builder, "", prefix + "_default")
        builder = builder.append(translate_default_ret(ret_type))
    }
    ret builder
}

fn translate_statements_no_default(
    ctx: mut TranslatorContext,
    statements: Vec[Statement],
    ret_type: str,
    prefix: str,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let mut i = 0_usize
    for stmt in statements {
        match stmt {
            Statement::Ret(expr) => {
                builder = builder.append(translate_owned_ret_expr(ctx, expr, ret_type, prefix + "_ret_"
                        + Debug::fmt(i),))
                break
            }
            Statement::If(if_stmt) => {
                let always_returns = if_stmt_always_returns(if_stmt)
                builder = builder.append(translate_if_stmt(ctx, if_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    break
                }
            }
            Statement::While(while_stmt) => {
                builder = builder.append(translate_while_stmt(ctx, while_stmt, ret_type, prefix, i))
            }
            Statement::Loop(loop_stmt) => {
                builder = builder.append(translate_loop_stmt(ctx, loop_stmt, ret_type, prefix, i))
            }
            Statement::DoWhile(do_stmt) => {
                builder = builder.append(translate_do_while_stmt(ctx, do_stmt, ret_type, prefix, i))
            }
            Statement::For(for_stmt) => {
                builder = builder.append(translate_for_stmt(ctx, for_stmt, ret_type, prefix, i))
            }
            Statement::With(with_stmt) => {
                builder = builder.append(translate_with_stmt(ctx, with_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
            }
            Statement::Let(let_stmt) => {
                builder = builder.append(translate_let_stmt(ctx, let_stmt, prefix, i))
            }
            Statement::Assignment(assign_stmt) => {
                builder = builder.append(translate_assignment_stmt(ctx, assign_stmt, prefix, i))
            }
            Statement::Expr(expr_stmt) => {
                builder = builder.append(translate_expr_stmt(ctx, expr_stmt, prefix, i))
            }
            Statement::Ehir(ehir_stmt) => {
                builder = builder.append(translate_ehir_stmt(ctx, ehir_stmt))
            }
            Statement::Unsafe(block) => {
                let always_returns = block_always_returns(block)
                builder = builder.append(translate_unsafe_stmt(ctx, block, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    break
                }
            }
            Statement::Match(match_stmt) => {
                let always_returns = match_stmt_always_returns(match_stmt)
                builder = builder.append(translate_match_stmt(ctx, match_stmt, ret_type, prefix, i, break_label,
                        continue_label,))
                if always_returns {
                    break
                }
            }
            Statement::Break(label) => {
                builder = builder.append(translate_with_cleanups(ctx, prefix + "_break_cleanup_" + Debug::fmt(i)))
                builder = append_owned_drops_from(ctx, builder, "", prefix + "_break_scope_" + Debug::fmt(i),
                    loop_cleanup_start(ctx, label),)
                match resolve_loop_target(ctx, label, break_label, false) {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {
                    }
                }
            }
            Statement::Continue(label) => {
                builder = builder.append(translate_with_cleanups(ctx, prefix + "_continue_cleanup_" +
                        Debug::fmt(i),))
                builder = append_owned_drops_from(ctx, builder, "", prefix + "_continue_scope_" + Debug::fmt(i),
                    loop_cleanup_start(ctx, label),)
                match resolve_loop_target(ctx, label, continue_label, true) {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1_usize
    }
    ret builder
}

fn translate_let_stmt(ctx: mut TranslatorContext, let_stmt: LetStmt, prefix: str, idx: usize) -> EhirTextBuilder
{
    let source_path = expr_path_or_empty(let_stmt.expr)
    let source_region = if source_path == "" {
        0_usize
    } else {
        ctx_lookup_var_region(ctx, source_path)
    }
    // Mutable bindings of owned/reference values preserve identity.  Pointing
    // the new binding at the existing slot is also what makes mutations
    // visible through either name; copying the aggregate here silently broke
    // Encore's reference assignment semantics.
    if let_stmt.is_mut {
        if source_path != "" {
            match ctx_lookup_var(ctx, source_path) {
                Option[str]::Some(source_type) => {
                    if starts_with(source_type, "mut ") && ctx_type_needs_ownership(ctx, value_type_name(source_type))
                    {
                        ctx_add_var_emitted(ctx, let_stmt.name, ctx_lookup_value_name(ctx, source_path),
                            source_type,)
                        ctx_set_var_region(ctx, let_stmt.name, source_region)
                        ret EhirTextBuilder::new()
                    }
                    if strict_thread_capabilities() && !starts_with(source_type, "mut ") &&
                    thread_type_is_transferable_region(ctx, source_type) {
                        translation_error_at(let_stmt.expr.source_name, let_stmt.expr.line,
                            let_stmt.expr.column, "mutable-alias-from-readonly",
                            "cannot create mutable binding '" + let_stmt.name +
                            "' from immutable region '" + source_path + "'",)
                    }
                }
                Option[str]::None => {
                }
            }
        }
    }
    let borrowed_copy = expr_is_borrowed_copy(let_stmt.expr) || expr_returns_borrowed(ctx, let_stmt.expr)
    match let_stmt.typ {
        Option[str]::Some(explicit_type) => {
            ctx.expression_hint = qualified_type_for_source(ctx, let_stmt.expr.source_name, explicit_type)
        }
        Option[str]::None => {
            ctx.expression_hint = ""
        }
    }
    let lowered = if ctx.expression_hint != "" {
        lower_expr_with_hint(ctx, let_stmt.expr, ctx.expression_hint, prefix + "_let", idx)
    } else {
        lower_expr(ctx, let_stmt.expr, prefix + "_let", idx)
    }
    let initializer_is_frozen = ctx_value_is_frozen(ctx, lowered.value) || ctx_path_is_frozen(ctx,
        source_path,)
    ctx.expression_hint = ""
    match let_stmt.typ {
        Option[str]::Some(explicit_type) => {
            let resolved_explicit_type = qualified_type_for_source(ctx, let_stmt.expr.source_name, explicit_type)
            let numeric_literal_coercion = expr_is_numeric_literal(let_stmt.expr) && is_numeric_type(value_type_name(resolved_explicit_type))
            && is_numeric_type(value_type_name(lowered.typ))
            if !numeric_literal_coercion && !function_type_matches(resolved_explicit_type, lowered.typ, Vec[str]::new())
            {
                translation_error_at(let_stmt.expr.source_name, let_stmt.expr.line, let_stmt.expr.column,
                    "type-mismatch", "cannot initialize '" + let_stmt.name + "' of type '" + canonical_type(value_type_name(resolved_explicit_type))
                    + "' with value of type '" + canonical_type(value_type_name(lowered.typ)) + "'",)
            }
        }
        Option[str]::None => {
        }
    }
    let mut builder = lowered.code
    let mut typ = lowered.typ
    match let_stmt.typ {
        Option[str]::Some(explicit_type) => {
            typ = qualified_type_for_source(ctx, let_stmt.expr.source_name, explicit_type)
        }
        Option[str]::None => {
            typ = canonical_type(typ)
        }
    }
    let explicit_mut = starts_with(typ, "mut ")
    if explicit_mut {
        typ = value_type_name(typ)
    }
    if base_type_name(typ) == "JoinHandle" && source_path != "" {
        move_var_out_of_context(ctx, source_path)
    } elif borrowed_copy && !(let_stmt.is_mut || explicit_mut) && ctx_type_needs_ownership(ctx, typ)
    {
        builder = builder.instr("retain " + lowered.value + ": " + typ)
    }
    let emitted_name = prefix + "_letvar_" + let_stmt.name + "_" + Debug::fmt(idx)
    if let_stmt.is_mut || explicit_mut {
        if ends_with(typ, "<H>") || ends_with(typ, "<S>") {
            let slot_type = "mut_handle " + typ
            let bits = prefix + "_let_handle_bits_" + Debug::fmt(idx)
            ctx_add_var_emitted(ctx, let_stmt.name, emitted_name, slot_type)
            if source_region != 0_usize {
                ctx_set_var_region(ctx, let_stmt.name, source_region)
            }
            ctx_add_owned_var(ctx, let_stmt.name, emitted_name, slot_type)
            if initializer_is_frozen {
                ctx_mark_region_frozen(ctx, ctx_lookup_var_region(ctx, let_stmt.name))
                ctx_mark_value_frozen(ctx, emitted_name)
            }
            builder = builder.instr(emitted_name + ": usize* = salloc usize")
            builder = builder.instr(bits + ": usize = pcast " + lowered.value +
                ": " + typ + ", usize",)
            // Moving the produced handle into an untyped slot transfers its
            // one owner; unlike an aggregate EHIR store this scalar store does
            // not retain or drop the pointee.
            builder = builder.instr("store " + bits + ": usize, " + emitted_name)
            ret builder
        }
        ctx_add_var_emitted(ctx, let_stmt.name, emitted_name, "mut " + typ)
        if source_region != 0_usize {
            ctx_set_var_region(ctx, let_stmt.name, source_region)
        }
        ctx_add_owned_var(ctx, let_stmt.name, emitted_name, "mut " + typ)
        if initializer_is_frozen {
            ctx_mark_region_frozen(ctx, ctx_lookup_var_region(ctx, let_stmt.name))
            ctx_mark_value_frozen(ctx, emitted_name)
        }
        builder = builder.instr(emitted_name + ": " + typ + "* = salloc " + typ)
        builder = builder.instr("store " + lowered.value + ", " + emitted_name)
        // Storing into a mutable slot retains its value. A freshly produced
        // owned RHS is therefore transferred by releasing the temporary
        // owner after the store; borrowed RHS values keep their original
        // owner and need no release here.
        if !borrowed_copy && ctx_type_needs_ownership(ctx, typ) {
            builder = builder.instr("drop " + lowered.value + ": " + typ)
        }
        ret builder
    }
    ctx_add_var_emitted(ctx, let_stmt.name, emitted_name, typ)
    if source_region != 0_usize {
        ctx_set_var_region(ctx, let_stmt.name, source_region)
    }
    ctx_add_owned_var(ctx, let_stmt.name, emitted_name, typ)
    if initializer_is_frozen {
        ctx_mark_region_frozen(ctx, ctx_lookup_var_region(ctx, let_stmt.name))
        ctx_mark_value_frozen(ctx, emitted_name)
    }
    builder = builder.instr(emitted_name + ": " + typ + " = " + lowered.value)
    ret builder
}

fn expr_is_numeric_literal(expr: ExprNode) -> bool {
    match expr.value {
        Expr::Integer(_) => {
            ret true
        }
        Expr::Float(_) => {
            ret true
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_is_numeric_literal(inner)
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn expr_h_is_numeric_literal(expr: ExprNode < H >) -> bool {
    match expr.value {
        Expr::Integer(_) => {
            ret true
        }
        Expr::Float(_) => {
            ret true
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_is_numeric_literal(inner)
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn expr_is_borrowed_copy(expr: ExprNode) -> bool {
    match expr.value {
        Expr::Path(_) => {
            ret true
        }
        Expr::Field(_) => {
            ret true
        }
        Expr::Index(_) => {
            ret true
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_is_borrowed_copy(tail)
                }
                None => {
                    ret false
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_is_borrowed_copy(inner)
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn expr_h_is_borrowed_copy(expr: ExprNode < H >) -> bool {
    match expr.value {
        Expr::Path(_) => {
            ret true
        }
        Expr::Field(_) => {
            ret true
        }
        Expr::Index(_) => {
            ret true
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_is_borrowed_copy(tail)
                }
                None => {
                    ret false
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_is_borrowed_copy(inner)
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn expr_returns_borrowed(ctx: mut TranslatorContext, expr: ExprNode) -> bool {
    match expr.value {
        Expr::Call(call_expr) => {
            ret ctx_function_returns_borrowed(ctx, expr_h_path_or_empty(call_expr.callee))
        }
        Expr::MethodCall(call_expr) => {
            ret method_call_returns_borrowed(ctx, call_expr)
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_returns_borrowed(ctx, tail)
                }
                None => {
                    ret false
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_returns_borrowed(ctx, inner)
        }
        Expr::Unsafe(block) => {
            if block.statements.len() == 0_usize {
                ret false
            }
            match block.statements.get(block.statements.len() - 1_usize) {
                Option[Statement]::Some(tail_stmt) => {
                    match tail_stmt {
                        Statement::Expr(tail) => {
                            ret expr_returns_borrowed(ctx, tail)
                        }
                        Statement::Ret(tail) => {
                            ret expr_returns_borrowed(ctx, tail)
                        }
                        _ => {
                        }
                    }
                }
                Option[Statement]::None => {
                }
            }
        }
        _ => {
        }
    }
    ret false
}

fn expr_h_returns_borrowed(ctx: mut TranslatorContext, expr: ExprNode < H >) -> bool {
    match expr.value {
        Expr::Call(call_expr) => {
            ret ctx_function_returns_borrowed(ctx, expr_h_path_or_empty(call_expr.callee))
        }
        Expr::MethodCall(call_expr) => {
            ret method_call_returns_borrowed(ctx, call_expr)
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_returns_borrowed(ctx, tail)
                }
                None => {
                    ret false
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_returns_borrowed(ctx, inner)
        }
        _ => {
        }
    }
    ret false
}

fn method_call_returns_borrowed(ctx: mut TranslatorContext, call: MethodCallExpr) -> bool {
    let receiver_type = value_type_name(translator_dispatch_type_h(ctx, call.receiver))
    let mut owner = method_owner_name(receiver_type)
    if starts_with(receiver_type, "dyn ") {
        owner = receiver_type.slice(4_usize, receiver_type.len() - 4_usize)
    }
    if owner == "Self" && ctx.self_type != "" {
        owner = method_owner_name(ctx.self_type)
    }
    if owner == "" {
        ret false
    }
    ret ctx_function_returns_borrowed(ctx, owner + "::" + call.method)
}

// A call that receives the assignment target through a `mut` parameter may
// return a view of the same live graph. Treat that result as borrowed at the
// assignment boundary so the temporary is not released as an independent
// owner after replacing the slot (`state = update_in_place(state)`).
fn expr_mutably_aliases_path(ctx: mut TranslatorContext, expr: ExprNode,
    target: str,) -> bool {
    match expr.value {
        Expr::Call(call) => {
            let mut callee = expr_h_path_or_empty(call.callee)
            if starts_with(callee, "Self::") && ctx.self_type != "" {
                callee = method_owner_name(ctx.self_type) + "::" +
                callee.slice(6_usize, callee.len() - 6_usize)
            }
            let generic_args = if call.generics.len() > 0_usize {
                call.generics
            } else {
                generic_args_from_path(callee)
            }
            let mut index = 0_usize
            for arg in call.args {
                if expr_path_or_empty(arg) == target {
                    match ctx_lookup_function_param_for_call(ctx,
                        expr.source_name, base_type_name(callee), index,
                        generic_args, call.args,) {
                        Some(expected) => {
                            if starts_with(expected, "mut ") {
                                ret true
                            }
                        }
                        None => {
                        }
                    }
                }
                index += 1_usize
            }
        }
        Expr::MethodCall(call) => {
            let receiver_path = expr_h_path_or_empty(call.receiver)
            let receiver_type = match ctx_lookup_var(ctx, receiver_path) {
                Some(found) => value_type_name(found)
                None => ""
            }
            let owner = method_owner_name(receiver_type)
            let name = owner + "::" + call.method
            let mut generics = generic_args_from_path(receiver_type)
            for generic in call.generics {
                generics.push(canonical_type(generic))
            }
            if receiver_path == target {
                match ctx_lookup_function_param(ctx, expr.source_name, name,
                    0_usize, generics,) {
                    Some(expected) => {
                        if starts_with(expected, "mut ") {
                            ret true
                        }
                    }
                    None => {
                    }
                }
            }
            let mut index = 0_usize
            for arg in call.args {
                if expr_path_or_empty(arg) == target {
                    match ctx_lookup_function_param(ctx, expr.source_name, name,
                        index + 1_usize, generics,) {
                        Some(expected) => {
                            if starts_with(expected, "mut ") {
                                ret true
                            }
                        }
                        None => {
                        }
                    }
                }
                index += 1_usize
            }
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_mutably_aliases_path(ctx, inner, target)
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_mutably_aliases_path(ctx, tail, target)
                }
                None => {
                }
            }
        }
        _ => {
        }
    }
    ret false
}

fn expr_h_mutably_aliases_path(ctx: mut TranslatorContext,
    expr: ExprNode < H >, target: str,) -> bool {
    match expr.value {
        Expr::Parenthesized(inner) => {
            ret expr_h_mutably_aliases_path(ctx, inner, target)
        }
        Expr::Block(block) => {
            match block.tail {
                Some(tail) => {
                    ret expr_h_mutably_aliases_path(ctx, tail, target)
                }
                None => {
                }
            }
        }
        Expr::Call(call) => {
            let mut callee = expr_h_path_or_empty(call.callee)
            if starts_with(callee, "Self::") && ctx.self_type != "" {
                callee = method_owner_name(ctx.self_type) + "::" +
                callee.slice(6_usize, callee.len() - 6_usize)
            }
            let generic_args = if call.generics.len() > 0_usize {
                call.generics
            } else {
                generic_args_from_path(callee)
            }
            let mut index = 0_usize
            for arg in call.args {
                if expr_path_or_empty(arg) == target {
                    match ctx_lookup_function_param_for_call(ctx,
                        expr.source_name, base_type_name(callee), index,
                        generic_args, call.args,) {
                        Some(expected) => {
                            if starts_with(expected, "mut ") {
                                ret true
                            }
                        }
                        None => {
                        }
                    }
                }
                index += 1_usize
            }
        }
        Expr::MethodCall(call) => {
            let receiver_path = expr_h_path_or_empty(call.receiver)
            let receiver_type = match ctx_lookup_var(ctx, receiver_path) {
                Some(found) => value_type_name(found)
                None => ""
            }
            let owner = method_owner_name(receiver_type)
            let name = owner + "::" + call.method
            let mut generics = generic_args_from_path(receiver_type)
            for generic in call.generics {
                generics.push(canonical_type(generic))
            }
            if receiver_path == target {
                match ctx_lookup_function_param(ctx, expr.source_name, name,
                    0_usize, generics,) {
                    Some(expected) => {
                        if starts_with(expected, "mut ") {
                            ret true
                        }
                    }
                    None => {
                    }
                }
            }
            let mut index = 0_usize
            for arg in call.args {
                if expr_path_or_empty(arg) == target {
                    match ctx_lookup_function_param(ctx, expr.source_name, name,
                        index + 1_usize, generics,) {
                        Some(expected) => {
                            if starts_with(expected, "mut ") {
                                ret true
                            }
                        }
                        None => {
                        }
                    }
                }
                index += 1_usize
            }
        }
        _ => {
        }
    }
    ret false
}

fn translate_assignment_stmt(ctx: mut TranslatorContext, assign_stmt: AssignmentStmt, prefix: str, idx:
    usize,) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let target = expr_path_or_empty(assign_stmt.target)
    if target == "" {
        ret translate_field_assignment_stmt(ctx, assign_stmt, prefix, idx)
    }

    if assign_stmt.operator == "=" {
        let borrowed_rhs = expr_is_borrowed_copy(assign_stmt.expr) ||
        expr_returns_borrowed(ctx, assign_stmt.expr) ||
        expr_mutably_aliases_path(ctx, assign_stmt.expr, target)
        let mut lowered = lower_expr(ctx, assign_stmt.expr, prefix + "_assign", idx)
        builder = builder.append(lowered.code)
        let mut target_type = ""
        match ctx_lookup_var(ctx, target) {
            Option[str]::Some(found) => {
                target_type = found
            }
            Option[str]::None => {
                translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
                    "unknown-variable", "unknown variable '" + target + "'",)
            }
        }
        if is_mutable_handle_slot(target_type) {
            let handle_type = mutable_handle_slot_type(target_type)
            if !function_type_matches(handle_type, lowered.typ, Vec[str]::new()) {
                translation_error_at(assign_stmt.expr.source_name,
                    assign_stmt.expr.line, assign_stmt.expr.column,
                    "assignment-type-mismatch", "cannot assign value of type '" +
                    canonical_type(lowered.typ) + "' to variable '" + target +
                    "' of type '" + canonical_type(handle_type) + "'",)
            }
            let target_value = ctx_lookup_value_name(ctx, target)
            let old_bits = prefix + "_assign_old_handle_bits_" + Debug::fmt(idx)
            let old_handle = prefix + "_assign_old_handle_" + Debug::fmt(idx)
            let new_bits = prefix + "_assign_new_handle_bits_" + Debug::fmt(idx)
            builder = builder.instr(old_bits + ": usize = load " + target_value)
            builder = builder.instr(old_handle + ": " + handle_type + " = pcast " +
                old_bits + ": usize, " + handle_type,)
            if borrowed_rhs {
                builder = builder.instr("retain " + lowered.value + ": " + handle_type)
            }
            builder = builder.instr(new_bits + ": usize = pcast " + lowered.value +
                ": " + handle_type + ", usize",)
            builder = builder.instr("store " + new_bits + ": usize, " + target_value)
            ret builder.instr("drop " + old_handle + ": " + handle_type)
        }
        let value_type = canonical_type(value_type_name(target_type))
        if is_numeric_type(value_type) && is_numeric_type(lowered.typ) && value_type != canonical_type(value_type_name(lowered.typ))
        {
            let cast_name = prefix + "_assign_cast_" + Debug::fmt(idx)
            builder = builder.instr(cast_name + ": " + value_type + " = pcast " + lowered.value + ": "
                + lowered.typ + ", " + value_type)
            lowered = LoweredExpr {
                EhirTextBuilder::new(), cast_name, value_type
            }
        } elif !function_type_matches(value_type, lowered.typ, Vec[str]::new()) {
            translation_error_at(assign_stmt.expr.source_name, assign_stmt.expr.line, assign_stmt.expr.column,
                "assignment-type-mismatch", "cannot assign value of type '" + canonical_type(value_type_name(lowered.typ))
                + "' to variable '" + target + "' of type '" + value_type + "'",)
        }
        if starts_with(target_type, "mut ") {
            let target_value = ctx_lookup_value_name(ctx, target)
            if ctx_type_needs_ownership(ctx, value_type) {
                let old_name = prefix + "_assign_old_" + Debug::fmt(idx) + "_" + lowered.value
                builder = builder.instr(old_name + ": " + value_type + " = load " + target_value)
                builder = builder.instr("store " + lowered.value + ", " + target_value)
                // `store` retains the new slot value. Release a produced RHS
                // to complete the move; a borrowed RHS keeps its existing
                // owner and the store's retain creates the slot owner.
                if !borrowed_rhs {
                    builder = builder.instr("drop " + lowered.value + ": " + value_type)
                }
                ret builder.instr("drop " + old_name + ": " + value_type)
            }
            ret builder.instr("store " + lowered.value + ", " + target_value)
        }
        if ctx_type_needs_ownership(ctx, target_type) {
            if borrowed_rhs {
                builder = builder.instr("retain " + lowered.value + ": " + target_type)
            }
            builder = builder.instr("drop " + ctx_lookup_value_name(ctx, target) + ": " + target_type)
        }
        builder = builder.instr(target + " = " + lowered.value)
        ret builder
    }

    let borrowed_rhs = expr_is_borrowed_copy(assign_stmt.expr) || expr_returns_borrowed(ctx, assign_stmt.expr)
    let mut lowered = lower_expr(ctx, assign_stmt.expr, prefix + "_assign", idx)
    builder = builder.append(lowered.code)
    let op = assignment_op_to_ehir(assign_stmt.operator)
    if op == "" {
        translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
            "unsupported-assignment-operator", "unsupported assignment operator '" + assign_stmt.operator
            + "'",)
        ret builder
    }
    let tmp_name = prefix + "_assign_tmp_" + Debug::fmt(idx) + "_" + lowered.value
    let mut target_type = lowered.typ
    match ctx_lookup_var(ctx, target) {
        Option[str]::Some(found) => {
            target_type = found
        }
        Option[str]::None => {
            translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
                "unknown-variable", "unknown variable '" + target + "'",)
        }
    }
    let value_type = value_type_name(target_type)
    if is_numeric_type(lowered.typ) && is_numeric_type(value_type) && lowered.typ != value_type {
        let cast_name = prefix + "_assign_rhs_cast_" + Debug::fmt(idx)
        builder = builder.instr(cast_name + ": " + value_type + " = pcast " + lowered.value + ": " +
            lowered.typ + ", " + value_type)
        lowered = LoweredExpr {
            EhirTextBuilder::new(), cast_name, value_type
        }
    }
    let target_value = ctx_lookup_value_name(ctx, target)
    if starts_with(target_type, "mut ") {
        let lhs_name = prefix + "_assign_lhs_" + Debug::fmt(idx) + "_" + lowered.value
        builder = builder.instr(lhs_name + ": " + value_type + " = load " + target_value)
        if assign_stmt.operator == "**=" {
            builder = builder.instr(tmp_name + ": " + value_type + " = call " + method_owner_name(value_type)
                + "::pow(" + lhs_name + ", " + lowered.value + ")")
        } else {
            builder = builder.instr(tmp_name + ": " + value_type + " = " + op + " " + lhs_name + ", "
                + lowered.value)
        }
        builder = builder.instr("store " + tmp_name + ", " + target_value)
        if ctx_type_needs_ownership(ctx, value_type) {
            builder = builder.instr("drop " + tmp_name + ": " + value_type)
            builder = builder.instr("drop " + lhs_name + ": " + value_type)
            if !borrowed_rhs {
                builder = builder.instr("drop " + lowered.value + ": " + lowered.typ)
            }
        }
        ret builder
    }
    if assign_stmt.operator == "**=" {
        builder = builder.instr(tmp_name + ": " + value_type + " = call " + method_owner_name(value_type)
            + "::pow(" + target_value + ", " + lowered.value + ")")
    } else {
        builder = builder.instr(tmp_name + ": " + value_type + " = " + op + " " + target_value + ", "
            + lowered.value)
    }
    builder = builder.instr(target_value + ": " + value_type + " = " + tmp_name)
    ret builder
}

fn translate_field_assignment_stmt(ctx: mut TranslatorContext, assign_stmt: AssignmentStmt, prefix: str,
    idx: usize,) -> EhirTextBuilder {
    match assign_stmt.target.value {
        Expr::Field(field_expr) => {
            let borrowed_rhs = expr_is_borrowed_copy(assign_stmt.expr) || expr_returns_borrowed(ctx,
                assign_stmt.expr,)
            let root_path = expr_h_frozen_root_path(field_expr.base)
            if strict_thread_capabilities() && !ctx_path_is_mutable(ctx, root_path) {
                translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line,
                    assign_stmt.target.column, "mutable-path-required",
                    "cannot assign through immutable path '" + if root_path == "" {
                        "projection"
                    } else {
                        root_path
                    }
                    + "'; declare the root with 'let mut' or use a mutable parameter",)
            }
            if ctx_path_is_frozen(ctx, root_path) {
                translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line,
                    assign_stmt.target.column, "frozen-region-mutation",
                    "cannot assign through frozen region '" + root_path + "'",)
            }
            let base = if ctx_path_is_mutable(ctx, root_path) {
                lower_mutable_place_h(ctx, field_expr.base, prefix + "_assign_field_base", idx + 1_usize)
            } else {
                lower_expr_h(ctx, field_expr.base, prefix + "_assign_field_base", idx + 1_usize)
            }
            if ctx_value_is_frozen(ctx, base.value) {
                translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line,
                    assign_stmt.target.column, "frozen-region-mutation",
                    "cannot assign through a frozen projection",)
            }
            let mut field_type = "void"
            match ctx_lookup_field(ctx, base.typ, field_expr.field) {
                Option[str]::Some(found) => {
                    field_type = found
                }
                Option[str]::None => {
                    translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
                        "unknown-field", "type '" + base.typ + "' has no field '" + field_expr.field
                        + "'",)
                }
            }

            let mut builder = base.code
            let mut rhs = lower_expr(ctx, assign_stmt.expr, prefix + "_assign_field_rhs", idx + 2_usize)
            builder = builder.append(rhs.code)
            let expected_type = canonical_type(value_type_name(field_type))
            if is_numeric_type(expected_type) && is_numeric_type(rhs.typ) && expected_type != canonical_type(value_type_name(rhs.typ))
            {
                let cast_name = prefix + "_assign_field_cast_" + Debug::fmt(idx)
                builder = builder.instr(cast_name + ": " + expected_type + " = pcast " + rhs.value +
                    ": " + rhs.typ + ", " + expected_type)
                rhs = LoweredExpr {
                    EhirTextBuilder::new(), cast_name, expected_type
                }
            } elif !function_type_matches(expected_type, rhs.typ, Vec[str]::new()) {
                translation_error_at(assign_stmt.expr.source_name, assign_stmt.expr.line, assign_stmt.expr.column,
                    "assignment-type-mismatch", "cannot assign value of type '" + canonical_type(value_type_name(rhs.typ))
                    + "' to field '" + field_expr.field + "' of type '" + expected_type + "'",)
            }
            if assign_stmt.operator == "=" {
                let field_index = ctx_lookup_field_index(ctx, base.typ, field_expr.field)
                if ctx_type_needs_ownership(ctx, field_type) {
                    let old_name = prefix + "_assign_field_old_" + Debug::fmt(idx) + "_" + rhs.value
                    builder = builder.instr(old_name + ": " + field_type + " = getfield " + base.value
                        + " > " + field_index)
                    if borrowed_rhs {
                        builder = builder.instr("retain " + rhs.value + ": " + field_type)
                    }
                    builder = builder.instr("setfield " + base.value + " > " + field_index + ", " + rhs.value)
                    ret builder.instr("drop " + old_name + ": " + field_type)
                }
                ret builder.instr("setfield " + base.value + " > " + field_index + ", " + rhs.value)
            }

            let op = assignment_op_to_ehir(assign_stmt.operator)
            if op == "" {
                translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
                    "unsupported-assignment-operator", "unsupported assignment operator '" + assign_stmt.operator
                    + "'",)
                ret builder
            }
            let current_name = prefix + "_assign_field_current_" + Debug::fmt(idx)
            let tmp_name = prefix + "_assign_field_tmp_" + Debug::fmt(idx)
            let field_index = ctx_lookup_field_index(ctx, base.typ, field_expr.field)
            builder = builder.instr(current_name + ": " + field_type + " = getfield " + base.value +
                " > " + field_index)
            builder = builder.instr(tmp_name + ": " + field_type + " = " + op + " " + current_name +
                ", " + rhs.value)
            builder = builder.instr("setfield " + base.value + " > " + field_index + ", " + tmp_name)
            if ctx_type_needs_ownership(ctx, field_type) {
                // `getfield` borrows the old slot while the compound result is
                // moved into it. Release the displaced owner and a produced
                // RHS after the operation has consumed neither input.
                builder = builder.instr("drop " + current_name + ": " + field_type)
                if !borrowed_rhs {
                    builder = builder.instr("drop " + rhs.value + ": " + rhs.typ)
                }
            }
            ret builder
        }
        _ => {
            translation_error_at(assign_stmt.target.source_name, assign_stmt.target.line, assign_stmt.target.column,
                "unsupported-assignment-target", "assignment target must be a variable or field",)
        }
    }
    ret EhirTextBuilder::new()
}

fn translate_expr_stmt(ctx: mut TranslatorContext, expr_stmt: ExprNode, prefix: str, idx: usize) -> EhirTextBuilder
{
    let lowered = lower_expr(ctx, expr_stmt, prefix + "_expr", idx)
    let mut builder = lowered.code
    if ctx_type_needs_ownership(ctx, lowered.typ) {
        builder = builder.instr("drop " + lowered.value + ": " + lowered.typ)
    }
    ret builder
}

fn translate_unsafe_stmt(
    ctx: mut TranslatorContext,
    block: ParsedBlock,
    ret_type: str,
    prefix: str,
    idx: usize,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    ret translate_statements_no_default(
        ctx,
        block.statements,
        ret_type,
        prefix + "_unsafe_" + Debug::fmt(idx),
        break_label,
        continue_label,
    )
}

fn translate_ehir_stmt(ctx: mut TranslatorContext, stmt: EhirStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    if stmt.is_unsafe {
        builder = builder.instr("; unsafe ehir")
    }
    let mut body = stmt.body
    for variable in ctx.vars {
        if variable.emitted_name != variable.name {
            body = replace_type_token(body, variable.name, variable.emitted_name)
        }
    }
    remember_ehir_outputs(ctx, body)
    builder = builder.instr(body)
    ret builder
}

fn remember_ehir_outputs(ctx: mut TranslatorContext, body: str) ->() {
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= body.len() {
        if index == body.len() || body.byte_at(index) == 10_u8 {
            let line = trim_spaces(body.slice(start, index - start))
            let colon = find_char(line, ":", 0_usize)
            let equal = find_assignment_separator(line)
            if colon < equal && equal < line.len() {
                let name = trim_spaces(line.slice(0_usize, colon))
                let typ = trim_spaces(line.slice(colon + 1_usize, equal - colon - 1_usize))
                if name.len() > 0_usize && typ.len() > 0_usize {
                    ctx_add_var(ctx, name, typ)
                }
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret()
}

fn find_assignment_separator(value: str) -> usize {
    let mut index = 0_usize
    while index + 2_usize < value.len() {
        if value.slice(index, 3_usize) == " = " {
            ret index
        }
        index = index + 1_usize
    }
    ret value.len()
}

fn expr_path_or_empty(expr: ExprNode) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        _ => {
            ret ""
        }
    }
    ret ""
}

fn expr_frozen_root_path(expr: ExprNode) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_frozen_root_path(inner)
        }
        Expr::Field(item) => {
            ret expr_h_frozen_root_path(item.base)
        }
        Expr::Index(item) => {
            ret expr_h_frozen_root_path(item.base)
        }
        Expr::MethodCall(item) => {
            ret expr_h_frozen_root_path(item.receiver)
        }
        _ => {
        }
    }
    ret ""
}

fn expr_h_frozen_root_path(expr: ExprNode < H >) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_frozen_root_path(inner)
        }
        Expr::Field(item) => {
            ret expr_h_frozen_root_path(item.base)
        }
        Expr::Index(item) => {
            ret expr_h_frozen_root_path(item.base)
        }
        Expr::MethodCall(item) => {
            ret expr_h_frozen_root_path(item.receiver)
        }
        _ => {
        }
    }
    ret ""
}

fn path_starts_uppercase(name: str) -> bool {
    if name.len() == 0_usize {
        ret false
    }
    let first = name.byte_at(0_usize)
    ret first >= 65_u8 && first <= 90_u8
}

fn assignment_op_to_ehir(op: str) -> str {
    if op == "+=" {
        ret "add"
    }
    if op == "-=" {
        ret "sub"
    }
    if op == "*=" {
        ret "mul"
    }
    if op == "**=" {
        ret "pow-call"
    }
    if op == "/=" {
        ret "div"
    }
    if op == "%=" {
        ret "mod"
    }
    if op == "<<=" {
        ret "shl"
    }
    if op == ">>=" {
        ret "shr"
    }
    if op == "|=" {
        ret "or"
    }
    if op == "&=" {
        ret "and"
    }
    if op == "^=" {
        ret "xor"
    }
    ret ""
}

fn lower_expr(ctx: mut TranslatorContext, expr: ExprNode, prefix: str, idx: usize) -> LoweredExpr {
    match expr.value {
        Expr::Integer(v) => {
            let name = prefix + "_int_" + Debug::fmt(idx)
            let typ = integer_literal_type(v)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::Float(v) => {
            let name = prefix + "_float_" + Debug::fmt(idx)
            let inferred = integer_literal_type(v)
            let typ = if inferred == "usize" {
                "f64"
            } else {
                inferred
            }
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::StringLiteral(v) => {
            let name = prefix + "_str_" + Debug::fmt(idx)
            let typ = "str"
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": str = capprim \"" + escape_str(string_token_body(v)) + "\"_str")
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::Boolean(v) => {
            let name = prefix + "_bool_" + Debug::fmt(idx)
            let mut lit = "0_u1"
            if v {
                lit = "1_u1"
            }
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": bool = capprim " + lit)
            ret LoweredExpr {
                code, name, "bool"
            }
        }
        Expr::Path(name) => {
            if path_starts_uppercase(name) {
                match ctx_lookup_function_for_args(ctx, expr.source_name, name, Vec[str]::new()) {
                    Some(function) => {
                        let out_name = prefix + "_global_" + Debug::fmt(idx)
                        let typ = canonical_type(function.ret_type)
                        let code = EhirTextBuilder::new().instr(out_name + ": " + typ + " = call " +
                            function.emitted_name + "()")
                        ret LoweredExpr {
                            code, out_name, typ
                        }
                    }
                    None => {
                    }
                }
            }
            match ctx_enum_variant_owner(ctx, name) {
                Option[str]::Some(owner) => {
                    let out_name = prefix + "_enum_" + Debug::fmt(idx)
                    let mut code = EhirTextBuilder::new()
                    let resolved_owner = if generic_args_from_path(owner).len() == 0_usize && ctx.expression_hint
                    != "" && base_type_name(ctx.expression_hint) == base_type_name(owner) {
                        canonical_type(ctx.expression_hint)
                    } else {
                        owner
                    }
                    code = code.instr(out_name + ": " + resolved_owner + " = capenum " + resolved_owner
                        + "::" + enum_variant_name(name) + "()")
                    ret LoweredExpr {
                        code, out_name, resolved_owner
                    }
                }
                Option[str]::None => {
                }
            }
            let mut typ = ""
            match ctx_lookup_var(ctx, name) {
                Option[str]::Some(found) => {
                    typ = found
                }
                Option[str]::None => {
                    translation_error_at(expr.source_name, expr.line, expr.column, "unknown-variable",
                        "unknown variable '" + name + "'",)
                }
            }
            if is_mutable_handle_slot(typ) {
                let handle_type = mutable_handle_slot_type(typ)
                let bits_name = prefix + "_handle_bits_" + Debug::fmt(idx)
                let out_name = prefix + "_handle_load_" + Debug::fmt(idx)
                let code = EhirTextBuilder::new()
                .instr(bits_name + ": usize = load " +
                    ctx_lookup_value_name(ctx, name),)
                .instr(out_name + ": " + handle_type + " = pcast " +
                    bits_name + ": usize, " + handle_type,)
                ret LoweredExpr {
                    code, out_name, handle_type
                }
            }
            if starts_with(typ, "mut ") && ends_with(canonical_type(typ), "&") {
                ret LoweredExpr {
                    EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name),
                    typ.slice(4_usize, typ.len() - 4_usize)
                }
            }
            if starts_with(typ, "mut ") {
                let mutable_value_type = canonical_type(typ).slice(4_usize,
                    canonical_type(typ).len() - 4_usize,)
                if is_node_handle_type_text(mutable_value_type) {
                    ret LoweredExpr {
                        EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name),
                        mutable_value_type
                    }
                }
                let value_type = value_type_name(typ)
                let out_name = prefix + "_load_" + Debug::fmt(idx)
                let mut code = EhirTextBuilder::new()
                code = code.instr(out_name + ": " + value_type + " = load " + ctx_lookup_value_name(ctx,
                        name,))
                ret LoweredExpr {
                    code, out_name, value_type
                }
            }
            ret LoweredExpr {
                EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), typ
            }
        }
        Expr::Binary(bin) => {
            ret lower_binary_expr(ctx, bin, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Call(call) => {
            ret lower_call_expr(ctx, call, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::StructInit(init_expr) => {
            ret lower_struct_init_expr(ctx, init_expr, expr.source_name, prefix, idx)
        }
        Expr::TupleLiteral(tuple_expr) => {
            ret lower_tuple_literal_expr(ctx, tuple_expr, prefix, idx)
        }
        Expr::ArrayLiteral(array_expr) => {
            ret lower_array_literal_expr(ctx, array_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::VecLiteral(vec_expr) => {
            ret lower_vec_literal_expr(ctx, vec_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::ArrayRepeat(repeat_expr) => {
            ret lower_array_repeat_expr(ctx, repeat_expr, prefix, idx)
        }
        Expr::Field(field_expr) => {
            ret lower_field_expr(ctx, field_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::MethodCall(method_call) => {
            ret lower_method_call_expr(ctx, method_call, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::Parenthesized(inner) => {
            ret lower_expr_h(ctx, inner, prefix, idx)
        }
        Expr::Await(inner) => {
            if !ctx.in_async_function {
                translation_error_at(expr.source_name, expr.line, expr.column, "await-outside-async",
                    "'await' can only be used inside an async function",)
            }
            let future = lower_expr_h(ctx, inner, prefix + "_await_future", idx)
            ctx_move_owned_var(ctx, expr_h_path_or_empty(inner))
            let output_type = future_output_type(ctx, future.typ, expr.source_name, expr.line, expr.column)
            let out_name = prefix + "_await_" + Debug::fmt(idx)
            let mut code = future.code
            code = code.instr(out_name + ": " + output_type + " = await " + future.value + ": " + future.typ)
            ret LoweredExpr {
                code, out_name, output_type
            }
        }
        Expr::Spawn(inner) => {
            match inner.value {
                Expr::Call(call) => {
                    ret lower_spawn_expr(ctx, call, expr.source_name, expr.line, expr.column, prefix,
                        idx,)
                }
                _ => {
                    translation_error_at(expr.source_name, expr.line, expr.column, "invalid-spawn-target",
                        "spawn expects a direct function call",)
                    ret LoweredExpr {
                        EhirTextBuilder::new(), "", "JoinHandle[()]"
                    }
                }
            }
        }
        Expr::Unary(unary_expr) => {
            ret lower_unary_expr(ctx, unary_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Cast(cast_expr) => {
            ret lower_cast_expr(ctx, cast_expr, expr.source_name, prefix, idx)
        }
        Expr::Match(_) => {
            match expr.value {
                Expr::Match(match_expr) => {
                    ret lower_match_expr(ctx, match_expr, expr.source_name, expr.line, expr.column, prefix,
                        idx,)
                }
                _ => {
                }
            }
            translation_error_at(expr.source_name, expr.line, expr.column, "translator-invariant", "match expression payload was lost during lowering")
            ret LoweredExpr {
                EhirTextBuilder::new(), "", "void"
            }
        }
        Expr::If(if_expr) => {
            ret lower_if_expr(ctx, if_expr, prefix, idx)
        }
        Expr::Block(block_expr) => {
            ret lower_block_expr(ctx, block_expr, prefix, idx)
        }
        Expr::Index(index_expr) => {
            ret lower_index_expr(ctx, index_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Closure(closure_expr) => {
            ret lower_closure_expr(ctx, closure_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::Try(inner) => {
            ret lower_try_expr(ctx, inner, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Unsafe(block) => {
            ret lower_unsafe_expr(ctx, block, prefix, idx)
        }
        _ => {
            translation_error_at(expr.source_name, expr.line, expr.column, "unsupported-expression",
                "unsupported expression kind",)
            ret LoweredExpr {
                EhirTextBuilder::new(), "", "void"
            }
        }
    }
}

fn binary_op_to_ehir(op: str) -> str {
    if op == "+" {
        ret "add"
    }
    if op == "-" {
        ret "sub"
    }
    if op == "*" {
        ret "mul"
    }
    if op == "**" {
        ret "mul"
    }
    if op == "/" {
        ret "div"
    }
    if op == "%" {
        ret "mod"
    }
    if op == "==" {
        ret "ieq"
    }
    if op == "!=" {
        ret "neq"
    }
    if op == "<" {
        ret "les"
    }
    if op == ">" {
        ret "grt"
    }
    if op == "<=" {
        ret "leq"
    }
    if op == ">=" {
        ret "geq"
    }
    if op == "&&" {
        ret "and"
    }
    if op == "||" {
        ret "or"
    }
    if op == "<<" {
        ret "shl"
    }
    if op == ">>" {
        ret "shr"
    }
    if op == "|" {
        ret "or"
    }
    if op == "&" {
        ret "and"
    }
    if op == "^" {
        ret "xor"
    }
    ret ""
}

fn binary_result_type(op: str, lhs_type: str) -> str {
    if op == "==" {
        ret "bool"
    }
    if op == "!=" {
        ret "bool"
    }
    if op == "<" {
        ret "bool"
    }
    if op == ">" {
        ret "bool"
    }
    if op == "<=" {
        ret "bool"
    }
    if op == ">=" {
        ret "bool"
    }
    if op == "&&" {
        ret "bool"
    }
    if op == "||" {
        ret "bool"
    }
    ret lhs_type
}

fn lower_expr_h(ctx: mut TranslatorContext, expr: ExprNode < H >, prefix: str, idx: usize) -> LoweredExpr
{
    match expr.value {
        Expr::Integer(v) => {
            let name = prefix + "_int_" + Debug::fmt(idx)
            let typ = integer_literal_type(v)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::Float(v) => {
            let name = prefix + "_float_" + Debug::fmt(idx)
            let inferred = integer_literal_type(v)
            let typ = if inferred == "usize" {
                "f64"
            } else {
                inferred
            }
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::StringLiteral(v) => {
            let name = prefix + "_str_" + Debug::fmt(idx)
            let typ = "str"
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": str = capprim \"" + escape_str(string_token_body(v)) + "\"_str")
            ret LoweredExpr {
                code, name, typ
            }
        }
        Expr::Boolean(v) => {
            let name = prefix + "_bool_" + Debug::fmt(idx)
            let mut lit = "0_u1"
            if v {
                lit = "1_u1"
            }
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": bool = capprim " + lit)
            ret LoweredExpr {
                code, name, "bool"
            }
        }
        Expr::Path(name) => {
            if path_starts_uppercase(name) {
                match ctx_lookup_function_for_args(ctx, expr.source_name, name, Vec[str]::new()) {
                    Some(function) => {
                        let out_name = prefix + "_global_" + Debug::fmt(idx)
                        let typ = canonical_type(function.ret_type)
                        let code = EhirTextBuilder::new().instr(out_name + ": " + typ + " = call " +
                            function.emitted_name + "()")
                        ret LoweredExpr {
                            code, out_name, typ
                        }
                    }
                    None => {
                    }
                }
            }
            match ctx_enum_variant_owner(ctx, name) {
                Option[str]::Some(owner) => {
                    let out_name = prefix + "_enum_" + Debug::fmt(idx)
                    let mut code = EhirTextBuilder::new()
                    let resolved_owner = if generic_args_from_path(owner).len() == 0_usize && ctx.expression_hint
                    != "" && base_type_name(ctx.expression_hint) == base_type_name(owner) {
                        canonical_type(ctx.expression_hint)
                    } else {
                        owner
                    }
                    code = code.instr(out_name + ": " + resolved_owner + " = capenum " + resolved_owner
                        + "::" + enum_variant_name(name) + "()")
                    ret LoweredExpr {
                        code, out_name, resolved_owner
                    }
                }
                Option[str]::None => {
                }
            }
            let mut typ = ""
            match ctx_lookup_var(ctx, name) {
                Option[str]::Some(found) => {
                    typ = found
                }
                Option[str]::None => {
                    translation_error_at(expr.source_name, expr.line, expr.column, "unknown-variable",
                        "unknown variable '" + name + "'",)
                }
            }
            if is_mutable_handle_slot(typ) {
                let handle_type = mutable_handle_slot_type(typ)
                let bits_name = prefix + "_handle_bits_" + Debug::fmt(idx)
                let out_name = prefix + "_handle_load_" + Debug::fmt(idx)
                let code = EhirTextBuilder::new()
                .instr(bits_name + ": usize = load " +
                    ctx_lookup_value_name(ctx, name),)
                .instr(out_name + ": " + handle_type + " = pcast " +
                    bits_name + ": usize, " + handle_type,)
                ret LoweredExpr {
                    code, out_name, handle_type
                }
            }
            if starts_with(typ, "mut ") {
                let value_type = value_type_name(typ)
                let out_name = prefix + "_load_" + Debug::fmt(idx)
                let mut code = EhirTextBuilder::new()
                code = code.instr(out_name + ": " + value_type + " = load " + ctx_lookup_value_name(ctx,
                        name,))
                ret LoweredExpr {
                    code, out_name, value_type
                }
            }
            ret LoweredExpr {
                EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), typ
            }
        }
        Expr::Parenthesized(inner) => {
            ret lower_expr_h(ctx, inner, prefix, idx)
        }
        Expr::Binary(bin) => {
            ret lower_binary_expr(ctx, bin, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Call(call) => {
            ret lower_call_expr(ctx, call, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::StructInit(init_expr) => {
            ret lower_struct_init_expr(ctx, init_expr, expr.source_name, prefix, idx)
        }
        Expr::TupleLiteral(tuple_expr) => {
            ret lower_tuple_literal_expr(ctx, tuple_expr, prefix, idx)
        }
        Expr::ArrayLiteral(array_expr) => {
            ret lower_array_literal_expr(ctx, array_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::VecLiteral(vec_expr) => {
            ret lower_vec_literal_expr(ctx, vec_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::ArrayRepeat(repeat_expr) => {
            ret lower_array_repeat_expr(ctx, repeat_expr, prefix, idx)
        }
        Expr::Await(inner) => {
            if !ctx.in_async_function {
                translation_error_at(expr.source_name, expr.line, expr.column, "await-outside-async",
                    "'await' can only be used inside an async function",)
            }
            let future = lower_expr_h(ctx, inner, prefix + "_await_future", idx)
            ctx_move_owned_var(ctx, expr_h_path_or_empty(inner))
            let output_type = future_output_type(ctx, future.typ, expr.source_name, expr.line, expr.column)
            let out_name = prefix + "_await_" + Debug::fmt(idx)
            let mut code = future.code
            code = code.instr(out_name + ": " + output_type + " = await " + future.value + ": " + future.typ)
            ret LoweredExpr {
                code, out_name, output_type
            }
        }
        Expr::Spawn(inner) => {
            match inner.value {
                Expr::Call(call) => {
                    ret lower_spawn_expr(ctx, call, expr.source_name, expr.line, expr.column, prefix,
                        idx,)
                }
                _ => {
                    translation_error_at(expr.source_name, expr.line, expr.column, "invalid-spawn-target",
                        "spawn expects a direct function call",)
                    ret LoweredExpr {
                        EhirTextBuilder::new(), "", "JoinHandle[()]"
                    }
                }
            }
        }
        Expr::Unary(unary_expr) => {
            ret lower_unary_expr(ctx, unary_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Cast(cast_expr) => {
            ret lower_cast_expr(ctx, cast_expr, expr.source_name, prefix, idx)
        }
        Expr::Field(field_expr) => {
            ret lower_field_expr(ctx, field_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::MethodCall(method_call) => {
            ret lower_method_call_expr(ctx, method_call, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::Match(_) => {
            match expr.value {
                Expr::Match(match_expr) => {
                    ret lower_match_expr(ctx, match_expr, expr.source_name, expr.line, expr.column, prefix,
                        idx,)
                }
                _ => {
                }
            }
            translation_error_at(expr.source_name, expr.line, expr.column, "translator-invariant", "boxed match expression payload was lost during lowering")
            ret LoweredExpr {
                EhirTextBuilder::new(), "", "void"
            }
        }
        Expr::If(if_expr) => {
            ret lower_if_expr(ctx, if_expr, prefix, idx)
        }
        Expr::Block(block_expr) => {
            ret lower_block_expr(ctx, block_expr, prefix, idx)
        }
        Expr::Index(index_expr) => {
            ret lower_index_expr(ctx, index_expr, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Closure(closure_expr) => {
            ret lower_closure_expr(ctx, closure_expr, expr.source_name, expr.line, expr.column, prefix,
                idx,)
        }
        Expr::Try(inner) => {
            ret lower_try_expr(ctx, inner, expr.source_name, expr.line, expr.column, prefix, idx)
        }
        Expr::Unsafe(block) => {
            ret lower_unsafe_expr(ctx, block, prefix, idx)
        }
        _ => {
            translation_error_at(expr.source_name, expr.line, expr.column, "unsupported-expression",
                "unsupported boxed expression kind",)
            ret LoweredExpr {
                EhirTextBuilder::new(), "", "void"
            }
        }
    }
}

fn lower_cast_expr(ctx: mut TranslatorContext, cast_expr: CastExpr, source_name: str, prefix: str, idx: usize) -> LoweredExpr
{
    let source = lower_expr_h(ctx, cast_expr.expr, prefix + "_cast_src", idx + 1_usize)
    let out_name = prefix + "_cast_" + Debug::fmt(idx)
    let target = qualified_type_for_source(ctx, source_name, cast_expr.target)
    let mut code = source.code
    code = code.instr(out_name + ": " + target + " = pcast " + source.value + ", " + target)
    ret LoweredExpr {
        code, out_name, target
    }
}

fn lower_closure_expr(ctx: mut TranslatorContext, closure: ClosureExpr, source_name: str, line: usize,
    column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let expected = canonical_type(ctx.expression_hint)
    let signature = closure_signature(ctx, expected, source_name, line, column)
    if closure.params.len() != signature.params.len() {
        translation_error_at(source_name, line, column, "closure-arity-mismatch",
            "closure expects " + Debug::fmt(signature.params.len()) + " parameter(s) from trait '" +
            signature.trait_name + "', but declares " + Debug::fmt(closure.params.len()),)
    }

    let mut effective_params = Vec[FunctionParam]::new()
    let mut parameter_names = Vec[str]::new()
    let mut parameter_index = 0_usize
    for parameter in closure.params {
        let expected_type = signature.params.get(parameter_index).unwrap_or("")
        match parameter.typ {
            Some(declared) => {
                if canonical_type(declared) != canonical_type(expected_type) {
                    translation_error_at(source_name, line, column, "closure-parameter-type-mismatch",
                        "closure parameter '" + parameter.name + "' has type '" + declared +
                        "', but trait '" + signature.trait_name + "' requires '" + expected_type + "'",)
                }
            }
            None => {
            }
        }
        effective_params.push(FunctionParam {
                parameter.name, Option[str]::Some(expected_type), parameter.is_sending
            }
            ,
        )
        parameter_names.push(parameter.name)
        parameter_index += 1_usize
    }

    let mut captures = Vec[VarType]::new()
    collect_closure_captures_h(ctx, closure.body, parameter_names, captures)
    for capture in captures {
        let capture_type = canonical_type(capture.typ)
        if starts_with(capture.typ, "mut ") {
            translation_error_at(source_name, line, column, "mutable-closure-capture",
                "closure cannot capture mutable local '" + capture.name +
                "' yet; capture an owning heap node such as Signal<H> instead",)
        }
        if ends_with(capture_type, "<S>") {
            translation_error_at(source_name, line, column, "stack-node-closure-escape",
                "closure environment escapes, so it cannot capture stack node '" + capture.name +
                "' of type '" + capture_type + "'; allocate it as <H>",)
        }
    }

    let closure_id = generated_closure_count(ctx)
    let closure_name = "__encore_closure_" + encode_module_identity(source_name) + "_" +
    Debug::fmt(line) + "_" + Debug::fmt(column) + "_" + Debug::fmt(closure_id)
    let closure_type = closure_name + "<H>"
    remember_type(ctx, closure_name)
    let _owning = unsafe {
        encore_strset_insert(ctx.owning_type_index, closure_name)
    }

    let declaration = translate_closure_declaration(ctx, closure_name, closure_type, signature,
        effective_params, captures, closure.body, source_name, line, column,)
    ctx.extern_functions.push("__encore_generated_closure__" + declaration)

    let concrete_name = prefix + "_closure_env_" + Debug::fmt(idx)
    let dyn_name = prefix + "_closure_" + Debug::fmt(idx)
    let mut values = Vec[str]::new()
    let mut code = EhirTextBuilder::new()
    for capture in captures {
        let capture_type = canonical_type(capture.typ)
        if ctx_type_needs_ownership(ctx, capture_type) {
            code = code.instr("retain " + capture.emitted_name + ": " + capture_type)
        }
        values.push(capture.emitted_name)
    }
    code = code.instr(concrete_name + ": " + closure_type + " = capstruct " + closure_type + "(" +
        join_strs(values, ", ") + ")")
    let dyn_type = "dyn " + signature.trait_name
    code = code.instr(dyn_name + ": " + dyn_type + " = pcast " + concrete_name + ", " + dyn_type)
    ret LoweredExpr {
        code, dyn_name, dyn_type
    }
}

fn closure_signature(ctx: mut TranslatorContext, expected: str, source_name: str, line: usize, column:
    usize,) -> ClosureSignature {
    if !starts_with(expected, "dyn ") {
        translation_error_at(source_name, line, column, "closure-context-required",
            "a closure needs an expected single-method dynamic trait type; add a 'dyn Trait' annotation or pass it directly to a typed parameter",)
    }
    let trait_name = trim_spaces(expected.slice(4_usize, expected.len() - 4_usize))
    if generic_args_from_path(trait_name).len() > 0_usize {
        translation_error_at(source_name, line, column, "generic-closure-trait-unsupported",
            "closures currently require a non-generic dynamic trait because generic trait objects are not yet represented by the EHIR backend",)
    }
    for trait_item in ctx.traits {
        if trait_item.name == trait_name || base_type_name(trait_item.name) == base_type_name(trait_name)
        {
            if trait_item.methods.len() != 1_usize {
                translation_error_at(source_name, line, column, "closure-trait-method-count",
                    "closure target trait '" + trait_name + "' must declare exactly one method",)
            }
            match trait_item.methods.get(0_usize) {
                Some(method) => {
                    let mut params = Vec[str]::new()
                    let mut index = 0_usize
                    for parameter in method.params {
                        if index > 0_usize {
                            params.push(canonical_type(unwrap_type_or_usize(parameter.typ)))
                        }
                        index += 1_usize
                    }
                    ret ClosureSignature {
                        trait_name, method.name, params, canonical_type(function_ret_type(method))
                    }
                }
                None => {
                }
            }
        }
    }
    translation_error_at(source_name, line, column, "unknown-closure-trait",
        "cannot resolve closure target trait '" + trait_name + "'",)
    ret ClosureSignature {
        trait_name, "call", Vec[str]::new(), "void"
    }
}

fn translate_closure_declaration(ctx: mut TranslatorContext, closure_name: str, closure_type: str,
    signature: ClosureSignature, params: Vec[FunctionParam], captures: Vec[VarType], body: ExprNode <
    H >,
    source_name: str, line: usize, column: usize,) -> str {
    let saved_vars = ctx.vars
    let saved_owned = ctx.owned_vars
    let saved_loops = ctx.loop_targets
    let saved_cleanups = ctx.with_cleanups
    let saved_self = ctx.self_type
    let saved_return = ctx.return_type
    let saved_hint = ctx.expression_hint
    let saved_generics = ctx.active_generics
    let saved_async = ctx.in_async_function
    let saved_future = ctx.async_poll_future_type

    ctx.vars = Vec[VarType]::new()
    ctx.owned_vars = Vec[VarType]::new()
    ctx.loop_targets = Vec[LoopTargetType]::new()
    ctx.with_cleanups = Vec[VarType]::new()
    ctx.self_type = closure_type
    ctx.return_type = signature.ret_type
    ctx.expression_hint = signature.ret_type
    ctx.active_generics = Vec[GenericParam]::new()
    ctx.in_async_function = false
    ctx.async_poll_future_type = ""

    ctx_add_var(ctx, "self", closure_type)
    ctx_add_owned_var(ctx, "self", "self", closure_type)
    for parameter in params {
        let typ = canonical_type(unwrap_type_or_usize(parameter.typ))
        ctx_add_var(ctx, parameter.name, typ)
        ctx_add_owned_var(ctx, parameter.name, parameter.name, typ)
    }

    let mut method = EhirTextBuilder::new()
    let mut struct_builder = EhirTextBuilder::new().line("struct " + closure_name + " {")
    let mut capture_index = 0_usize
    for capture in captures {
        let typ = canonical_type(capture.typ)
        struct_builder = struct_builder.line("  " + capture.name + ": " + typ)
        let loaded = "__closure_capture_" + Debug::fmt(capture_index)
        method = method.instr(loaded + ": " + typ + " = getfield self > " + Debug::fmt(capture_index))
        ctx_add_var_emitted(ctx, capture.name, loaded, typ)
        capture_index += 1_usize
    }
    struct_builder = struct_builder.line("}").empty_line()

    let lowered = lower_expr_h_with_hint(ctx, body, signature.ret_type, "__closure_body", 0_usize)
    method = method.append(lowered.code)
    let body_returns = closure_body_always_returns(body)
    if !body_returns {
        let result_type = canonical_type(lowered.typ)
        let expected_return = canonical_type(signature.ret_type)
        if expected_return == "void" || expected_return == "()" {
            if lowered.value != "" && result_type != "!" && result_type != "void" && result_type != "()"
            &&
            ctx_type_needs_ownership(ctx, result_type) {
                method = method.instr("drop " + lowered.value + ": " + result_type)
            }
            method = append_owned_drops(ctx, method, "", "__closure_exit")
            method = method.instr("ret void: ()")
        } else {
            if result_type == "!" || !function_type_matches(expected_return, result_type, Vec[str]::new())
            {
                translation_error_at(source_name, line, column, "closure-return-type-mismatch",
                    "closure returns '" + result_type + "', but trait '" + signature.trait_name +
                    "' requires '" + expected_return + "'",)
            }
            if expr_h_is_borrowed_copy(body) && ctx_type_needs_ownership(ctx, result_type) {
                method = method.instr("retain " + lowered.value + ": " + result_type)
            }
            method = append_owned_drops(ctx, method, "", "__closure_exit")
            method = method.instr("ret " + lowered.value + ": " + expected_return)
        }
    }

    let mut signature_params = Vec[str]::new()
    signature_params.push("self: " + closure_type)
    for parameter in params {
        signature_params.push(parameter.name + ": " + canonical_type(unwrap_type_or_usize(parameter.typ)))
    }
    let mut declaration = struct_builder
    declaration = declaration.line("impl " + signature.trait_name + " for " + closure_type + " {")
    declaration = declaration.line("fn " + signature.method_name + "(" + join_strs(signature_params,
            ", ",) +
        ") -> " + signature.ret_type + " {")
    declaration = declaration.label("entry")
    declaration = declaration.append(method)
    declaration = declaration.line("}")
    declaration = declaration.line("}")

    ctx.vars = saved_vars
    ctx.owned_vars = saved_owned
    ctx.loop_targets = saved_loops
    ctx.with_cleanups = saved_cleanups
    ctx.self_type = saved_self
    ctx.return_type = saved_return
    ctx.expression_hint = saved_hint
    ctx.active_generics = saved_generics
    ctx.in_async_function = saved_async
    ctx.async_poll_future_type = saved_future
    ret declaration.finish()
}

fn closure_body_always_returns(body: ExprNode < H >) -> bool {
    match body.value {
        Expr::Block(block) => {
            ret block_always_returns(ParsedBlock {
                    block.statements
                }
            )
        }
        _ => {
        }
    }
    ret false
}

fn collect_closure_captures_h(ctx: mut TranslatorContext, expr: ExprNode < H >, bound: mut Vec[str],
    captures: mut Vec[VarType],) ->() {
    match expr.value {
        Expr::Path(name) => {
            remember_closure_capture(ctx, name, bound, captures)
        }
        Expr::Parenthesized(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Unary(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
        }
        Expr::Await(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Spawn(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Try(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Cast(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
        }
        Expr::Binary(item) => {
            collect_closure_captures_h(ctx, item.lhs, bound, captures)
            collect_closure_captures_h(ctx, item.rhs, bound, captures)
        }
        Expr::Call(item) => {
            collect_closure_captures_h(ctx, item.callee, bound, captures)
            for arg in item.args {
                collect_closure_captures(ctx, arg, bound, captures)
            }
        }
        Expr::Field(item) => {
            collect_closure_captures_h(ctx, item.base, bound, captures)
        }
        Expr::MethodCall(item) => {
            collect_closure_captures_h(ctx, item.receiver, bound, captures)
            for arg in item.args {
                collect_closure_captures(ctx, arg, bound, captures)
            }
        }
        Expr::Match(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
            for arm in item.arms {
                match arm.pattern.binding {
                    Some(name) => {
                        bound.push(name)
                    }
                    None => {
                    }
                }
                collect_closure_captures(ctx, arm.expr, bound, captures)
            }
        }
        Expr::If(item) => {
            for branch in item.branches {
                collect_closure_captures(ctx, branch.condition, bound, captures)
                collect_closure_captures(ctx, branch.body, bound, captures)
            }
            collect_closure_captures_h(ctx, item.else_body, bound, captures)
        }
        Expr::StructInit(item) => {
            for value in item.values {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::TupleLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::ArrayLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::VecLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::ArrayRepeat(item) => {
            collect_closure_captures_h(ctx, item.value, bound, captures)
        }
        Expr::Block(item) => {
            collect_closure_statement_captures(ctx, item.statements, bound, captures)
            match item.tail {
                Some(tail) => {
                    collect_closure_captures_h(ctx, tail, bound, captures)
                }
                None => {
                }
            }
        }
        Expr::Index(item) => {
            collect_closure_captures_h(ctx, item.base, bound, captures)
            collect_closure_captures_h(ctx, item.index, bound, captures)
        }
        Expr::Closure(item) => {
            for parameter in item.params {
                bound.push(parameter.name)
            }
            collect_closure_captures_h(ctx, item.body, bound, captures)
        }
        Expr::Unsafe(item) => {
            collect_closure_statement_captures(ctx, item.statements, bound, captures)
        }
        _ => {
        }
    }
    ret()
}

fn collect_closure_captures(ctx: mut TranslatorContext, expr: ExprNode, bound: mut Vec[str], captures:
    mut Vec[VarType],) ->() {
    match expr.value {
        Expr::Path(name) => {
            remember_closure_capture(ctx, name, bound, captures)
        }
        Expr::Parenthesized(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Unary(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
        }
        Expr::Await(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Spawn(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Try(inner) => {
            collect_closure_captures_h(ctx, inner, bound, captures)
        }
        Expr::Cast(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
        }
        Expr::Binary(item) => {
            collect_closure_captures_h(ctx, item.lhs, bound, captures)
            collect_closure_captures_h(ctx, item.rhs, bound, captures)
        }
        Expr::Call(item) => {
            collect_closure_captures_h(ctx, item.callee, bound, captures)
            for arg in item.args {
                collect_closure_captures(ctx, arg, bound, captures)
            }
        }
        Expr::Field(item) => {
            collect_closure_captures_h(ctx, item.base, bound, captures)
        }
        Expr::MethodCall(item) => {
            collect_closure_captures_h(ctx, item.receiver, bound, captures)
            for arg in item.args {
                collect_closure_captures(ctx, arg, bound, captures)
            }
        }
        Expr::Match(item) => {
            collect_closure_captures_h(ctx, item.expr, bound, captures)
            for arm in item.arms {
                match arm.pattern.binding {
                    Some(name) => {
                        bound.push(name)
                    }
                    None => {
                    }
                }
                collect_closure_captures(ctx, arm.expr, bound, captures)
            }
        }
        Expr::If(item) => {
            for branch in item.branches {
                collect_closure_captures(ctx, branch.condition, bound, captures)
                collect_closure_captures(ctx, branch.body, bound, captures)
            }
            collect_closure_captures_h(ctx, item.else_body, bound, captures)
        }
        Expr::StructInit(item) => {
            for value in item.values {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::TupleLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::ArrayLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::VecLiteral(item) => {
            for value in item.items {
                collect_closure_captures(ctx, value, bound, captures)
            }
        }
        Expr::ArrayRepeat(item) => {
            collect_closure_captures_h(ctx, item.value, bound, captures)
        }
        Expr::Block(item) => {
            collect_closure_statement_captures(ctx, item.statements, bound, captures)
            match item.tail {
                Some(tail) => {
                    collect_closure_captures_h(ctx, tail, bound, captures)
                }
                None => {
                }
            }
        }
        Expr::Index(item) => {
            collect_closure_captures_h(ctx, item.base, bound, captures)
            collect_closure_captures_h(ctx, item.index, bound, captures)
        }
        Expr::Closure(item) => {
            for parameter in item.params {
                bound.push(parameter.name)
            }
            collect_closure_captures_h(ctx, item.body, bound, captures)
        }
        Expr::Unsafe(item) => {
            collect_closure_statement_captures(ctx, item.statements, bound, captures)
        }
        _ => {
        }
    }
    ret()
}

fn collect_closure_statement_captures(ctx: mut TranslatorContext, statements: Vec[Statement], bound:
    mut Vec[str], captures: mut Vec[VarType],) ->() {
    for statement in statements {
        match statement {
            Statement::Let(item) => {
                collect_closure_captures(ctx, item.expr, bound, captures)
                bound.push(item.name)
            }
            Statement::Ret(expr) => {
                collect_closure_captures(ctx, expr, bound, captures)
            }
            Statement::Expr(expr) => {
                collect_closure_captures(ctx, expr, bound, captures)
            }
            Statement::Assignment(item) => {
                collect_closure_captures(ctx, item.target, bound, captures)
                collect_closure_captures(ctx, item.expr, bound, captures)
            }
            Statement::If(item) => {
                for branch in item.branches {
                    collect_closure_captures(ctx, branch.condition, bound, captures)
                    collect_closure_statement_captures(ctx, branch.body.statements, bound, captures)
                }
                match item.else_body {
                    Some(body) => {
                        collect_closure_statement_captures(ctx, body.statements, bound, captures)
                    }
                    None => {
                    }
                }
            }
            Statement::Match(item) => {
                collect_closure_captures(ctx, item.expr, bound, captures)
                for arm in item.arms {
                    match arm.pattern.binding {
                        Some(name) => {
                            bound.push(name)
                        }
                        None => {
                        }
                    }
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            collect_closure_statement_captures(ctx, body.statements, bound, captures)
                        }
                        MatchArmBody::Expr(expr) => {
                            collect_closure_captures(ctx, expr, bound, captures)
                        }
                    }
                }
            }
            Statement::While(item) => {
                collect_closure_captures(ctx, item.condition, bound, captures)
                collect_closure_statement_captures(ctx, item.body.statements, bound, captures)
            }
            Statement::Loop(item) => {
                collect_closure_statement_captures(ctx, item.body.statements, bound, captures)
            }
            Statement::DoWhile(item) => {
                collect_closure_statement_captures(ctx, item.body.statements, bound, captures)
                collect_closure_captures(ctx, item.condition, bound, captures)
            }
            Statement::For(item) => {
                collect_closure_captures(ctx, item.iterable, bound, captures)
                bound.push(item.name)
                collect_closure_statement_captures(ctx, item.body.statements, bound, captures)
            }
            Statement::With(item) => {
                collect_closure_captures(ctx, item.expr, bound, captures)
                bound.push(item.name)
                collect_closure_statement_captures(ctx, item.body.statements, bound, captures)
            }
            Statement::Unsafe(item) => {
                collect_closure_statement_captures(ctx, item.statements, bound, captures)
            }
            _ => {
            }
        }
    }
    ret()
}

fn remember_closure_capture(ctx: mut TranslatorContext, name: str, bound: Vec[str], captures:
    mut Vec[VarType],) ->() {
    if name == "" || contains_str(bound, name) {
        ret()
    }
    for capture in captures {
        if capture.name == name {
            ret()
        }
    }
    match ctx_lookup_var(ctx, name) {
        Some(typ) => {
            captures.push(VarType {
                    name, ctx_lookup_value_name(ctx, name), typ
                }
                ,
            )
        }
        None => {
        }
    }
    ret()
}

fn lower_try_expr(ctx: mut TranslatorContext, inner: ExprNode < H >, source_name: str, line: usize, column:
    usize, prefix: str, idx: usize,) -> LoweredExpr {
    let tried = lower_expr_h(ctx, inner, prefix + "_try_value", idx + 1_usize)
    let result_type = canonical_type(tried.typ)
    if method_owner_name(result_type) != "Result" {
        translation_error_at(source_name, line, column, "invalid-try-operand", "'?' operator expects Result[T, E], got '"
            + result_type + "'",)
    }

    let ok_type = nth_generic_type(result_type, 0_usize)
    let err_type = nth_generic_type(result_type, 1_usize)
    let fn_ret_type = canonical_type(ctx.return_type)
    if method_owner_name(fn_ret_type) != "Result" {
        translation_error_at(source_name, line, column, "invalid-try-context", "'?' operator can only be used in functions returning Result")
    }
    let fn_err_type = nth_generic_type(fn_ret_type, 1_usize)
    if canonical_type(fn_err_type) != canonical_type(err_type) {
        translation_error_at(source_name, line, column, "try-error-type-mismatch", "function expects error type '"
            + fn_err_type + "', got '" + err_type + "'",)
    }

    let ok_label = prefix + "_try_ok_" + Debug::fmt(idx)
    let err_label = prefix + "_try_err_" + Debug::fmt(idx)
    let cond_name = prefix + "_try_is_ok_" + Debug::fmt(idx)
    let err_payload = prefix + "_try_err_payload_" + Debug::fmt(idx)
    let err_result = prefix + "_try_err_result_" + Debug::fmt(idx)
    let ok_payload = prefix + "_try_ok_payload_" + Debug::fmt(idx)

    let mut code = tried.code
    code = code.instr(cond_name + ": bool = ieq " + tried.value + ", Ok")
    code = code.instr("cbr " + cond_name + ", $" + ok_label + ", $" + err_label)
    code = code.label(err_label)
    code = code.instr(err_payload + ": " + err_type + " = getfield " + tried.value + " > Err")
    code = code.instr(err_result + ": " + fn_ret_type + " = capenum " + fn_ret_type + "::Err(" + err_payload
        + ")")
    code = code.instr("ret " + err_result + ": " + fn_ret_type)
    code = code.label(ok_label)
    code = code.instr(ok_payload + ": " + ok_type + " = getfield " + tried.value + " > Ok")
    ret LoweredExpr {
        code, ok_payload, ok_type
    }
}

fn lower_unary_expr(ctx: mut TranslatorContext, unary_expr: UnaryExpr, source_name: str, line: usize,
    column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    if unary_expr.operator == "-" {
        match unary_expr.expr.value {
            Expr::Integer(value) => {
                if integer_literal_type(value) == "usize" {
                    let typ = "isize"
                    let operand = lower_integer_literal(value, typ, prefix + "_unary_src", idx + 1_usize)
                    let out_name = prefix + "_unary_" + Debug::fmt(idx)
                    let zero_name = out_name + "_zero"
                    let mut code = operand.code
                    code = code.instr(zero_name + ": " + typ + " = capprim 0_isize")
                    code = code.instr(out_name + ": " + typ + " = sub " + zero_name + ", " + operand.value)
                    ret LoweredExpr {
                        code, out_name, typ
                    }
                }
            }
            _ => {
            }
        }
    }
    let operand = lower_expr_h(ctx, unary_expr.expr, prefix + "_unary_src", idx + 1_usize)
    let out_name = prefix + "_unary_" + Debug::fmt(idx)
    let mut code = operand.code

    if unary_expr.operator == "!" {
        let false_name = out_name + "_false"
        code = code.instr(false_name + ": bool = capprim 0_u1")
        code = code.instr(out_name + ": bool = ieq " + operand.value + ", " + false_name)
        ret LoweredExpr {
            code, out_name, "bool"
        }
    }
    if unary_expr.operator == "+" {
        ret operand
    }
    if unary_expr.operator == "-" {
        let zero_name = out_name + "_zero"
        code = code.instr(zero_name + ": " + operand.typ + " = capprim " + with_numeric_suffix("0", operand.typ))
        code = code.instr(out_name + ": " + operand.typ + " = sub " + zero_name + ", " + operand.value)
        ret LoweredExpr {
            code, out_name, operand.typ
        }
    }

    translation_error_at(source_name, line, column, "unsupported-unary-operator", "unsupported unary operator '"
        + unary_expr.operator + "'",)
    ret LoweredExpr {
        code, out_name, "void"
    }
}

fn lower_binary_expr(ctx: mut TranslatorContext, bin: BinaryExpr, source_name: str, line: usize, column:
    usize, prefix: str, idx: usize,) -> LoweredExpr {
    if bin.operator == "&&" || bin.operator == "||" {
        ret lower_short_circuit_expr(
            ctx, bin, source_name, line, column, prefix, idx,)
    }
    let out_name = prefix + "_bin_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let op = binary_op_to_ehir(bin.operator)

    if op == "" {
        translation_error_at(source_name, line, column, "unsupported-binary-operator", "unsupported binary operator '"
            + bin.operator + "'",)
        ret LoweredExpr {
            code, out_name, "usize"
        }
    }

    let lhs_borrowed = expr_h_is_borrowed_copy(bin.lhs)
    let rhs_borrowed = expr_h_is_borrowed_copy(bin.rhs)
    let mut lhs = load_mutable_value(lower_expr_h(ctx, bin.lhs, prefix + "_lhs", idx + 1_usize), prefix
        + "_lhs_load_" + Debug::fmt(idx),)
    let mut rhs_hint = lhs.typ
    if bin.operator == "**" {
        if lhs.typ == "f32" || lhs.typ == "f64" {
            rhs_hint = "i32"
        } elif !is_numeric_type(lhs.typ) {
            match ctx_lookup_function_param(ctx, source_name, method_owner_name(lhs.typ) + "::pow", 1_usize,
                Vec[str]::new(),) {
                Some(found) => {
                    rhs_hint = canonical_type(found)
                }
                None => {
                }
            }
        }
    }
    let mut rhs = load_mutable_value(lower_expr_h_with_hint(ctx, bin.rhs, rhs_hint, prefix + "_rhs",
            idx + 2_usize,), prefix + "_rhs_load_" + Debug::fmt(idx))

    code = code.append(lhs.code)
    code = code.append(rhs.code)
    if bin.operator == "**" {
        code = code.instr(out_name + ": " + lhs.typ + " = call " + method_owner_name(lhs.typ) + "::pow("
            + lhs.value + ", " + rhs.value + ")")
        ret LoweredExpr {
            code, out_name, lhs.typ
        }
    }
    if is_numeric_type(lhs.typ) && is_numeric_type(rhs.typ) && lhs.typ != rhs.typ {
        let common_type = if lhs.typ == "f64" || rhs.typ == "f64" {
            "f64"
        } elif lhs.typ == "f32" || rhs.typ == "f32" {
            "f32"
        } else {
            lhs.typ
        }
        if lhs.typ != common_type {
            let cast_name = prefix + "_lhs_cast_" + Debug::fmt(idx)
            code = code.instr(cast_name + ": " + common_type + " = pcast " + lhs.value + ": " + lhs.typ
                + ", " + common_type)
            lhs = LoweredExpr {
                EhirTextBuilder::new(), cast_name, common_type
            }
        }
        if rhs.typ != common_type {
            let cast_name = prefix + "_rhs_cast_" + Debug::fmt(idx)
            code = code.instr(cast_name + ": " + common_type + " = pcast " + rhs.value + ": " + rhs.typ
                + ", " + common_type)
            rhs = LoweredExpr {
                EhirTextBuilder::new(), cast_name, common_type
            }
        }
    }
    let result_type = binary_result_type(bin.operator, lhs.typ)
    if bin.operator == "+" && !is_numeric_type(lhs.typ) && lhs.typ != "str" {
        if lhs_borrowed && ctx_type_needs_ownership(ctx, lhs.typ) {
            code = code.instr("retain " + lhs.value + ": " + lhs.typ)
        }
        if rhs_borrowed && ctx_type_needs_ownership(ctx, rhs.typ) {
            code = code.instr("retain " + rhs.value + ": " + rhs.typ)
        }
        code = code.instr(out_name + ": " + lhs.typ + " = call " + method_owner_name(lhs.typ) + "::op("
            + lhs.value + ", " + rhs.value + ")")
        ret LoweredExpr {
            code, out_name, lhs.typ
        }
    }
    if lhs.typ == "str" &&(bin.operator == "==" || bin.operator == "!=") {
        let equals_name = out_name + "_str_eq"
        code = code.instr(equals_name + ": bool = unsafe call encore_str_eq(" + lhs.value + ", " + rhs.value
            + ")")
        if !lhs_borrowed {
            code = code.instr("drop " + lhs.value + ": " + lhs.typ)
        }
        if !rhs_borrowed {
            code = code.instr("drop " + rhs.value + ": " + rhs.typ)
        }
        if bin.operator == "==" {
            ret LoweredExpr {
                code, equals_name, "bool"
            }
        }
        let false_name = out_name + "_false"
        code = code.instr(false_name + ": bool = capprim 0_u1")
        code = code.instr(out_name + ": bool = ieq " + equals_name + ", " + false_name)
        ret LoweredExpr {
            code, out_name, "bool"
        }
    }
    code = code.instr(out_name + ": " + result_type + " = " + op + " " + lhs.value + ", " + rhs.value)
    if ctx_type_needs_ownership(ctx, lhs.typ) && !lhs_borrowed {
        code = code.instr("drop " + lhs.value + ": " + lhs.typ)
    }
    if ctx_type_needs_ownership(ctx, rhs.typ) && !rhs_borrowed {
        code = code.instr("drop " + rhs.value + ": " + rhs.typ)
    }
    ret LoweredExpr {
        code, out_name, result_type
    }
}

/// Encore logical operators are control-flow constructs. EHIR's `and` and
/// `or` instructions remain eager value operations (and are also used for
/// bitwise integer expressions), so lowering `&&`/`||` to either instruction
/// would incorrectly evaluate a side-effecting right-hand operand.
fn lower_short_circuit_expr(ctx: mut TranslatorContext, bin: BinaryExpr,
    source_name: str, line: usize, column: usize,
    prefix: str, idx: usize,) -> LoweredExpr {
    let out_name = prefix + "_logical_" + Debug::fmt(idx)
    let result_slot = out_name + "_slot"
    let rhs_label = out_name + "_rhs"
    let short_label = out_name + "_short"
    let end_label = out_name + "_end"

    let lhs = load_mutable_value(
        lower_expr_h(ctx, bin.lhs, prefix + "_lhs", idx + 1_usize),
        prefix + "_lhs_load_" + Debug::fmt(idx),)
    if canonical_type(lhs.typ) != "bool" {
        translation_error_at(source_name, line, column,
            "logical-operand-type",
            "logical operator '" + bin.operator + "' expects bool operands",)
    }

    let mut code = lhs.code
    code = code.instr(result_slot + ": bool* = salloc bool")
    if bin.operator == "&&" {
        code = code.instr("cbr " + lhs.value + ", $" + rhs_label + ", $" + short_label)
    } else {
        code = code.instr("cbr " + lhs.value + ", $" + short_label + ", $" + rhs_label)
    }

    code = code.label(short_label)
    let short_value = out_name + "_short_value"
    code = code.instr(short_value + ": bool = capprim " +
        if bin.operator == "&&" {
            "0_u1"
        } else {
            "1_u1"
        }
    )
    code = code.instr("store " + short_value + ", " + result_slot)
    code = code.instr("br $" + end_label)

    code = code.label(rhs_label)
    let rhs = load_mutable_value(
        lower_expr_h_with_hint(ctx, bin.rhs, "bool", prefix + "_rhs", idx + 2_usize),
        prefix + "_rhs_load_" + Debug::fmt(idx),)
    if canonical_type(rhs.typ) != "bool" {
        translation_error_at(source_name, line, column,
            "logical-operand-type",
            "logical operator '" + bin.operator + "' expects bool operands",)
    }
    code = code.append(rhs.code)
    code = code.instr("store " + rhs.value + ", " + result_slot)
    code = code.instr("br $" + end_label)

    code = code.label(end_label)
    code = code.instr(out_name + ": bool = load " + result_slot)
    ret LoweredExpr {
        code, out_name, "bool"
    }
}

fn lower_call_expr(ctx: mut TranslatorContext, call: CallExpr, source_name: str, line: usize, column:
    usize, prefix: str, idx: usize,) -> LoweredExpr {
    ret lower_invocation_expr(ctx, call, source_name, line, column, prefix, idx, false)
}

fn lower_spawn_expr(ctx: mut TranslatorContext, call: CallExpr, source_name: str, line: usize, column:
    usize, prefix: str, idx: usize,) -> LoweredExpr {
    ret lower_invocation_expr(ctx, call, source_name, line, column, prefix, idx, true)
}

fn lower_decorator_target_call(ctx: mut TranslatorContext, call: CallExpr, source_name: str,
    line: usize, column: usize, prefix: str, idx: usize, spawning: bool,) -> LoweredExpr {
    if call.args.len() != 1_usize {
        translation_error_at(source_name, line, column, "invalid-decorator-call",
            "decorator func must be invoked as func(args)",)
    }
    match call.args.get(0_usize) {
        Some(argument) => {
            if expr_path_or_empty(argument) != ctx.decorator_args_name {
                translation_error_at(source_name, line, column, "invalid-decorator-call",
                    "decorator func must receive its compiler args parameter",)
            }
        }
        None => {
        }
    }
    let mut target_args = Vec[ExprNode]::new()
    for name in ctx.decorator_target_params {
        target_args.push(ExprNode {
                Expr::Path(name), line, column, name.len(), source_name
            }
            ,
        )
    }
    // Decorator template nodes retain the decorator definition's source for
    // diagnostics. The synthetic `func(args)` call, however, names a private
    // hidden function in the decorated target's module. Resolve only that
    // compiler call in the target module so cross-package decorators cannot
    // accidentally emit an unmangled, undefined symbol.
    let target_source_name = ctx.decorator_target_source_name
    let target_path = ExprNode < H > {
        Expr::Path(ctx.decorator_target_name), line, column,
        ctx.decorator_target_name.len(), target_source_name
    }
    let target_call = CallExpr {
        target_path, ctx.decorator_target_generics, target_args
    }
    ret lower_invocation_expr(ctx, target_call, target_source_name, line, column, prefix, idx,
        spawning,)
}

fn lower_invocation_expr(ctx: mut TranslatorContext, call: CallExpr, source_name: str, line: usize, column:
    usize, prefix: str, idx: usize, spawning: bool,) -> LoweredExpr {
    let mut callee = expr_h_path_or_empty(call.callee)
    if ctx.decorator_callable_name != "" && callee == ctx.decorator_callable_name {
        ret lower_decorator_target_call(ctx, call, source_name, line, column, prefix, idx, spawning)
    }
    if starts_with(callee, "Self::") && ctx.self_type != "" {
        callee = method_owner_name(ctx.self_type) + "::" + callee.slice(6_usize, callee.len() - 6_usize)
    }
    let callee_base = base_type_name(callee)
    let mut generic_args = call.generics
    if generic_args.len() == 0_usize {
        generic_args = generic_args_from_path(callee)
    }
    let has_explicit_generic_args = generic_args.len() > 0_usize
    let out_name = prefix + "_call_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let mut arg_values = Vec[str]::new()
    let mut arg_types = Vec[str]::new()
    let mut arg_paths = Vec[str]::new()
    let mut arg_frozen_roots = Vec[str]::new()
    let mut arg_is_frozen = Vec[bool]::new()
    let mut arg_borrowed = Vec[bool]::new()
    let mut i = 0_usize

    for arg in call.args {
        let borrowed_arg = expr_is_borrowed_copy(arg)
        let mut hint = ""
        let mut expected = ""
        match ctx_lookup_function_param_for_call(ctx, source_name, callee_base, i,
            generic_args, call.args,) {
            Option[str]::Some(found) => {
                expected = found
                hint = direct_generic_hint(found, generic_args)
            }
            Option[str]::None => {
            }
        }
        let callee_scope = last_scope_index(callee_base)
        if i == 0_usize && callee_scope < callee_base.len() && hint == callee_base.slice(0_usize, callee_scope)
        {
            hint = ""
        }
        if generic_args.len() == 0_usize && is_generic_placeholder(hint) {
            hint = ""
        }
        let arg_path = expr_path_or_empty(arg)
        let frozen_root = expr_frozen_root_path(arg)
        let expects_borrowed = ends_with(canonical_type(expected), "&")
        let mut lowered = if expects_borrowed {
            lower_borrowed_call_argument(ctx, arg,
                prefix + "_arg_borrow_" + Debug::fmt(idx), idx + i + 1_usize,)
        } elif starts_with(hint, "mut ") {
            lower_mutable_call_argument(ctx, arg,
                prefix + "_arg_mut_" + Debug::fmt(idx), idx + i + 1_usize,)
        } else {
            lower_expr_with_hint(ctx, arg, hint,
                prefix + "_arg_" + Debug::fmt(idx), idx + i + 1_usize,)
        }
        let argument_is_frozen_now = ctx_path_is_frozen(ctx, frozen_root) ||
        ctx_value_is_frozen(ctx, lowered.value)
        if starts_with(hint, "mut ") {
            if !starts_with(lowered.typ, "mut ") && !argument_is_frozen_now && !expects_borrowed {
                translation_error_at(
                    arg.source_name,
                    arg.line,
                    arg.column,
                    "mutable-argument-required",
                    "parameter " + Debug::fmt(i + 1_usize) + " of '" + callee_base +
                    "' requires a mutable argument" + if arg_path == "" {
                        ""
                    } else {
                        "; declare '" + arg_path + "' with 'let mut'"
                    }
                    ,
                )
            }
        }
        if !starts_with(hint, "mut ") && !expects_borrowed {
            lowered = load_mutable_value(lowered, prefix + "_arg_load_" + Debug::fmt(idx + i))
        }
        code = code.append(lowered.code)
        if base_type_name(lowered.typ) == "JoinHandle" && arg_path != "" {
            move_var_out_of_context(ctx, arg_path)
        } elif borrowed_arg && !ends_with(canonical_type(expected), "&")
        && !(i == 0_usize && !spawning && ctx_function_borrows_self(ctx, callee_base))
        && ctx_type_needs_ownership(ctx, lowered.typ) {
            code = code.instr("retain " + lowered.value + ": " + lowered.typ)
        }
        arg_values.push(lowered.value)
        arg_types.push(lowered.typ)
        arg_paths.push(arg_path)
        arg_frozen_roots.push(frozen_root)
        arg_is_frozen.push(argument_is_frozen_now)
        arg_borrowed.push(borrowed_arg)
        i = i + 1_usize
    }

    let direct_function = ctx_lookup_function_for_args(ctx, source_name, callee, arg_types)
    let mut dispatch_callee = callee
    let mut matched_return_type = ""
    match direct_function {
        Option[FunctionType]::Some(function) => {
            dispatch_callee = function.emitted_name
            matched_return_type = function.ret_type

            let mut ordinary_region_count = 0_usize
            let mut region_count_index = 0_usize
            while region_count_index < arg_types.len() {
                let region_type = arg_types.get(region_count_index).unwrap_or("")
                if thread_type_is_transferable_region(ctx, region_type) &&
                !function.sending_params.get(region_count_index).unwrap_or(false) &&
                !function.frozen_params.get(region_count_index).unwrap_or(false) {
                    ordinary_region_count += 1_usize
                }
                region_count_index += 1_usize
            }
            let ordinary_regions_connect = ordinary_region_count > 1_usize || function.is_extern
            let mut sending_index = 0_usize
            while sending_index < arg_types.len() {
                let is_sending = function.sending_params.get(sending_index).unwrap_or(false)
                let is_frozen = function.frozen_params.get(sending_index).unwrap_or(false)
                let argument_type = arg_types.get(sending_index).unwrap_or("")
                let argument_path = arg_paths.get(sending_index).unwrap_or("")
                let argument_root = arg_frozen_roots.get(sending_index).unwrap_or("")
                let argument_is_frozen = arg_is_frozen.get(sending_index).unwrap_or(false)
                if is_sending {
                    let consume_path = validate_sending_argument(ctx, argument_type, argument_path,
                        source_name, line, column,)
                    if consume_path {
                        if arg_borrowed.get(sending_index).unwrap_or(false) &&
                        ctx_type_needs_ownership(ctx, argument_type) {
                            let argument_value = arg_values.get(sending_index).unwrap_or("")
                            code = code.instr("drop " + argument_value + ": " + argument_type)
                        }
                        move_var_out_of_context(ctx, argument_path)
                    }
                } elif is_frozen {
                    if !thread_type_is_send(ctx, argument_type, Vec[str]::new()) &&
                    !thread_type_is_freezable_region(ctx, argument_type) {
                        translation_error_at(source_name, line, column, "non-freezable-region",
                            "argument type '" + canonical_type(argument_type) +
                            "' is not a supported immutable region",)
                    }
                    if argument_root != "" {
                        let region = ctx_lookup_var_region(ctx, argument_root)
                        if ctx_region_is_connected(ctx, region) {
                            translation_error_at(source_name, line, column, "connected-region-freeze",
                                "cannot freeze '" + argument_root +
                                "' because its region may be reachable through an unknown call or store",)
                        }
                        ctx_mark_region_frozen(ctx, region)
                    }
                } else {
                    if argument_is_frozen && !thread_type_is_send(ctx, argument_type, Vec[str]::new()) {
                        translation_error_at(source_name, line, column, "frozen-region-escape",
                            "cannot pass frozen region '" + if argument_root == "" {
                                "projection"
                            } else {
                                argument_root
                            }
                            +
                            "' to a parameter that is not declared frozen",)
                    }
                    if spawning && thread_type_is_transferable_region(ctx, argument_type) {
                        translation_error_at(source_name, line, column, "thread-transfer-requires-sending",
                            "argument type '" + canonical_type(argument_type) +
                            "' can cross spawn only through a 'sending' parameter",)
                    }
                    if ordinary_regions_connect && argument_path != "" &&
                    thread_type_is_transferable_region(ctx, argument_type) {
                        ctx_mark_region_connected(ctx, ctx_lookup_var_region(ctx, argument_path))
                    }
                }
                sending_index += 1_usize
            }
        }
        Option[FunctionType]::None => {
            dispatch_callee = resolve_module_function_call(ctx, resolve_static_trait_call(ctx, callee,
                    arg_types,))
        }
    }
    let dispatch_base = base_type_name(dispatch_callee)
    let mut semantic_dispatch_base = dispatch_base
    match direct_function {
        Option[FunctionType]::Some(function) => {
            semantic_dispatch_base = function.name
        }
        Option[FunctionType]::None => {
        }
    }

    if generic_args.len() == 0_usize {
        match direct_function {
            Option[FunctionType]::Some(function) => {
                generic_args = infer_function_generic_args(function, arg_types)
            }
            Option[FunctionType]::None => {
                generic_args = infer_call_generic_args(ctx, semantic_dispatch_base, arg_types)
            }
        }
    }
    if generic_args.len() == 0_usize && semantic_dispatch_base == "enumerate" {
        match arg_types.get(0_usize) {
            Some(iter_type) => {
                generic_args.push(first_generic_type(iter_type))
                generic_args.push(canonical_type(iter_type))
            }
            None => {
            }
        }
    }
    if generic_args.len() == 0_usize && ctx.expression_hint != "" {
        generic_args = infer_call_generic_args_from_return(ctx, semantic_dispatch_base, ctx.expression_hint)
    }
    let mut resolved_generic_args = Vec[str]::new()
    for generic_arg in generic_args {
        resolved_generic_args.push(resolve_async_future_aliases(ctx, source_name, generic_arg))
    }
    generic_args = resolved_generic_args

    if callee == "" {
        translation_error_at(source_name, line, column, "invalid-call-target", "call target must be a function or method path")
        ret LoweredExpr {
            code, out_name, "usize"
        }
    }

    match ctx_enum_variant_owner(ctx, callee) {
        Option[str]::Some(owner) => {
            let mut canonical_owner = resolve_async_future_aliases(ctx, source_name, owner)
            if generic_args_from_path(canonical_owner).len() == 0_usize && ctx.expression_hint != ""
            {
                if base_type_name(ctx.expression_hint) == base_type_name(canonical_owner) {
                    canonical_owner = canonical_type(ctx.expression_hint)
                }
            }
            let variant = enum_variant_name(callee)
            code = code.instr(out_name + ": " + canonical_owner + " = capenum " + canonical_owner + "::"
                + variant + "(" + join_strs(arg_values, ", ") + ")")
            ret LoweredExpr {
                code, out_name, canonical_owner
            }
        }
        Option[str]::None => {
        }
    }

    match direct_function {
        Some(_) => {
        }
        None => {
            match plain_function_argument_error(ctx, source_name, callee, arg_types) {
                Some(message) => {
                    translation_error_at(call.callee.source_name, call.callee.line, call.callee.column,
                        "argument-mismatch", message,)
                }
                None => {
                }
            }
        }
    }

    let mut validate_generics = true
    match direct_function {
        Option[FunctionType]::Some(function) => {
            if function.generics.len() == 0_usize && !has_explicit_generic_args {
                validate_generics = false
            }
        }
        Option[FunctionType]::None => {
        }
    }
    if validate_generics {
        validate_generic_call_bounds(ctx, semantic_dispatch_base, generic_args, source_name, line, column)
    }

    let mut ret_type = "usize"
    let mut emitted_callee = canonical_scoped_name(dispatch_callee)
    if generic_args.len() > 0_usize && find_char(dispatch_callee, "[", 0_usize) >= dispatch_callee.len()
    {
        let mut generic_types = Vec[str]::new()
        for generic in generic_args {
            generic_types.push(canonical_type(generic))
        }
        emitted_callee = emitted_callee + "[" + join_strs(generic_types, ", ") + "]"
    }
    if matched_return_type != "" {
        match direct_function {
            Option[FunctionType]::Some(function) => {
                ret_type = canonical_type(specialize_named_type(matched_return_type, function.generics,
                        generic_args,))
            }
            Option[FunctionType]::None => {
                ret_type = canonical_type(matched_return_type)
            }
        }
    } else {
        match ctx_lookup_function(ctx, dispatch_base) {
            Option[str]::Some(found) => {
                ret_type = canonical_type(found)
            }
            Option[str]::None => {
                ret_type = canonical_type(static_call_return_type(dispatch_callee))
            }
        }
    }
    ret_type = direct_generic_hint(specialize_function_return(ctx, dispatch_base, generic_args, ret_type),
        generic_args,)

    if spawning {
        if ctx_function_is_extern(ctx, dispatch_base) {
            translation_error_at(source_name, line, column, "extern-spawn-target", "spawn target must be an Encore function")
        }
        let mut thread_arg_index = 0_usize
        for arg_type in arg_types {
            if thread_type_is_send(ctx, arg_type, Vec[str]::new()) {
                thread_arg_index += 1_usize
                continue
            }
            let mut crosses_as_sending = false
            let mut crosses_as_frozen = false
            match direct_function {
                Some(function) => {
                    crosses_as_sending = function.sending_params.get(thread_arg_index).unwrap_or(false)
                    crosses_as_frozen = function.frozen_params.get(thread_arg_index).unwrap_or(false)
                }
                None => {
                }
            }
            if !(crosses_as_sending && thread_type_is_transferable_region(ctx, arg_type)) &&
            !(crosses_as_frozen && thread_type_is_freezable_region(ctx, arg_type)) {
                validate_thread_send_type(ctx, arg_type, source_name, line, column, "argument")
            }
            thread_arg_index += 1_usize
        }
        let mut result_is_sending = false
        let mut result_is_frozen = false
        match direct_function {
            Some(function) => {
                result_is_sending = function.returns_sending
                result_is_frozen = function.returns_frozen
            }
            None => {
            }
        }
        if !thread_type_is_send(ctx, ret_type, Vec[str]::new()) &&
        !(result_is_sending && thread_type_is_transferable_region(ctx, ret_type)) &&
        !(result_is_frozen && thread_type_is_freezable_region(ctx, ret_type)) {
            validate_thread_send_type(ctx, ret_type, source_name, line, column, "result")
        }
        let handle_type = "JoinHandle[" + ret_type + "]"
        code = code.instr(out_name + ": " + handle_type + " = call __encore_thread_spawn__" + emitted_callee
            + "(" + join_strs(arg_values, ", ") + ")")
        if result_is_frozen {
            ctx_mark_value_frozen(ctx, out_name)
        }
        ret LoweredExpr {
            code, out_name, handle_type
        }
    }
    code = code.instr(out_name + ": " + ret_type + " = call " + emitted_callee + "(" + join_strs(arg_values,
            ", ",) + ")")
    match direct_function {
        Some(function) => {
            if function.returns_frozen && !thread_type_is_send(ctx, ret_type, Vec[str]::new()) {
                ctx_mark_value_frozen(ctx, out_name)
            }
        }
        None => {
        }
    }
    if ctx_function_is_extern(ctx, dispatch_base) {
        let mut drop_index = 0_usize
        while drop_index < arg_values.len() && drop_index < arg_types.len() {
            match arg_values.get(drop_index) {
                Some(arg_value) => {
                    match arg_types.get(drop_index) {
                        Some(arg_type) => {
                            if ctx_type_needs_ownership(ctx, arg_type) {
                                code = code.instr("drop " + arg_value + ": " + arg_type)
                            }
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            drop_index = drop_index + 1_usize
        }
    }
    ret LoweredExpr {
        code, out_name, ret_type
    }
}

fn ctx_lookup_function_param_for_call(ctx: mut TranslatorContext, source_name: str,
    name: str, wanted: usize, generic_args: Vec[str], args: Vec[ExprNode],) -> Option[str] {
    let base = base_type_name(name)
    let mut resolved = ""
    let mut found = false
    // Function heads already index every overload by its base name. Scanning
    // the complete workspace here made every call argument O(all functions)
    // and repeatedly re-ran module visibility checks.
    let mut encoded = unsafe {
        encore_strmap_get(ctx.function_heads, base)
    }
    while encoded > 0_usize {
        let item_index = encoded - 1_usize
        match ctx.functions.get(item_index) {
            Some(function) => {
                if (function.name == name || function.name == base) &&
                (function.source_name == source_name ||
                    function_visible_from(ctx, source_name, function.source_name,
                        function.name,)) &&
                function.params.len() == args.len() {
                    let mut compatible = true
                    let mut index = 0_usize
                    while index < args.len() {
                        let expected = function.params.get(index).unwrap_or("")
                        let actual = match args.get(index) {
                            Option::Some(argument) => {
                                translator_dispatch_type(ctx, argument)
                            }
                            Option::None => {
                                ""
                            }
                        }
                        if actual != "" && !function_type_matches(expected, actual, function.generics)
                        {
                            match args.get(index) {
                                Option::Some(argument) => {
                                    match argument.value {
                                        Expr::Integer(value) => {
                                            if contains_substring(value, "_") ||
                                            !translator_integer_type(expected) {
                                                compatible = false
                                            }
                                        }
                                        _ => {
                                            compatible = false
                                        }
                                    }
                                }
                                Option::None => {
                                    compatible = false
                                }
                            }
                        }
                        index += 1_usize
                    }
                    if compatible {
                        let candidate = function.params.get(wanted).unwrap_or("")
                        let specialized = specialize_named_type(candidate, function.generics, generic_args)
                        if !found {
                            resolved = specialized
                            found = true
                        } elif resolved != specialized {
                            ret Option[str]::None
                        }
                    }
                }
            }
            None => {
            }
        }
        match ctx.function_next.get(item_index) {
            Some(next) => {
                encoded = next
            }
            None => {
                encoded = 0_usize
            }
        }
    }
    ret if found {
        Option[str]::Some(resolved)
    } else {
        Option[str]::None
    }
}

fn translator_dispatch_type(ctx: mut TranslatorContext, expr: ExprNode) -> str {
    match expr.value {
        Expr::Integer(value) => {
            ret if contains_substring(value, "_") {
                integer_literal_type(value)
            } else {
                ""
            }
        }
        Expr::Float(value) => {
            ret if contains_substring(value, "_") {
                integer_literal_type(value)
            } else {
                ""
            }
        }
        Expr::StringLiteral(_) => {
            ret "str"
        }
        Expr::Boolean(_) => {
            ret "bool"
        }
        Expr::Path(name) => {
            ret ctx_lookup_var(ctx, name).unwrap_or("")
        }
        Expr::Parenthesized(inner) => {
            ret translator_dispatch_type_h(ctx, inner)
        }
        _ => {
        }
    }
    ret ""
}

fn translator_dispatch_type_h(ctx: mut TranslatorContext, expr: ExprNode < H >) -> str {
    match expr.value {
        Expr::Integer(value) => {
            ret if contains_substring(value, "_") {
                integer_literal_type(value)
            } else {
                ""
            }
        }
        Expr::Float(value) => {
            ret if contains_substring(value, "_") {
                integer_literal_type(value)
            } else {
                ""
            }
        }
        Expr::StringLiteral(_) => {
            ret "str"
        }
        Expr::Boolean(_) => {
            ret "bool"
        }
        Expr::Path(name) => {
            ret ctx_lookup_var(ctx, name).unwrap_or("")
        }
        Expr::Field(field_expr) => {
            let owner = translator_dispatch_type_h(ctx, field_expr.base)
            if owner == "" {
                ret ""
            }
            ret ctx_lookup_field(ctx, owner, field_expr.field).unwrap_or("")
        }
        Expr::Index(index_expr) => {
            let owner = translator_dispatch_type_h(ctx, index_expr.base)
            if owner == "" {
                ret ""
            }
            match index_expr.index.value {
                Expr::Integer(raw_index) => {
                    ret ctx_lookup_field(ctx, owner, numeric_literal_value(raw_index)).unwrap_or("")
                }
                _ => {
                    ret ""
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret translator_dispatch_type_h(ctx, inner)
        }
        _ => {
        }
    }
    ret ""
}

fn translator_integer_type(typ: str) -> bool {
    let canonical = canonical_type(typ)
    ret canonical == "u8" || canonical == "u16" || canonical == "u32" ||
    canonical == "u64" || canonical == "u128" || canonical == "usize" ||
    canonical == "i8" || canonical == "i16" || canonical == "i32" ||
    canonical == "i64" || canonical == "i128" || canonical == "isize"
}

fn translator_integer_literal_fits(value: str, typ: str) -> bool {
    let decimal = trim_translator_numeric_zeroes(numeric_literal_value(value))
    let maximum = if typ == "u8" {
        "255"
    } else {
        if typ == "u16" {
            "65535"
        } else {
            if typ == "u32" {
                "4294967295"
            } else {
                if typ == "u64" || typ == "usize" {
                    "18446744073709551615"
                } else {
                    if typ == "u128" {
                        "340282366920938463463374607431768211455"
                    } else {
                        if typ == "i8" {
                            "127"
                        } else {
                            if typ == "i16" {
                                "32767"
                            } else {
                                if typ == "i32" {
                                    "2147483647"
                                } else {
                                    if typ == "i64" || typ == "isize" {
                                        "9223372036854775807"
                                    } else {
                                        if typ == "i128" {
                                            "170141183460469231731687303715884105727"
                                        } else {
                                            ""
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if maximum == "" {
        ret false
    }
    if decimal.len() != maximum.len() {
        ret decimal.len() < maximum.len()
    }
    let mut index = 0_usize
    while index < decimal.len() {
        let actual = decimal.byte_at(index)
        let limit = maximum.byte_at(index)
        if actual < limit {
            ret true
        }
        if actual > limit {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn trim_translator_numeric_zeroes(value: str) -> str {
    let mut start = 0_usize
    while start + 1_usize < value.len() && value.slice(start, 1_usize) == "0" {
        start += 1_usize
    }
    ret value.slice(start, value.len() - start)
}

fn is_generic_placeholder(value: str) -> bool {
    if value.len() != 1_usize {
        ret false
    }
    let first = value.byte_at(0_usize)
    ret first >= 65_u8 && first <= 90_u8
}

fn generic_dispatch_base_name(name: str) -> str {
    let scope = last_scope_index(name)
    if scope >= name.len() {
        ret base_type_name(name)
    }
    let owner = name.slice(0_usize, scope)
    let member = name.slice(scope + 2_usize, name.len() - scope - 2_usize)
    ret base_type_name(owner) + "::" + member
}

fn resolve_static_trait_call(ctx: mut TranslatorContext, callee: str, arg_types: Vec[str]) -> str {
    let scope = find_char(callee, ":", 0_usize)
    if scope >= callee.len() || arg_types.len() == 0_usize {
        ret callee
    }
    let method = callee.slice(scope + 2_usize, callee.len() - scope - 2_usize)
    match arg_types.get(0_usize) {
        Option[str]::Some(first_type) => {
            let candidate = base_type_name(canonical_type(first_type)) + "::" + method
            match ctx_lookup_function(ctx, candidate) {
                Option[str]::Some(_) => {
                    ret candidate
                }
                Option[str]::None => {
                }
            }
        }
        Option[str]::None => {
        }
    }
    ret callee
}

fn resolve_module_function_call(ctx: mut TranslatorContext, callee: str) -> str {
    match ctx_lookup_function(ctx, callee) {
        Option[str]::Some(_) => {
            ret callee
        }
        Option[str]::None => {
        }
    }
    let member = enum_variant_name(callee)
    if member == callee {
        ret callee
    }
    match ctx_lookup_function(ctx, member) {
        Option[str]::Some(_) => {
            ret member
        }
        Option[str]::None => {
        }
    }
    ret callee
}

fn infer_call_generic_args(ctx: mut TranslatorContext, name: str, actual_types: Vec[str]) -> Vec[str]
{
    let mut function_index = ctx.functions.len()
    while function_index > 0_usize {
        function_index = function_index - 1_usize
        match ctx.functions.get(function_index) {
            Some(function) => {
                if function.name == name && function.generics.len() > 0_usize {
                    ret infer_function_generic_args(function, actual_types)
                }
            }
            None => {
            }
        }
    }
    ret Vec[str]::new()
}

fn infer_function_generic_args(function: FunctionType, actual_types: Vec[str]) -> Vec[str] {
    let mut inferred = Vec[str]::new()
    for generic in function.generics {
        let mut found = ""
        let mut index = 0_usize
        while index < function.params.len() && index < actual_types.len() {
            match function.params.get(index) {
                Option[str]::Some(template) => {
                    match actual_types.get(index) {
                        Option[str]::Some(actual) => {
                            found = infer_generic_from_types(template, actual, generic)
                        }
                        Option[str]::None => {
                        }
                    }
                }
                Option[str]::None => {
                }
            }
            index = index + 1_usize
        }
        if found == "" {
            ret Vec[str]::new()
        }
        inferred.push(found)
    }
    ret inferred
}

fn infer_call_generic_args_from_return(ctx: mut TranslatorContext, name: str, actual_return: str) ->
Vec[str] {
    let mut function_index = ctx.functions.len()
    while function_index > 0_usize {
        function_index = function_index - 1_usize
        match ctx.functions.get(function_index) {
            Some(function) => {
                if function.name == name && function.generics.len() > 0_usize {
                    let mut inferred = Vec[str]::new()
                    for generic in function.generics {
                        let found = infer_generic_from_types(function.ret_type, actual_return, generic)
                        if found == "" {
                            ret Vec[str]::new()
                        }
                        inferred.push(found)
                    }
                    ret inferred
                }
            }
            None => {
            }
        }
    }
    ret Vec[str]::new()
}

fn infer_generic_from_types(template: str, actual: str, generic: str) -> str {
    let canonical_template = canonical_type(template)
    let canonical_actual = canonical_type(actual)
    if canonical_template == generic {
        ret canonical_actual
    }
    if base_type_name(canonical_template) != base_type_name(canonical_actual) {
        ret ""
    }
    let template_args = generic_args_from_path(canonical_template)
    let actual_args = generic_args_from_path(canonical_actual)
    let mut index = 0_usize
    while index < template_args.len() && index < actual_args.len() {
        match template_args.get(index) {
            Some(template_arg) => {
                match actual_args.get(index) {
                    Some(actual_arg) => {
                        let found = infer_generic_from_types(template_arg, actual_arg, generic)
                        if found != "" {
                            ret found
                        }
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret ""
}

fn load_mutable_value(value: LoweredExpr, out_name: str) -> LoweredExpr {
    if !starts_with(value.typ, "mut ") {
        ret value
    }
    let typ = value_type_name(value.typ)
    let code = value.code.instr(out_name + ": " + typ + " = load " + value.value)
    ret LoweredExpr {
        code, out_name, typ
    }
}

fn generic_args_from_path(path: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let open = find_char(path, "[", 0_usize)
    if open >= path.len() {
        ret out
    }
    let mut close = open + 1_usize
    let mut bracket_depth = 1_usize
    while close < path.len() && bracket_depth > 0_usize {
        let ch = path.slice(close, 1_usize)
        if ch == "[" {
            bracket_depth += 1_usize
        } elif ch == "]" {
            bracket_depth -= 1_usize
        }
        close += 1_usize
    }
    if bracket_depth != 0_usize {
        ret out
    }
    let inner = path.slice(open + 1_usize, close - open - 2_usize)
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut tuple_depth = 0_usize
    let mut index = 0_usize
    while index < inner.len() {
        let ch = inner.slice(index, 1_usize)
        if ch == "[" {
            depth = depth + 1_usize
        } elif ch == "]" && depth > 0_usize {
            depth = depth - 1_usize
        } elif ch == "(" {
            tuple_depth += 1_usize
        } elif ch == ")" && tuple_depth > 0_usize {
            tuple_depth -= 1_usize
        } elif ch == "," && depth == 0_usize && tuple_depth == 0_usize {
            out.push(canonical_type(trim_spaces(inner.slice(start, index - start))))
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    if start < inner.len() {
        out.push(canonical_type(trim_spaces(inner.slice(start, inner.len() - start))))
    }
    ret out
}

fn direct_generic_hint(typ: str, args: Vec[str]) -> str {
    if typ.len() == 1_usize && args.len() == 1_usize {
        let first = typ.byte_at(0_usize)
        if first >= 65_u8 && first <= 90_u8 {
            match args.get(0_usize) {
                Option[str]::Some(arg_type) => {
                    ret canonical_type(arg_type)
                }
                Option[str]::None => {
                }
            }
        }
    }
    ret typ
}

fn lower_expr_with_hint(ctx: mut TranslatorContext, expr: ExprNode, hint: str, prefix: str, idx: usize)
-> LoweredExpr {
    if hint != "" {
        match expr.value {
            Expr::Integer(value) => {
                let typ = canonical_type(hint)
                if !contains_substring(value, "_") && translator_integer_type(typ) &&
                !translator_integer_literal_fits(value, typ) {
                    translation_error_at(expr.source_name, expr.line, expr.column,
                        "integer-literal-out-of-range",
                        "integer literal '" + value + "' is outside the range of type '" + typ + "'",)
                }
                ret lower_integer_literal(value, typ, prefix, idx)
            }
            Expr::Float(value) => {
                ret lower_float_literal(value, canonical_type(hint), prefix, idx)
            }
            _ => {
            }
        }
    }
    let previous_hint = ctx.expression_hint
    if hint != "" {
        ctx.expression_hint = canonical_type(hint)
    }
    let lowered = lower_expr(ctx, expr, prefix, idx)
    ctx.expression_hint = previous_hint
    ret lowered
}

fn lower_expr_h_with_hint(ctx: mut TranslatorContext, expr: ExprNode < H >, hint: str, prefix: str, idx:
    usize,) -> LoweredExpr {
    if hint != "" {
        match expr.value {
            Expr::Integer(value) => {
                let typ = canonical_type(hint)
                if !contains_substring(value, "_") && translator_integer_type(typ) &&
                !translator_integer_literal_fits(value, typ) {
                    translation_error_at(expr.source_name, expr.line, expr.column,
                        "integer-literal-out-of-range",
                        "integer literal '" + value + "' is outside the range of type '" + typ + "'",)
                }
                ret lower_integer_literal(value, typ, prefix, idx)
            }
            Expr::Float(value) => {
                ret lower_float_literal(value, canonical_type(hint), prefix, idx)
            }
            Expr::Unary(unary) => {
                if unary.operator == "-" {
                    match unary.expr.value {
                        Expr::Integer(value) => {
                            let typ = canonical_type(hint)
                            let operand = lower_integer_literal(value, typ, prefix + "_unary_operand",
                                idx + 1_usize,)
                            let zero_name = prefix + "_unary_zero_" + Debug::fmt(idx)
                            let out_name = prefix + "_unary_" + Debug::fmt(idx)
                            let mut code = operand.code
                            code = code.instr(zero_name + ": " + typ + " = capprim " + with_numeric_suffix("0",
                                    typ,))
                            code = code.instr(out_name + ": " + typ + " = sub " + zero_name + ", " +
                                operand.value)
                            ret LoweredExpr {
                                code, out_name, typ
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    let previous_hint = ctx.expression_hint
    if hint != "" {
        ctx.expression_hint = canonical_type(hint)
    }
    let lowered = lower_expr_h(ctx, expr, prefix, idx)
    ctx.expression_hint = previous_hint
    ret lowered
}

fn lower_integer_literal(value: str, typ: str, prefix: str, idx: usize) -> LoweredExpr {
    let name = prefix + "_int_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(value, typ))
    ret LoweredExpr {
        code, name, typ
    }
}

fn lower_float_literal(value: str, typ: str, prefix: str, idx: usize) -> LoweredExpr {
    let name = prefix + "_float_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(value, typ))
    ret LoweredExpr {
        code, name, typ
    }
}

fn static_call_return_type(callee: str) -> str {
    if callee == "Debug::fmt" {
        ret "str"
    }
    if ends_with(callee, "::new") {
        let owner = callee.slice(0_usize, callee.len() - 5_usize)
        if method_owner_name(owner) == "Vec" {
            ret owner
        }
        ret owner
    }
    if ends_with(callee, "::with_capacity") {
        let owner = callee.slice(0_usize, callee.len() - 15_usize)
        ret owner
    }
    if ends_with(callee, "::singleton") {
        let owner = callee.slice(0_usize, callee.len() - 11_usize)
        ret owner
    }
    ret "usize"
}

fn lower_struct_init_expr(ctx: mut TranslatorContext, init_expr: StructInitExpr, source_name: str, prefix: str, idx: usize)
-> LoweredExpr {
    let out_name = prefix + "_struct_" + Debug::fmt(idx)
    let struct_type = qualified_type_for_source(ctx, source_name,
        self_context_type(ctx, canonical_type(init_expr.path)),)
    let mut code = EhirTextBuilder::new()
    let mut values = Vec[str]::new()
    let mut i = 0_usize
    for item in init_expr.values {
        let borrowed_item = expr_is_borrowed_copy(item)
        let mut field_hint = ""
        match ctx_lookup_field_at_position(ctx, struct_type, Debug::fmt(i)) {
            Some(found) => {
                field_hint = canonical_type(found)
            }
            None => {
            }
        }
        let lowered = lower_expr_with_hint(ctx, item, field_hint, prefix + "_struct_" + Debug::fmt(idx)
            + "_field", i,)
        code = code.append(lowered.code)
        if borrowed_item && ctx_type_needs_ownership(ctx, lowered.typ) {
            code = code.instr("retain " + lowered.value + ": " + lowered.typ)
        }
        values.push(lowered.value)
        i = i + 1_usize
    }
    code = code.instr(out_name + ": " + struct_type + " = capstruct " + struct_type + "(" + join_strs(values,
            ", ",) + ")")
    ret LoweredExpr {
        code, out_name, struct_type
    }
}

fn lower_tuple_literal_expr(ctx: mut TranslatorContext, tuple_expr: TupleLiteralExpr, prefix: str, idx:
    usize,) -> LoweredExpr {
    let out_name = prefix + "_tuple_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let mut values = Vec[str]::new()
    let mut types = Vec[str]::new()
    let mut i = 0_usize
    for item in tuple_expr.items {
        let borrowed_item = expr_is_borrowed_copy(item)
        let lowered = lower_expr(ctx, item, prefix + "_tuple_item", idx + i + 1_usize)
        code = code.append(lowered.code)
        if borrowed_item && ctx_type_needs_ownership(ctx, lowered.typ) {
            code = code.instr("retain " + lowered.value + ": " + lowered.typ)
        }
        values.push(lowered.value)
        types.push(canonical_type(lowered.typ))
        i = i + 1_usize
    }

    if types.len() == 0_usize {
        ret LoweredExpr {
            code, "void", "()"
        }
    }

    let tuple_type = "__tuple_" + Debug::fmt(types.len()) + "[" + join_strs(types, ", ") + "]"
    code = code.instr(out_name + ": " + tuple_type + " = capstruct " + tuple_type + "(" + join_strs(values,
            ", ",) + ")")
    ret LoweredExpr {
        code, out_name, tuple_type
    }
}

fn lower_array_literal_expr(ctx: mut TranslatorContext, array_expr: ArrayLiteralExpr, source_name: str,
    line: usize, column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let out_name = prefix + "_array_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let mut values = Vec[str]::new()
    let mut item_type = "void"
    let mut count = 0_usize
    for item in array_expr.items {
        let lowered = lower_expr(ctx, item, prefix + "_array_item", idx + count + 1_usize)
        code = code.append(lowered.code)
        values.push(lowered.value)
        if count == 0_usize {
            item_type = canonical_type(lowered.typ)
        }
        count = count + 1_usize
    }
    if count == 0_usize {
        translation_error_at(source_name, line, column, "cannot-infer-empty-array", "cannot infer the element type of an empty array; add a type annotation")
    }
    let array_type = "__array_" + Debug::fmt(count) + "[" + item_type + "]"
    code = code.instr(out_name + ": " + array_type + " = capstruct " + array_type + "(" + join_strs(values,
            ", ",) + ")")
    ret LoweredExpr {
        code, out_name, array_type
    }
}

fn lower_vec_literal_expr(ctx: mut TranslatorContext, vec_expr: ArrayLiteralExpr, source_name: str, line:
    usize, column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    if vec_expr.items.len() == 0_usize {
        translation_error_at(source_name, line, column, "cannot-infer-empty-vec", "cannot infer the element type of an empty vec! literal; add a type annotation")
    }
    let mut code = EhirTextBuilder::new()
    let mut values = Vec[str]::new()
    let mut item_type = "void"
    let mut item_index = 0_usize
    for item in vec_expr.items {
        let lowered = lower_expr(ctx, item, prefix + "_vec_item", idx + item_index + 1_usize)
        code = code.append(lowered.code)
        if item_index == 0_usize {
            item_type = canonical_type(lowered.typ)
        }
        values.push(lowered.value)
        item_index = item_index + 1_usize
    }
    let vec_type = "Vec[" + item_type + "]"
    let initial = prefix + "_vec_initial_" + Debug::fmt(idx)
    let storage = prefix + "_vec_storage_" + Debug::fmt(idx)
    let out_name = prefix + "_vec_" + Debug::fmt(idx)
    code = code.instr(initial + ": " + vec_type + " = call Vec::new[" + item_type + "]()")
    code = code.instr(storage + ": " + vec_type + "* = salloc " + vec_type)
    code = code.instr("store " + initial + ", " + storage)
    let mut push_index = 0_usize
    for value in values {
        code = code.instr(prefix + "_vec_push_" + Debug::fmt(idx) + "_" + Debug::fmt(push_index) + ": () = call Vec::push["
            + item_type + "](" + storage + ", " + value + ")")
        push_index = push_index + 1_usize
    }
    code = code.instr(out_name + ": " + vec_type + " = load " + storage)
    ret LoweredExpr {
        code, out_name, vec_type
    }
}

fn lower_array_repeat_expr(ctx: mut TranslatorContext, repeat_expr: ArrayRepeatExpr, prefix: str, idx:
    usize,) -> LoweredExpr {
    let item = lower_expr_h(ctx, repeat_expr.value, prefix + "_array_repeat_item", idx + 1_usize)
    let count = decimal_usize(numeric_literal_value(repeat_expr.size))
    let mut values = Vec[str]::new()
    let mut index = 0_usize
    while index < count {
        values.push(item.value)
        index = index + 1_usize
    }
    let array_type = "__array_" + Debug::fmt(count) + "[" + canonical_type(item.typ) + "]"
    let out_name = prefix + "_array_repeat_" + Debug::fmt(idx)
    let mut code = item.code
    code = code.instr(out_name + ": " + array_type + " = capstruct " + array_type + "(" + join_strs(values,
            ", ",) + ")")
    ret LoweredExpr {
        code, out_name, array_type
    }
}

fn lower_field_expr(ctx: mut TranslatorContext, field_expr: FieldExpr, source_name: str, line: usize,
    column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let base_path = expr_h_path_or_empty(field_expr.base)
    let mut borrowed_mutable_type = ""
    if base_path != "" {
        match ctx_lookup_var(ctx, base_path) {
            Some(found) => {
                if starts_with(found, "mut ") && ends_with(canonical_type(found), "&") {
                    borrowed_mutable_type = found
                }
            }
            None => {
            }
        }
    }
    let base = if borrowed_mutable_type != "" {
        LoweredExpr {
            EhirTextBuilder::new(), ctx_lookup_value_name(ctx, base_path),
            borrowed_mutable_type.slice(4_usize, borrowed_mutable_type.len() - 4_usize)
        }
    } else {
        lower_expr_h(ctx, field_expr.base, prefix + "_field_base", idx + 1_usize)
    }
    let base_is_frozen = ctx_path_is_frozen(ctx, base_path) || ctx_value_is_frozen(ctx, base.value)
    let mut field_type = "void"
    match ctx_lookup_field(ctx, base.typ, field_expr.field) {
        Option[str]::Some(found) => {
            field_type = canonical_type(found)
        }
        Option[str]::None => {
            translation_error_at(source_name, line, column, "unknown-field", "type '" + base.typ + "' has no field '"
                + field_expr.field + "'",)
        }
    }
    let out_name = prefix + "_field_" + Debug::fmt(idx)
    let mut code = base.code
    code = code.instr(out_name + ": " + field_type + " = getfield " + base.value + " > " + ctx_lookup_field_index(ctx,
            base.typ, field_expr.field,))
    if base_is_frozen && !thread_type_is_send(ctx, field_type, Vec[str]::new()) {
        ctx_mark_value_frozen(ctx, out_name)
    }
    ret LoweredExpr {
        code, out_name, field_type
    }
}

fn lower_index_expr(ctx: mut TranslatorContext, index_expr: IndexExpr, source_name: str, line: usize,
    column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let base_path = expr_h_path_or_empty(index_expr.base)
    let base = lower_expr_h(ctx, index_expr.base, prefix + "_index_base", idx + 1_usize)
    let base_is_frozen = ctx_path_is_frozen(ctx, base_path) || ctx_value_is_frozen(ctx, base.value)
    let mut field = ""
    match index_expr.index.value {
        Expr::Integer(raw_index) => {
            field = numeric_literal_value(raw_index)
        }
        _ => {
            translation_error_at(source_name, line, column, "unsupported-index", "only constant integer indexing is currently supported")
        }
    }
    let mut field_type = "void"
    match ctx_lookup_field(ctx, base.typ, field) {
        Option[str]::Some(found) => {
            field_type = canonical_type(found)
        }
        Option[str]::None => {
            translation_error_at(source_name, line, column, "invalid-index", "type '" + base.typ + "' has no index '"
                + field + "'",)
        }
    }

    let out_name = prefix + "_index_" + Debug::fmt(idx)
    let mut code = base.code
    code = code.instr(out_name + ": " + field_type + " = getfield " + base.value + " > " + field)
    if base_is_frozen && !thread_type_is_send(ctx, field_type, Vec[str]::new()) {
        ctx_mark_value_frozen(ctx, out_name)
    }
    ret LoweredExpr {
        code, out_name, field_type
    }
}

fn lower_method_call_expr(ctx: mut TranslatorContext, method_call: MethodCallExpr, source_name: str,
    line: usize, column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let receiver_path = expr_h_path_or_empty(method_call.receiver)
    let receiver_root = expr_h_frozen_root_path(method_call.receiver)
    let receiver = lower_method_receiver(ctx, method_call.receiver, prefix + "_recv", idx + 1_usize)
    if base_type_name(receiver.typ) == "JoinHandle" && method_call.method == "join" {
        if method_call.args.len() != 0_usize || method_call.generics.len() != 0_usize {
            translation_error_at(source_name, line, column, "invalid-join-call", "JoinHandle::join takes no arguments")
        }
        let output_type = first_generic_type(receiver.typ)
        let out_name = prefix + "_join_" + Debug::fmt(idx)
        let mut code = receiver.code
        // A projected handle is still owned by its aggregate. The join
        // intrinsic releases the consumed handle, so retain one temporary
        // reference and let the aggregate's normal destructor release the
        // original ownership later. Direct local handles are moved normally.
        if receiver_path == "" && expr_h_is_borrowed_copy(method_call.receiver) {
            code = code.instr("retain " + receiver.value + ": " + receiver.typ)
        }
        code = code.instr(out_name + ": " + output_type + " = call __encore_thread_join(" + receiver.value
            + ")")
        if ctx_value_is_frozen(ctx, receiver.value) &&
        !thread_type_is_send(ctx, output_type, Vec[str]::new()) {
            ctx_mark_value_frozen(ctx, out_name)
        }
        move_var_out_of_context(ctx, receiver_path)
        ret LoweredExpr {
            code, out_name, output_type
        }
    }
    if base_type_name(receiver.typ) == "JoinHandle" && method_call.method == "is_finished" {
        if method_call.args.len() != 0_usize || method_call.generics.len() != 0_usize {
            translation_error_at(source_name, line, column, "invalid-thread-poll-call",
                "JoinHandle::is_finished takes no arguments",)
        }
        let token_name = prefix + "_thread_token_" + Debug::fmt(idx)
        let out_name = prefix + "_thread_finished_" + Debug::fmt(idx)
        let mut code = receiver.code
        code = code.instr(token_name + ": usize = getfield " + receiver.value + " > 0")
        code = code.instr(out_name + ": bool = call encore_thread_is_finished(" + token_name + ")")
        ret LoweredExpr {
            code, out_name, "bool"
        }
    }
    let borrowed_receiver = expr_h_is_borrowed_copy(method_call.receiver)
    let mut owner = method_owner_name(value_type_name(receiver.typ))
    if starts_with(receiver.typ, "dyn ") {
        owner = receiver.typ.slice(4_usize, receiver.typ.len() - 4_usize)
    }
    if owner == "Self" && ctx.self_type != "" {
        owner = method_owner_name(ctx.self_type)
    }
    let receiver_is_frozen = ctx_path_is_frozen(ctx, receiver_root) ||
    ctx_value_is_frozen(ctx, receiver.value)
    let fn_name = owner + "::" + method_call.method
    let mut concrete_generics = generic_args_from_path(receiver.typ)
    for generic in method_call.generics {
        concrete_generics.push(canonical_type(generic))
    }
    let mut ret_type = "void"
    match ctx_lookup_function(ctx, fn_name) {
        Option[str]::Some(found) => {
            ret_type = canonical_type(found)
        }
        Option[str]::None => {
            match generic_bound_method_return(ctx, owner, method_call.method) {
                Some(found) => {
                    ret_type = canonical_type(found)
                }
                None => {
                    if starts_with(receiver.typ, "dyn ") {
                        match ctx_lookup_method_return(ctx, method_call.method) {
                            Some(found) => {
                                ret_type = canonical_type(found)
                            }
                            None => {
                                ret_type = canonical_type(method_return_type(receiver.typ, method_call.method,
                                        source_name, line, column,))
                            }
                        }
                    } elif receiver.typ == "Iter" && method_call.method == "next" {
                        ret_type = "__tuple_2[Iter, Option[T]]"
                    } else {
                        ret_type = canonical_type(method_return_type(receiver.typ, method_call.method,
                                source_name, line, column,))
                    }
                }
            }
        }
    }
    ret_type = direct_generic_hint(specialize_function_return(ctx, fn_name, concrete_generics, ret_type),
        concrete_generics,)
    let out_name = prefix + "_method_" + Debug::fmt(idx)
    let mut code = receiver.code
    let mut args = Vec[str]::new()
    let mut capability_types = Vec[str]::new()
    let mut capability_paths = Vec[str]::new()
    let mut capability_roots = Vec[str]::new()
    let mut capability_frozen = Vec[bool]::new()
    let mut capability_borrowed = Vec[bool]::new()
    let mut receiver_value = receiver.value
    let mut receiver_was_loaded = false
    let mut receiver_uses_temporary_storage = false
    let mut receiver_expects_borrow = false
    let receiver_value_type = value_type_name(receiver.typ)
    let mut receiver_param = ctx_lookup_function_param(ctx, source_name, fn_name, 0_usize, concrete_generics)
    match receiver_param {
        None => {
            receiver_param = generic_bound_method_param(ctx, owner, method_call.method, 0_usize)
        }
        Some(_) => {
        }
    }
    match receiver_param {
        Option[str]::Some(expected_self) => {
            receiver_expects_borrow = ends_with(canonical_type(expected_self), "&")
            if receiver_expects_borrow {
                let mut concrete_receiver_type = canonical_type(receiver.typ)
                if starts_with(concrete_receiver_type, "mut ") {
                    concrete_receiver_type = concrete_receiver_type.slice(4_usize,
                        concrete_receiver_type.len() - 4_usize,)
                }
                if !is_node_handle_type_text(concrete_receiver_type) {
                    translation_error_at(source_name, line, column, "node-handle-required",
                        "method '" + method_call.method + "' requires an owning node receiver; construct '"
                        +
                        base_type_name(concrete_receiver_type) + "<S>' or '" +
                        base_type_name(concrete_receiver_type) + "<H>' explicitly",)
                }
                if starts_with(receiver.typ, "mut ") &&
                !ends_with(canonical_type(receiver.typ), "&") {
                    let loaded_receiver = prefix + "_recv_node_load_" + Debug::fmt(idx)
                    code = code.instr(loaded_receiver + ": " + concrete_receiver_type +
                        " = load " + receiver.value)
                    receiver_value = loaded_receiver
                    receiver_was_loaded = true
                }
                if borrowed_receiver {
                    code = code.instr("retain " + receiver_value + ": " + concrete_receiver_type)
                }
                if !ends_with(concrete_receiver_type, "&") {
                    let erased_receiver = prefix + "_recv_node_any_" + Debug::fmt(idx)
                    let erased_type = value_type_name(concrete_receiver_type) + "&"
                    code = code.instr(erased_receiver + ": " + erased_type + " = pcast " +
                        receiver_value + ": " + concrete_receiver_type + ", " + erased_type,)
                    receiver_value = erased_receiver
                }
            } elif starts_with(receiver.typ, "mut ") && !starts_with(expected_self, "mut ") {
                let loaded_name = prefix + "_recv_load_" + Debug::fmt(idx)
                code = code.instr(loaded_name + ": " + expected_self + " = load " + receiver.value)
                receiver_value = loaded_name
                receiver_was_loaded = true
            } elif starts_with(expected_self, "mut ") && !starts_with(receiver.typ, "mut ") {
                if !receiver_is_frozen &&(receiver_path != "" || receiver_root != "") {
                    translation_error_at(source_name, line, column, "mutable-receiver-required", "method '"
                        + method_call.method + "' requires a mutable receiver",)
                }
                let storage_name = prefix + "_recv_storage_" + Debug::fmt(idx)
                code = code.instr(storage_name + ": " + receiver.typ + "* = salloc " + receiver.typ)
                code = code.instr("store " + receiver.value + ", " + storage_name)
                // The receiver's owned value is moved into the temporary
                // mutable slot.  Its single cleanup below releases that
                // ownership after the call.  Dropping the SSA value here as
                // well releases the same root twice (most visibly when the
                // receiver was loaded from an owned aggregate field).
                receiver_value = storage_name
                receiver_uses_temporary_storage = true
            }
        }
        Option[str]::None => {
            // Built-in value methods (notably str methods) do not always
            // have a source-level function signature in the context. A field
            // reached through a mutable aggregate is still a pointer and
            // must be loaded before calling a value method.
            if starts_with(receiver.typ, "mut ") {
                let loaded_name = prefix + "_recv_load_" + Debug::fmt(idx)
                code = code.instr(loaded_name + ": " + value_type_name(receiver.typ) + " = load " + receiver.value)
                receiver_value = loaded_name
                receiver_was_loaded = true
            }
        }
    }
    if borrowed_receiver && !receiver_expects_borrow &&
    !ctx_function_borrows_self(ctx, fn_name) && !receiver_uses_temporary_storage
    &&(receiver_was_loaded || !starts_with(receiver.typ, "mut ")) && ctx_type_needs_ownership(ctx, receiver_value_type)
    {
        code = code.instr("retain " + receiver_value + ": " + receiver_value_type)
    }
    args.push(receiver_value)
    capability_types.push(receiver.typ)
    capability_paths.push(receiver_path)
    capability_roots.push(receiver_root)
    capability_frozen.push(receiver_is_frozen)
    capability_borrowed.push(borrowed_receiver)

    let mut i = 0_usize
    for arg in method_call.args {
        let borrowed_arg = expr_is_borrowed_copy(arg)
        let arg_path = expr_path_or_empty(arg)
        let frozen_root = expr_frozen_root_path(arg)
        let mut expected = ""
        match ctx_lookup_function_param(ctx, source_name, fn_name, i + 1_usize, concrete_generics) {
            Some(found) => {
                expected = found
            }
            None => {
            }
        }
        let lowered = if ends_with(canonical_type(expected), "&") {
            lower_borrowed_call_argument(ctx, arg,
                prefix + "_method_arg_borrow_" + Debug::fmt(idx), idx + i + 2_usize,)
        } elif starts_with(expected, "mut ") {
            lower_mutable_call_argument(ctx, arg,
                prefix + "_method_arg_mut_" + Debug::fmt(idx), idx + i + 2_usize,)
        } else {
            lower_expr_with_hint(ctx, arg, expected,
                prefix + "_method_arg_" + Debug::fmt(idx), idx + i + 2_usize,)
        }
        let argument_is_frozen_now = ctx_path_is_frozen(ctx, frozen_root) ||
        ctx_value_is_frozen(ctx, lowered.value)
        if starts_with(expected, "mut ") && !starts_with(lowered.typ, "mut ") &&
        !argument_is_frozen_now && !ends_with(canonical_type(expected), "&") {
            translation_error_at(
                arg.source_name,
                arg.line,
                arg.column,
                "mutable-argument-required",
                "parameter " + Debug::fmt(i + 1_usize) + " of method '" +
                method_call.method + "' requires a mutable argument" +
                if arg_path == "" {
                    ""
                } else {
                    "; declare '" + arg_path + "' with 'let mut'"
                }
                ,
            )
        }
        code = code.append(lowered.code)
        if borrowed_arg && !starts_with(lowered.typ, "mut ") &&
        !ends_with(canonical_type(expected), "&") && ctx_type_needs_ownership(ctx, lowered.typ)
        {
            code = code.instr("retain " + lowered.value + ": " + lowered.typ)
        }
        args.push(lowered.value)
        capability_types.push(lowered.typ)
        capability_paths.push(arg_path)
        capability_roots.push(frozen_root)
        capability_frozen.push(argument_is_frozen_now)
        capability_borrowed.push(borrowed_arg)
        i = i + 1_usize
    }

    match ctx_lookup_function_for_args(ctx, source_name, fn_name, capability_types) {
        Some(function) => {
            if receiver_is_frozen && !function.readonly_self {
                translation_error_at(source_name, line, column, "frozen-region-mutation",
                    "method '" + method_call.method + "' is not available through frozen region '" +
                    receiver_root + "'; use an immutable self receiver for read-only methods",)
            }
            let mut ordinary_region_count = 0_usize
            let mut region_count_index = 0_usize
            while region_count_index < capability_types.len() {
                let region_type = capability_types.get(region_count_index).unwrap_or("")
                let region_path = capability_paths.get(region_count_index).unwrap_or("")
                let is_readonly_receiver = region_count_index == 0_usize && function.readonly_self
                if region_path != "" && thread_type_is_transferable_region(ctx, region_type) &&
                !is_readonly_receiver &&
                !function.sending_params.get(region_count_index).unwrap_or(false) &&
                !function.frozen_params.get(region_count_index).unwrap_or(false) {
                    ordinary_region_count += 1_usize
                }
                region_count_index += 1_usize
            }
            let unknown_regions_connect = function.is_extern
            let ordinary_regions_merge = ordinary_region_count > 1_usize && !unknown_regions_connect
            let mut capability_index = 1_usize
            while capability_index < capability_types.len() {
                let argument_type = capability_types.get(capability_index).unwrap_or("")
                let argument_path = capability_paths.get(capability_index).unwrap_or("")
                let argument_root = capability_roots.get(capability_index).unwrap_or("")
                let argument_is_frozen = capability_frozen.get(capability_index).unwrap_or(false)
                let is_sending = function.sending_params.get(capability_index).unwrap_or(false)
                let is_frozen = function.frozen_params.get(capability_index).unwrap_or(false)
                if is_sending {
                    let consume_path = validate_sending_argument(ctx, argument_type, argument_path,
                        source_name, line, column,)
                    if consume_path {
                        if capability_borrowed.get(capability_index).unwrap_or(false) &&
                        ctx_type_needs_ownership(ctx, argument_type) {
                            let argument_value = args.get(capability_index).unwrap_or("")
                            code = code.instr("drop " + argument_value + ": " + argument_type)
                        }
                        move_var_out_of_context(ctx, argument_path)
                    }
                } elif is_frozen {
                    if !thread_type_is_send(ctx, argument_type, Vec[str]::new()) &&
                    !thread_type_is_freezable_region(ctx, argument_type) {
                        translation_error_at(source_name, line, column, "non-freezable-region",
                            "argument type '" + canonical_type(argument_type) +
                            "' is not a supported immutable region",)
                    }
                    if argument_root != "" {
                        let region = ctx_lookup_var_region(ctx, argument_root)
                        if ctx_region_is_connected(ctx, region) {
                            translation_error_at(source_name, line, column, "connected-region-freeze",
                                "cannot freeze '" + argument_root +
                                "' because its region may be reachable through an unknown call or store",)
                        }
                        ctx_mark_region_frozen(ctx, region)
                    }
                } elif argument_is_frozen &&
                !thread_type_is_send(ctx, argument_type, Vec[str]::new()) {
                    translation_error_at(source_name, line, column, "frozen-region-escape",
                        "cannot pass frozen region '" + if argument_root == "" {
                            "projection"
                        } else {
                            argument_root
                        }
                        + "' to a method parameter that is not declared frozen",)
                } elif unknown_regions_connect && argument_path != "" &&
                thread_type_is_transferable_region(ctx, argument_type) {
                    ctx_mark_region_connected(ctx, ctx_lookup_var_region(ctx, argument_path))
                }
                capability_index += 1_usize
            }
            if unknown_regions_connect && !function.readonly_self && receiver_path != "" &&
            thread_type_is_transferable_region(ctx, receiver.typ) {
                ctx_mark_region_connected(ctx, ctx_lookup_var_region(ctx, receiver_path))
            }
            if ordinary_regions_merge {
                let mut merged_region = 0_usize
                let mut merge_index = 0_usize
                while merge_index < capability_types.len() {
                    let merge_type = capability_types.get(merge_index).unwrap_or("")
                    let merge_path = capability_paths.get(merge_index).unwrap_or("")
                    let is_readonly_receiver = merge_index == 0_usize && function.readonly_self
                    if merge_path != "" && !is_readonly_receiver &&
                    thread_type_is_transferable_region(ctx, merge_type) &&
                    !function.sending_params.get(merge_index).unwrap_or(false) &&
                    !function.frozen_params.get(merge_index).unwrap_or(false) {
                        merged_region = ctx_merge_regions(ctx, merged_region,
                            ctx_lookup_var_region(ctx, merge_path),)
                    }
                    merge_index += 1_usize
                }
            }
        }
        None => {
            if receiver_is_frozen {
                translation_error_at(source_name, line, column, "frozen-region-mutation",
                    "cannot prove method '" + method_call.method +
                    "' read-only for frozen receiver '" + receiver_root + "'",)
            }
        }
    }

    validate_generic_call_bounds(ctx, fn_name, concrete_generics, source_name, line, column)

    let mut emitted_name = fn_name
    if concrete_generics.len() > 0_usize {
        emitted_name = emitted_name + "[" + join_strs(concrete_generics, ", ") + "]"
    }
    code = code.instr(out_name + ": " + ret_type + " = call " + emitted_name + "(" + join_strs(args,
            ", ",) + ")")
    if receiver_is_frozen && !thread_type_is_send(ctx, ret_type, Vec[str]::new()) {
        ctx_mark_value_frozen(ctx, out_name)
    }
    if receiver_uses_temporary_storage && ctx_type_needs_ownership(ctx, receiver_value_type) {
        let cleanup_name = prefix + "_recv_cleanup_" + Debug::fmt(idx)
        code = code.instr(cleanup_name + ": " + receiver_value_type + " = load " + receiver_value)
        code = code.instr("drop " + cleanup_name + ": " + receiver_value_type)
    }
    ret LoweredExpr {
        code, out_name, ret_type
    }
}

fn generic_bound_method_return(ctx: mut TranslatorContext, owner: str, method: str) -> Option[str] {
    for generic in ctx.active_generics {
        if generic.name == owner {
            for bound in generic.bounds {
                let trait_name = base_type_name(bound.path)
                match trait_method_contract(ctx, trait_name, method) {
                    Some(function) => {
                        let mut specialized = replace_type_token(function.ret_type, trait_name, owner)
                        match lookup_trait(ctx, trait_name) {
                            Some(contract) => {
                                specialized = specialize_named_type(specialized, generic_param_names(contract.generics),
                                    bound.args,)
                            }
                            None => {
                            }
                        }
                        ret Option[str]::Some(specialized)
                    }
                    None => {
                    }
                }
            }
        }
    }
    ret Option[str]::None
}

fn generic_bound_method_param(ctx: mut TranslatorContext, owner: str, method: str, index: usize) -> Option[str]
{
    for generic in ctx.active_generics {
        if generic.name == owner {
            for bound in generic.bounds {
                let trait_name = base_type_name(bound.path)
                match trait_method_contract(ctx, trait_name, method) {
                    Some(function) => {
                        match function.params.get(index) {
                            Some(param) => {
                                let mut specialized = replace_type_token(param, trait_name, owner)
                                match lookup_trait(ctx, trait_name) {
                                    Some(contract) => {
                                        specialized = specialize_named_type(specialized, generic_param_names(contract.generics),
                                            bound.args,)
                                    }
                                    None => {
                                    }
                                }
                                ret Option[str]::Some(specialized)
                            }
                            None => {
                            }
                        }
                    }
                    None => {
                    }
                }
            }
        }
    }
    ret Option[str]::None
}

fn validate_generic_call_bounds(ctx: mut TranslatorContext, name: str, args: Vec[str], source_name: str,
    line: usize, column: usize,) ->() {
    let base = generic_dispatch_base_name(name)
    let mut found_callable = false
    let mut expected_arity = 0_usize
    for callable in ctx.generic_callables {
        if generic_dispatch_base_name(callable.name) == base {
            found_callable = true
            expected_arity = callable.params.len()
        }
        if generic_dispatch_base_name(callable.name) == base && callable.params.len() == args.len() {
            let mut index = 0_usize
            while index < callable.params.len() {
                match callable.params.get(index) {
                    Some(parameter) => {
                        match args.get(index) {
                            Some(argument) => {
                                for bound in parameter.bounds {
                                    if !type_satisfies_trait_bound(ctx, ctx.active_generics, argument,
                                        bound.path,) {
                                        translation_error_at(source_name, line, column, "generic-bound-not-satisfied",
                                            "type '" + canonical_type(argument) + "' does not satisfy bound '"
                                            + bound.path + "' for generic parameter '" + parameter.name
                                            +
                                            "' of '" + callable.name + "'",)
                                    }
                                }
                            }
                            None => {
                            }
                        }
                    }
                    None => {
                    }
                }
                index = index + 1_usize
            }
            ret()
        }
    }
    if found_callable {
        translation_error_at(source_name, line, column, "generic-arity-mismatch", "generic callable '"
            + base + "' expects " + Debug::fmt(expected_arity) + " generic argument(s), got " + Debug::fmt(args.len()),)
    }
    ret()
}

fn lower_mutable_call_argument(ctx: mut TranslatorContext, expr: ExprNode,
    prefix: str, idx: usize,) -> LoweredExpr {
    match expr.value {
        Expr::Path(name) => {
            match ctx_lookup_var(ctx, name) {
                Option[str]::Some(found) => {
                    if is_mutable_handle_slot(found) {
                        let handle_type = mutable_handle_slot_type(found)
                        let out_name = prefix + "_handle_ptr_" + Debug::fmt(idx)
                        let code = EhirTextBuilder::new().instr(out_name + ": " + handle_type +
                            "* = pcast " + ctx_lookup_value_name(ctx, name) + ": usize*, " +
                            handle_type + "*",)
                        ret LoweredExpr {
                            code, out_name, "mut " + handle_type
                        }
                    }
                    if starts_with(found, "mut ") {
                        ret LoweredExpr {
                            EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), found
                        }
                    }
                }
                Option[str]::None => {
                }
            }
        }
        Expr::Field(field_expr) => {
            let root_path = expr_h_frozen_root_path(field_expr.base)
            if ctx_path_is_mutable(ctx, root_path) {
                ret lower_mutable_field_place(ctx, field_expr, expr.source_name, expr.line,
                    expr.column, prefix, idx,)
            }
        }
        _ => {
        }
    }
    ret lower_expr(ctx, expr, prefix, idx)
}

fn lower_borrowed_call_argument(ctx: mut TranslatorContext, expr: ExprNode,
    prefix: str, idx: usize,) -> LoweredExpr {
    let source_name = expr.source_name
    let source_line = expr.line
    let source_column = expr.column
    let copies_existing_owner = expr_is_borrowed_copy(expr)
    let lowered = lower_expr(ctx, expr, prefix + "_node", idx)
    let mut lowered_type = canonical_type(lowered.typ)
    let mut lowered_value = lowered.value
    let mut code = lowered.code
    if starts_with(lowered_type, "mut ") && !ends_with(lowered_type, "&") {
        lowered_type = lowered_type.slice(4_usize, lowered_type.len() - 4_usize)
        let loaded_value = prefix + "_node_load_" + Debug::fmt(idx)
        code = code.instr(loaded_value + ": " + lowered_type + " = load " + lowered_value)
        lowered_value = loaded_value
    } elif starts_with(lowered_type, "mut ") {
        lowered_type = lowered_type.slice(4_usize, lowered_type.len() - 4_usize)
    }
    if !is_node_handle_type_text(lowered_type) {
        translation_error_at(
            source_name,
            source_line,
            source_column,
            "node-handle-required",
            "parameter requires an owning node handle; construct '" +
            base_type_name(lowered_type) + "<S>' or '" +
            base_type_name(lowered_type) + "<H>' explicitly",
        )
    }

    if copies_existing_owner {
        code = code.instr("retain " + lowered_value + ": " + lowered_type)
    }
    if ends_with(lowered_type, "&") {
        ret LoweredExpr {
            code, lowered_value, lowered_type
        }
    }

    let erased_type = value_type_name(lowered_type) + "&"
    let erased_value = prefix + "_node_any_" + Debug::fmt(idx)
    code = code.instr(erased_value + ": " + erased_type + " = pcast " +
        lowered_value + ": " + lowered_type + ", " + erased_type,)
    ret LoweredExpr {
        code, erased_value, erased_type
    }
}

fn lower_method_receiver(ctx: mut TranslatorContext, expr: ExprNode < H >, prefix: str, idx: usize) ->
LoweredExpr {
    match expr.value {
        Expr::Path(name) => {
            match ctx_lookup_var(ctx, name) {
                Option[str]::Some(found) => {
                    if is_mutable_handle_slot(found) {
                        let handle_type = mutable_handle_slot_type(found)
                        let out = prefix + "_handle_ptr_" + Debug::fmt(idx)
                        let code = EhirTextBuilder::new().instr(out + ": " + handle_type +
                            "* = pcast " + ctx_lookup_value_name(ctx, name) + ": usize*, " +
                            handle_type + "*",)
                        ret LoweredExpr {
                            code, out, "mut " + handle_type
                        }
                    }
                    if starts_with(found, "mut ") {
                        ret LoweredExpr {
                            EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), found
                        }
                    }
                    ret LoweredExpr {
                        EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), found
                    }
                }
                Option[str]::None => {
                }
            }
        }
        Expr::Field(field_expr) => {
            let root_path = expr_h_frozen_root_path(field_expr.base)
            if ctx_path_is_mutable(ctx, root_path) {
                ret lower_mutable_field_place(ctx, field_expr, expr.source_name, expr.line,
                    expr.column, prefix, idx,)
            }
        }
        _ => {
        }
    }
    ret lower_expr_h(ctx, expr, prefix, idx)
}

/// Lowers an addressable projection rooted in an explicit mutable capability.
/// Every nested field remains a place, so a call such as
/// `state.inner.values.push(value)` updates the original graph rather than a
/// temporary copy.
fn lower_mutable_place_h(ctx: mut TranslatorContext, expr: ExprNode < H >,
    prefix: str, idx: usize,) -> LoweredExpr {
    match expr.value {
        Expr::Path(name) => {
            match ctx_lookup_var(ctx, name) {
                Option[str]::Some(found) => {
                    if starts_with(found, "mut ") {
                        ret LoweredExpr {
                            EhirTextBuilder::new(), ctx_lookup_value_name(ctx, name), found
                        }
                    }
                    // A mutable node handle is stored in a scalar slot. Its
                    // fields live in the referenced node, so load the handle
                    // before projecting into the node.
                    if is_mutable_handle_slot(found) {
                        ret lower_expr_h(ctx, expr, prefix, idx)
                    }
                }
                Option[str]::None => {
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret lower_mutable_place_h(ctx, inner, prefix, idx)
        }
        Expr::Field(field_expr) => {
            ret lower_mutable_field_place(ctx, field_expr, expr.source_name, expr.line,
                expr.column, prefix, idx,)
        }
        _ => {
        }
    }
    ret lower_expr_h(ctx, expr, prefix, idx)
}

fn lower_mutable_field_place(ctx: mut TranslatorContext, field_expr: FieldExpr,
    source_name: str, line: usize, column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let base = lower_mutable_place_h(ctx, field_expr.base, prefix + "_base", idx + 1_usize)
    let owner_type = canonical_type(value_type_name(base.typ))
    let mut field_type = "void"
    match ctx_lookup_field(ctx, owner_type, field_expr.field) {
        Option[str]::Some(found) => {
            field_type = canonical_type(found)
        }
        Option[str]::None => {
            translation_error_at(source_name, line, column, "unknown-field",
                "type '" + owner_type + "' has no field '" + field_expr.field + "'",)
        }
    }
    let out_name = prefix + "_field_ptr_" + Debug::fmt(idx)
    let code = base.code.instr(out_name + ": " + field_type + "* = getfieldptr " +
        base.value + " > " + ctx_lookup_field_index(ctx, owner_type, field_expr.field),)
    ret LoweredExpr {
        code, out_name, "mut " + field_type
    }
}

fn lower_match_expr(ctx: mut TranslatorContext, match_expr: MatchExpr, source_name: str, line: usize,
    column: usize, prefix: str, idx: usize,) -> LoweredExpr {
    let cond_borrowed = expr_h_is_borrowed_copy(match_expr.expr)
    let cond = lower_expr_h(ctx, match_expr.expr, prefix + "_match_expr", idx)
    let result_name = prefix + "_match_result_" + Debug::fmt(idx)
    let result_slot = result_name + "_slot"
    let result_type = infer_match_expr_result_type(ctx, match_expr, cond.typ, source_name, line, column)
    let end_label = prefix + "_match_expr_end_" + Debug::fmt(idx)
    let mut builder = cond.code
    if cond_borrowed && ctx_type_needs_ownership(ctx, cond.typ) {
        builder = builder.instr("retain " + cond.value + ": " + cond.typ)
    }
    builder = builder.instr(result_slot + ": " + result_type + "* = salloc " + result_type)
    let mut arm_idx = 0_usize
    let outer_owned = ctx.owned_vars.len()

    for arm in match_expr.arms {
        let body_label = prefix + "_match_expr_body_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx)
        let fail_label = prefix + "_match_expr_next_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx +
            1_usize)
        let test = lower_match_pattern_test(cond.value, cond.typ, arm.pattern, source_name, line, column,
            prefix, idx, arm_idx,)
        builder = builder.append(test.code)
        if test.is_always_true {
            builder = builder.instr("br $" + body_label)
        } else {
            builder = builder.instr("cbr " + test.cond_value + ", $" + body_label + ", $" + fail_label)
        }
        builder = builder.label(body_label)
        builder = builder.append(bind_match_payload(ctx, arm.pattern, cond.value, cond.typ, source_name,
                line, column, prefix + "_match_expr_binding_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx),))
        if ctx_type_needs_ownership(ctx, cond.typ) {
            builder = builder.instr("drop " + cond.value + ": " + cond.typ)
        }
        let borrowed_result = expr_is_borrowed_copy(arm.expr)
        let lowered = lower_expr(ctx, arm.expr, prefix + "_match_expr_arm_" + Debug::fmt(idx) + "_" +
            Debug::fmt(arm_idx), idx + arm_idx + 1_usize,)
        builder = builder.append(lowered.code)
        if lowered.typ != "!" {
            if borrowed_result && ctx_type_needs_ownership(ctx, lowered.typ) {
                builder = builder.instr("retain " + lowered.value + ": " + lowered.typ)
            }
            builder = builder.instr("store " + lowered.value + ", " + result_slot)
            if ctx_type_needs_ownership(ctx, result_type) {
                builder = builder.instr("drop " + lowered.value + ": " + result_type)
            }
            builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", outer_owned)
            builder = builder.instr("br $" + end_label)
        }
        restore_owned_vars(ctx, outer_owned)
        builder = builder.label(fail_label)
        arm_idx = arm_idx + 1_usize
    }

    if ctx_type_needs_ownership(ctx, cond.typ) {
        builder = builder.instr("drop " + cond.value + ": " + cond.typ)
    }
    builder = builder.instr("br $" + end_label)
    builder = builder.label(end_label)
    builder = builder.instr(result_name + ": " + result_type + " = load " + result_slot)
    ret LoweredExpr {
        builder, result_name, result_type
    }
}

fn lower_if_expr(ctx: mut TranslatorContext, if_expr: IfExpr, prefix: str, idx: usize) -> LoweredExpr
{
    let result_name = prefix + "_if_result_" + Debug::fmt(idx)
    let result_slot = result_name + "_slot"
    let end_label = prefix + "_if_expr_end_" + Debug::fmt(idx)
    let result_type = infer_if_expr_result_type(ctx, if_expr)
    let mut builder = EhirTextBuilder::new()
    builder = builder.instr(result_slot + ": " + result_type + "* = salloc " + result_type)

    let mut branch_idx = 0_usize
    let outer_owned = ctx.owned_vars.len()
    for branch in if_expr.branches {
        let then_label = prefix + "_if_expr_then_" + Debug::fmt(idx) + "_" + Debug::fmt(branch_idx)
        let next_label = prefix + "_if_expr_next_" + Debug::fmt(idx) + "_" + Debug::fmt(branch_idx)
        let cond_name = prefix + "_if_expr_cond_" + Debug::fmt(idx) + "_" + Debug::fmt(branch_idx)
        builder = builder.append(lower_cond(ctx, branch.condition, cond_name))
        builder = builder.instr("cbr " + cond_name + ", $" + then_label + ", $" + next_label)
        builder = builder.label(then_label)
        let borrowed_result = expr_is_borrowed_copy(branch.body)
        let lowered = lower_expr(ctx, branch.body, prefix + "_if_expr_body_" + Debug::fmt(branch_idx),
            idx + branch_idx + 1_usize,)
        builder = builder.append(lowered.code)
        if canonical_type(lowered.typ) != "!" {
            if borrowed_result && ctx_type_needs_ownership(ctx, lowered.typ) {
                builder = builder.instr("retain " + lowered.value + ": " + lowered.typ)
            }
            builder = builder.instr("store " + lowered.value + ", " + result_slot)
            if ctx_type_needs_ownership(ctx, result_type) {
                builder = builder.instr("drop " + lowered.value + ": " + result_type)
            }
            builder = append_owned_drops_from(ctx, builder, "", then_label + "_scope", outer_owned)
            builder = builder.instr("br $" + end_label)
        }
        restore_owned_vars(ctx, outer_owned)
        builder = builder.label(next_label)
        branch_idx = branch_idx + 1_usize
    }

    let borrowed_else = expr_h_is_borrowed_copy(if_expr.else_body)
    let else_lowered = lower_expr_h(ctx, if_expr.else_body, prefix + "_if_expr_else", idx + branch_idx
        + 1_usize,)
    builder = builder.append(else_lowered.code)
    if canonical_type(else_lowered.typ) != "!" {
        if borrowed_else && ctx_type_needs_ownership(ctx, else_lowered.typ) {
            builder = builder.instr("retain " + else_lowered.value + ": " + else_lowered.typ)
        }
        builder = builder.instr("store " + else_lowered.value + ", " + result_slot)
        if ctx_type_needs_ownership(ctx, result_type) {
            builder = builder.instr("drop " + else_lowered.value + ": " + result_type)
        }
        builder = append_owned_drops_from(ctx, builder, "", prefix + "_if_expr_else_scope", outer_owned)
        builder = builder.instr("br $" + end_label)
    }
    restore_owned_vars(ctx, outer_owned)
    builder = builder.label(end_label)
    builder = builder.instr(result_name + ": " + result_type + " = load " + result_slot)
    ret LoweredExpr {
        builder, result_name, result_type
    }
}

fn infer_if_expr_result_type(ctx: mut TranslatorContext, if_expr: IfExpr) -> str {
    let owned_size = ctx.owned_vars.len()
    for branch in if_expr.branches {
        let lowered = lower_expr(ctx, branch.body, "_if_type_probe", 0_usize)
        let typ = canonical_type(lowered.typ)
        restore_owned_vars(ctx, owned_size)
        if typ != "!" {
            ret typ
        }
    }
    let lowered_else = lower_expr_h(ctx, if_expr.else_body, "_if_type_probe_else", 0_usize)
    let typ = lowered_else.typ
    restore_owned_vars(ctx, owned_size)
    ret typ
}

fn lower_block_expr(ctx: mut TranslatorContext, block_expr: BlockExpr, prefix: str, idx: usize) -> LoweredExpr
{
    let mut builder = translate_statements_no_default(
        ctx,
        block_expr.statements,
        ctx.return_type,
        prefix + "_block",
        Option[str]::None,
        Option[str]::None,
    )
    match block_expr.tail {
        Option[ExprNode < H >]::Some(tail_expr) => {
            let tail = lower_expr_h(ctx, tail_expr, prefix + "_block_tail", idx + 1_usize)
            builder = builder.append(tail.code)
            ret LoweredExpr {
                builder, tail.value, tail.typ
            }
        }
        Option[ExprNode < H >]::None => {
            ret LoweredExpr {
                builder, "", "!"
            }
        }
    }
}

fn lower_unsafe_expr(ctx: mut TranslatorContext, block: ParsedBlock, prefix: str, idx: usize) -> LoweredExpr
{
    let mut builder = EhirTextBuilder::new()
    let mut stmt_index = 0_usize
    loop {
        match block.statements.get(stmt_index) {
            Option[Statement]::Some(stmt) => {
                if stmt_index + 1_usize >= block.statements.len() {
                    match stmt {
                        Statement::Expr(expr_stmt) => {
                            let tail = lower_expr(ctx, expr_stmt, prefix + "_unsafe_tail", idx + stmt_index
                                + 1_usize,)
                            builder = builder.append(tail.code)
                            ret LoweredExpr {
                                builder, tail.value, tail.typ
                            }
                        }
                        Statement::Ret(expr_stmt) => {
                            let tail = lower_expr(ctx, expr_stmt, prefix + "_unsafe_ret", idx + stmt_index
                                + 1_usize,)
                            builder = builder.append(tail.code)
                            ret LoweredExpr {
                                builder, tail.value, tail.typ
                            }
                        }
                        _ => {
                        }
                    }
                }
                builder = builder.append(translate_statements_no_default(
                        ctx,
                        single_statement(stmt),
                        "void",
                        prefix + "_unsafe_stmt_" + Debug::fmt(stmt_index),
                        Option[str]::None,
                        Option[str]::None,
                    ))
                stmt_index = stmt_index + 1_usize
            }
            Option[Statement]::None => {
                break
            }
        }
    }
    ret LoweredExpr {
        builder, "void", "()"
    }
}

fn single_statement(stmt: Statement) -> Vec[Statement] {
    let mut out = Vec[Statement]::new()
    out.push(stmt)
    ret out
}

fn infer_match_expr_result_type(ctx: mut TranslatorContext, match_expr: MatchExpr, scrutinee_type: str,
    source_name: str, line: usize, column: usize,) -> str {
    let owned_size = ctx.owned_vars.len()
    for arm in match_expr.arms {
        let _bindings = bind_match_payload(ctx, arm.pattern, "_match_type_probe_subject", scrutinee_type,
            source_name, line, column, "_match_type_probe_binding",)
        let lowered = lower_expr(ctx, arm.expr, "_match_type_probe", 0_usize)
        let typ = canonical_type(lowered.typ)
        restore_owned_vars(ctx, owned_size)
        if typ != "!" {
            ret typ
        }
    }
    translation_error_at(source_name, line, column, "diverging-match-expression", "match expression has no value-producing arm")
    ret "!"
}

fn bind_match_payload(ctx: mut TranslatorContext, pattern: MatchPattern, scrutinee_value: str, scrutinee_type:
    str, source_name: str, line: usize, column: usize, binding_prefix: str,) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    match pattern.binding {
        Option[str]::Some(name) => {
            let payload_type = match_payload_type(ctx, pattern, scrutinee_type, source_name, line, column)
            let emitted_name = binding_prefix + "_" + match_payload_field(pattern) + "_" + name
            let payload_is_frozen = ctx_value_is_frozen(ctx, scrutinee_value) &&
            !thread_type_is_send(ctx, payload_type, Vec[str]::new())
            ctx_add_var_emitted(ctx, name, emitted_name, payload_type)
            if payload_is_frozen {
                ctx_mark_region_frozen(ctx, ctx_lookup_var_region(ctx, name))
                ctx_mark_value_frozen(ctx, emitted_name)
            }
            builder = builder.instr(emitted_name + ": " + payload_type + " = getfield " + scrutinee_value
                + " > " + match_payload_field(pattern))
            if ctx_type_needs_ownership(ctx, payload_type) {
                builder = builder.instr("retain " + emitted_name + ": " + payload_type)
                ctx_add_owned_var(ctx, name, emitted_name, payload_type)
            }
        }
        Option[str]::None => {
        }
    }
    ret builder
}

fn match_payload_field(pattern: MatchPattern) -> str {
    match pattern.value {
        Option[str]::Some(value) => {
            ret enum_variant_name(value)
        }
        Option[str]::None => {
        }
    }
    ret "1"
}

fn match_payload_type(ctx: mut TranslatorContext, pattern: MatchPattern, scrutinee_type: str, source_name:
    str, line: usize, column: usize,) -> str {
    match pattern.value {
        Option[str]::Some(value) => {
            if is_option_some_pattern(value) && base_type_name(scrutinee_type) == "Option" {
                ret first_generic_type(scrutinee_type)
            }
            if is_result_ok_pattern(value) && base_type_name(scrutinee_type) == "Result" {
                ret nth_generic_type(scrutinee_type, 0_usize)
            }
            if is_result_err_pattern(value) && base_type_name(scrutinee_type) == "Result" {
                ret nth_generic_type(scrutinee_type, 1_usize)
            }
            if scrutinee_type == "Json" {
                let payload = json_payload_type(value)
                if payload != "" {
                    ret payload
                }
            }
            let variant = enum_variant_name(value)
            for item in ctx.enum_variants {
                if item.owner == base_type_name(scrutinee_type) && enum_variant_name(item.path) == variant
                && item.payload_type != "void" {
                    ret specialize_named_type(item.payload_type, item.generics, generic_args_from_path(scrutinee_type))
                }
            }
            translation_error_at(source_name, line, column, "invalid-match-payload", "pattern '" + value
                + "' has no payload compatible with type '" + scrutinee_type + "'",)
        }
        Option[str]::None => {
        }
    }
    translation_error_at(source_name, line, column, "invalid-match-payload", "cannot resolve a payload for type '"
        + scrutinee_type + "'",)
    ret "void"
}

fn json_payload_type(value: str) -> str {
    if value == "Json::Bool" || value == "Bool" {
        ret "bool"
    }
    if value == "Json::Number" || value == "Number" {
        ret "str"
    }
    if value == "Json::String" || value == "String" {
        ret "str"
    }
    if value == "Json::Array" || value == "Array" {
        ret "Vec[Json]"
    }
    if value == "Json::Object" || value == "Object" {
        ret "Vec[__tuple_2[str, Json]]"
    }
    ret ""
}

fn is_option_some_pattern(value: str) -> bool {
    if enum_variant_name(value) == "Some" {
        ret true
    }
    if value == "Some" {
        ret true
    }
    if value == "Option::Some" {
        ret true
    }
    if starts_with(value, "Option[") && ends_with(value, "::Some") {
        ret true
    }
    ret false
}

fn is_result_ok_pattern(value: str) -> bool {
    if enum_variant_name(value) == "Ok" {
        ret true
    }
    if value == "Ok" {
        ret true
    }
    if value == "Result::Ok" {
        ret true
    }
    if starts_with(value, "Result[") && ends_with(value, "::Ok") {
        ret true
    }
    ret false
}

fn is_result_err_pattern(value: str) -> bool {
    if enum_variant_name(value) == "Err" {
        ret true
    }
    if value == "Err" {
        ret true
    }
    if value == "Result::Err" {
        ret true
    }
    if starts_with(value, "Result[") && ends_with(value, "::Err") {
        ret true
    }
    ret false
}

fn expr_h_path_or_empty(expr: ExprNode < H >) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_path_or_empty(inner)
        }
        _ => {
            ret ""
        }
    }
    ret ""
}

fn translate_match_stmt(
    ctx: mut TranslatorContext,
    match_stmt: MatchStmt,
    ret_type: str,
    prefix: str,
    idx: usize,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let cond_borrowed = expr_is_borrowed_copy(match_stmt.expr)
    let cond = lower_expr(ctx, match_stmt.expr, prefix + "_match_expr", idx)
    builder = builder.append(cond.code)
    if cond_borrowed && ctx_type_needs_ownership(ctx, cond.typ) {
        builder = builder.instr("retain " + cond.value + ": " + cond.typ)
    }

    let end_label = prefix + "_match_end_" + Debug::fmt(idx)
    let mut next_label = prefix + "_match_next_" + Debug::fmt(idx) + "_0"
    let is_exhaustive = match_stmt_is_exhaustive_for_type(ctx, match_stmt, cond.typ)
    match duplicate_match_variant(match_stmt) {
        Option[str]::Some(variant) => {
            translation_error_at(match_stmt.expr.source_name, match_stmt.expr.line, match_stmt.expr.column,
                "duplicate-match-arm", "duplicate match arm for variant '" + variant + "'",)
        }
        Option[str]::None => {
        }
    }
    if !is_exhaustive {
        translation_error_at(match_stmt.expr.source_name, match_stmt.expr.line, match_stmt.expr.column,
            "non-exhaustive-match", "non-exhaustive match for enum '" + base_type_name(cond.typ) + "'",)
    }
    let all_arms_return = match_stmt_always_returns(match_stmt)
    let outer_owned = ctx.owned_vars.len()
    let mut arm_idx = 0_usize
    for arm in match_stmt.arms {
        let body_label = prefix + "_match_body_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx)
        let fail_label = prefix + "_match_next_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx + 1_usize)
        let is_last_arm = arm_idx + 1_usize == match_stmt.arms.len()
        if is_exhaustive && is_last_arm {
            builder = builder.instr("br $" + body_label)
        } else {
            let test = lower_match_pattern_test(cond.value, cond.typ, arm.pattern, match_stmt.expr.source_name,
                match_stmt.expr.line, match_stmt.expr.column, prefix, idx, arm_idx,)
            builder = builder.append(test.code)
            if test.is_always_true {
                builder = builder.instr("br $" + body_label)
            } else {
                builder = builder.instr("cbr " + test.cond_value + ", $" + body_label + ", $" + fail_label)
            }
        }
        builder = builder.label(body_label)
        builder = builder.append(bind_match_payload(ctx, arm.pattern, cond.value, cond.typ, match_stmt.expr.source_name,
                match_stmt.expr.line, match_stmt.expr.column, prefix + "_match_binding_" + Debug::fmt(idx)
                +
                "_" + Debug::fmt(arm_idx),))
        if ctx_type_needs_ownership(ctx, cond.typ) {
            builder = builder.instr("drop " + cond.value + ": " + cond.typ)
        }
        let arm_returns = match_arm_always_returns(arm)
        let arm_terminates = match_arm_terminates_flow(arm)
        builder = builder.append(translate_match_arm_body(
                ctx,
                arm,
                ret_type,
                prefix + "_match_" + Debug::fmt(idx) + "_arm_" + Debug::fmt(arm_idx),
                break_label,
                continue_label,
            ))
        if !arm_returns && !arm_terminates {
            builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", outer_owned)
            builder = builder.instr("br $" + end_label)
        }
        restore_owned_vars(ctx, outer_owned)
        next_label = fail_label
        if !(is_exhaustive && is_last_arm) {
            builder = builder.label(next_label)
        }
        arm_idx = arm_idx + 1_usize
    }

    if !is_exhaustive {
        builder = builder.instr("; no pattern matched")
        if ctx_type_needs_ownership(ctx, cond.typ) {
            builder = builder.instr("drop " + cond.value + ": " + cond.typ)
        }
        builder = builder.instr("br $" + end_label)
    }
    if !(is_exhaustive && all_arms_return) {
        builder = builder.label(end_label)
    }
    ret builder
}

fn duplicate_match_variant(match_stmt: MatchStmt) -> Option[str] {
    let mut seen = Vec[str]::new()
    for arm in match_stmt.arms {
        if arm.pattern.kind == "path" {
            match arm.pattern.value {
                Option[str]::Some(value) => {
                    let variant = enum_variant_name(value)
                    for known in seen {
                        if known == variant {
                            ret Option[str]::Some(variant)
                        }
                    }
                    seen.push(variant)
                }
                Option[str]::None => {
                }
            }
        }
    }
    ret Option[str]::None
}

fn match_arm_always_returns(arm: ParsedMatchArm) -> bool {
    match arm.body {
        MatchArmBody::Block(block) => {
            ret block_always_returns(block)
        }
        MatchArmBody::Expr(_) => {
        }
    }
    ret false
}

fn match_arm_terminates_flow(arm: ParsedMatchArm) -> bool {
    match arm.body {
        MatchArmBody::Block(block) => {
            ret block_terminates_flow(block)
        }
        MatchArmBody::Expr(_) => {
        }
    }
    ret false
}

fn block_always_returns(block: ParsedBlock) -> bool {
    for stmt in block.statements {
        if statement_always_returns(stmt) {
            ret true
        }
    }
    ret false
}

fn block_terminates_flow(block: ParsedBlock) -> bool {
    for stmt in block.statements {
        if statement_terminates_flow(stmt) {
            ret true
        }
    }
    ret false
}

fn statement_terminates_flow(stmt: Statement) -> bool {
    match stmt {
        Statement::Ret(_) => {
            ret true
        }
        Statement::Break(_) => {
            ret true
        }
        Statement::Continue(_) => {
            ret true
        }
        Statement::Match(match_stmt) => {
            ret match_stmt_always_returns(match_stmt)
        }
        Statement::If(if_stmt) => {
            ret if_stmt_always_returns(if_stmt)
        }
        _ => {
        }
    }
    ret false
}

fn statement_always_returns(stmt: Statement) -> bool {
    match stmt {
        Statement::Ret(_) => {
            ret true
        }
        Statement::Match(match_stmt) => {
            ret match_stmt_always_returns(match_stmt)
        }
        Statement::If(if_stmt) => {
            ret if_stmt_always_returns(if_stmt)
        }
        _ => {
        }
    }
    ret false
}

fn match_stmt_always_returns(match_stmt: MatchStmt) -> bool {
    if match_stmt.arms.len() == 0_usize {
        ret false
    }
    for arm in match_stmt.arms {
        if !match_arm_always_returns(arm) {
            ret false
        }
    }
    ret true
}

fn if_stmt_always_returns(if_stmt: IfStmt) -> bool {
    for branch in if_stmt.branches {
        if !block_always_returns(branch.body) {
            ret false
        }
    }
    match if_stmt.else_body {
        Option[ParsedBlock]::Some(block) => {
            ret block_always_returns(block)
        }
        Option[ParsedBlock]::None => {
        }
    }
    ret false
}

fn match_stmt_is_exhaustive_for_type(ctx: mut TranslatorContext, match_stmt: MatchStmt, subject_type:
    str,) -> bool {
    let subject_base = base_type_name(subject_type)
    let mut has_some = false
    let mut has_none = false
    let mut has_ok = false
    let mut has_err = false
    let mut has_true = false
    let mut has_false = false

    for arm in match_stmt.arms {
        if arm.pattern.kind == "wildcard" {
            ret true
        }
        match arm.pattern.value {
            Option[str]::Some(value) => {
                if subject_base == "Option" {
                    if is_option_some_pattern(value) {
                        has_some = true
                    }
                    if is_option_none_pattern(value) {
                        has_none = true
                    }
                }
                if subject_base == "Result" {
                    if is_result_ok_pattern(value) {
                        has_ok = true
                    }
                    if is_result_err_pattern(value) {
                        has_err = true
                    }
                }
                if subject_base == "bool" {
                    if value == "true" {
                        has_true = true
                    }
                    if value == "false" {
                        has_false = true
                    }
                }
            }
            Option[str]::None => {
            }
        }
    }

    if subject_base == "Option" {
        ret has_some && has_none
    }
    if subject_base == "Result" {
        ret has_ok && has_err
    }
    if subject_base == "bool" {
        ret has_true && has_false
    }

    let mut declared = Vec[str]::new()
    for item in ctx.enum_variants {
        if item.owner == subject_base {
            let variant = enum_variant_name(item.path)
            let mut seen = false
            for known in declared {
                if known == variant {
                    seen = true
                }
            }
            if !seen {
                declared.push(variant)
            }
        }
    }
    let declared_count = declared.len()
    if declared_count == 0_usize {
        ret false
    }

    let mut matched = Vec[str]::new()
    for arm in match_stmt.arms {
        match arm.pattern.value {
            Option[str]::Some(value) => {
                let variant = enum_variant_name(value)
                let mut is_declared = false
                for item in ctx.enum_variants {
                    if item.owner == subject_base && enum_variant_name(item.path) == variant {
                        is_declared = true
                    }
                }
                if is_declared {
                    let mut seen = false
                    for known in matched {
                        if known == variant {
                            seen = true
                        }
                    }
                    if !seen {
                        matched.push(variant)
                    }
                }
            }
            Option[str]::None => {
            }
        }
    }
    ret matched.len() == declared_count
}

fn is_option_none_pattern(value: str) -> bool {
    if enum_variant_name(value) == "None" {
        ret true
    }
    if value == "None" {
        ret true
    }
    if value == "Option::None" {
        ret true
    }
    if starts_with(value, "Option[") && ends_with(value, "::None") {
        ret true
    }
    ret false
}

struct LoweredPatternTest {
    code: EhirTextBuilder
    cond_value: str
    is_always_true: bool
}

fn lower_match_pattern_test(
    subject_value: str,
    subject_typ: str,
    pattern: MatchPattern,
    source_name: str,
    line: usize,
    column: usize,
    prefix: str,
    idx: usize,
    arm_idx: usize,
) -> LoweredPatternTest {
    let mut code = EhirTextBuilder::new()
    if pattern.kind == "wildcard" {
        ret LoweredPatternTest {
            code, "", true
        }
    }

    let cond_name = prefix + "_match_cond_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx)
    match pattern.value {
        Option[str]::Some(value) => {
            if pattern.kind == "integer" {
                let lit = with_numeric_suffix(value, subject_typ)
                code = code.instr(cond_name + " = ieq " + subject_value + ", " + lit)
                ret LoweredPatternTest {
                    code, cond_name, false
                }
            }
            if pattern.kind == "float" {
                let lit = with_numeric_suffix(value, subject_typ)
                code = code.instr(cond_name + " = ieq " + subject_value + ", " + lit)
                ret LoweredPatternTest {
                    code, cond_name, false
                }
            }
            if pattern.kind == "bool" {
                let mut lit = "0_u1"
                if value == "true" {
                    lit = "1_u1"
                }
                code = code.instr(cond_name + " = ieq " + subject_value + ", " + lit)
                ret LoweredPatternTest {
                    code, cond_name, false
                }
            }
            if pattern.kind == "string" {
                let literal_name = cond_name + "_literal"
                code = code.instr(literal_name + ": str = capprim \"" + escape_str(string_token_body(value))
                    + "\"_str")
                code = code.instr(cond_name + ": bool = unsafe call encore_str_eq(" + subject_value +
                    ", " + literal_name + ")")
                code = code.instr("drop " + literal_name + ": str")
                ret LoweredPatternTest {
                    code, cond_name, false
                }
            }
            if pattern.kind == "path" {
                let mut rhs = value
                if is_enum_variant_path(value) {
                    rhs = enum_variant_name(value)
                }
                code = code.instr(cond_name + " = ieq " + subject_value + ", " + rhs)
                ret LoweredPatternTest {
                    code, cond_name, false
                }
            }
        }
        Option[str]::None => {
        }
    }

    translation_error_at(source_name, line, column, "unsupported-match-pattern", "unsupported match pattern kind '"
        + pattern.kind + "'",)
    ret LoweredPatternTest {
        code, cond_name, false
    }
}

fn translate_match_arm_body(
    ctx: mut TranslatorContext,
    arm: ParsedMatchArm,
    ret_type: str,
    prefix: str,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    match arm.body {
        MatchArmBody::Block(block) => {
            ret translate_statements_no_default(ctx, block.statements, ret_type, prefix, break_label,
                continue_label,)
        }
        MatchArmBody::Expr(expr) => {
            ret translate_expr_stmt(ctx, expr, prefix, 0_usize)
        }
    }
    ret EhirTextBuilder::new()
}

fn lower_cond(ctx: mut TranslatorContext, expr: ExprNode, temp_name: str) -> EhirTextBuilder {
    let lowered = lower_expr(ctx, expr, temp_name, 0_usize)
    let mut builder = lowered.code
    builder = builder.instr(temp_name + ": bool = " + lowered.value)
    ret builder
}

fn translate_if_stmt(
    ctx: mut TranslatorContext,
    if_stmt: IfStmt,
    ret_type: str,
    prefix: str,
    idx: usize,
    break_label: Option[str],
    continue_label: Option[str],
) -> EhirTextBuilder {
    let else_label = prefix + "_if_else_" + Debug::fmt(idx)
    let end_label = prefix + "_if_end_" + Debug::fmt(idx)
    let outer_owned = ctx.owned_vars.len()
    let mut all_paths_terminate = false
    match if_stmt.else_body {
        Some(_) => {
            all_paths_terminate = true
        }
        None => {
        }
    }

    let mut builder = EhirTextBuilder::new()
    let branches = if_stmt.branches
    let mut branch_index = 0_usize
    while branch_index < branches.len() {
        match branches.get(branch_index) {
            Option[IfBranch]::Some(branch) => {
                let branch_suffix = Debug::fmt(idx) + "_" + Debug::fmt(branch_index)
                let then_label = prefix + "_if_then_" + branch_suffix
                let next_label = if branch_index + 1_usize < branches.len() {
                    prefix + "_if_elif_" + branch_suffix
                } else {
                    else_label
                }
                let cond_name = prefix + "_if_cond_" + branch_suffix
                builder = builder.append(lower_cond(ctx, branch.condition, cond_name))
                builder = builder.instr("cbr " + cond_name + ", $" + then_label + ", $" + next_label)
                builder = builder.label(then_label)
                let then_returns = block_always_returns(branch.body)
                let then_terminates = block_terminates_flow(branch.body)
                if !then_terminates {
                    all_paths_terminate = false
                }
                builder = builder.append(translate_statements_no_default(
                        ctx,
                        branch.body.statements,
                        ret_type,
                        then_label,
                        break_label,
                        continue_label,
                    ))
                if !then_returns && !then_terminates {
                    builder = append_owned_drops_from(ctx, builder, "", then_label + "_scope", outer_owned)
                }
                if !then_terminates {
                    builder = builder.instr("br $" + end_label)
                }
                restore_owned_vars(ctx, outer_owned)
                builder = builder.label(next_label)
            }
            Option[IfBranch]::None => {
            }
        }
        branch_index = branch_index + 1_usize
    }

    if branches.len() == 0_usize {
        builder = builder.label(else_label)
    }
    match if_stmt.else_body {
        Option[ParsedBlock]::Some(else_block) => {
            let else_returns = block_always_returns(else_block)
            let else_terminates = block_terminates_flow(else_block)
            if !else_terminates {
                all_paths_terminate = false
            }
            builder = builder.append(translate_statements_no_default(
                    ctx,
                    else_block.statements,
                    ret_type,
                    else_label,
                    break_label,
                    continue_label,
                ))
            if !else_returns && !else_terminates {
                builder = append_owned_drops_from(ctx, builder, "", else_label + "_scope", outer_owned)
            }
            if !else_terminates {
                builder = builder.instr("br $" + end_label)
            }
            restore_owned_vars(ctx, outer_owned)
        }
        Option[ParsedBlock]::None => {
            builder = builder.instr("br $" + end_label)
        }
    }
    builder = builder.label(end_label)
    if all_paths_terminate {
        builder = builder.instr("unreachable")
    }
    ret builder
}

fn translate_while_stmt(ctx: mut TranslatorContext, while_stmt: WhileStmt, ret_type: str, prefix: str,
    idx: usize,) -> EhirTextBuilder {
    let cond_label = prefix + "_while_cond_" + Debug::fmt(idx)
    let body_label = prefix + "_while_body_" + Debug::fmt(idx)
    let end_label = prefix + "_while_end_" + Debug::fmt(idx)
    let cond_name = prefix + "_while_condv_" + Debug::fmt(idx)
    let outer_owned = ctx.owned_vars.len()

    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + cond_label)
    builder = builder.label(cond_label)
    builder = builder.append(lower_cond(ctx, while_stmt.condition, cond_name))
    builder = builder.instr("cbr " + cond_name + ", $" + body_label + ", $" + end_label)
    builder = builder.label(body_label)
    let loop_target_count = ctx.loop_targets.len()
    ctx.loop_targets.push(LoopTargetType {
            loop_label_name(while_stmt.label), end_label, cond_label, outer_owned
        }
        ,
    )
    builder = builder.append(translate_statements_no_default(
            ctx,
            while_stmt.body.statements,
            ret_type,
            body_label,
            Option[str]::Some(end_label),
            Option[str]::Some(cond_label),
        ))
    while ctx.loop_targets.len() > loop_target_count {
        ctx.loop_targets.pop()
    }
    let body_terminates = block_terminates_flow(while_stmt.body)
    if !block_always_returns(while_stmt.body) && !body_terminates {
        builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", outer_owned)
    }
    restore_owned_vars(ctx, outer_owned)
    if !body_terminates {
        builder = builder.instr("br $" + cond_label)
    }
    builder = builder.label(end_label)
    ret builder
}

fn translate_loop_stmt(ctx: mut TranslatorContext, loop_stmt: LoopStmt, ret_type: str, prefix: str, idx:
    usize,) -> EhirTextBuilder {
    let body_label = prefix + "_loop_body_" + Debug::fmt(idx)
    let end_label = prefix + "_loop_end_" + Debug::fmt(idx)
    let outer_owned = ctx.owned_vars.len()
    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + body_label)
    builder = builder.label(body_label)
    let loop_target_count = ctx.loop_targets.len()
    ctx.loop_targets.push(LoopTargetType {
            loop_label_name(loop_stmt.label), end_label, body_label, outer_owned
        }
        ,
    )
    builder = builder.append(translate_statements_no_default(
            ctx,
            loop_stmt.body.statements,
            ret_type,
            body_label,
            Option[str]::Some(end_label),
            Option[str]::Some(body_label),
        ))
    while ctx.loop_targets.len() > loop_target_count {
        ctx.loop_targets.pop()
    }
    let body_terminates = block_terminates_flow(loop_stmt.body)
    if !block_always_returns(loop_stmt.body) && !body_terminates {
        builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", outer_owned)
    }
    restore_owned_vars(ctx, outer_owned)
    if !body_terminates {
        builder = builder.instr("br $" + body_label)
    }
    builder = builder.label(end_label)
    ret builder
}

fn translate_do_while_stmt(ctx: mut TranslatorContext, do_stmt: DoWhileStmt, ret_type: str, prefix: str,
    idx: usize,) -> EhirTextBuilder {
    let body_label = prefix + "_do_body_" + Debug::fmt(idx)
    let cond_label = prefix + "_do_cond_" + Debug::fmt(idx)
    let end_label = prefix + "_do_end_" + Debug::fmt(idx)
    let cond_name = prefix + "_do_condv_" + Debug::fmt(idx)
    let outer_owned = ctx.owned_vars.len()
    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + body_label)
    builder = builder.label(body_label)
    let loop_target_count = ctx.loop_targets.len()
    ctx.loop_targets.push(LoopTargetType {
            "", end_label, cond_label, outer_owned
        }
        ,
    )
    builder = builder.append(translate_statements_no_default(
            ctx,
            do_stmt.body.statements,
            ret_type,
            body_label,
            Option[str]::Some(end_label),
            Option[str]::Some(cond_label),
        ))
    while ctx.loop_targets.len() > loop_target_count {
        ctx.loop_targets.pop()
    }
    let body_terminates = block_terminates_flow(do_stmt.body)
    if !block_always_returns(do_stmt.body) && !body_terminates {
        builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", outer_owned)
    }
    restore_owned_vars(ctx, outer_owned)
    if !body_terminates {
        builder = builder.instr("br $" + cond_label)
    }
    builder = builder.label(cond_label)
    builder = builder.append(lower_cond(ctx, do_stmt.condition, cond_name))
    builder = builder.instr("cbr " + cond_name + ", $" + body_label + ", $" + end_label)
    builder = builder.label(end_label)
    ret builder
}

fn translate_with_cleanups(ctx: mut TranslatorContext, prefix: str) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let mut index = ctx.with_cleanups.len()
    while index > 0_usize {
        index = index - 1_usize
        match ctx.with_cleanups.get(index) {
            Some(resource) => {
                builder = builder.instr(prefix + "_" + Debug::fmt(index) + ": bool = call " + method_owner_name(resource.typ)
                    + "::with_exit(" + resource.emitted_name + ")")
            }
            None => {
            }
        }
    }
    ret builder
}

fn translate_with_stmt(ctx: mut TranslatorContext, with_stmt: WithStmt, ret_type: str, prefix: str, idx:
    usize, break_label: Option[str], continue_label: Option[str],) -> EhirTextBuilder {
    let source = load_mutable_value(lower_expr(ctx, with_stmt.expr, prefix + "_with_source", idx), prefix
        + "_with_source_load",)
    let resource_type = value_type_name(source.typ)
    let resource_name = prefix + "_with_resource_" + with_stmt.name + "_" + Debug::fmt(idx)
    let mut builder = source.code
    builder = builder.instr(resource_name + ": " + resource_type + " = call " + method_owner_name(resource_type)
        + "::with_enter(" + source.value + ")")
    ctx_add_var_emitted(ctx, with_stmt.name, resource_name, resource_type)
    let cleanup_count = ctx.with_cleanups.len()
    ctx.with_cleanups.push(VarType {
            with_stmt.name, resource_name, resource_type
        }
        ,
    )
    builder = builder.append(translate_statements_no_default(ctx, with_stmt.body.statements, ret_type,
            prefix + "_with_body_" + Debug::fmt(idx), break_label, continue_label,))
    if !block_terminates_flow(with_stmt.body) {
        builder = builder.instr(prefix + "_with_exit_" + Debug::fmt(idx) + ": bool = call " + method_owner_name(resource_type)
            + "::with_exit(" + resource_name + ")")
    }
    while ctx.with_cleanups.len() > cleanup_count {
        ctx.with_cleanups.pop()
    }
    ret builder
}

fn translate_for_stmt(ctx: mut TranslatorContext, for_stmt: ForStmt, ret_type: str, prefix: str, idx:
    usize,) -> EhirTextBuilder {
    let iter_prefix = prefix + "_for_" + Debug::fmt(idx)
    let body_label = iter_prefix + "_body"
    let end_label = iter_prefix + "_end"
    let exhausted_label = iter_prefix + "_exhausted"
    let iter_slot = iter_prefix + "_iter_slot"
    let iter_value_name = iter_prefix + "_iter"
    let step_name = iter_prefix + "_step"
    let next_iter_name = iter_prefix + "_next_iter"
    let option_name = iter_prefix + "_option"
    let item_name = iter_prefix + "_item_" + for_stmt.name
    let outer_owned = ctx.owned_vars.len()

    let borrowed_iterable = expr_is_borrowed_copy(for_stmt.iterable)
    let iterable = load_mutable_value(lower_expr(ctx, for_stmt.iterable, iter_prefix + "_source", idx),
        iter_prefix + "_source_load",)
    let iter_type = iterator_type_for(iterable.typ, for_stmt.iterable.source_name, for_stmt.iterable.line,
        for_stmt.iterable.column,)
    let item_type = iterator_item_type(iter_type, for_stmt.iterable.source_name, for_stmt.iterable.line,
        for_stmt.iterable.column,)
    let option_type = "Option[" + item_type + "]"
    let step_type = "__tuple_2[" + iter_type + ", " + option_type + "]"

    let mut builder = EhirTextBuilder::new()
    builder = builder.append(iterable.code)
    if borrowed_iterable && ctx_type_needs_ownership(ctx, iterable.typ) {
        builder = builder.instr("retain " + iterable.value + ": " + iterable.typ)
    }
    let iter_generics = generic_args_from_path(iter_type)
    let generic_suffix = if iter_generics.len() == 0_usize {
        ""
    } else {
        "[" + join_strs(iter_generics, ", ") + "]"
    }
    builder = builder.instr(iter_value_name + ": " + iter_type + " = call " + iterator_iter_function(iterable.typ,
            for_stmt.iterable.source_name, for_stmt.iterable.line, for_stmt.iterable.column,) + generic_suffix
        + "(" + iterable.value + ")")
    builder = builder.instr(iter_slot + ": " + iter_type + "* = salloc " + iter_type)
    builder = builder.instr("store " + iter_value_name + ", " + iter_slot)
    if ctx_type_needs_ownership(ctx, iter_type) {
        ctx_add_owned_var(ctx, iter_prefix + "_iterator", iter_slot, "mut " + iter_type)
    }
    let body_owned = ctx.owned_vars.len()
    builder = builder.instr("br $" + body_label)
    builder = builder.label(body_label)
    builder = builder.instr(iter_value_name + "_current: " + iter_type + " = load " + iter_slot)
    builder = builder.instr(step_name + ": " + step_type + " = call " + iterator_next_function(iter_type,
            for_stmt.iterable.source_name, for_stmt.iterable.line, for_stmt.iterable.column,) + generic_suffix
        + "(" + iter_value_name + "_current)")
    builder = builder.instr(next_iter_name + ": " + iter_type + " = getfield " + step_name + " > 0")
    builder = builder.instr("store " + next_iter_name + ", " + iter_slot)
    builder = builder.instr(option_name + ": " + option_type + " = getfield " + step_name + " > 1")
    builder = builder.instr("match " + option_name + ", $" + exhausted_label + " {")
    builder = builder.instr("Some -> $" + body_label + "_some")
    builder = builder.instr("None -> $" + exhausted_label)
    builder = builder.instr("}")
    builder = builder.label(body_label + "_some")
    builder = builder.instr(item_name + ": " + item_type + " = getfield " + option_name + " > Some")
    ctx_add_var_emitted(ctx, for_stmt.name, item_name, item_type)
    if ctx_type_needs_ownership(ctx, item_type) {
        builder = builder.instr("retain " + item_name + ": " + item_type)
        ctx_add_owned_var(ctx, for_stmt.name, item_name, item_type)
    }
    builder = builder.instr("drop " + option_name + ": " + option_type)
    let loop_target_count = ctx.loop_targets.len()
    ctx.loop_targets.push(LoopTargetType {
            loop_label_name(for_stmt.label), end_label, body_label, body_owned
        }
        ,
    )
    builder = builder.append(translate_statements_no_default(
            ctx,
            for_stmt.body.statements,
            ret_type,
            body_label + "_some",
            Option[str]::Some(end_label),
            Option[str]::Some(body_label),
        ))
    while ctx.loop_targets.len() > loop_target_count {
        ctx.loop_targets.pop()
    }
    let body_terminates = block_terminates_flow(for_stmt.body)
    if !block_always_returns(for_stmt.body) && !body_terminates {
        builder = append_owned_drops_from(ctx, builder, "", body_label + "_scope", body_owned)
    }
    restore_owned_vars(ctx, body_owned)
    if !body_terminates {
        builder = builder.instr("br $" + body_label)
    }
    builder = builder.label(exhausted_label)
    builder = builder.instr("drop " + option_name + ": " + option_type)
    builder = builder.instr("br $" + end_label)
    builder = builder.label(end_label)
    let final_iter_name = iter_prefix + "_final_iter"
    builder = builder.instr(final_iter_name + ": " + iter_type + " = load " + iter_slot)
    if ctx_type_needs_ownership(ctx, iter_type) {
        builder = builder.instr("drop " + final_iter_name + ": " + iter_type)
    }
    restore_owned_vars(ctx, outer_owned)
    ret builder
}

fn iterator_type_for(iterable_type: str, source_name: str, line: usize, column: usize) -> str {
    let owner = method_owner_name(iterable_type)
    if owner == "Vec" {
        ret "VecIter[" + first_generic_type(iterable_type) + "]"
    }
    if owner == "VecIter" {
        ret iterable_type
    }
    if owner == "Range" {
        ret "Range"
    }
    if owner == "Enumerate" {
        ret iterable_type
    }
    translation_error_at(source_name, line, column, "not-iterable", "type '" + iterable_type + "' cannot be iterated")
    ret "void"
}

fn iterator_item_type(iter_type: str, source_name: str, line: usize, column: usize) -> str {
    let owner = method_owner_name(iter_type)
    if owner == "VecIter" {
        ret first_generic_type(iter_type)
    }
    if owner == "Range" {
        ret "usize"
    }
    if owner == "Enumerate" {
        ret "__tuple_2[usize, " + nth_generic_type(iter_type, 0_usize) + "]"
    }
    translation_error_at(source_name, line, column, "invalid-iterator", "cannot resolve item type for iterator '"
        + iter_type + "'",)
    ret "void"
}

fn iterator_iter_function(iterable_type: str, source_name: str, line: usize, column: usize) -> str {
    let owner = method_owner_name(iterable_type)
    if owner == "Vec" {
        ret "Vec::iter"
    }
    if owner == "VecIter" {
        ret "VecIter::iter"
    }
    if owner == "Range" {
        ret "Range::iter"
    }
    if owner == "Enumerate" {
        ret "Enumerate::iter"
    }
    translation_error_at(source_name, line, column, "invalid-iterator", "cannot resolve iter function for type '"
        + iterable_type + "'",)
    ret ""
}

fn iterator_next_function(iter_type: str, source_name: str, line: usize, column: usize) -> str {
    let owner = method_owner_name(iter_type)
    if owner == "VecIter" {
        ret "VecIter::next"
    }
    if owner == "Range" {
        ret "Range::next"
    }
    if owner == "Enumerate" {
        ret "Enumerate::next"
    }
    translation_error_at(source_name, line, column, "invalid-iterator", "cannot resolve next function for iterator '"
        + iter_type + "'",)
    ret ""
}

fn translate_params(fn_item: FunctionItem) -> str {
    let mut out = ""
    let mut i = 0_usize
    for param in fn_item.params {
        if i > 0_usize {
            out = out + ", "
        }
        let t = abi_parameter_type(canonical_type(unwrap_type_or_usize(param.typ)))
        out = out + param.name + ": " + t
        i = i + 1_usize
    }
    ret out
}

fn translate_params_in_context(ctx: mut TranslatorContext, fn_item: FunctionItem) -> str {
    let mut out = ""
    let mut i = 0_usize
    for param in fn_item.params {
        if i > 0_usize {
            out = out + ", "
        }
        let typ = abi_parameter_type(self_context_type(ctx,
                canonical_type(unwrap_type_or_usize(param.typ)),))
        out = out + param.name + ": " + typ
        i = i + 1_usize
    }
    ret out
}

fn abi_parameter_type(typ: str) -> str {
    let value = canonical_type(typ)
    if starts_with(value, "mut ") && ends_with(value, "&") {
        ret value.slice(4_usize, value.len() - 4_usize)
    }
    ret value
}

fn translate_generic_params(params: Vec[GenericParam]) -> str {
    let mut names = Vec[str]::new()
    for param in params {
        names.push(param.name)
    }
    ret join_strs(names, ", ")
}

fn function_ret_type(fn_item: FunctionItem) -> str {
    match fn_item.ret_type {
        Option[str]::Some(rt) => {
            ret canonical_type(rt)
        }
        Option[str]::None => {
            ret "void"
        }
    }
    ret "void"
}

fn function_ret_type_for_owner(fn_item: FunctionItem, owner: str) -> str {
    ret owner_context_type(owner, function_ret_type(fn_item))
}

fn canonical_type(typ: str) -> str {
    if starts_with(typ, "[") && ends_with(typ, "]") {
        let inner = typ.slice(1_usize, typ.len() - 2_usize)
        let separator = find_char(inner, ";", 0_usize)
        if separator < inner.len() {
            let item_type = trim_spaces(inner.slice(0_usize, separator))
            let size = trim_spaces(inner.slice(separator + 1_usize, inner.len() - separator - 1_usize))
            ret "__array_" + numeric_literal_value(size) + "[" + canonical_type(item_type) + "]"
        }
    }
    if starts_with(typ, "(") && ends_with(typ, ")") {
        let inner = typ.slice(1_usize, typ.len() - 2_usize)
        let comma = find_top_level_comma(inner)
        if comma < inner.len() {
            let items = canonical_type_list(inner)
            let arity = generic_args_from_path("__tuple[" + items + "]").len()
            ret "__tuple_" + Debug::fmt(arity) + "[" + items + "]"
        }
    }
    let open = find_char(typ, "[", 0_usize)
    if open < typ.len() && ends_with(typ, "]") {
        let owner = typ.slice(0_usize, open)
        let inner = typ.slice(open + 1_usize, typ.len() - open - 2_usize)
        ret owner + "[" + canonical_type_list(inner) + "]"
    }
    ret typ
}

fn canonical_type_list(value: str) -> str {
    let mut parts = Vec[str]::new()
    let mut start = 0_usize
    let mut depth_square = 0_usize
    let mut depth_paren = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "[" {
            depth_square = depth_square + 1_usize
        } elif ch == "]" {
            if depth_square > 0_usize {
                depth_square = depth_square - 1_usize
            }
        } elif ch == "(" {
            depth_paren = depth_paren + 1_usize
        } elif ch == ")" {
            if depth_paren > 0_usize {
                depth_paren = depth_paren - 1_usize
            }
        } elif ch == "," && depth_square == 0_usize && depth_paren == 0_usize {
            parts.push(canonical_type(trim_spaces(value.slice(start, index - start))))
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    if start < value.len() {
        parts.push(canonical_type(trim_spaces(value.slice(start, value.len() - start))))
    }
    ret join_strs(parts, ", ")
}

fn find_top_level_comma(value: str) -> usize {
    let mut depth_square = 0_usize
    let mut depth_paren = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "[" {
            depth_square = depth_square + 1_usize
        } elif ch == "]" {
            if depth_square > 0_usize {
                depth_square = depth_square - 1_usize
            }
        } elif ch == "(" {
            depth_paren = depth_paren + 1_usize
        } elif ch == ")" {
            if depth_paren > 0_usize {
                depth_paren = depth_paren - 1_usize
            }
        } elif ch == "," && depth_square == 0_usize && depth_paren == 0_usize {
            ret index
        }
        index = index + 1_usize
    }
    ret value.len()
}

fn function_has_attr(item: FunctionItem, expected: str) -> bool {
    for attr in item.attrs {
        if attr == expected {
            ret true
        }
    }
    ret false
}

fn function_is_decorator_definition(item: FunctionItem) -> bool {
    ret function_has_attr(item, "decorator")
}

fn function_is_active(item: FunctionItem, target: TargetSpec, features: Vec[str]) -> bool {
    for attr in item.attrs {
        if contains_substring(attr, "test") {
            ret false
        }
        if starts_with(attr, "cfg:") {
            let expr = attr.slice(4_usize, attr.len() - 4_usize)
            if !cfg_active_with_features(target, expr, features) {
                ret false
            }
        }
    }
    ret true
}

fn unwrap_type_or_usize(typ: Option[str]) -> str {
    match typ {
        Option[str]::Some(value) => {
            ret canonical_type(value)
        }
        Option[str]::None => {
            ret "usize"
        }
    }
    ret "usize"
}

fn validate_frozen_return(ctx: mut TranslatorContext, typ: str, path: str, value: str,
    source_name: str, line: usize, column: usize,) ->() {
    if thread_type_is_send(ctx, typ, Vec[str]::new()) {
        ret()
    }
    if !thread_type_is_freezable_region(ctx, typ) {
        translation_error_at(source_name, line, column, "non-freezable-region",
            "return type '" + canonical_type(typ) + "' is not a supported immutable region",)
    }
    if ctx_value_is_frozen(ctx, value) || ctx_path_is_frozen(ctx, path) {
        ret()
    }
    if path == "" {
        translation_error_at(source_name, line, column, "frozen-return-requires-root",
            "a frozen return must be an already frozen projection or a named exclusive region",)
    }
    let region = ctx_lookup_var_region(ctx, path)
    if region == 0_usize || ctx_region_is_connected(ctx, region) ||
    contains_usize(ctx.borrowed_input_regions, region) {
        translation_error_at(source_name, line, column, "connected-region-freeze",
            "cannot return '" + path + "' as frozen because its region may remain reachable",)
    }
    ctx_mark_region_frozen(ctx, region)
    ret()
}

fn translate_owned_ret_expr(ctx: mut TranslatorContext, expr: ExprNode, ret_type: str, result_prefix:
    str,) -> EhirTextBuilder {
    if ctx.async_poll_future_type != "" {
        ret translate_async_ready_ret(ctx, expr, ret_type, result_prefix)
    }
    let mut exclude_name = returned_owner_name(ctx, expr)
    if exclude_name != "" {
        match ctx_lookup_var(ctx, exclude_name) {
            Option[str]::Some(owner_type) => {
                if starts_with(owner_type, "mut ") {
                    exclude_name = ""
                }
            }
            Option[str]::None => {
            }
        }
    }
    let borrowed_copy = expr_is_borrowed_copy(expr)
    ctx.expression_hint = canonical_type(ret_type)
    let lowered = load_mutable_value(lower_expr(ctx, expr, result_prefix + "_expr", 0_usize), result_prefix
        + "_load",)
    ctx.expression_hint = ""
    let numeric_coercion = is_numeric_type(value_type_name(lowered.typ)) && is_numeric_type(value_type_name(ret_type))
    if !numeric_coercion && !function_type_matches(ret_type, lowered.typ, Vec[str]::new()) {
        translation_error_at(expr.source_name, expr.line, expr.column, "return-type-mismatch", "cannot return value of type '"
            + canonical_type(value_type_name(lowered.typ)) + "' from function returning '" + canonical_type(value_type_name(ret_type))
            + "'",)
    }
    if ctx.return_is_sending {
        let _consumes_return = validate_sending_argument(ctx, lowered.typ, expr_path_or_empty(expr),
            expr.source_name, expr.line, expr.column,)
    }
    if ctx.return_is_frozen {
        validate_frozen_return(ctx, lowered.typ, expr_path_or_empty(expr), lowered.value,
            expr.source_name, expr.line, expr.column,)
    }
    let mut builder = lowered.code
    builder = builder.append(translate_with_cleanups(ctx, result_prefix + "_with_cleanup"))
    if borrowed_copy && exclude_name == "" && ctx_type_needs_ownership(ctx, lowered.typ) {
        builder = builder.instr("retain " + lowered.value + ": " + lowered.typ)
    }
    if exclude_name != "" && expr_path_or_empty(expr) == "" {
        match ctx_lookup_var(ctx, exclude_name) {
            Option[str]::Some(owner_type) => {
                let owner_value = ctx_lookup_value_name(ctx, exclude_name)
                if starts_with(owner_type, "mut ") {
                    let value_type = value_type_name(owner_type)
                    let loaded = result_prefix + "_moved_owner"
                    builder = builder.instr(loaded + ": " + value_type + " = load " + owner_value)
                    builder = builder.instr("drop " + loaded + ": " + value_type)
                } else {
                    builder = builder.instr("drop " + owner_value + ": " + owner_type)
                }
            }
            Option[str]::None => {
            }
        }
    }
    builder = append_owned_drops(ctx, builder, exclude_name, result_prefix)
    if is_numeric_type(lowered.typ) && is_numeric_type(ret_type) && lowered.typ != ret_type {
        let casted = result_prefix + "_coerce"
        builder = builder.instr(casted + ": " + ret_type + " = pcast " + lowered.value + ": " + lowered.typ
            + ", " + ret_type)
        ret builder.instr("ret " + casted + ": " + ret_type)
    }
    ret builder.instr("ret " + lowered.value + ": " + ret_type)
}

fn translate_async_ready_ret(ctx: mut TranslatorContext, expr: ExprNode, output_type: str, result_prefix:
    str,) -> EhirTextBuilder {
    let exclude_name = returned_owner_name(ctx, expr)
    let borrowed_copy = expr_is_borrowed_copy(expr)
    ctx.expression_hint = canonical_type(output_type)
    let mut lowered = load_mutable_value(lower_expr(ctx, expr, result_prefix + "_expr", 0_usize), result_prefix
        + "_load",)
    ctx.expression_hint = ""
    let numeric_coercion = is_numeric_type(value_type_name(lowered.typ)) && is_numeric_type(value_type_name(output_type))
    if !numeric_coercion && !function_type_matches(output_type, lowered.typ, Vec[str]::new()) {
        translation_error_at(expr.source_name, expr.line, expr.column, "return-type-mismatch", "cannot return value of type '"
            + canonical_type(value_type_name(lowered.typ)) + "' from async function returning '" + canonical_type(value_type_name(output_type))
            + "'",)
    }
    if ctx.return_is_sending {
        let _consumes_return = validate_sending_argument(ctx, lowered.typ, expr_path_or_empty(expr),
            expr.source_name, expr.line, expr.column,)
    }
    if ctx.return_is_frozen {
        validate_frozen_return(ctx, lowered.typ, expr_path_or_empty(expr), lowered.value,
            expr.source_name, expr.line, expr.column,)
    }
    let mut builder = lowered.code
    if is_numeric_type(lowered.typ) && is_numeric_type(output_type) && lowered.typ != output_type {
        let casted = result_prefix + "_coerce"
        builder = builder.instr(casted + ": " + output_type + " = pcast " + lowered.value + ": " + lowered.typ
            + ", " + output_type)
        lowered = LoweredExpr {
            EhirTextBuilder::new(), casted, output_type
        }
    }
    if borrowed_copy && exclude_name == "" && ctx_type_needs_ownership(ctx, lowered.typ) {
        builder = builder.instr("retain " + lowered.value + ": " + lowered.typ)
    }
    let poll_type = "Poll[" + ctx.async_poll_future_type + ", " + output_type + "]"
    let ready_value = result_prefix + "_ready"
    builder = builder.instr(ready_value + ": " + poll_type + " = capenum " + poll_type + "::Ready(" +
        lowered.value + ")")
    builder = builder.append(translate_with_cleanups(ctx, result_prefix + "_with_cleanup"))
    builder = append_owned_drops(ctx, builder, exclude_name, result_prefix)
    ret builder.instr("ret " + ready_value + ": " + poll_type)
}

fn returned_owner_name(ctx: mut TranslatorContext, expr: ExprNode) -> str {
    let direct = expr_path_or_empty(expr)
    if direct != "" {
        ret direct
    }
    match expr.value {
        Expr::Call(call_expr) => {
            let callee = expr_h_path_or_empty(call_expr.callee)
            match ctx_enum_variant_owner(ctx, callee) {
                Option[str]::Some(_) => {
                    if call_expr.args.len() == 1_usize {
                        match call_expr.args.get(0_usize) {
                            Option[ExprNode]::Some(arg) => {
                                ret expr_path_or_empty(arg)
                            }
                            Option[ExprNode]::None => {
                            }
                        }
                    }
                }
                Option[str]::None => {
                }
            }
        }
        Expr::StructInit(init_expr) => {
            if init_expr.values.len() == 1_usize {
                match init_expr.values.get(0_usize) {
                    Option[ExprNode]::Some(arg) => {
                        ret expr_path_or_empty(arg)
                    }
                    Option[ExprNode]::None => {
                    }
                }
            }
        }
        _ => {
        }
    }
    ret ""
}

fn translate_ret_expr(ctx: mut TranslatorContext, expr: ExprNode, ret_type: str, result_prefix: str)
-> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    match expr.value {
        Expr::Integer(v) => {
            builder = builder.instr(result_prefix + ": " + ret_type + " = capprim " + with_numeric_suffix(v,
                    ret_type,))
            ret builder.instr("ret " + result_prefix + ": " + ret_type)
        }
        Expr::Float(v) => {
            builder = builder.instr(result_prefix + ": " + ret_type + " = capprim " + with_numeric_suffix(v,
                    ret_type,))
            ret builder.instr("ret " + result_prefix + ": " + ret_type)
        }
        Expr::StringLiteral(v) => {
            builder = builder.instr(result_prefix + ": str = capprim \"" + escape_str(string_token_body(v))
                + "\"_str")
            ret builder.instr("ret " + result_prefix + ": str")
        }
        Expr::Boolean(v) => {
            let mut lit = "0_u1"
            if v {
                lit = "1_u1"
            }
            builder = builder.instr(result_prefix + ": bool = capprim " + lit)
            ret builder.instr("ret " + result_prefix + ": bool")
        }
        Expr::Path(name) => {
            match ctx_enum_variant_owner(ctx, name) {
                Option[str]::Some(_) => {
                    ctx.expression_hint = canonical_type(ret_type)
                    let lowered = lower_expr(ctx, expr, result_prefix + "_expr", 0_usize)
                    ctx.expression_hint = ""
                    builder = builder.append(lowered.code)
                    ret builder.instr("ret " + lowered.value + ": " + ret_type)
                }
                Option[str]::None => {
                }
            }
            ret builder.instr("ret " + ctx_lookup_value_name(ctx, name) + ": " + ret_type)
        }
        _ => {
            ctx.expression_hint = canonical_type(ret_type)
            let lowered = lower_expr(ctx, expr, result_prefix + "_expr", 0_usize)
            ctx.expression_hint = ""
            builder = builder.append(lowered.code)
            ret builder.instr("ret " + lowered.value + ": " + ret_type)
        }
    }
}

fn translate_default_ret(ret_type: str) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    if ret_type == "void" || ret_type == "()" {
        ret builder.instr("ret void: ()")
    }
    if ret_type == "str" {
        builder = builder.instr("_ret: str = capprim \"\"_str")
        ret builder.instr("ret _ret: str")
    }
    if ret_type == "bool" {
        builder = builder.instr("_ret: bool = capprim 0_u1")
        ret builder.instr("ret _ret: bool")
    }
    if base_type_name(ret_type) == "Option" {
        builder = builder.instr("_ret: " + ret_type + " = capenum " + ret_type + "::None")
        ret builder.instr("ret _ret: " + ret_type)
    }
    if !is_numeric_type(ret_type) {
        ret builder.instr("unreachable")
    }
    builder = builder.instr("_ret: " + ret_type + " = capprim " + with_numeric_suffix("0", ret_type))
    ret builder.instr("ret _ret: " + ret_type)
}

fn is_numeric_type(typ: str) -> bool {
    if typ == "usize" {
        ret true
    }
    if typ == "isize" {
        ret true
    }
    if typ == "u8" {
        ret true
    }
    if typ == "u16" {
        ret true
    }
    if typ == "u32" {
        ret true
    }
    if typ == "u64" {
        ret true
    }
    if typ == "i8" {
        ret true
    }
    if typ == "i16" {
        ret true
    }
    if typ == "i32" {
        ret true
    }
    if typ == "i64" {
        ret true
    }
    if typ == "f32" {
        ret true
    }
    if typ == "f64" {
        ret true
    }
    ret false
}

fn with_numeric_suffix(value: str, typ: str) -> str {
    let numeric = numeric_literal_value(value)
    let explicit = numeric_literal_suffix(value)
    if explicit != "" {
        ret numeric + explicit
    }
    if ends_with(typ, "usize") {
        ret numeric + "_usize"
    }
    if ends_with(typ, "isize") {
        ret numeric + "_isize"
    }
    if starts_with(typ, "u") {
        ret numeric + "_" + typ
    }
    if starts_with(typ, "i") {
        ret numeric + "_" + typ
    }
    if starts_with(typ, "f") {
        ret numeric + "_" + typ
    }
    ret numeric + "_usize"
}

fn integer_literal_type(value: str) -> str {
    if ends_with(value, "_usize") {
        ret "usize"
    }
    if ends_with(value, "_isize") {
        ret "isize"
    }
    if ends_with(value, "_u8") {
        ret "u8"
    }
    if ends_with(value, "_u16") {
        ret "u16"
    }
    if ends_with(value, "_u32") {
        ret "u32"
    }
    if ends_with(value, "_u64") {
        ret "u64"
    }
    if ends_with(value, "_i8") {
        ret "i8"
    }
    if ends_with(value, "_i16") {
        ret "i16"
    }
    if ends_with(value, "_i32") {
        ret "i32"
    }
    if ends_with(value, "_i64") {
        ret "i64"
    }
    if ends_with(value, "_f32") {
        ret "f32"
    }
    if ends_with(value, "_f64") {
        ret "f64"
    }
    ret "usize"
}

fn numeric_literal_value(value: str) -> str {
    let mut index = 0_usize
    while index < value.len() {
        if value.slice(index, 1_usize) == "_" {
            ret radix_literal_to_decimal(value.slice(0_usize, index))
        }
        index = index + 1_usize
    }
    ret radix_literal_to_decimal(value)
}

fn numeric_literal_suffix(value: str) -> str {
    let mut index = 0_usize
    while index < value.len() {
        if value.slice(index, 1_usize) == "_" {
            ret value.slice(index, value.len() - index)
        }
        index += 1_usize
    }
    ret ""
}

fn radix_literal_to_decimal(value: str) -> str {
    if value.len() < 3_usize || value.slice(0_usize, 1_usize) != "0" {
        ret value
    }
    let prefix = value.slice(1_usize, 1_usize)
    let base = if prefix == "x" || prefix == "X" {
        16_u32
    } else {
        if prefix == "b" || prefix == "B" {
            2_u32
        } else {
            if prefix == "o" || prefix == "O" {
                8_u32
            } else {
                0_u32
            }
        }
    }
    if base == 0_u32 {
        ret value
    }
    let mut decimal = "0"
    let mut index = 2_usize
    while index < value.len() {
        decimal = decimal_multiply_add(decimal, base,
            translator_radix_digit(value.slice(index, 1_usize)),)
        index += 1_usize
    }
    ret decimal
}

fn translator_radix_digit(value: str) -> u32 {
    if value.len() != 1_usize {
        ret 0_u32
    }
    let code = value.byte_at(0_usize)
    if code >= 48_u8 && code <= 57_u8 {
        ret(code - 48_u8) as u32
    }
    if code >= 65_u8 && code <= 70_u8 {
        ret(code - 65_u8) as u32 + 10_u32
    }
    if code >= 97_u8 && code <= 102_u8 {
        ret(code - 97_u8) as u32 + 10_u32
    }
    ret 0_u32
}

fn decimal_multiply_add(value: str, multiplier: u32, addition: u32) -> str {
    let mut reversed = ""
    let mut carry = addition
    let mut index = value.len()
    while index > 0_usize {
        index -= 1_usize
        let digit =(value.byte_at(index) - 48_u8) as u32
        let product = digit * multiplier + carry
        reversed += Debug::fmt(product % 10_u32)
        carry = product / 10_u32
    }
    while carry > 0_u32 {
        reversed += Debug::fmt(carry % 10_u32)
        carry = carry / 10_u32
    }
    let mut out = ""
    index = reversed.len()
    while index > 0_usize {
        index -= 1_usize
        out += reversed.slice(index, 1_usize)
    }
    ret out
}

fn decimal_usize(value: str) -> usize {
    let mut out = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        let digit = value.slice(index, 1_usize)
        out = out * 10_usize + decimal_digit(digit)
        index = index + 1_usize
    }
    ret out
}

fn decimal_digit(value: str) -> usize {
    if value == "0" {
        ret 0_usize
    }
    if value == "1" {
        ret 1_usize
    }
    if value == "2" {
        ret 2_usize
    }
    if value == "3" {
        ret 3_usize
    }
    if value == "4" {
        ret 4_usize
    }
    if value == "5" {
        ret 5_usize
    }
    if value == "6" {
        ret 6_usize
    }
    if value == "7" {
        ret 7_usize
    }
    if value == "8" {
        ret 8_usize
    }
    if value == "9" {
        ret 9_usize
    }
    translation_invariant_error("invalid decimal array size '" + value + "' reached lowering")
    ret 0_usize
}

fn join_strs(items: Vec[str], sep: str) -> str {
    let mut out = ""
    let mut i = 0_usize
    for item in items {
        if i > 0_usize {
            out = out + sep
        }
        out = out + item
        i = i + 1_usize
    }
    ret out
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn append_ehir_documentation(builder: EhirTextBuilder, documentation: Option[Documentation], prefix:
    str,) -> EhirTextBuilder {
    let mut out = builder
    match documentation {
        Option[Documentation]::Some(doc) => {
            let mut line = prefix
            let mut has_text = false
            let mut index = 0_usize
            while index < doc.text.char_len() {
                match doc.text.get(index) {
                    Option[str]::Some(ch) => {
                        if ch == "\n" {
                            out = out.line(line)
                            line = prefix
                            has_text = false
                        } else {
                            if !has_text {
                                line = line + " " has_text = true
                            }
                            line = line + ch
                        }
                    }
                    Option[str]::None => {
                        break
                    }
                }
                index += 1_usize
            }
            out = out.line(line)
        }
        Option[Documentation]::None => {
        }
    }
    ret out
}

fn contains_substring(value: str, needle: str) -> bool {
    ret unsafe {
        encore_compiler_str_contains(value, needle)
    }
}

fn contains_str(values: Vec[str], needle: str) -> bool {
    for value in values {
        if value == needle {
            ret true
        }
    }
    ret false
}

fn copy_str_vec(values: Vec[str]) -> Vec[str] {
    let mut copied = Vec[str]::new()
    for value in values {
        copied.push(value)
    }
    ret copied
}

fn find_char(value: str, needle: str, start: usize) -> usize {
    let mut index = start
    while index < value.len() {
        if value.slice(index, 1_usize) == needle {
            ret index
        }
        index = index + 1_usize
    }
    ret value.len()
}

fn ends_with(value: str, suffix: str) -> bool {
    if suffix.len() > value.len() {
        ret false
    }
    let start = value.len() - suffix.len()
    ret value.slice(start, suffix.len()) == suffix
}

fn trim_spaces(value: str) -> str {
    let mut start = 0_usize
    while start < value.len() && value.slice(start, 1_usize) == " " {
        start = start + 1_usize
    }
    let mut end = value.len()
    while end > start && value.slice(end - 1_usize, 1_usize) == " " {
        end = end - 1_usize
    }
    ret value.slice(start, end - start)
}

fn escape_str(value: str) -> str {
    let mut out = ""
    let mut i = 0_usize
    loop {
        match value.get(i) {
            Option[str]::Some(ch) => {
                if ch == "\\" {
                    out = out + "\\\\"
                } elif ch == "\"" {
                    out = out + "\\\""
                } elif ch == "\n" {
                    out = out + "\\n"
                } else {
                    out = out + ch
                }
                i = i + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }
    ret out
}

extern fn encore_unescape_string_literal(value: str) -> str

fn string_token_body(value: str) -> str {
    let chars = value.char_len()
    if chars >= 2_usize && value.slice(0_usize, 1_usize) == "\"" && value.slice(chars - 1_usize, 1_usize)
    == "\"" {
        ret unsafe {
            encore_unescape_string_literal(value.slice(1_usize, chars - 2_usize))
        }
    }
    ret unsafe {
        encore_unescape_string_literal(value)
    }
}

#attr(test)
fn module_function_overload_contract() -> bool {
    let source = "fn draw(value: u32) -> u32 { ret value }\nfn draw(value: str) -> str { ret value }\nfn main() -> u32 { let a = canvas::draw(7_u32)\nlet b = fonts::draw(\"Roboto\")\nret a }"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    ret output.contains("__draw(value: u32) -> u32")
    && output.contains("__draw__overload_1(value: str) -> str")
    && output.contains("call __encore_m")
    && output.contains("__draw__overload_1(")
}

#attr(test)
fn module_function_identity_contract() -> bool {
    let mut lexer_a = Lexer::new()
    let mut parser_a = Parser::new_for_source("alpha.enq")
    let mut ast = parser_a.parse(lexer_a.tokenize(
            "fn label() -> u32 { ret 11_u32 }\nfn alpha_value() -> u32 { ret label() }"))
    let mut lexer_b = Lexer::new()
    let mut parser_b = Parser::new_for_source("beta.enq")
    ast.extend(parser_b.parse(lexer_b.tokenize(
                "fn label() -> u32 { ret 22_u32 }\nfn beta_value() -> u32 { ret label() }")))
    let output = translate_to_ehir(ast)
    let alpha = "__encore_m616c7068612e656e71__"
    let beta = "__encore_m626574612e656e71__"
    ret output.contains("fn " + alpha + "label() -> u32")
    && output.contains("fn " + beta + "label() -> u32")
    && output.contains("call " + alpha + "label(")
    && output.contains("call " + beta + "label(")
}

#attr(test)
fn nested_generic_module_dispatch_contract() -> bool {
    let mut lexer_a = Lexer::new()
    let mut parser_a = Parser::new_for_source("collections.enq")
    let ast_a = parser_a.parse(lexer_a.tokenize(
            "struct Vec[T] { value: T }\nfn append[T](left: Vec[T], right: Vec[T]) -> Vec[T] { ret left }"))
    let mut lexer_b = Lexer::new()
    let mut parser_b = Parser::new_for_source("consumer.enq")
    let ast_b = parser_b.parse(lexer_b.tokenize(
            "fn combine(values: Vec[u32]) -> Vec[u32] { ret append(values, values) }"))
    let mut imports_a = Vec[str]::new()
    let mut imports_b = Vec[str]::new()
    imports_b.push("collections")
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule {
            "collections", "collections.enq", Option[Documentation]::None, imports_a, ast_a, Vec[str]::new()
        }
        ,
    )
    modules.push(TranslationModule {
            "consumer", "consumer.enq", Option[Documentation]::None, imports_b, ast_b, Vec[str]::new()
        }
        ,
    )
    let output = translate_modules_to_ehir(modules, host_target())
    let collections = "__encore_m636f6c6c656374696f6e73__"
    ret output.contains("fn " + collections + "append[T](left: Vec[T], right: Vec[T]) -> Vec[T]") &&
    output.contains("call " + collections + "append[u32](")
}

#attr(test)
fn borrowed_method_return_contract() -> bool {
    let source = "struct Item { value: str }\nstruct Store { item: Item }\nstruct State { store: Store }\nimpl for Store {\n#attr(borrowed_return)\nfn peek(self: Store) -> Item { ret self.item }\n}\nfn main() -> u32 {\nlet state = State{Store{Item{\"alive\"}}}\nlet item = state.store.peek()\nret item.value.len() as u32\n}"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    ret output.contains("call Store::peek(")
    && output.contains("retain entry_let_method_1: Item")
}
