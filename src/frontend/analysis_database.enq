//! Maintains typed incremental analysis state for Encore modules.

import core::fmt::Debug
import core::option::Option
import std::dict::Hashable
import std::vec::Vec

import refrain::frontend::analysis::DiagnosticLabelKind
import refrain::frontend::analysis::FrontendDocument
import refrain::frontend::analysis::FrontendSymbol
import refrain::frontend::analysis::analyze_module_lightweight
import refrain::frontend::analysis::analyze_named_module
import refrain::frontend::analysis::analyze_named_tokens
import refrain::frontend::hir::{DefinitionId, DefinitionKind, DefinitionNamespace, HirDefinition, ModuleDefMap, TypeId, definition_id}
import refrain::frontend::lexer::Token
import refrain::frontend::lexer::TokenType
import refrain::frontend::parser::{FunctionItem, Statement}
import refrain::frontend::semantic::{SemanticBody, SemanticCallable, SemanticDependency, SemanticField, SemanticMethod, check_function_body, check_module_bodies, check_module_declarations}
import refrain::frontend::syntax::SyntaxDocument
import refrain::target::{TargetSpec, host_target}

extern fn encore_strset_new() -> usize
extern fn encore_strset_insert(set: usize, value: str) -> bool
extern fn encore_strset_contains(set: usize, value: str) -> bool
extern fn encore_strset_free(set: usize) ->()
extern fn encore_strmap_new() -> usize
extern fn encore_strmap_put(map: usize, key: str, value: usize) ->()
extern fn encore_strmap_get(map: usize, key: str) -> usize
extern fn encore_strmap_free(map: usize) ->()

/// Deterministic identity of a module across analysis database instances.
pub struct ModuleId {
    raw: u64 key: str
}

/// Deterministic identity of a scoped declaration across database instances.
pub struct SymbolId {
    raw: u64 key: str
}

struct AnalysisSymbolIdentity {
    name: str
    kind: usize
    ordinal: usize
    id: SymbolId
}

struct AnalysisSource {
    id: ModuleId
    module_name: str
    source_name: str
    source: str
    source_fingerprint: u64
    interface_fingerprint: u64
    interface_revision: usize
    lightweight: FrontendDocument
    full: FrontendDocument
    full_dirty: bool
    analysis_revision: usize
    lightweight_count: usize
    parse_count: usize
    syntax: SyntaxDocument
    syntax_dirty: bool
    syntax_count: usize
}

struct SemanticBodyCache {
    id: SymbolId
    module_name: str
    symbol_name: str
    body_fingerprint: u64
    result: SemanticBody
    count: usize
}

struct DefMapCache {
    module_name: str
    interface_fingerprint: u64
    result: ModuleDefMap
    count: usize
}

/// Caches analysis queries and invalidates dependants only when a module's
/// declaration interface changes.
pub struct AnalysisDatabase {
    sources: Vec[AnalysisSource]
    semantic_bodies: Vec[SemanticBodyCache]
    def_maps: Vec[DefMapCache]
    revision: usize
}

/// Associates a stable identity and declaring module with a frontend symbol.
pub struct AnalysisSymbol {
    id: SymbolId
    module_id: ModuleId
    module_name: str
    symbol: FrontendSymbol
}

/// Immutable, thread-safe input for checking one module outside the mutable
/// analysis database.
pub struct PreparedSemanticModule {
    module_name: str
    source_name: str
    source: str
    target: TargetSpec
    features: Vec[str]
    callables: Vec[SemanticCallable]
    fields: Vec[SemanticField]
    methods: Vec[SemanticMethod]
    resolution_diagnostics: Vec[FrontendDiagnostic]
}

/// Immutable module input used to assemble an isolated semantic workspace.
pub struct AnalysisSourceSnapshot {
    module_name: str
    source_name: str
    source: str
}

/// Immutable source snapshot for a complete semantic check on a worker.
pub struct PreparedSemanticWorkspace {
    module_name: str
    sources: Vec[AnalysisSourceSnapshot]
}

impl for AnalysisSourceSnapshot {
    /// Creates one canonical source entry for a tooling semantic snapshot.
    pub fn new(module_name: str, source_name: str, source: str) -> Self {
        ret Self {
            module_name, source_name, source
        }
    }
}

/// Freezes resolved source entries for checking on a worker thread.
pub fn prepare_semantic_workspace_from_sources(module_name: str,
    sources: Vec[AnalysisSourceSnapshot],) -> sending PreparedSemanticWorkspace {
    ret PreparedSemanticWorkspace {
        module_name, sources
    }
}

/// Owns a completed tolerant module analysis which can be produced on a
/// worker thread and installed into the mutable database by its owner.
pub struct PreparedLightweightModule {
    module_name: str
    source_name: str
    source: str
    source_fingerprint: u64
    interface_fingerprint: u64
    document: FrontendDocument
}

/// Computes the complete tolerant per-module query without accessing an
/// analysis database or filesystem.
pub fn prepare_lightweight_module(module_name: str, source_name: str, source: str) -> sending PreparedLightweightModule {
    let document = analyze_module_lightweight(module_name, source)
    ret PreparedLightweightModule {
        module_name,
        source_name,
        source,
        source.hash(),
        module_interface_fingerprint(document.tokens),
        document
    }
}

/// Wraps a validated editor cache entry for installation in an analysis database.
pub fn prepare_cached_lightweight_module(module_name: str, source_name: str, source: str,
    document: sending FrontendDocument,) -> sending PreparedLightweightModule {
    ret PreparedLightweightModule {
        module_name,
        source_name,
        source,
        source.hash(),
        module_interface_fingerprint(document.tokens),
        document
    }
}

impl for PreparedLightweightModule {
    /// Returns the completed tolerant frontend document.
    pub fn document(self: Self) -> FrontendDocument {
        ret self.document
    }
}

/// Checks one prepared module without reading or mutating an analysis database.
pub fn check_prepared_semantic_module(prepared: PreparedSemanticModule) -> Vec[FrontendDiagnostic] {
    let document = analyze_named_module(prepared.module_name, prepared.source_name, prepared.source)
    let mut diagnostics = check_module_declarations(document.ast, prepared.target, prepared.features)
    diagnostics.extend(prepared.resolution_diagnostics)
    diagnostics.extend(check_module_bodies(document.ast, prepared.callables, prepared.fields, prepared.methods))
    ret diagnostics
}

/// Checks a source snapshot without reading or mutating the owner's database.
pub fn check_prepared_semantic_workspace(prepared: sending PreparedSemanticWorkspace) -> sending Vec[FrontendDiagnostic] {
    let mut database = AnalysisDatabase::new()
    for source in prepared.sources {
        database.set_module(source.module_name, source.source_name, source.source)
    }
    ret database.module_semantic_diagnostics(prepared.module_name)
}

impl for ModuleId {
    /// Returns an identity that never names a registered module.
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }

    /// Returns the opaque numeric representation for persistence and tests.
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }

    /// Returns the collision-free canonical identity used by persistent data.
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for SymbolId {
    /// Returns an identity that never names a registered symbol.
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }

    /// Returns the opaque numeric representation for persistence and tests.
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }

    /// Returns the collision-free canonical identity used by persistent data.
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for AnalysisDatabase {
    /// Creates an empty analysis database at revision zero.
    pub fn new() -> Self {
        ret Self {
            Vec[AnalysisSource]::new(), Vec[SemanticBodyCache]::new(), Vec[DefMapCache]::new(), 0_usize
        }
    }

    /// Returns the current source revision of the database.
    pub fn revision(self: Self) -> usize {
        ret self.revision
    }

    /// Copies immutable source inputs for an isolated worker-side semantic check.
    pub fn prepare_semantic_workspace(self: Self, module_name: str) -> sending PreparedSemanticWorkspace {
        let mut sources = Vec[AnalysisSourceSnapshot]::new()
        for source in self.sources {
            sources.push(AnalysisSourceSnapshot {
                    source.module_name, source.source_name, source.source
                }
                ,)
        }
        ret PreparedSemanticWorkspace {
            module_name, sources
        }
    }

    /// Returns the stable identity assigned to a registered module.
    pub fn module_id(self: Self, module_name: str) -> Option[ModuleId] {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret Option[ModuleId]::Some(entry.id)
            }
        }
        ret Option[ModuleId]::None
    }

    /// Inserts or replaces a module. Identical source updates are no-ops.
    ///
    /// The tolerant declaration query runs eagerly so dependency and interface
    /// changes are known before another module is requested. Full parsing stays
    /// lazy and is performed by `document`.
    pub fn set_module(self: mut Self, module_name: str, source_name: str, source: str) ->() {
        self.apply_prepared_lightweight(prepare_lightweight_module(module_name, source_name, source))
        ret()
    }

    /// Installs a tolerant query produced by `prepare_lightweight_module`
    /// without repeating lexer or declaration work on this thread.
    pub fn apply_prepared_lightweight(self: mut Self, prepared: sending PreparedLightweightModule) ->() {
        let module_name = prepared.module_name
        let source_name = prepared.source_name
        let source = prepared.source
        let source_fingerprint = prepared.source_fingerprint
        let lightweight = prepared.document
        let interface_fingerprint = prepared.interface_fingerprint
        let mut index = 0_usize
        while index < self.sources.len() {
            match self.sources.get(index) {
                Option[AnalysisSource]::Some(entry) => {
                    if entry.module_name == module_name {
                        if entry.source_fingerprint == source_fingerprint && entry.source == source &&
                        entry.source_name == source_name {
                            ret()
                        }
                        self.revision += 1_usize
                        let interface_changed = interface_fingerprint != entry.interface_fingerprint
                        let interface_revision = if interface_changed {
                            self.revision
                        } else {
                            entry.interface_revision
                        }
                        self.sources.set(index, AnalysisSource {
                                entry.id,
                                module_name,
                                source_name,
                                source,
                                source_fingerprint,
                                interface_fingerprint,
                                interface_revision,
                                lightweight,
                                entry.full,
                                true,
                                entry.analysis_revision,
                                entry.lightweight_count + 1_usize,
                                entry.parse_count,
                                SyntaxDocument::empty(),
                                true,
                                entry.syntax_count
                            }
                            ,)
                        if interface_changed {
                            self.invalidate_dependents(module_name)
                        }
                        ret()
                    }
                }
                Option[AnalysisSource]::None => {
                }
            }
            index += 1_usize
        }

        self.revision += 1_usize
        let id = module_identity(module_name)
        self.sources.push(AnalysisSource {
                id,
                module_name,
                source_name,
                source,
                source_fingerprint,
                interface_fingerprint,
                self.revision,
                lightweight,
                FrontendDocument::empty(),
                true,
                0_usize,
                1_usize,
                0_usize,
                SyntaxDocument::empty(),
                true,
                0_usize
            }
            ,)
        self.invalidate_dependents(module_name)
        ret()
    }

    /// Registers valid compiler input using one strict parse instead of first
    /// computing the tolerant editor query. This keeps cold compiler loading
    /// on a single lex/parse pass while sharing the same database and indexes.
    pub fn set_module_full(self: mut Self, module_name: str, source_name: str, source: str) ->() {
        let source_fingerprint = source.hash()
        let mut index = 0_usize
        while index < self.sources.len() {
            match self.sources.get(index) {
                Option[AnalysisSource]::Some(entry) => {
                    if entry.module_name == module_name {
                        if entry.source_fingerprint == source_fingerprint && entry.source == source &&
                        entry.source_name == source_name {
                            ret()
                        }
                        self.revision += 1_usize
                        let document = analyze_named_module(module_name, source_name, source)
                        let interface_fingerprint = module_interface_fingerprint(document.tokens)
                        let interface_changed = interface_fingerprint != entry.interface_fingerprint
                        let interface_revision = if interface_changed {
                            self.revision
                        } else {
                            entry.interface_revision
                        }
                        self.sources.set(index, AnalysisSource {
                                entry.id,
                                module_name,
                                source_name,
                                source,
                                source_fingerprint,
                                interface_fingerprint,
                                interface_revision,
                                document,
                                document,
                                false,
                                self.revision,
                                entry.lightweight_count,
                                entry.parse_count + 1_usize,
                                SyntaxDocument::empty(),
                                true,
                                entry.syntax_count
                            }
                            ,)
                        if interface_changed {
                            self.invalidate_dependents(module_name)
                        }
                        ret()
                    }
                }
                Option[AnalysisSource]::None => {
                }
            }
            index += 1_usize
        }

        self.revision += 1_usize
        let id = module_identity(module_name)
        let document = analyze_named_module(module_name, source_name, source)
        let interface_fingerprint = module_interface_fingerprint(document.tokens)
        self.sources.push(AnalysisSource {
                id,
                module_name,
                source_name,
                source,
                source_fingerprint,
                interface_fingerprint,
                self.revision,
                document,
                document,
                false,
                self.revision,
                0_usize,
                1_usize,
                SyntaxDocument::empty(),
                true,
                0_usize
            }
            ,)
        self.invalidate_dependents(module_name)
        ret()
    }

    /// Removes a module and invalidates modules that imported it.
    pub fn remove_module(self: mut Self, module_name: str) ->() {
        let mut found = false
        let mut next = Vec[AnalysisSource]::new()
        for entry in self.sources {
            if entry.module_name == module_name {
                found = true
            } else {
                next.push(entry)
            }
        }
        if !found {
            ret()
        }
        self.revision += 1_usize
        self.sources = next
        let mut semantic_bodies = Vec[SemanticBodyCache]::new()
        for cached in self.semantic_bodies {
            if cached.module_name != module_name {
                semantic_bodies.push(cached)
            }
        }
        self.semantic_bodies = semantic_bodies
        self.invalidate_dependents(module_name)
        ret()
    }

    /// Returns a fully parsed document, computing only this query when dirty.
    pub fn document(self: mut Self, module_name: str) -> Option[FrontendDocument] {
        let mut index = 0_usize
        while index < self.sources.len() {
            match self.sources.get(index) {
                Option[AnalysisSource]::Some(entry) => {
                    if entry.module_name == module_name {
                        if !entry.full_dirty {
                            ret Option[FrontendDocument]::Some(entry.full)
                        }
                        let document = analyze_named_tokens(entry.module_name, entry.source_name, entry.lightweight.tokens)
                        self.sources.set(index, AnalysisSource {
                                entry.id,
                                entry.module_name,
                                entry.source_name,
                                entry.source,
                                entry.source_fingerprint,
                                entry.interface_fingerprint,
                                entry.interface_revision,
                                entry.lightweight,
                                document,
                                false,
                                self.revision,
                                entry.lightweight_count,
                                entry.parse_count + 1_usize,
                                entry.syntax,
                                entry.syntax_dirty,
                                entry.syntax_count
                            }
                            ,)
                        ret Option[FrontendDocument]::Some(document)
                    }
                }
                Option[AnalysisSource]::None => {
                }
            }
            index += 1_usize
        }
        ret Option[FrontendDocument]::None
    }

    /// Returns the independently cached tolerant editor-oriented document.
    pub fn document_lightweight(self: mut Self, module_name: str) -> Option[FrontendDocument] {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret Option[FrontendDocument]::Some(entry.lightweight)
            }
        }
        ret Option[FrontendDocument]::None
    }

    /// Returns the exact source registered for a module.
    pub fn source_text(self: Self, module_name: str) -> Option[str] {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret Option[str]::Some(entry.source)
            }
        }
        ret Option[str]::None
    }

    /// Returns a lazily computed lossless syntax query.
    pub fn syntax_document(self: mut Self, module_name: str) -> Option[SyntaxDocument] {
        let mut index = 0_usize
        while index < self.sources.len() {
            match self.sources.get(index) {
                Option[AnalysisSource]::Some(entry) => {
                    if entry.module_name == module_name {
                        if !entry.syntax_dirty {
                            ret Option[SyntaxDocument]::Some(entry.syntax)
                        }
                        let syntax = SyntaxDocument::parse(entry.source)
                        self.sources.set(index, AnalysisSource {
                                entry.id,
                                entry.module_name,
                                entry.source_name,
                                entry.source,
                                entry.source_fingerprint,
                                entry.interface_fingerprint,
                                entry.interface_revision,
                                entry.lightweight,
                                entry.full,
                                entry.full_dirty,
                                entry.analysis_revision,
                                entry.lightweight_count,
                                entry.parse_count,
                                syntax,
                                false,
                                entry.syntax_count + 1_usize
                            }
                            ,)
                        ret Option[SyntaxDocument]::Some(syntax)
                    }
                }
                Option[AnalysisSource]::None => {
                }
            }
            index += 1_usize
        }
        ret Option[SyntaxDocument]::None
    }

    /// Returns how often the lossless syntax query was recomputed.
    pub fn module_syntax_count(self: Self, module_name: str) -> usize {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.syntax_count
            }
        }
        ret 0_usize
    }

    /// Returns whether the module's full-document query must be recomputed.
    pub fn module_is_dirty(self: Self, module_name: str) -> bool {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.full_dirty
            }
        }
        ret false
    }

    /// Returns the revision of the last full-document computation.
    pub fn module_analysis_revision(self: Self, module_name: str) -> usize {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.analysis_revision
            }
        }
        ret 0_usize
    }

    /// Returns the revision at which the module interface last changed.
    pub fn module_interface_revision(self: Self, module_name: str) -> usize {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.interface_revision
            }
        }
        ret 0_usize
    }

    /// Returns the deterministic declaration-only fingerprint used by
    /// persistent compiler caches. Function bodies are deliberately omitted,
    /// so a body edit invalidates that module without invalidating importers.
    pub fn module_interface_fingerprint(self: Self, module_name: str) -> u64 {
        ret self.module_interface_fingerprint_value(module_name)
    }

    /// Returns how many tolerant declaration queries were computed.
    pub fn module_lightweight_count(self: Self, module_name: str) -> usize {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.lightweight_count
            }
        }
        ret 0_usize
    }

    /// Returns how many full parse queries were computed.
    pub fn module_parse_count(self: Self, module_name: str) -> usize {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret entry.parse_count
            }
        }
        ret 0_usize
    }

    /// Returns the current stable symbol index across all modules.
    pub fn all_symbols(self: Self) -> Vec[AnalysisSymbol] {
        let mut out = Vec[AnalysisSymbol]::new()
        for entry in self.sources {
            out.extend(analysis_symbols_for_source(entry))
        }
        ret out
    }

    /// Lowers one module's declarations into a backend-neutral definition map.
    ///
    /// The map is the shared name-resolution boundary for the compiler, LSP,
    /// IDE and structured agent tools; consumers do not walk parser nodes.
    pub fn module_def_map(self: mut Self, module_name: str) -> Option[ModuleDefMap] {
        let interface_fingerprint = self.module_interface_fingerprint_value(module_name)
        let mut cache_index = 0_usize
        while cache_index < self.def_maps.len() {
            match self.def_maps.get(cache_index) {
                Option[DefMapCache]::Some(cached) => {
                    if cached.module_name == module_name && cached.interface_fingerprint == interface_fingerprint
                    {
                        ret Option[ModuleDefMap]::Some(cached.result)
                    }
                }
                Option[DefMapCache]::None => {
                }
            }
            cache_index += 1_usize
        }
        let document = match self.document(module_name) {
            Option[FrontendDocument]::Some(value) => value
            Option[FrontendDocument]::None => {
                ret Option[ModuleDefMap]::None
            }
        }
        let mut map = ModuleDefMap::new(module_name)
        // Publish an in-progress sentinel before following re-exports. Cyclic
        // module graphs then observe an empty map for the active edge instead
        // of recursively rebuilding the same module forever.
        let mut sentinel_index = 0_usize
        let mut sentinel_written = false
        while sentinel_index < self.def_maps.len() {
            match self.def_maps.get(sentinel_index) {
                Option[DefMapCache]::Some(cached) => {
                    if cached.module_name == module_name {
                        self.def_maps.set(sentinel_index, DefMapCache {
                                module_name, interface_fingerprint, map, cached.count
                            }
                            ,
                        )
                        sentinel_written = true
                        break
                    }
                }
                Option[DefMapCache]::None => {
                }
            }
            sentinel_index += 1_usize
        }
        if !sentinel_written {
            self.def_maps.push(DefMapCache {
                    module_name, interface_fingerprint, map, 0_usize
                }
                ,
            )
        }
        let source_name = self.module_source_name(module_name)
        let mut identity_keys = Vec[str]::new()
        for statement in document.ast {
            match statement {
                Statement::Import(item) => {
                    self.insert_import_definitions(module_name, item.path, item.is_public, map)
                }
                Statement::Function(item) => {
                    let id = next_definition_id(module_name, "", "function", item.name, identity_keys)
                    map.insert(HirDefinition::new(id, module_name, item.name, DefinitionKind::Function,
                            DefinitionNamespace::Value, item.is_public, item.source_name, item.line,
                            item.column,
                            item.name.len(), TypeId::named(function_type_key(item), item.ret_type.unwrap_or("void")),))
                }
                Statement::Struct(item) => {
                    let id = next_definition_id(module_name, "", "struct", item.name, identity_keys)
                    let position = symbol_position(document.symbols, item.name, 23_usize)
                    map.insert(HirDefinition::new(id, module_name, item.name, DefinitionKind::Struct,
                            DefinitionNamespace::Type, item.is_public, source_name, position.0, position.1,
                            position.2,
                            TypeId::named(item.name, item.name),))
                }
                Statement::EnumItem(item) => {
                    let id = next_definition_id(module_name, "", "enum", item.name, identity_keys)
                    let position = symbol_position(document.symbols, item.name, 10_usize)
                    map.insert(HirDefinition::new(id, module_name, item.name, DefinitionKind::Enum, DefinitionNamespace::Type,
                            item.is_public, source_name, position.0, position.1, position.2, TypeId::named(item.name,
                                item.name,),))
                }
                Statement::Trait(item) => {
                    let id = next_definition_id(module_name, "", "trait", item.name, identity_keys)
                    map.insert(HirDefinition::new(id, module_name, item.name, DefinitionKind::Trait,
                            DefinitionNamespace::Trait, item.is_public, item.source_name, item.line,
                            item.column,
                            item.name.len(), TypeId::named("dyn " + item.name, item.name),))
                    for method in item.methods {
                        let method_id = next_definition_id(module_name, item.name, "method", method.name,
                            identity_keys,)
                        map.insert(HirDefinition::new(method_id, module_name, method.name, DefinitionKind::Method,
                                DefinitionNamespace::Value, item.is_public, method.source_name, method.line,
                                method.column, method.name.len(), TypeId::named(function_type_key(method),
                                    method.ret_type.unwrap_or("void"),),))
                    }
                }
                Statement::Impl(item) => {
                    for method in item.methods {
                        let method_id = next_definition_id(module_name, item.target, "method", method.name,
                            identity_keys,)
                        map.insert(HirDefinition::new(method_id, module_name, method.name, DefinitionKind::Method,
                                DefinitionNamespace::Value, false, method.source_name, method.line, method.column,
                                method.name.len(), TypeId::named(function_type_key(method), method.ret_type.unwrap_or("void")),))
                    }
                }
                _ => {
                }
            }
        }
        cache_index = 0_usize
        while cache_index < self.def_maps.len() {
            match self.def_maps.get(cache_index) {
                Option[DefMapCache]::Some(cached) => {
                    if cached.module_name == module_name {
                        self.def_maps.set(cache_index, DefMapCache {
                                module_name, interface_fingerprint, map, cached.count + 1_usize
                            }
                            ,
                        )
                        ret Option[ModuleDefMap]::Some(map)
                    }
                }
                Option[DefMapCache]::None => {
                }
            }
            cache_index += 1_usize
        }
        self.def_maps.push(DefMapCache {
                module_name, interface_fingerprint, map, 1_usize
            }
            ,
        )
        ret Option[ModuleDefMap]::Some(map)
    }

    fn insert_import_definitions(
        self: mut Self,
        module_name: str,
        path: str,
        is_public: bool,
        map: mut ModuleDefMap,
    ) ->() {
        let normalized = self.resolved_import_target(module_name, path)
        let mut owner_name = ""
        for source in self.sources {
            if (normalized == source.module_name || starts_with(normalized, source.module_name + "::"))
            && source.module_name.len() > owner_name.len() {
                owner_name = source.module_name
            }
        }
        if owner_name == "" {
            ret()
        }
        let requested = import_binding_names(normalized, owner_name)
        let mut exported = match self.module_def_map(owner_name) {
            Option[ModuleDefMap]::Some(target) => target.all_definitions()
            Option[ModuleDefMap]::None => Vec[HirDefinition]::new()
        }
        // A directory module is the public namespace of its source fragments.
        // This mirrors normal Encore resolution where
        // `refrain::frontend::parser::Expr` may be declared in
        // `frontend/parser/statements.enq`.
        let mut fragments = Vec[str]::new()
        for source in self.sources {
            if starts_with(source.module_name, owner_name + "::") {
                fragments.push(source.module_name)
            }
        }
        for fragment in fragments {
            match self.module_def_map(fragment) {
                Option[ModuleDefMap]::Some(fragment_map) => {
                    for definition in fragment_map.all_definitions() {
                        if definition.is_public() {
                            exported.push(definition)
                        }
                    }
                }
                Option[ModuleDefMap]::None => {
                }
            }
        }
        for binding in requested {
            for definition in exported {
                if definition.is_public() &&(binding.0 == "*" || definition.name() == binding.0) {
                    let alias = if binding.0 == "*" {
                        definition.name()
                    } else {
                        binding.1
                    }
                    insert_import_definition(definition, alias, is_public, map)
                }
            }
        }
        ret()
    }

    /// Returns how often the module definition-map query was recomputed.
    pub fn module_def_map_count(self: Self, module_name: str) -> usize {
        for cached in self.def_maps {
            if cached.module_name == module_name {
                ret cached.count
            }
        }
        ret 0_usize
    }

    fn module_interface_fingerprint_value(self: Self, module_name: str) -> u64 {
        for source in self.sources {
            if source.module_name == module_name {
                ret source.interface_fingerprint
            }
        }
        ret 0_u64
    }

    fn module_source_name(self: Self, module_name: str) -> str {
        for source in self.sources {
            if source.module_name == module_name {
                ret source.source_name
            }
        }
        ret ""
    }

    /// Finds all indexed declarations with the supplied exact name.
    pub fn symbols_named(self: Self, name: str) -> Vec[AnalysisSymbol] {
        let mut out = Vec[AnalysisSymbol]::new()
        for indexed in self.all_symbols() {
            if indexed.symbol.name == name {
                out.push(indexed)
            }
        }
        ret out
    }

    /// Returns the stable identity of a named declaration in one module.
    pub fn symbol_id(self: Self, module_name: str, name: str) -> Option[SymbolId] {
        for indexed in self.symbols_named(name) {
            if indexed.module_name == module_name {
                ret Option[SymbolId]::Some(indexed.id)
            }
        }
        ret Option[SymbolId]::None
    }

    /// Returns the stable identity of an exact symbol record, including its
    /// declaration scope. This distinguishes same-named methods in impls.
    pub fn symbol_id_for(self: Self, module_name: str, needle: FrontendSymbol) -> Option[SymbolId] {
        for entry in self.sources {
            if entry.module_name == module_name {
                let identities = symbol_identities(entry.module_name, entry.lightweight.symbols)
                let mut index = 0_usize
                for symbol in entry.lightweight.symbols {
                    if symbol.name == needle.name && symbol.scope == needle.scope && symbol.kind == needle.kind
                    && symbol.line == needle.line && symbol.column == needle.column {
                        ret Option[SymbolId]::Some(identity_at(identities, index))
                    }
                    index += 1_usize
                }
            }
        }
        ret Option[SymbolId]::None
    }

    /// Resolves a stable symbol identity against the current database revision.
    pub fn symbol_by_id(self: Self, id: SymbolId) -> Option[AnalysisSymbol] {
        if id.raw == 0_u64 || id.key == "" {
            ret Option[AnalysisSymbol]::None
        }
        for entry in self.sources {
            if starts_with(id.key, entry.module_name + "#") {
                for indexed in analysis_symbols_for_source(entry) {
                    if indexed.id.raw == id.raw && indexed.id.key == id.key {
                        ret Option[AnalysisSymbol]::Some(indexed)
                    }
                }
                ret Option[AnalysisSymbol]::None
            }
        }
        ret Option[AnalysisSymbol]::None
    }

    /// Returns the cached semantic result for one function declaration.
    ///
    /// The query is recomputed only when that function body or one of the
    /// declaration signatures read by its previous result has changed.
    pub fn semantic_body(self: mut Self, id: SymbolId) -> Option[SemanticBody] {
        let indexed = match self.symbol_by_id(id) {
            Option[AnalysisSymbol]::Some(value) => value
            Option[AnalysisSymbol]::None => {
                ret Option[SemanticBody]::None
            }
        }
        if indexed.symbol.kind != 12_usize {
            ret Option[SemanticBody]::None
        }
        let callables = self.visible_semantic_callables(indexed.module_name)
        let fields = self.visible_semantic_fields(indexed.module_name)
        let methods = self.visible_semantic_methods(indexed.module_name)
        ret self.semantic_body_for(indexed, callables, fields, methods)
    }

    fn semantic_body_for(
        self: mut Self,
        indexed: AnalysisSymbol,
        callables: Vec[SemanticCallable],
        fields: Vec[SemanticField],
        methods: Vec[SemanticMethod],
    ) -> Option[SemanticBody] {
        let id = indexed.id
        let fingerprint = match self.source_lightweight_document(indexed.module_name) {
            Option[FrontendDocument]::Some(value) => function_body_fingerprint(value.tokens, indexed.symbol.name,
                indexed.symbol.line, indexed.symbol.column,)
            Option[FrontendDocument]::None => {
                ret Option[SemanticBody]::None
            }
        }
        let mut cache_index = 0_usize
        while cache_index < self.semantic_bodies.len() {
            match self.semantic_bodies.get(cache_index) {
                Option[SemanticBodyCache]::Some(cached) => {
                    if same_symbol_id(cached.id, id) {
                        if cached.body_fingerprint == fingerprint && self.semantic_dependencies_are_current(cached.result.dependencies)
                        {
                            ret Option[SemanticBody]::Some(cached.result)
                        }
                        let document = if cached.body_fingerprint == fingerprint {
                            self.stored_full_document(indexed.module_name).unwrap_or(FrontendDocument::empty())
                        } else {
                            self.document(indexed.module_name).unwrap_or(FrontendDocument::empty())
                        }
                        let item = match find_function(document.ast, indexed.symbol.name, indexed.symbol.line,
                            indexed.symbol.column,) {
                            Option[FunctionItem]::Some(value) => value
                            Option[FunctionItem]::None => {
                                ret Option[SemanticBody]::None
                            }
                        }
                        let result = check_function_body(item, callables, fields, methods, semantic_owner_type(indexed.symbol.scope))
                        self.semantic_bodies.set(cache_index, SemanticBodyCache {
                                id, indexed.module_name, indexed.symbol.name, fingerprint, result, cached.count
                                + 1_usize
                            }
                            ,
                        )
                        ret Option[SemanticBody]::Some(result)
                    }
                }
                Option[SemanticBodyCache]::None => {
                }
            }
            cache_index += 1_usize
        }
        let document = self.document(indexed.module_name).unwrap_or(FrontendDocument::empty())
        let item = match find_function(document.ast, indexed.symbol.name, indexed.symbol.line, indexed.symbol.column)
        {
            Option[FunctionItem]::Some(value) => value
            Option[FunctionItem]::None => {
                ret Option[SemanticBody]::None
            }
        }
        let result = check_function_body(item, callables, fields, methods, semantic_owner_type(indexed.symbol.scope))
        self.semantic_bodies.push(SemanticBodyCache {
                id, indexed.module_name, indexed.symbol.name, fingerprint, result, 1_usize
            }
            ,
        )
        ret Option[SemanticBody]::Some(result)
    }

    /// Returns whether a cached semantic body must be recomputed.
    pub fn semantic_body_is_dirty(self: mut Self, id: SymbolId) -> bool {
        for cached in self.semantic_bodies {
            if same_symbol_id(cached.id, id) {
                let document = match self.source_lightweight_document(cached.module_name) {
                    Option[FrontendDocument]::Some(value) => value
                    Option[FrontendDocument]::None => {
                        ret true
                    }
                }
                let indexed = match self.symbol_by_id(id) {
                    Option[AnalysisSymbol]::Some(value) => value
                    Option[AnalysisSymbol]::None => {
                        ret true
                    }
                }
                if function_body_fingerprint(document.tokens, cached.symbol_name, indexed.symbol.line,
                    indexed.symbol.column,) != cached.body_fingerprint {
                    ret true
                }
                ret !self.semantic_dependencies_are_current(cached.result.dependencies)
            }
        }
        ret true
    }

    /// Returns how many times a function semantic query was executed.
    pub fn semantic_body_count(self: Self, id: SymbolId) -> usize {
        for cached in self.semantic_bodies {
            if same_symbol_id(cached.id, id) {
                ret cached.count
            }
        }
        ret 0_usize
    }

    /// Returns cached semantic diagnostics for all top-level function bodies
    /// in a module. Compiler and editor clients consume this same query.
    pub fn module_semantic_diagnostics(self: mut Self, module_name: str) -> Vec[FrontendDiagnostic] {
        ret self.module_semantic_diagnostics_for_target(module_name, host_target(), Vec[str]::new())
    }

    /// Returns the shared semantic diagnostics for a concrete compilation
    /// target and enabled feature set.
    pub fn module_semantic_diagnostics_for_target(self: mut Self, module_name: str, target: TargetSpec,
        features: Vec[str],) -> Vec[FrontendDiagnostic] {
        let callables = self.visible_semantic_callables(module_name)
        let fields = self.visible_semantic_fields(module_name)
        let methods = self.visible_semantic_methods(module_name)
        let document = match self.stored_full_document(module_name) {
            Option[FrontendDocument]::Some(value) => value
            Option[FrontendDocument]::None => {
                match self.document(module_name) {
                    Option[FrontendDocument]::Some(value) => value
                    Option[FrontendDocument]::None => {
                        ret Vec[FrontendDiagnostic]::new()
                    }
                }
            }
        }
        let mut diagnostics = check_module_declarations(document.ast, target, features)
        diagnostics.extend(self.module_resolution_diagnostics(module_name, document))
        diagnostics.extend(check_module_bodies(document.ast, callables, fields, methods))
        ret diagnostics
    }

    /// Freezes all workspace-dependent facts needed to check one module on a
    /// worker thread. The returned value contains no AST graph handles.
    pub fn prepare_module_semantic_check_for_target(self: mut Self, module_name: str, target: TargetSpec,
        features: Vec[str],) -> PreparedSemanticModule {
        let callables = self.visible_semantic_callables(module_name)
        let fields = self.visible_semantic_fields(module_name)
        let methods = self.visible_semantic_methods(module_name)
        let document = match self.stored_full_document(module_name) {
            Option[FrontendDocument]::Some(value) => value
            Option[FrontendDocument]::None => {
                self.document(module_name).unwrap_or(FrontendDocument::empty())
            }
        }
        let mut source_name = ""
        let mut source = ""
        for entry in self.sources {
            if entry.module_name == module_name {
                source_name = entry.source_name
                source = entry.source
            }
        }
        let resolution_diagnostics = self.module_resolution_diagnostics(module_name, document)
        ret PreparedSemanticModule {
            module_name,
            source_name,
            source,
            target,
            features,
            callables,
            fields,
            methods,
            resolution_diagnostics
        }
    }

    fn module_resolution_diagnostics(self: mut Self, module_name: str, document: FrontendDocument) ->
    Vec[FrontendDiagnostic] {
        let mut diagnostics = Vec[FrontendDiagnostic]::new()
        for edge in document.dependencies.all() {
            if !self.import_target_resolves(module_name, edge.target) {
                diagnostics.push(
                    FrontendDiagnostic::new(
                        1_usize,
                        "unresolved-import",
                        self.unresolved_import_message(edge.target),
                        edge.line,
                        edge.column,
                        if edge.length == 0_usize {
                            1_usize
                        } else {
                            edge.length
                        }
                        ,
                    ).with_label("", edge.line, edge.column, edge.length, DiagnosticLabelKind::Primary,
                        "cannot resolve this import",)
                )
            }
        }

        let generics = module_generic_names(document.ast)
        let decorator_callables = module_decorator_callable_names(document.ast)
        let mut known_types = Vec[str]::new()
        let mut known_callables = Vec[str]::new()
        match self.module_def_map(module_name) {
            Option[ModuleDefMap]::Some(map) => {
                for definition in map.all_definitions() {
                    match definition.namespace() {
                        DefinitionNamespace::Type => {
                            known_types.push(definition.name())
                        }
                        DefinitionNamespace::Trait => {
                            known_types.push(definition.name())
                        }
                        DefinitionNamespace::Value => {
                            match definition.kind() {
                                DefinitionKind::Function => {
                                    known_callables.push(definition.name())
                                }
                                DefinitionKind::Import => {
                                    known_callables.push(definition.name())
                                }
                                _ => {
                                }
                            }
                        }
                        DefinitionNamespace::Module => {
                        }
                    }
                }
            }
            Option[ModuleDefMap]::None => {
            }
        }
        // Core declarations form the language prelude and are visible without
        // an explicit source import. No other workspace module is consulted.
        for source in self.sources {
            if source.module_name == "core" || starts_with(source.module_name, "core::") {
                for symbol in source.lightweight.symbols {
                    if symbol.scope == "" {
                        if symbol.kind == 23_usize || symbol.kind == 10_usize || symbol.kind == 11_usize
                        {
                            known_types.push(symbol.name)
                        } elif symbol.kind == 12_usize {
                            known_callables.push(symbol.name)
                        }
                    }
                }
            }
        }
        let type_set = unsafe {
            encore_strset_new()
        }
        let callable_set = unsafe {
            encore_strset_new()
        }
        let generic_set = unsafe {
            encore_strset_new()
        }
        for name in known_types {
            let _inserted = unsafe {
                encore_strset_insert(type_set, name)
            }
        }
        for name in known_callables {
            let _inserted = unsafe {
                encore_strset_insert(callable_set, name)
            }
        }
        for name in decorator_callables {
            let _inserted = unsafe {
                encore_strset_insert(callable_set, name)
            }
        }
        for name in generics {
            let _inserted = unsafe {
                encore_strset_insert(generic_set, name)
            }
        }
        let mut index = 0_usize
        let mut previous_type = TokenType::UNKNOWN
        let mut in_attribute = false
        let mut attribute_depth = 0_i32
        while index < document.tokens.len() {
            match document.tokens.get(index) {
                Option[Token]::Some(token) => {
                    if token.type == TokenType::HASH {
                        in_attribute = true
                        attribute_depth = 0_i32
                    } elif in_attribute && token.type == TokenType::LEFT_PAREN {
                        attribute_depth += 1_i32
                    } elif in_attribute && token.type == TokenType::RIGHT_PAREN {
                        attribute_depth -= 1_i32
                        if attribute_depth <= 0_i32 {
                            in_attribute = false
                        }
                    }
                    let type_position = previous_type == TokenType::COLON || previous_type == TokenType::ARROW
                    || previous_type == TokenType::KW_AS || previous_type == TokenType::KW_IMPL
                    if token.type == TokenType::IDENTIFIER && type_position {
                        if starts_with_uppercase(token.value) && !builtin_type_name(token.value) && !unsafe
                        {
                            encore_strset_contains(generic_set, token.value)
                        }
                        && !unsafe {
                            encore_strset_contains(type_set, token.value)
                        }
                        {
                            let code = if previous_type == TokenType::KW_IMPL {
                                "unknown-trait"
                            } else {
                                "unknown-type"
                            }
                            let message = if previous_type == TokenType::KW_IMPL {
                                "unknown trait '" + token.value + "'"
                            } else {
                                "unknown type '" + token.value + "'"
                            }
                            diagnostics.push(
                                FrontendDiagnostic::new(1_usize, code, message, token.line, token.column,
                                    token.value.len(),)
                                .with_label("", token.line, token.column, token.value.len(), DiagnosticLabelKind::Primary,
                                    "not found in this scope",)
                            )
                        }
                    }
                    let mut followed_by_call = false
                    match document.tokens.get(index + 1_usize) {
                        Option[Token]::Some(next) => {
                            followed_by_call = next.type == TokenType::LEFT_PAREN
                        }
                        Option[Token]::None => {
                        }
                    }
                    let qualified = previous_type == TokenType::DOT || previous_type == TokenType::SCOPE
                    || previous_type == TokenType::KW_FN || previous_type == TokenType::HASH
                    if token.type == TokenType::IDENTIFIER && followed_by_call && !qualified && !in_attribute
                    {
                        if !unsafe {
                            encore_strset_contains(callable_set, token.value)
                        }
                        && !starts_with_uppercase(token.value) {
                            diagnostics.push(
                                FrontendDiagnostic::new(1_usize, "unresolved-call", "cannot find function `"
                                    + token.value + "` in this scope", token.line, token.column, token.value.len(),)
                                .with_label("", token.line, token.column, token.value.len(), DiagnosticLabelKind::Primary,
                                    "not found in this scope",)
                            )
                        }
                    }
                    previous_type = token.type
                }
                Option[Token]::None => {
                }
            }
            index += 1_usize
        }
        unsafe {
            encore_strset_free(type_set)
            encore_strset_free(callable_set)
            encore_strset_free(generic_set)
        }
        let _ignored = module_name
        ret diagnostics
    }

    fn unresolved_import_message(self: Self, path: str) -> str {
        let platform = starts_with(path, "core::io") || starts_with(path, "core::os")
        || starts_with(path, "core::process") || starts_with(path, "core::thread")
        || starts_with(path, "core::time") || starts_with(path, "core::net")
        || starts_with(path, "core::http") || starts_with(path, "core::tls")
        || starts_with(path, "core::fs") || starts_with(path, "core::path")
        if platform {
            ret "platform API `" + path + "` moved to `std::"
            + path.slice(6_usize, path.len() - 6_usize) + "`"
        }
        ret "unresolved import `" + path + "`"
    }

    fn import_target_resolves(self: Self, module_name: str, target: str) -> bool {
        let cleaned = strip_import_alias(self.resolved_import_target(module_name, target))
        for source in self.sources {
            if cleaned == source.module_name {
                ret true
            }
            if starts_with(cleaned, source.module_name + "::") {
                ret true
            }
        }
        ret false
    }

    /// Returns the semantic type of a local binding at a source line.
    pub fn semantic_binding_type(self: mut Self, module_name: str, name: str, line: usize) -> Option[str]
    {
        let symbols = self.module_analysis_symbols(module_name)
        let callables = self.visible_semantic_callables(module_name)
        let fields = self.visible_semantic_fields(module_name)
        let methods = self.visible_semantic_methods(module_name)
        let mut adjacent = Option[str]::None
        for indexed in symbols {
            if indexed.symbol.kind == 12_usize {
                match self.semantic_body_for(indexed, callables, fields, methods) {
                    Option[SemanticBody]::Some(body) => {
                        for binding in body.bindings {
                            if binding.name == name && binding.line == line {
                                ret Option[str]::Some(binding.typ)
                            }
                            if binding.name == name &&(binding.line == line + 1_usize ||(line > 0_usize
                                    && binding.line + 1_usize == line)) {
                                adjacent = Option[str]::Some(binding.typ)
                            }
                        }
                    }
                    Option[SemanticBody]::None => {
                    }
                }
            }
        }
        ret adjacent
    }

    fn module_analysis_symbols(self: Self, module_name: str) -> Vec[AnalysisSymbol] {
        for entry in self.sources {
            if entry.module_name == module_name {
                ret analysis_symbols_for_source(entry)
            }
        }
        ret Vec[AnalysisSymbol]::new()
    }

    fn source_lightweight_document(self: Self, module_name: str) -> Option[FrontendDocument] {
        for source in self.sources {
            if source.module_name == module_name {
                ret Option[FrontendDocument]::Some(source.lightweight)
            }
        }
        ret Option[FrontendDocument]::None
    }

    fn stored_full_document(self: Self, module_name: str) -> Option[FrontendDocument] {
        for source in self.sources {
            if source.module_name == module_name && source.full.parsed {
                ret Option[FrontendDocument]::Some(source.full)
            }
        }
        ret Option[FrontendDocument]::None
    }

    fn semantic_dependencies_are_current(self: mut Self, dependencies: Vec[SemanticDependency]) -> bool
    {
        for dependency in dependencies {
            match self.semantic_callable(dependency.module_name, dependency.name) {
                Option[SemanticCallable]::Some(callable) => {
                    if callable.signature != dependency.signature {
                        ret false
                    }
                }
                Option[SemanticCallable]::None => {
                    ret false
                }
            }
        }
        ret true
    }

    fn semantic_callable(self: mut Self, module_name: str, name: str) -> Option[SemanticCallable] {
        let document = match self.document(module_name) {
            Option[FrontendDocument]::Some(value) => value
            Option[FrontendDocument]::None => {
                ret Option[SemanticCallable]::None
            }
        }
        for statement in document.ast {
            match statement {
                Statement::Function(item) => {
                    if item.name == name {
                        ret Option[SemanticCallable]::Some(callable_from_function(module_name, item))
                    }
                }
                _ => {
                }
            }
        }
        ret Option[SemanticCallable]::None
    }

    fn visible_semantic_callables(self: mut Self, module_name: str) -> Vec[SemanticCallable] {
        let visible_modules = self.visible_semantic_modules(module_name)
        let mut out = Vec[SemanticCallable]::new()
        for visible in visible_modules {
            let document = match self.stored_full_document(visible) {
                Option[FrontendDocument]::Some(value) => value
                Option[FrontendDocument]::None => self.document(visible).unwrap_or(FrontendDocument::empty())
            }
            for statement in document.ast {
                match statement {
                    Statement::Function(item) => {
                        out.push(callable_from_function(visible, item))
                    }
                    _ => {
                    }
                }
            }
        }
        ret out
    }

    fn visible_semantic_fields(self: mut Self, module_name: str) -> Vec[SemanticField] {
        let mut out = Vec[SemanticField]::new()
        for visible in self.visible_semantic_modules(module_name) {
            let document = match self.stored_full_document(visible) {
                Option[FrontendDocument]::Some(value) => value
                Option[FrontendDocument]::None => self.document(visible).unwrap_or(FrontendDocument::empty())
            }
            for statement in document.ast {
                match statement {
                    Statement::Struct(item) => {
                        for field in item.named_fields {
                            out.push(SemanticField::new(visible, item.name, field.name, field.typ))
                        }
                        let mut field_index = 0_usize
                        for field_type in item.tuple_fields {
                            out.push(SemanticField::new(visible, item.name, Debug::fmt(field_index),
                                    field_type,))
                            field_index += 1_usize
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        ret out
    }

    fn visible_semantic_methods(self: mut Self, module_name: str) -> Vec[SemanticMethod] {
        let mut out = Vec[SemanticMethod]::new()
        // Inherent methods belong to their receiver type, not to the lexical
        // import scope of the call site. Once a type is reachable, its impl
        // methods must remain discoverable even when the type flowed through
        // another public API (for example FrontendDocument.dependencies).
        let mut method_modules = Vec[str]::new()
        for source in self.sources {
            if !contains_string(method_modules, source.module_name) {
                method_modules.push(source.module_name)
            }
        }
        for visible in method_modules {
            let document = match self.stored_full_document(visible) {
                Option[FrontendDocument]::Some(value) => value
                Option[FrontendDocument]::None => self.document(visible).unwrap_or(FrontendDocument::empty())
            }
            for statement in document.ast {
                match statement {
                    Statement::Impl(item) => {
                        for method in item.methods {
                            let mut params = Vec[str]::new()
                            let mut index = 0_usize
                            for param in method.params {
                                if index > 0_usize {
                                    params.push(param.typ.unwrap_or(""))
                                }
                                index += 1_usize
                            }
                            out.push(SemanticMethod::new(visible, item.target, method.name, params, method.ret_type.unwrap_or("void")))
                        }
                    }
                    Statement::Trait(item) => {
                        for method in item.methods {
                            let mut params = Vec[str]::new()
                            let mut index = 0_usize
                            for param in method.params {
                                if index > 0_usize {
                                    params.push(param.typ.unwrap_or(""))
                                }
                                index += 1_usize
                            }
                            out.push(SemanticMethod::new(visible, "dyn " + item.name, method.name, params,
                                    method.ret_type.unwrap_or("void"),))
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        for source in self.sources {
            let document = self.document(source.module_name).unwrap_or(FrontendDocument::empty())
            for statement in document.ast {
                match statement {
                    Statement::Trait(child) => {
                        for base in child.bases {
                            for base_source in self.sources {
                                let base_document = self.document(base_source.module_name).unwrap_or(FrontendDocument::empty())
                                for candidate in base_document.ast {
                                    match candidate {
                                        Statement::Trait(parent) => {
                                            if parent.name == base {
                                                for method in parent.methods {
                                                    let mut params = Vec[str]::new()
                                                    let mut index = 0_usize
                                                    for param in method.params {
                                                        if index > 0_usize {
                                                            params.push(param.typ.unwrap_or(""))
                                                        }
                                                        index += 1_usize
                                                    }
                                                    out.push(SemanticMethod::new(base_source.module_name,
                                                            "dyn " + child.name, method.name, params,
                                                            method.ret_type.unwrap_or("void"),))
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        ret out
    }

    fn visible_semantic_modules(self: Self, module_name: str) -> Vec[str] {
        let mut visible_modules = Vec[str]::new()
        visible_modules.push(module_name)
        for source in self.sources {
            if source.module_name == module_name {
                for edge in source.lightweight.dependencies.all() {
                    let normalized = self.resolved_import_target(module_name, edge.target)
                    for candidate in self.sources {
                        if normalized == candidate.module_name || starts_with(normalized, candidate.module_name
                            + "::",) {
                            if !contains_string(visible_modules, candidate.module_name) {
                                visible_modules.push(candidate.module_name)
                            }
                        }
                    }
                }
            }
        }
        ret visible_modules
    }

    fn resolved_import_target(self: Self, module_name: str, target: str) -> str {
        let direct = normalized_import_target(module_name, target)
        if !starts_with(target, "mod::") {
            ret direct
        }
        let mut source_name = ""
        for source in self.sources {
            if source.module_name == module_name {
                source_name = source.source_name break
            }
        }
        if ends_with_analysis(source_name, "/mod.enq") || ends_with_analysis(source_name, "\\mod.enq")
        || ends_with_analysis(source_name, "/lib.enq") || ends_with_analysis(source_name, "\\lib.enq")
        || ends_with_analysis(source_name, "/main.enq") || ends_with_analysis(source_name, "\\main.enq")
        || source_name == "mod.enq" || source_name == "lib.enq" || source_name == "main.enq" {
            ret direct
        }
        let parent = parent_module_name(module_name)
        if parent == "" {
            ret direct
        }
        ret parent + "::" + target.slice(5_usize, target.len() - 5_usize)
    }

    fn invalidate_dependents(self: mut Self, changed_module: str) ->() {
        let mut changed = Vec[str]::new()
        changed.push(changed_module)
        let mut cursor = 0_usize
        while cursor < changed.len() {
            let dependency = match changed.get(cursor) {
                Option[str]::Some(value) => value
                Option[str]::None => ""
            }
            let mut index = 0_usize
            while index < self.sources.len() {
                match self.sources.get(index) {
                    Option[AnalysisSource]::Some(entry) => {
                        if entry.module_name != dependency && document_imports_module(entry.lightweight,
                            dependency,) {
                            if !entry.full_dirty {
                                self.sources.set(index, AnalysisSource {
                                        entry.id,
                                        entry.module_name,
                                        entry.source_name,
                                        entry.source,
                                        entry.source_fingerprint,
                                        entry.interface_fingerprint,
                                        entry.interface_revision,
                                        entry.lightweight,
                                        entry.full,
                                        true,
                                        entry.analysis_revision,
                                        entry.lightweight_count,
                                        entry.parse_count,
                                        entry.syntax,
                                        entry.syntax_dirty,
                                        entry.syntax_count
                                    }
                                    ,)
                            }
                            if !contains_string(changed, entry.module_name) {
                                changed.push(entry.module_name)
                            }
                        }
                    }
                    Option[AnalysisSource]::None => {
                    }
                }
                index += 1_usize
            }
            cursor += 1_usize
        }
        ret()
    }
}

fn analysis_symbols_for_source(entry: AnalysisSource) -> Vec[AnalysisSymbol] {
    let mut out = Vec[AnalysisSymbol]::new()
    let identities = symbol_identities(entry.module_name, entry.lightweight.symbols)
    let mut symbol_index = 0_usize
    for symbol in entry.lightweight.symbols {
        let id = identity_at(identities, symbol_index)
        out.push(AnalysisSymbol {
                id, entry.id, entry.module_name, symbol
            }
            ,
        )
        symbol_index += 1_usize
    }
    ret out
}

fn callable_from_function(module_name: str, item: FunctionItem) -> SemanticCallable {
    let mut params = Vec[str]::new()
    for param in item.params {
        params.push(param.typ.unwrap_or(""))
    }
    ret SemanticCallable::new(module_name, item.name, params, item.ret_type.unwrap_or("void"))
}

fn function_type_key(item: FunctionItem) -> str {
    let mut out = "fn("
    for param in item.params {
        out += param.typ.unwrap_or("_") + ","
    }
    ret out + ")->" + item.ret_type.unwrap_or("void")
}

fn symbol_position(symbols: Vec[FrontendSymbol], name: str, kind: usize) ->(usize, usize, usize) {
    for symbol in symbols {
        if symbol.name == name && symbol.kind == kind {
            ret(symbol.line, symbol.column, symbol.length)
        }
    }
    ret(0_usize, 0_usize, if name.len() == 0_usize {
            1_usize
        } else {
            name.len()
        }
        ,
    )
}

fn semantic_owner_type(scope: str) -> str {
    let mut owner_scope = scope
    let mut separator = 0_usize
    let mut index = 0_usize
    while index + 1_usize < owner_scope.len() {
        if owner_scope.slice(index, 2_usize) == "::" {
            separator = index + 2_usize
        }
        index += 1_usize
    }
    if separator > 0_usize {
        owner_scope = owner_scope.slice(separator, owner_scope.len() - separator)
    }
    if !starts_with(owner_scope, "impl") {
        ret ""
    }
    let mut for_index = 0_usize
    index = 4_usize
    while index + 3_usize <= owner_scope.len() {
        if owner_scope.slice(index, 3_usize) == "for" {
            for_index = index + 3_usize
        }
        index += 1_usize
    }
    if for_index > 0_usize && for_index < owner_scope.len() {
        ret owner_scope.slice(for_index, owner_scope.len() - for_index)
    }
    if owner_scope.len() > 4_usize {
        ret owner_scope.slice(4_usize, owner_scope.len() - 4_usize)
    }
    ret ""
}

fn find_function(ast: Vec[Statement], name: str, line: usize, column: usize) -> Option[FunctionItem]
{
    let mut fallback = Option[FunctionItem]::None
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                if item.name == name {
                    if item.line == line {
                        ret Option[FunctionItem]::Some(item)
                    }
                    fallback = Option[FunctionItem]::Some(item)
                }
            }
            Statement::Trait(item) => {
                for method in item.methods {
                    if method.name == name {
                        if method.line == line {
                            ret Option[FunctionItem]::Some(method)
                        }
                        fallback = Option[FunctionItem]::Some(method)
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    if method.name == name {
                        if method.line == line {
                            ret Option[FunctionItem]::Some(method)
                        }
                        fallback = Option[FunctionItem]::Some(method)
                    }
                }
            }
            _ => {
            }
        }
    }
    ret fallback
}

fn function_body_fingerprint(tokens: Vec[Token], name: str, line: usize, column: usize) -> u64 {
    let mut fallback = 0_u64
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::KW_FN {
                    match next_identifier_token_at(tokens, index + 1_usize) {
                        Option[Token]::Some(found) => {
                            if found.value == name {
                                let fingerprint = hash_function_tokens(tokens, index)
                                if found.line == line && found.column == column {
                                    ret fingerprint
                                }
                                fallback = fingerprint
                            }
                        }
                        Option[Token]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret fallback
}

fn next_identifier_token_at(tokens: Vec[Token], start: usize) -> Option[Token] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER {
                    ret Option[Token]::Some(token)
                }
                if token.type == TokenType::LEFT_BRACE {
                    ret Option[Token]::None
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn hash_function_tokens(tokens: Vec[Token], start: usize) -> u64 {
    let mut fingerprint = 1469598103934665603_u64
    let prime = 1099511628211_u64
    let mut index = start
    let mut body_started = false
    let mut depth = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                fingerprint =(fingerprint ^ token.value.hash()) * prime
                if token.type == TokenType::LEFT_BRACE {
                    body_started = true
                    depth += 1_usize
                } elif body_started && token.type == TokenType::RIGHT_BRACE {
                    depth -= 1_usize
                    if depth == 0_usize {
                        ret fingerprint
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret fingerprint
}

fn same_symbol_id(lhs: SymbolId, rhs: SymbolId) -> bool {
    ret lhs.raw == rhs.raw && lhs.key == rhs.key
}

fn module_identity(module_name: str) -> ModuleId {
    ret ModuleId {
        stable_hash_nonzero(module_name), module_name
    }
}

fn symbol_identities(module_name: str, symbols: Vec[FrontendSymbol]) -> Vec[AnalysisSymbolIdentity] {
    let mut out = Vec[AnalysisSymbolIdentity]::new()
    let ordinals = encore_strmap_new()
    for symbol in symbols {
        let scoped_name = if symbol.scope == "" {
            symbol.name
        } else {
            symbol.scope + "::" + symbol.name
        }
        let ordinal_key = scoped_name + "\n" + Debug::fmt(symbol.kind)
        let ordinal = encore_strmap_get(ordinals, ordinal_key)
        encore_strmap_put(ordinals, ordinal_key, ordinal + 1_usize)
        let key = module_name + "#" + Debug::fmt(symbol.kind) + "#" + scoped_name + "#" + Debug::fmt(ordinal)
        out.push(AnalysisSymbolIdentity {
                scoped_name, symbol.kind, ordinal, SymbolId {
                    stable_hash_nonzero(key), key
                }
            }
            ,
        )
    }
    encore_strmap_free(ordinals)
    ret out
}

fn stable_hash_nonzero(value: str) -> u64 {
    let hashed = value.hash()
    if hashed == 0_u64 {
        ret 1_u64
    }
    ret hashed
}

fn identity_at(identities: Vec[AnalysisSymbolIdentity], index: usize) -> SymbolId {
    match identities.get(index) {
        Option[AnalysisSymbolIdentity]::Some(identity) => {
            ret identity.id
        }
        Option[AnalysisSymbolIdentity]::None => {
            ret SymbolId::invalid()
        }
    }
    ret SymbolId::invalid()
}

fn document_imports_module(document: FrontendDocument, module_name: str) -> bool {
    for edge in document.dependencies.all() {
        if edge.target == module_name {
            ret true
        }
        if starts_with(edge.target, module_name + "::") {
            ret true
        }
    }
    ret false
}

// Produces a declaration fingerprint while deliberately omitting function
// bodies. This is tolerant of incomplete editor input and ensures body-only
// changes do not invalidate importing modules.
fn module_interface_fingerprint(tokens: Vec[Token]) -> u64 {
    let mut fingerprint = 1469598103934665603_u64
    let prime = 1099511628211_u64
    let mut index = 0_usize
    let mut awaiting_function_body = false
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if awaiting_function_body && token.type != TokenType::KW_FN && declaration_starts(token.type)
                {
                    awaiting_function_body = false
                }
                if token.type == TokenType::KW_FN {
                    awaiting_function_body = true
                }
                if awaiting_function_body && token.type == TokenType::LEFT_BRACE {
                    fingerprint =(fingerprint ^ 31613_u64) * prime
                    let mut depth = 1_usize
                    index += 1_usize
                    while index < tokens.len() && depth > 0_usize {
                        match tokens.get(index) {
                            Option[Token]::Some(body_token) => {
                                if body_token.type == TokenType::LEFT_BRACE {
                                    depth += 1_usize
                                } elif body_token.type == TokenType::RIGHT_BRACE {
                                    depth -= 1_usize
                                }
                            }
                            Option[Token]::None => {
                            }
                        }
                        index += 1_usize
                    }
                    awaiting_function_body = false
                    continue
                }
                fingerprint =(fingerprint ^ token.value.hash()) * prime
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret fingerprint
}

fn declaration_starts(token_type: TokenType) -> bool {
    ret token_type == TokenType::KW_IMPORT
    || token_type == TokenType::KW_STRUCT
    || token_type == TokenType::KW_ENUM
    || token_type == TokenType::KW_TRAIT
    || token_type == TokenType::KW_IMPL
    || token_type == TokenType::KW_LET
}

fn contains_string(items: Vec[str], needle: str) -> bool {
    for item in items {
        if item == needle {
            ret true
        }
    }
    ret false
}

fn module_generic_names(ast: Vec[Statement]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                for generic in item.generics {
                    if !contains_string(out, generic.name) {
                        out.push(generic.name)
                    }
                }
            }
            Statement::Struct(item) => {
                for generic in item.generics {
                    if !contains_string(out, generic.name) {
                        out.push(generic.name)
                    }
                }
            }
            Statement::EnumItem(item) => {
                for generic in item.generics {
                    if !contains_string(out, generic.name) {
                        out.push(generic.name)
                    }
                }
            }
            Statement::Trait(item) => {
                for generic in item.generics {
                    if !contains_string(out, generic.name) {
                        out.push(generic.name)
                    }
                }
                for method in item.methods {
                    for generic in method.generics {
                        if !contains_string(out, generic.name) {
                            out.push(generic.name)
                        }
                    }
                }
            }
            Statement::Impl(item) => {
                for generic in item.generics {
                    if !contains_string(out, generic.name) {
                        out.push(generic.name)
                    }
                }
                for method in item.methods {
                    for generic in method.generics {
                        if !contains_string(out, generic.name) {
                            out.push(generic.name)
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret out
}

fn analysis_function_has_attr(item: FunctionItem, expected: str) -> bool {
    for attr in item.attrs {
        if attr == expected {
            ret true
        }
    }
    ret false
}

fn append_decorator_callable_names(out: mut Vec[str], item: FunctionItem) ->() {
    if !analysis_function_has_attr(item, "decorator") {
        ret()
    }
    for param in item.params {
        match param.typ {
            Some(typ) => {
                if starts_with(typ, "Callable[") && !contains_string(out, param.name) {
                    out.push(param.name)
                }
            }
            None => {
            }
        }
    }
    ret()
}

fn module_decorator_callable_names(ast: Vec[Statement]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                append_decorator_callable_names(out, item)
            }
            Statement::Trait(item) => {
                for method in item.methods {
                    append_decorator_callable_names(out, method)
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    append_decorator_callable_names(out, method)
                }
            }
            _ => {
            }
        }
    }
    ret out
}

fn builtin_type_name(name: str) -> bool {
    ret name == "Self" || name == "str" || name == "bool" || name == "void"
    || name == "u1" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128"
    || name == "usize"
    || name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" || name == "isize"
    || name == "f32" || name == "f64" || name == "any" || name == "Callable"
}

fn starts_with_uppercase(value: str) -> bool {
    if value.len() == 0_usize {
        ret false
    }
    let byte = value.byte_at(0_usize)
    ret byte >= 65_u8 && byte <= 90_u8
}

fn strip_import_alias(value: str) -> str {
    let mut index = 0_usize
    while index + 4_usize <= value.len() {
        if value.slice(index, 4_usize) == " as " {
            ret value.slice(0_usize, index)
        }
        index += 1_usize
    }
    ret value
}

fn module_root_name(module_name: str) -> str {
    let mut index = 0_usize
    while index + 2_usize <= module_name.len() {
        if module_name.slice(index, 2_usize) == "::" {
            ret module_name.slice(0_usize, index)
        }
        index += 1_usize
    }
    ret module_name
}

fn normalized_import_target(module_name: str, target: str) -> str {
    let mut cleaned = target
    if starts_with(cleaned, "mod::") {
        ret module_name + "::" + cleaned.slice(5_usize, cleaned.len() - 5_usize)
    }
    if starts_with(cleaned, "refrain::") || starts_with(cleaned, "repo::") {
        let prefix_len = if starts_with(cleaned, "refrain::") {
            9_usize
        } else {
            6_usize
        }
        ret module_root_name(module_name) + "::" + cleaned.slice(prefix_len, cleaned.len() - prefix_len)
    }
    ret cleaned
}

fn parent_module_name(module_name: str) -> str {
    let mut index = module_name.len()
    while index >= 2_usize {
        if module_name.slice(index - 2_usize, 2_usize) == "::" {
            ret module_name.slice(0_usize, index - 2_usize)
        }
        index -= 1_usize
    }
    ret ""
}

fn import_binding_names(path: str, owner: str) -> Vec[(str, str)] {
    let mut out = Vec[(str, str)]::new()
    if path.len() <= owner.len() + 2_usize {
        out.push(("*", "*")) ret out
    }
    let suffix = path.slice(owner.len() + 2_usize, path.len() - owner.len() - 2_usize)
    if starts_with(suffix, "{") {
        let mut inner = suffix.slice(1_usize, suffix.len() - 1_usize)
        if inner.len() > 0_usize && inner.slice(inner.len() - 1_usize, 1_usize) == "}" {
            inner = inner.slice(0_usize, inner.len() - 1_usize)
        }
        for item in split_import_items(inner) {
            out.push(import_binding(item))
        }
        ret out
    }
    out.push(import_binding(suffix))
    ret out
}

fn split_import_items(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "," {
            if trim_analysis_text(current) != "" {
                out.push(trim_analysis_text(current))
            }
            current = ""
        } else {
            current += ch
        }
        index += 1_usize
    }
    if trim_analysis_text(current) != "" {
        out.push(trim_analysis_text(current))
    }
    ret out
}

fn import_binding(value: str) ->(str, str) {
    let trimmed = trim_analysis_text(value)
    let mut index = 0_usize
    while index + 4_usize <= trimmed.len() {
        if trimmed.slice(index, 4_usize) == " as " {
            ret(trim_analysis_text(trimmed.slice(0_usize, index)), trim_analysis_text(trimmed.slice(index
                        + 4_usize, trimmed.len() - index - 4_usize,)))
        }
        index += 1_usize
    }
    ret(trimmed, trimmed)
}

fn trim_analysis_text(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.len()
    while start < end &&(value.slice(start, 1_usize) == " " || value.slice(start, 1_usize) == "\t") {
        start += 1_usize
    }
    while end > start &&(value.slice(end - 1_usize, 1_usize) == " " || value.slice(end - 1_usize, 1_usize)
        == "\t") {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn next_definition_id(
    module_name: str,
    owner: str,
    kind: str,
    name: str,
    identity_keys: mut Vec[str],
) -> DefinitionId {
    let key = owner + "#" + kind + "#" + name
    let mut ordinal = 0_usize
    for existing in identity_keys {
        if existing == key {
            ordinal += 1_usize
        }
    }
    identity_keys.push(key)
    ret definition_id(module_name, owner, kind, name, ordinal)
}

fn insert_import_definition(
    definition: HirDefinition,
    alias: str,
    is_public: bool,
    map: mut ModuleDefMap,
) ->() {
    map.insert(HirDefinition::new(
            definition.id(),
            definition.module_name(),
            alias,
            DefinitionKind::Import,
            definition.namespace(),
            is_public,
            definition.source_name(),
            definition.line(),
            definition.column(),
            definition.length(),
            definition.typ(),
        ))
    ret()
}

fn contains_string_value(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn starts_with(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}

fn ends_with_analysis(value: str, suffix: str) -> bool {
    ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}

#attr(test)
fn semantic_hir_def_map_contract() -> bool {
    let mut database = AnalysisDatabase::new()
    database.set_module_full(
        "sample",
        "sample.enq",
        "pub struct User { name: str }\npub trait Named { fn name(self: Self) -> str }\npub fn make() -> User { ret User{\"Ada\"} }\n",
    )
    let map = match database.module_def_map("sample") {
        Option[ModuleDefMap]::Some(value) => value
        Option[ModuleDefMap]::None => {
            ret false
        }
    }
    let user = match map.resolve("User", DefinitionNamespace::Type) {
        Option::Some(value) => value
        Option::None => {
            ret false
        }
    }
    let make = match map.resolve("make", DefinitionNamespace::Value) {
        Option::Some(value) => value
        Option::None => {
            ret false
        }
    }
    ret user.value() != 0_u64 && make.value() != 0_u64 && user.key() != make.key()
}

#attr(test)
fn semantic_hir_ids_survive_body_edits_contract() -> bool {
    let mut database = AnalysisDatabase::new()
    database.set_module_full("sample", "sample.enq", "pub fn answer() -> u32 { ret 1_u32 }\n")
    let mut first = DefinitionId::invalid()
    match database.module_def_map("sample") {
        Option[ModuleDefMap]::Some(map) => {
            match map.resolve("answer", DefinitionNamespace::Value) {
                Option::Some(value) => {
                    first = value
                }
                Option::None => {
                }
            }
        }
        Option[ModuleDefMap]::None => {
        }
    }
    if database.module_def_map_count("sample") != 1_usize {
        ret false
    }
    database.set_module_full(
        "sample",
        "sample.enq",
        "pub struct Unrelated { value: u32 }\npub fn answer() -> u32 { ret 2_u32 }\n",
    )
    let mut second = DefinitionId::invalid()
    match database.module_def_map("sample") {
        Option[ModuleDefMap]::Some(map) => {
            match map.resolve("answer", DefinitionNamespace::Value) {
                Option::Some(value) => {
                    second = value
                }
                Option::None => {
                }
            }
        }
        Option[ModuleDefMap]::None => {
        }
    }
    ret first.value() != 0_u64 && first.value() == second.value() && first.key() == second.key()
    && database.module_def_map_count("sample") == 2_usize
}

#attr(test)
fn semantic_hir_import_namespace_contract() -> bool {
    let mut database = AnalysisDatabase::new()
    database.set_module_full("dependency", "dependency.enq", "pub struct Item { value: u32 }\npub fn make() -> Item { ret Item{1_u32} }\n")
    database.set_module_full("consumer", "consumer.enq", "import dependency::Item as ImportedItem\nimport dependency::make\nfn main() -> u32 { let item = make() ret item.value }\n")
    let map = match database.module_def_map("consumer") {
        Option[ModuleDefMap]::Some(value) => value
        Option[ModuleDefMap]::None => {
            ret false
        }
    }
    let imported_item = map.resolve("ImportedItem", DefinitionNamespace::Type)
    let imported_make = map.resolve("make", DefinitionNamespace::Value)
    let dependency = match database.module_def_map("dependency") {
        Option[ModuleDefMap]::Some(value) => value
        Option[ModuleDefMap]::None => {
            ret false
        }
    }
    ret imported_item.is_some()
    && imported_make.is_some()
    && imported_item.unwrap_or(DefinitionId::invalid()).key()
    == dependency.resolve("Item", DefinitionNamespace::Type).unwrap_or(DefinitionId::invalid()).key()
    && imported_make.unwrap_or(DefinitionId::invalid()).key()
    == dependency.resolve("make", DefinitionNamespace::Value).unwrap_or(DefinitionId::invalid()).key()
}

#attr(test)
fn semantic_hir_relative_module_import_contract() -> bool {
    let mut database = AnalysisDatabase::new()
    database.set_module_full(
        "sample::frontend::lexer::token",
        "token.enq",
        "pub struct Token {}\npub enum TokenType { Unknown }\n",
    )
    database.set_module_full(
        "sample::frontend::lexer::lexer",
        "lexer.enq",
        "import mod::token::Token\nimport mod::token::TokenType\nfn consume(value: Token, kind: TokenType) -> () { ret () }\n",
    )
    let map = match database.module_def_map("sample::frontend::lexer::lexer") {
        Option[ModuleDefMap]::Some(value) => value
        Option[ModuleDefMap]::None => {
            ret false
        }
    }
    ret map.resolve("Token", DefinitionNamespace::Type).is_some()
    && map.resolve("TokenType", DefinitionNamespace::Type).is_some()
}
