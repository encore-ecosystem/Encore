//! Provides reusable source-analysis data for compiler tools.

import core::option::Option
import std::vec::Vec

import refrain::frontend::dependency_graph::DependencyGraph
import refrain::frontend::lexer::Lexer
import refrain::frontend::lexer::Token
import refrain::frontend::lexer::TokenType
import refrain::frontend::parser::Documentation
import refrain::frontend::parser::Parser
import refrain::frontend::parser::Statement

extern fn encore_strset_new() -> usize
extern fn encore_strset_insert(set: usize, value: str) -> bool
extern fn encore_strset_free(set: usize) ->()

/// Identifies how a labelled source range contributes to a diagnostic.
pub enum DiagnosticLabelKind {
    Primary
    Secondary
}

/// A labelled range in one source document.
pub struct DiagnosticLabel {
    source_name: str
    line: usize
    column: usize
    length: usize
    kind: DiagnosticLabelKind
    message: str
}

/// Classifies whether a diagnostic suggestion may be applied automatically.
pub enum SuggestionApplicability {
    MachineApplicable
    MaybeIncorrect
    HasPlaceholders
    Unspecified
}

/// A structured source edit attached to a diagnostic.
pub struct DiagnosticSuggestion {
    source_name: str
    line: usize
    column: usize
    length: usize
    replacement: str
    message: str
    applicability: SuggestionApplicability
}

/// Describes a source diagnostic with stable code, labelled ranges, notes,
/// help, and machine-readable suggestions.
pub struct FrontendDiagnostic {
    severity: usize
    code: str
    message: str
    line: usize
    column: usize
    length: usize
    labels: Vec[DiagnosticLabel]
    notes: Vec[str]
    helps: Vec[str]
    suggestions: Vec[DiagnosticSuggestion]
}

/// Describes a declaration discovered during frontend analysis.
pub struct FrontendSymbol {
    name: str
    scope: str
    kind: usize
    line: usize
    column: usize
    length: usize
    documentation: Option[Documentation]
}

/// Describes a callable signature used by editor and analysis clients.
pub struct FrontendCallable {
    name: str
    params: Vec[str]
    ret_type: Option[str]
    line: usize
    column: usize
    length: usize
}

/// Contains the syntax, symbols, dependencies, and diagnostics of one module.
pub struct FrontendDocument {
    tokens: Vec[Token]
    ast: Vec[Statement]
    module_documentation: Option[Documentation]
    diagnostics: Vec[FrontendDiagnostic]
    symbols: Vec[FrontendSymbol]
    callables: Vec[FrontendCallable]
    dependencies: DependencyGraph
    parsed: bool
}

impl for FrontendDiagnostic {
    /// Creates a diagnostic at the supplied zero-based source position.
    pub fn new(severity: usize, code: str, message: str, line: usize, column: usize, length: usize) ->
    Self {
        ret Self {
            severity,
            code,
            message,
            line,
            column,
            length,
            Vec[DiagnosticLabel]::new(),
            Vec[str]::new(),
            Vec[str]::new(),
            Vec[DiagnosticSuggestion]::new()
        }
    }

    /// Adds a primary or secondary labelled range.
    pub fn with_label(
        self: mut Self,
        source_name: str,
        line: usize,
        column: usize,
        length: usize,
        kind: DiagnosticLabelKind,
        message: str,
    ) -> Self {
        self.labels.push(DiagnosticLabel {
                source_name, line, column, length, kind, message
            }
            ,
        )
        ret self
    }

    /// Adds explanatory context which is not tied to a source range.
    pub fn with_note(self: mut Self, message: str) -> Self {
        self.notes.push(message)
        ret self
    }

    /// Adds actionable human guidance.
    pub fn with_help(self: mut Self, message: str) -> Self {
        self.helps.push(message)
        ret self
    }

    /// Adds a structured source edit for CLI, LSP, and IDE consumers.
    pub fn with_suggestion(
        self: mut Self,
        source_name: str,
        line: usize,
        column: usize,
        length: usize,
        replacement: str,
        message: str,
        applicability: SuggestionApplicability,
    ) -> Self {
        self.suggestions.push(DiagnosticSuggestion {
                source_name,
                line,
                column,
                length,
                replacement,
                message,
                applicability
            }
            ,)
        ret self
    }
}

impl for FrontendSymbol {
    /// Creates a symbol description and attaches optional documentation.
    pub fn new(name: str, scope: str, kind: usize, line: usize, column: usize, length: usize, documentation:
        Option[Documentation],) -> Self {
        ret Self {
            name, scope, kind, line, column, length, documentation
        }
    }
}

impl for FrontendCallable {
    /// Creates a callable description from its parameter and return metadata.
    pub fn new(name: str, params: Vec[str], ret_type: Option[str], line: usize, column: usize, length:
        usize,) -> Self {
        ret Self {
            name, params, ret_type, line, column, length
        }
    }
}

impl for FrontendDocument {
    /// Creates an unanalyzed empty document.
    pub fn empty() -> Self {
        ret Self {
            Vec[Token]::new(),
            Vec[Statement]::new(),
            Option[Documentation]::None,
            Vec[FrontendDiagnostic]::new(),
            Vec[FrontendSymbol]::new(),
            Vec[FrontendCallable]::new(),
            DependencyGraph::new(),
            false
        }
    }

    /// Creates a fast declaration outline for latency-sensitive editor requests.
    pub fn outline(module_name: str, source: str) -> Self {
        let mut lexer = Lexer::new()
        let tokens = lexer.tokenize(source)
        ret Self {
            tokens,
            Vec[Statement]::new(),
            collect_module_documentation(tokens),
            Vec[FrontendDiagnostic]::new(),
            collect_symbols(tokens),
            collect_callables(tokens),
            DependencyGraph::from_tokens(module_name, tokens),
            false
        }
    }

    /// Restores a validated lightweight document from editor-owned metadata.
    pub fn from_cached_lightweight(
        source: str,
        module_documentation: Option[Documentation],
        diagnostics: Vec[FrontendDiagnostic],
        symbols: Vec[FrontendSymbol],
        callables: Vec[FrontendCallable],
        dependencies: DependencyGraph,
        parsed: bool,
    ) -> Self {
        let mut lexer = Lexer::new()
        ret Self {
            lexer.tokenize(source),
            Vec[Statement]::new(),
            module_documentation,
            diagnostics,
            symbols,
            callables,
            dependencies,
            parsed
        }
    }
}

/// Fully analyzes an anonymous source document, including parsing its AST.
pub fn analyze_source(source: str) -> FrontendDocument {
    ret analyze_module("document", source)
}

/// Analyzes an anonymous document without invoking the strict parser.
pub fn analyze_source_lightweight(source: str) -> FrontendDocument {
    ret analyze_module_lightweight("document", source)
}

/// Tokenizes source for cursor-based tooling and exposes expressions embedded
/// in f-strings at their original source coordinates.
pub fn tooling_tokens(source: str) -> Vec[Token] {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    ret tooling_tokens_from_tokens(tokens)
}

/// Expands embedded expressions without retokenizing an existing document.
pub fn tooling_tokens_from_tokens(tokens: Vec[Token]) -> Vec[Token] {
    let mut out = Vec[Token]::new()
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                out.push(token)
                if token.type == TokenType::IDENTIFIER && token.value == "f" {
                    match tokens.get(index + 1_usize) {
                        Option[Token]::Some(string_token) => {
                            if string_token.type == TokenType::STRING {
                                push_fstring_tooling_tokens(out, string_token)
                            }
                        }
                        Option[Token]::None => {
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn push_fstring_tooling_tokens(out: mut Vec[Token], string_token: Token) ->() {
    if string_token.value.len() < 2_usize {
        ret()
    }
    let body = string_token.value.slice(1_usize, string_token.value.len() - 2_usize)
    let mut cursor = 0_usize
    while cursor < body.len() {
        if body.slice(cursor, 1_usize) != "{" {
            cursor += 1_usize
            continue
        }
        let mut end = cursor + 1_usize
        while end < body.len() && body.slice(end, 1_usize) != "}" {
            end += 1_usize
        }
        if end >= body.len() {
            ret()
        }
        let mut expression = body.slice(cursor + 1_usize, end - cursor - 1_usize)
        let mut expression_column = string_token.column + cursor + 2_usize
        if expression.len() > 0_usize && expression.slice(0_usize, 1_usize) == "#" {
            expression = expression.slice(1_usize, expression.len() - 1_usize)
            expression_column += 1_usize
        }
        let mut nested_lexer = Lexer::new()
        for nested in nested_lexer.tokenize(expression) {
            if nested.type != TokenType::EOF {
                let line = string_token.line + nested.line
                let column = if nested.line == 0_usize {
                    expression_column + nested.column
                } else {
                    nested.column
                }
                out.push(Token::new(nested.type, nested.value, line, column))
            }
        }
        cursor = end + 1_usize
    }
    ret()
}

/// Collects tolerant diagnostics, symbols, callables, and dependencies.
///
/// This mode is suitable for editors while a document is incomplete.
pub fn analyze_module_lightweight(module_name: str, source: str) -> FrontendDocument {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    let module_documentation = collect_module_documentation(tokens)
    let mut diagnostics = collect_lexer_diagnostics(tokens)
    let symbols = collect_symbols(tokens)
    let callables = collect_callables(tokens)
    let dependencies = DependencyGraph::from_tokens(module_name, tokens)

    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            module_documentation,
            diagnostics,
            symbols,
            callables,
            dependencies,
            false
        }
    }

    let structural_diagnostics = collect_structural_diagnostics(tokens)
    if structural_diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            module_documentation,
            structural_diagnostics,
            symbols,
            callables,
            dependencies,
            false
        }
    }

    diagnostics.extend(collect_declaration_diagnostics(tokens))

    ret FrontendDocument {
        tokens,
        Vec[Statement]::new(),
        module_documentation,
        diagnostics,
        symbols,
        callables,
        dependencies,
        true
    }
}

/// Fully analyzes a module using its module name as the diagnostic source.
pub fn analyze_module(module_name: str, source: str) -> FrontendDocument {
    ret analyze_named_module(module_name, module_name, source)
}

/// Fully analyzes a module while reporting diagnostics under `source_name`.
pub fn analyze_named_module(module_name: str, source_name: str, source: str) -> FrontendDocument {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    ret analyze_named_tokens(module_name, source_name, tokens)
}

/// Fully analyzes a module from an existing token query.
///
/// Incremental consumers use this entry point to avoid lexing a source again
/// when upgrading a tolerant document to a strict AST-backed document.
pub fn analyze_named_tokens(module_name: str, source_name: str, tokens: Vec[Token]) -> FrontendDocument
{
    let module_documentation = collect_module_documentation(tokens)
    let mut diagnostics = collect_lexer_diagnostics(tokens)
    let symbols = collect_symbols(tokens)
    let callables = collect_callables(tokens)

    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            module_documentation,
            diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }

    let structural_diagnostics = collect_structural_diagnostics(tokens)
    if structural_diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            module_documentation,
            structural_diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }

    diagnostics.extend(collect_declaration_diagnostics(tokens))
    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            module_documentation,
            diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }

    let mut parser = Parser::new_for_source(source_name)
    let ast = parser.parse(tokens)
    let dependencies = DependencyGraph::from_tokens(module_name, tokens)

    ret FrontendDocument {
        tokens,
        ast,
        module_documentation,
        diagnostics,
        symbols,
        callables,
        dependencies,
        true
    }
}

fn collect_lexer_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    for token in tokens {
        if token.type == TokenType::UNKNOWN && token.value != "$" {
            out.push(FrontendDiagnostic::new(1_usize, "unknown-token", "unknown token: " + token.value,
                    token.line, token.column, token.value.char_len(),))
        }
    }
    ret out
}

fn collect_module_documentation(tokens: Vec[Token]) -> Option[Documentation] {
    let mut end = 0_usize
    while end < tokens.len() {
        match tokens.get(end) {
            Option[Token]::Some(token) => {
                if token.type != TokenType::MODULE_DOC_COMMENT {
                    break
                }
            }
            Option[Token]::None => {
                break
            }
        }
        end += 1_usize
    }
    ret documentation_from_token_range(tokens, 0_usize, end, TokenType::MODULE_DOC_COMMENT)
}

fn documentation_before(tokens: Vec[Token], declaration_index: usize) -> Option[Documentation] {
    let mut end = declaration_index
    while end > 0_usize {
        match tokens.get(end - 1_usize) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::KW_PUB || token.type == TokenType::KW_ASYNC || token.type
                == TokenType::KW_EXTERN {
                    end -= 1_usize
                    continue
                }
            }
            Option[Token]::None => {
            }
        }
        break
    }
    let mut start = end
    while start > 0_usize {
        match tokens.get(start - 1_usize) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::DOC_COMMENT {
                    start -= 1_usize
                    continue
                }
            }
            Option[Token]::None => {
            }
        }
        break
    }
    ret documentation_from_token_range(tokens, start, end, TokenType::DOC_COMMENT)
}

fn documentation_from_token_range(tokens: Vec[Token], start: usize, end: usize, expected: TokenType)
-> Option[Documentation] {
    if start >= end {
        ret Option[Documentation]::None
    }
    let mut text = ""
    let mut index = start
    let mut first = Option[Token]::None
    while index < end {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type != expected {
                    ret Option[Documentation]::None
                }
                match first {
                    Option[Token]::None => {
                        first = Option[Token]::Some(token)
                    }
                    _ => {
                    }
                }
                let mut line = ""
                if token.value.len() >= 3_usize {
                    line = token.value.slice(3_usize, token.value.len() - 3_usize)
                }
                if line.len() > 0_usize && line.slice(0_usize, 1_usize) == " " {
                    line = line.slice(1_usize, line.len() - 1_usize)
                }
                if index > start {
                    text = text + "\n"
                }
                text = text + line
            }
            Option[Token]::None => {
                ret Option[Documentation]::None
            }
        }
        index += 1_usize
    }
    match first {
        Option[Token]::Some(token) => {
            ret Option[Documentation]::Some(Documentation::new(text, token.line, token.column))
        }
        Option[Token]::None => {
        }
    }
    ret Option[Documentation]::None
}

fn collect_structural_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut parens = 0_i32
    let mut braces = 0_i32
    let mut brackets = 0_i32

    for token in tokens {
        match token.type {
            TokenType::LEFT_PAREN => {
                parens += 1_i32
            }
            TokenType::RIGHT_PAREN => {
                parens -= 1_i32
                if parens < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-parenthesis", "unmatched closing parenthesis",
                            token.line, token.column, token.value.char_len(),))
                    ret out
                }
            }
            TokenType::LEFT_BRACE => {
                braces += 1_i32
            }
            TokenType::RIGHT_BRACE => {
                braces -= 1_i32
                if braces < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-brace", "unmatched closing brace",
                            token.line, token.column, token.value.char_len(),))
                    ret out
                }
            }
            TokenType::LEFT_BRACKET => {
                brackets += 1_i32
            }
            TokenType::RIGHT_BRACKET => {
                brackets -= 1_i32
                if brackets < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-bracket", "unmatched closing bracket",
                            token.line, token.column, token.value.char_len(),))
                    ret out
                }
            }
            _ => {
            }
        }
    }

    match last_token(tokens) {
        Option[Token]::Some(token) => {
            if parens > 0_i32 {
                out.push(FrontendDiagnostic::new(1_usize, "unclosed-parenthesis", "unclosed parenthesis",
                        token.line, token.column + token.value.char_len(), 1_usize,))
            } elif braces > 0_i32 {
                out.push(FrontendDiagnostic::new(1_usize, "unclosed-brace", "unclosed brace", token.line,
                        token.column + token.value.char_len(), 1_usize,))
            } elif brackets > 0_i32 {
                out.push(FrontendDiagnostic::new(1_usize, "unclosed-bracket", "unclosed bracket", token.line,
                        token.column + token.value.char_len(), 1_usize,))
            }
        }
        Option[Token]::None => {
        }
    }

    ret out
}

fn collect_declaration_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    let function_names = encore_strset_new()
    let mut brace_depth = 0_i32
    let mut pending_attribute = false
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if brace_depth == 0_i32 && token.type == TokenType::HASH {
                    pending_attribute = true
                } elif token.type == TokenType::LEFT_BRACE {
                    brace_depth += 1_i32
                } elif token.type == TokenType::RIGHT_BRACE {
                    brace_depth -= 1_i32
                } elif brace_depth == 0_i32 && token.type == TokenType::KW_FN {
                    match next_significant_token(tokens, index + 1_usize) {
                        Option[Token]::Some(name) => {
                            if name.type == TokenType::IDENTIFIER && !pending_attribute {
                                if !encore_strset_insert(function_names, name.value) {
                                    out.push(FrontendDiagnostic::new(1_usize, "duplicate-function", "duplicate function declaration '"
                                            + name.value + "'", name.line, name.column, name.value.char_len(),))
                                }
                            }
                        }
                        Option[Token]::None => {
                        }
                    }
                    pending_attribute = false
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    encore_strset_free(function_names)
    ret out
}

fn next_significant_token(tokens: Vec[Token], start: usize) -> Option[Token] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type != TokenType::WHITESPACE && token.type != TokenType::NEWLINE && token.type
                != TokenType::ONE_LINE_COMMENT && token.type != TokenType::MULTI_LINE_COMMENT {
                    ret Option[Token]::Some(token)
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn last_token(tokens: Vec[Token]) -> Option[Token] {
    if tokens.len() == 0_usize {
        ret Option[Token]::None
    }
    ret tokens.get(tokens.len() - 1_usize)
}

fn collect_symbols(tokens: Vec[Token]) -> Vec[FrontendSymbol] {
    let mut out = Vec[FrontendSymbol]::new()
    let mut scopes = Vec[(str, usize)]::new()
    let mut pending_scope = ""
    let mut depth = 0_usize
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::RIGHT_BRACE {
                    if scopes.len() > 0_usize {
                        match scopes.get(scopes.len() - 1_usize) {
                            Option[(str, usize)]::Some(scope) => {
                                if scope.1 == depth {
                                    scopes.pop()
                                }
                            }
                            Option[(str, usize)]::None => {
                            }
                        }
                    }
                    if depth > 0_usize {
                        depth -= 1_usize
                    }
                    pending_scope = ""
                } elif token.type == TokenType::LEFT_BRACE {
                    depth += 1_usize
                    if pending_scope != "" {
                        scopes.push((pending_scope, depth))
                        pending_scope = ""
                    }
                } elif pending_scope != "" && symbol_declaration_starts(token.type) {
                    pending_scope = ""
                }
                let scope = symbol_scope_text(scopes)
                match token.type {
                    TokenType::KW_FN => {
                        push_next_identifier_symbol(out, tokens, index, 12_usize, scope)
                    }
                    TokenType::KW_STRUCT => {
                        push_next_identifier_symbol(out, tokens, index, 23_usize, scope)
                        pending_scope = next_declaration_name(tokens, index)
                    }
                    TokenType::KW_ENUM => {
                        push_next_identifier_symbol(out, tokens, index, 10_usize, scope)
                        pending_scope = next_declaration_name(tokens, index)
                    }
                    TokenType::KW_TRAIT => {
                        push_next_identifier_symbol(out, tokens, index, 11_usize, scope)
                        pending_scope = next_declaration_name(tokens, index)
                    }
                    TokenType::KW_IMPL => {
                        let impl_name = impl_symbol_name(tokens, index)
                        let impl_scope = impl_declaration_scope(tokens, index)
                        push_impl_symbol(out, tokens, index, join_symbol_scope(scope, impl_scope), impl_name)
                        pending_scope = impl_scope
                    }
                    _ => {
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn collect_callables(tokens: Vec[Token]) -> Vec[FrontendCallable] {
    let mut out = Vec[FrontendCallable]::new()
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::KW_FN {
                    push_function_callable(out, tokens, index)
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn push_function_callable(out: mut Vec[FrontendCallable], tokens: Vec[Token], fn_index: usize) ->() {
    match next_identifier_token_index(tokens, fn_index + 1_usize) {
        Option[usize]::Some(name_index) => {
            let name_token = tokens.get(name_index).unwrap_or(Token::new(TokenType::IDENTIFIER, "", 0_usize,
                    0_usize,))
            let params = collect_function_params(tokens, name_index + 1_usize)
            let ret_type = collect_function_return_type(tokens, name_index + 1_usize)
            out.push(FrontendCallable::new(name_token.value, params, ret_type, name_token.line, name_token.column,
                    name_token.value.char_len(),))
        }
        Option[Token]::None => {
        }
    }
    ret()
}

fn collect_function_params(tokens: Vec[Token], start: usize) -> Vec[str] {
    let mut params = Vec[str]::new()
    let mut index = start
    let mut depth = 0_i32
    let mut in_params = false

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if !in_params {
                    if token.type == TokenType::LEFT_PAREN {
                        in_params = true
                        depth = 1_i32
                    }
                } else {
                    if token.type == TokenType::LEFT_PAREN {
                        depth += 1_i32
                    } elif token.type == TokenType::RIGHT_PAREN {
                        depth -= 1_i32
                        if depth == 0_i32 {
                            ret params
                        }
                    } elif depth == 1_i32 {
                        if token.type == TokenType::IDENTIFIER {
                            if next_token_is(tokens, index + 1_usize, TokenType::COLON) {
                                params.push(token.value + ": " + collect_parameter_type(tokens, index + 2_usize))
                            }
                        }
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }

    ret params
}

fn collect_parameter_type(tokens: Vec[Token], start: usize) -> str {
    let mut out = ""
    let mut index = start
    let mut bracket_depth = 0_i32
    let mut paren_depth = 0_i32
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if bracket_depth == 0_i32 && paren_depth == 0_i32 {
                    if token.type == TokenType::COMMA || token.type == TokenType::RIGHT_PAREN {
                        break
                    }
                }
                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                } elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                } elif token.type == TokenType::LEFT_PAREN {
                    paren_depth += 1_i32
                } elif token.type == TokenType::RIGHT_PAREN {
                    paren_depth -= 1_i32
                }
                out += token.value
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn collect_function_return_type(tokens: Vec[Token], start: usize) -> Option[str] {
    let mut index = start
    let mut depth = 0_i32
    let mut after_params = false

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_PAREN {
                    depth += 1_i32
                } elif token.type == TokenType::RIGHT_PAREN {
                    depth -= 1_i32
                    if depth == 0_i32 {
                        after_params = true
                    }
                } elif after_params {
                    if token.type == TokenType::ARROW {
                        ret collect_type_after_arrow(tokens, index + 1_usize)
                    }
                    if token.type == TokenType::LEFT_BRACE {
                        ret Option[str]::None
                    }
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }

    ret Option[str]::None
}

fn collect_type_after_arrow(tokens: Vec[Token], start: usize) -> Option[str] {
    let mut out = ""
    let mut index = start
    let mut bracket_depth = 0_i32
    let mut paren_depth = 0_i32

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if bracket_depth == 0_i32 && paren_depth == 0_i32 {
                    if token.type == TokenType::LEFT_BRACE {
                        break
                    }
                    if token.type == TokenType::COMMA {
                        break
                    }
                }

                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                } elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                } elif token.type == TokenType::LEFT_PAREN {
                    paren_depth += 1_i32
                } elif token.type == TokenType::RIGHT_PAREN {
                    paren_depth -= 1_i32
                }
                out += token.value
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }

    if out.len() == 0_usize {
        ret Option[str]::None
    }
    ret Option[str]::Some(out)
}

fn next_token_is(tokens: Vec[Token], index: usize, expected: TokenType) -> bool {
    match tokens.get(index) {
        Option[Token]::Some(token) => {
            ret token.type == expected
        }
        Option[Token]::None => {
            ret false
        }
    }
}

fn push_next_identifier_symbol(out: mut Vec[FrontendSymbol], tokens: Vec[Token], start: usize, kind:
    usize, scope: str,) ->() {
    match next_identifier_token(tokens, start + 1_usize) {
        Option[Token]::Some(name_token) => {
            out.push(FrontendSymbol::new(name_token.value, scope, kind, name_token.line, name_token.column,
                    name_token.value.char_len(), documentation_before(tokens, start),))
        }
        Option[Token]::None => {
        }
    }
    ret()
}

fn impl_symbol_name(tokens: Vec[Token], start: usize) -> str {
    let mut name = "impl"
    match next_identifier_token_index(tokens, start + 1_usize) {
        Option[usize]::Some(first_index) => {
            let first = tokens.get(first_index).unwrap_or(Token::new(TokenType::IDENTIFIER, "", 0_usize, 0_usize))
            if first.value == "for" {
                match next_identifier_token(tokens, first_index + 1_usize) {
                    Option[Token]::Some(target) => {
                        name = "impl " + target.value
                    }
                    Option[Token]::None => {
                    }
                }
            } else {
                name = "impl " + first.value
            }
        }
        Option[Token]::None => {
        }
    }
    ret name
}

fn push_impl_symbol(out: mut Vec[FrontendSymbol], tokens: Vec[Token], start: usize, scope: str, name:
    str,) ->() {
    match tokens.get(start) {
        Option[Token]::Some(token) => {
            out.push(FrontendSymbol::new(name, scope, 5_usize, token.line, token.column, name.char_len(),
                    documentation_before(tokens, start),))
        }
        Option[Token]::None => {
        }
    }
    ret()
}

fn impl_declaration_scope(tokens: Vec[Token], start: usize) -> str {
    let mut out = ""
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_BRACE {
                    break
                }
                out += token.value
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn next_declaration_name(tokens: Vec[Token], start: usize) -> str {
    match next_identifier_token(tokens, start + 1_usize) {
        Option[Token]::Some(token) => {
            ret token.value
        }
        Option[Token]::None => {
        }
    }
    ret ""
}

fn symbol_scope_text(scopes: Vec[(str, usize)]) -> str {
    let mut out = ""
    for scope in scopes {
        if out != "" {
            out += "::"
        }
        out += scope.0
    }
    ret out
}

fn join_symbol_scope(prefix: str, suffix: str) -> str {
    if prefix == "" {
        ret suffix
    }
    if suffix == "" {
        ret prefix
    }
    ret prefix + "::" + suffix
}

fn symbol_declaration_starts(token_type: TokenType) -> bool {
    ret token_type == TokenType::KW_FN
    || token_type == TokenType::KW_STRUCT
    || token_type == TokenType::KW_ENUM
    || token_type == TokenType::KW_TRAIT
    || token_type == TokenType::KW_IMPL
    || token_type == TokenType::KW_IMPORT
    || token_type == TokenType::KW_LET
}

fn next_identifier_token(tokens: Vec[Token], start: usize) -> Option[Token] {
    match next_identifier_token_index(tokens, start) {
        Option[usize]::Some(index) => {
            match tokens.get(index) {
                Option[Token]::Some(token) => {
                    if token.type == TokenType::KW_FOR {
                        ret Option[Token]::Some(Token::new(TokenType::IDENTIFIER, "for", token.line, token.column))
                    }
                    ret Option[Token]::Some(token)
                }
                Option[Token]::None => {
                }
            }
        }
        Option[usize]::None => {
        }
    }
    ret Option[Token]::None
}

fn next_identifier_token_index(tokens: Vec[Token], start: usize) -> Option[usize] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER || token.type == TokenType::KW_FOR {
                    ret Option[usize]::Some(index)
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[usize]::None
}
