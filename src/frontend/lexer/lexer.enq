//! Tokenizes Encore source code.

import mod::token::Token
import mod::token::TokenType

import core::option::Option
import std::io::eprintln
import std::process::exit
import std::vec::Vec

import core::fmt::Debug
import std::io::print
import std::io::println

extern fn encore_str_char_width_at_byte(value: str, byte_index: usize) -> usize

enum LexerByte {
    Space
    Tab
    CarriageReturn
    Newline
    Plus
    Minus
    Asterisk
    Slash
    Percent
    Less
    Greater
    LeftParen
    RightParen
    LeftBracket
    RightBracket
    LeftBrace
    RightBrace
    Colon
    Dot
    Comma
    Semicolon
    Equal
    Bang
    Ampersand
    Pipe
    Caret
    Tilde
    Question
    Hash
    At
    DoubleQuote
    Quote
    Other
}

/// Stores the state of a `Lexer` value.
pub struct Lexer {
    line: usize
    column: usize
    consumed: usize
    token_start: usize
    token_line: usize
    token_column: usize
    program: str
    tokens: Vec[Token]
    preserve_trivia: bool
}

impl for Lexer {
    /// Creates a new value with its default initial state.
    pub fn new() -> Lexer {
        ret Lexer {
            0_usize, 0_usize, 0_usize, 0_usize, 0_usize, 0_usize, "", Vec[Token]::new(), false
        }
    }

    /// Performs the `tokenize` operation.
    pub fn tokenize(mut self, p: str) -> Vec[Token] {
        self.preserve_trivia = false
        ret self.tokenize_source(p)
    }

    /// Tokenizes source while retaining whitespace, newlines, and ordinary
    /// comments. This lossless stream is used by formatting and source tools;
    /// the parser continues to consume the compact stream returned by
    /// `tokenize`.
    pub fn tokenize_lossless(mut self, p: str) -> Vec[Token] {
        self.preserve_trivia = true
        ret self.tokenize_source(p)
    }

    fn tokenize_source(mut self, p: str) -> Vec[Token] {
        self.line = 0_usize
        self.column = 0_usize
        self.consumed = 0_usize
        self.token_start = 0_usize
        self.token_line = 0_usize
        self.token_column = 0_usize
        self.program = p
        self.tokens = Vec[Token]::new()

        let mut progress_guard = 0_usize
        loop {
            if self.is_at_end() {
                break
            }
            progress_guard = progress_guard + 1_usize
            if progress_guard > self.program.byte_len() * 4_usize + 16_usize {
                eprintln("error[lexer-invariant]: lexer made no progress at byte index " + Debug::fmt(self.consumed))
                exit(1_i32)
            }
            match lexer_byte(self.peek_byte(0_usize)) {
                LexerByte::Space => {
                    self.consume_and_push(TokenType::WHITESPACE)
                }
                LexerByte::Tab => {
                    self.consume_and_push(TokenType::WHITESPACE)
                }
                LexerByte::CarriageReturn => {
                    self.consume()
                    if self.peek_byte(0_usize) == 10_u8 {
                        self.consumed += 1_usize
                    }
                    self.push_token(TokenType::NEWLINE)
                }
                LexerByte::Newline => {
                    self.consume_and_push(TokenType::NEWLINE)
                }
                LexerByte::Plus => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::PLUS_EQUAL)
                    } elif self.peek_byte(0_usize) == 43_u8 {
                        self.consume_and_push(TokenType::INCREMENT)
                    } else {
                        self.push_token(TokenType::PLUS)
                    }
                }
                LexerByte::Minus => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::MINUS_EQUAL)
                    } elif self.peek_byte(0_usize) == 62_u8 {
                        self.consume_and_push(TokenType::ARROW)
                    } elif self.peek_byte(0_usize) == 45_u8 {
                        self.consume_and_push(TokenType::DECREMENT)
                    } else {
                        self.push_token(TokenType::MINUS)
                    }
                }
                LexerByte::Asterisk => {
                    self.consume()
                    if self.peek_byte(0_usize) == 42_u8 {
                        self.consume()
                        if self.peek_byte(0_usize) == 61_u8 {
                            self.consume_and_push(TokenType::POWER_EQUAL)
                        } else {
                            self.push_token(TokenType::POWER)
                        }
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::ASTERISK_EQUAL)
                    } else {
                        self.push_token(TokenType::ASTERISK)
                    }
                }
                LexerByte::Slash => {
                    self.consume()
                    if self.peek_byte(0_usize) == 47_u8 {
                        self.consume()
                        let mut comment_type = TokenType::ONE_LINE_COMMENT
                        if self.peek_byte(0_usize) == 47_u8 {
                            self.consume()
                            comment_type = TokenType::DOC_COMMENT
                        } elif self.peek_byte(0_usize) == 33_u8 {
                            self.consume()
                            comment_type = TokenType::MODULE_DOC_COMMENT
                        }
                        self.skip_one_line_comment()
                        self.push_token(comment_type)
                    } elif self.peek_byte(0_usize) == 42_u8 {
                        self.consume()
                        self.skip_multi_line_comment_body()

                        if self.is_at_end() {
                            self.push_token(TokenType::UNKNOWN)
                        } else {
                            self.consume()
                            self.consume_and_push(TokenType::MULTI_LINE_COMMENT)
                        }
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::SLASH_EQUAL)
                    } else {
                        self.push_token(TokenType::SLASH)
                    }
                }
                LexerByte::Percent => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::PERCENT_EQUAL)
                    } else {
                        self.push_token(TokenType::PERCENT)
                    }
                }
                LexerByte::Less => {
                    self.consume()
                    if self.peek_byte(0_usize) == 60_u8 {
                        self.consume()
                        if self.peek_byte(0_usize) == 61_u8 {
                            self.consume_and_push(TokenType::LEFT_SHIFT_EQUAL)
                        } else {
                            self.push_token(TokenType::LEFT_SHIFT)
                        }
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::LESS_EQUAL)
                    } else {
                        self.push_token(TokenType::LESS)
                    }
                }
                LexerByte::Greater => {
                    self.consume()
                    if self.peek_byte(0_usize) == 62_u8 {
                        self.consume()
                        if self.peek_byte(0_usize) == 61_u8 {
                            self.consume_and_push(TokenType::RIGHT_SHIFT_EQUAL)
                        } else {
                            self.push_token(TokenType::RIGHT_SHIFT)
                        }
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::GREATER_EQUAL)
                    } else {
                        self.push_token(TokenType::GREATER)
                    }
                }
                LexerByte::LeftParen => {
                    self.consume_and_push(TokenType::LEFT_PAREN)
                }
                LexerByte::RightParen => {
                    self.consume_and_push(TokenType::RIGHT_PAREN)
                }
                LexerByte::LeftBracket => {
                    self.consume_and_push(TokenType::LEFT_BRACKET)
                }
                LexerByte::RightBracket => {
                    self.consume_and_push(TokenType::RIGHT_BRACKET)
                }
                LexerByte::LeftBrace => {
                    self.consume_and_push(TokenType::LEFT_BRACE)
                }
                LexerByte::RightBrace => {
                    self.consume_and_push(TokenType::RIGHT_BRACE)
                }
                LexerByte::Colon => {
                    self.consume()
                    if self.peek_byte(0_usize) == 58_u8 {
                        self.consume_and_push(TokenType::SCOPE)
                    } else {
                        self.push_token(TokenType::COLON)
                    }
                }
                LexerByte::Dot => {
                    self.consume_and_push(TokenType::DOT)
                }
                LexerByte::Comma => {
                    self.consume_and_push(TokenType::COMMA)
                }
                LexerByte::Semicolon => {
                    self.consume_and_push(TokenType::SEMICOLON)
                }
                LexerByte::Equal => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::EQUAL_EQUAL)
                    } elif self.peek_byte(0_usize) == 62_u8 {
                        self.consume_and_push(TokenType::FAT_ARROW)
                    } else {
                        self.push_token(TokenType::ASSIGN)
                    }
                }
                LexerByte::Bang => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::BANG_EQUAL)
                    } else {
                        self.push_token(TokenType::BANG)
                    }
                }
                LexerByte::Ampersand => {
                    self.consume()
                    if self.peek_byte(0_usize) == 38_u8 {
                        self.consume_and_push(TokenType::AND_AND)
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::AMPERSAND_EQUAL)
                    } else {
                        self.push_token(TokenType::AMPERSAND)
                    }
                }
                LexerByte::Pipe => {
                    self.consume()
                    if self.peek_byte(0_usize) == 124_u8 {
                        self.consume_and_push(TokenType::PIPE_PIPE)
                    } elif self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::PIPE_EQUAL)
                    } else {
                        self.push_token(TokenType::PIPE)
                    }
                }
                LexerByte::Caret => {
                    self.consume()
                    if self.peek_byte(0_usize) == 61_u8 {
                        self.consume_and_push(TokenType::CARET_EQUAL)
                    } else {
                        self.push_token(TokenType::CARET)
                    }
                }
                LexerByte::Tilde => {
                    self.consume_and_push(TokenType::TILDE)
                }
                LexerByte::Question => {
                    self.consume_and_push(TokenType::QUESTION)
                }
                LexerByte::Hash => {
                    self.consume_and_push(TokenType::HASH)
                }
                LexerByte::At => {
                    self.consume_and_push(TokenType::AT)
                }
                LexerByte::DoubleQuote => {
                    self.consume()
                    loop {
                        if self.is_at_end() {
                            break
                        }
                        if self.peek_byte(0_usize) == 92_u8 {
                            self.consume()
                            if self.is_at_end() {
                                break
                            }
                            self.consume()
                            continue
                        }
                        if self.peek_byte(0_usize) == 34_u8 {
                            break
                        }
                        self.consume()
                    }
                    if self.is_at_end() {
                        self.push_token(TokenType::UNKNOWN)
                    } else {
                        self.consume_and_push(TokenType::STRING)
                    }
                }
                LexerByte::Quote => {
                    self.consume_and_push(TokenType::QUOTE)
                }
                LexerByte::Other => {
                    let curr = self.peek_byte(0_usize)
                    if is_digit_byte(curr) {
                        self.parse_number()
                    } elif is_identifier_start_byte(curr) {
                        self.parse_identifier()
                    } else {
                        self.consume()
                        self.push_token(TokenType::UNKNOWN)
                    }
                }
            }
        }

        ret self.tokens
    }

    fn parse_number(mut self) ->() {
        let mut is_float = false

        if self.peek_byte(0_usize) == 48_u8 {
            let prefix = self.peek_byte(1_usize)
            if prefix == 120_u8 || prefix == 88_u8 || prefix == 98_u8 || prefix == 66_u8 ||
            prefix == 111_u8 || prefix == 79_u8 {
                self.consume()
                self.consume()
                let mut digits = 0_usize
                let base = if prefix == 120_u8 || prefix == 88_u8 {
                    16_u32
                } else {
                    if prefix == 98_u8 || prefix == 66_u8 {
                        2_u32
                    } else {
                        8_u32
                    }
                }
                while radix_digit_byte_value(self.peek_byte(0_usize)) < base {
                    self.consume()
                    digits += 1_usize
                }
                // Consume an invalid alphanumeric tail as one token so the
                // parser reports the malformed literal at its real source
                // location instead of treating it as an adjacent identifier.
                if digits == 0_usize || is_alnum_byte(self.peek_byte(0_usize)) {
                    while is_alnum_byte(self.peek_byte(0_usize)) {
                        self.consume()
                    }
                    self.push_token(TokenType::UNKNOWN)
                    ret()
                }
                self.push_token(TokenType::INTEGER)
                ret()
            }
        }

        loop {
            if !is_digit_byte(self.peek_byte(0_usize)) {
                break
            }
            self.consume()
        }

        if self.peek_byte(0_usize) == 46_u8 {
            if is_digit_byte(self.peek_byte(1_usize)) {
                is_float = true
                self.consume()
                loop {
                    if !is_digit_byte(self.peek_byte(0_usize)) {
                        break
                    }
                    self.consume()
                }
            }
        }

        if is_float {
            self.push_token(TokenType::FLOAT)
            ret()
        }
        self.push_token(TokenType::INTEGER)
        ret()
    }

    fn parse_identifier(mut self) ->() {
        loop {
            let curr = self.peek_byte(0_usize)
            if is_alnum_byte(curr) {
                self.consume()
                continue
            }
            if curr == 95_u8 {
                self.consume()
                continue
            }
            break
        }

        let raw = self.program.slice_bytes(self.token_start, self.consumed - self.token_start)
        let token_type = identifier_token_type(raw)
        self.push_token(token_type)
        ret()
    }

    fn consume(mut self) ->() {
        if self.is_at_end() {
            ret()
        }
        let curr = self.peek_byte(0_usize)

        self.consumed = self.consumed + unsafe {
            encore_str_char_width_at_byte(self.program, self.consumed)
        }
        if curr == 10_u8 || curr == 13_u8 {
            self.line += 1_usize
            self.column = 0_usize
        } else {
            self.column += 1_usize
        }
        ret()
    }

    fn skip_one_line_comment(mut self) ->() {
        let end = self.program.byte_len()
        while self.consumed < end {
            let byte = self.program.byte_at(self.consumed)
            if byte == 10_u8 || byte == 13_u8 {
                break
            }
            let width = unsafe {
                encore_str_char_width_at_byte(self.program, self.consumed)
            }
            if width == 0_usize {
                break
            }
            self.consumed += width
            self.column += 1_usize
        }
        ret()
    }

    fn skip_multi_line_comment_body(mut self) ->() {
        let end = self.program.byte_len()
        while self.consumed < end {
            let byte = self.program.byte_at(self.consumed)
            if byte == 42_u8 && self.consumed + 1_usize < end && self.program.byte_at(self.consumed +
                1_usize) == 47_u8 {
                break
            }
            if byte == 13_u8 {
                self.consumed += 1_usize
                if self.consumed < end && self.program.byte_at(self.consumed) == 10_u8 {
                    self.consumed += 1_usize
                }
                self.line += 1_usize
                self.column = 0_usize
            } elif byte == 10_u8 {
                self.consumed += 1_usize
                self.line += 1_usize
                self.column = 0_usize
            } else {
                let width = unsafe {
                    encore_str_char_width_at_byte(self.program, self.consumed)
                }
                if width == 0_usize {
                    break
                }
                self.consumed += width
                self.column += 1_usize
            }
        }
        ret()
    }

    fn consume_and_push(mut self, token_type: TokenType) ->() {
        self.consume()
        self.push_token(token_type)
        ret()
    }

    fn push_token(mut self, token_type: TokenType) ->() {
        let token_value = self.program.slice_bytes(self.token_start, self.consumed - self.token_start)
        self.token_start = self.consumed
        let line = self.token_line
        let column = self.token_column
        self.token_line = self.line
        self.token_column = self.column
        if !self.preserve_trivia {
            match token_type {
                TokenType::NEWLINE => {
                    ret()
                }
                TokenType::WHITESPACE => {
                    ret()
                }
                TokenType::ONE_LINE_COMMENT => {
                    ret()
                }
                TokenType::MULTI_LINE_COMMENT => {
                    ret()
                }
                _ => {
                }
            }
        }

        let token = Token::new(
            token_type,
            token_value,
            line,
            column,
        )
        self.tokens.push(token)
        ret()
    }

    fn is_at_end(mut self) -> bool {
        ret self.consumed >= self.program.byte_len()
    }

    fn peek_byte(mut self, offset: usize) -> u8 {
        let index = self.consumed + offset
        if index >= self.program.byte_len() {
            ret 0_u8
        }
        ret self.program.byte_at(index)
    }
}

fn lexer_byte(value: u8) -> LexerByte {
    if value == 32_u8 {
        ret LexerByte::Space
    }
    if value == 9_u8 {
        ret LexerByte::Tab
    }
    if value == 13_u8 {
        ret LexerByte::CarriageReturn
    }
    if value == 10_u8 {
        ret LexerByte::Newline
    }
    if value == 43_u8 {
        ret LexerByte::Plus
    }
    if value == 45_u8 {
        ret LexerByte::Minus
    }
    if value == 42_u8 {
        ret LexerByte::Asterisk
    }
    if value == 47_u8 {
        ret LexerByte::Slash
    }
    if value == 37_u8 {
        ret LexerByte::Percent
    }
    if value == 60_u8 {
        ret LexerByte::Less
    }
    if value == 62_u8 {
        ret LexerByte::Greater
    }
    if value == 40_u8 {
        ret LexerByte::LeftParen
    }
    if value == 41_u8 {
        ret LexerByte::RightParen
    }
    if value == 91_u8 {
        ret LexerByte::LeftBracket
    }
    if value == 93_u8 {
        ret LexerByte::RightBracket
    }
    if value == 123_u8 {
        ret LexerByte::LeftBrace
    }
    if value == 125_u8 {
        ret LexerByte::RightBrace
    }
    if value == 58_u8 {
        ret LexerByte::Colon
    }
    if value == 46_u8 {
        ret LexerByte::Dot
    }
    if value == 44_u8 {
        ret LexerByte::Comma
    }
    if value == 59_u8 {
        ret LexerByte::Semicolon
    }
    if value == 61_u8 {
        ret LexerByte::Equal
    }
    if value == 33_u8 {
        ret LexerByte::Bang
    }
    if value == 38_u8 {
        ret LexerByte::Ampersand
    }
    if value == 124_u8 {
        ret LexerByte::Pipe
    }
    if value == 94_u8 {
        ret LexerByte::Caret
    }
    if value == 126_u8 {
        ret LexerByte::Tilde
    }
    if value == 63_u8 {
        ret LexerByte::Question
    }
    if value == 35_u8 {
        ret LexerByte::Hash
    }
    if value == 64_u8 {
        ret LexerByte::At
    }
    if value == 34_u8 {
        ret LexerByte::DoubleQuote
    }
    if value == 39_u8 {
        ret LexerByte::Quote
    }
    ret LexerByte::Other
}

fn identifier_token_type(raw: str) -> TokenType {
    ret match raw {
        "fn" => TokenType::KW_FN
        "async" => TokenType::KW_ASYNC
        "await" => TokenType::KW_AWAIT
        "spawn" => TokenType::KW_SPAWN
        "struct" => TokenType::KW_STRUCT
        "enum" => TokenType::KW_ENUM
        "trait" => TokenType::KW_TRAIT
        "impl" => TokenType::KW_IMPL
        "for" => TokenType::KW_FOR
        "let" => TokenType::KW_LET
        "static" => TokenType::KW_STATIC
        "mut" => TokenType::KW_MUT
        "ret" => TokenType::KW_RET
        "while" => TokenType::KW_WHILE
        "do" => TokenType::KW_DO
        "break" => TokenType::KW_BREAK
        "continue" => TokenType::KW_CONTINUE
        "loop" => TokenType::KW_LOOP
        "if" => TokenType::KW_IF
        "elif" => TokenType::KW_ELIF
        "else" => TokenType::KW_ELSE
        "match" => TokenType::KW_MATCH
        "pub" => TokenType::KW_PUB
        "import" => TokenType::KW_IMPORT
        "as" => TokenType::KW_AS
        "dyn" => TokenType::KW_DYN
        "extern" => TokenType::KW_EXTERN
        "unsafe" => TokenType::KW_UNSAFE
        "ehir" => TokenType::KW_EHIR
        "with" => TokenType::KW_WITH
        "not" => TokenType::BANG
        "true" => TokenType::BOOLEAN
        "false" => TokenType::BOOLEAN
        _ => TokenType::IDENTIFIER
    }
}

fn is_digit_byte(value: u8) -> bool {
    ret value >= 48_u8 && value <= 57_u8
}

fn radix_digit_byte_value(value: u8) -> u32 {
    if value >= 48_u8 && value <= 57_u8 {
        ret(value - 48_u8) as u32
    }
    if value >= 65_u8 && value <= 70_u8 {
        ret(value - 65_u8) as u32 + 10_u32
    }
    if value >= 97_u8 && value <= 102_u8 {
        ret(value - 97_u8) as u32 + 10_u32
    }
    ret 16_u32
}

fn is_alpha_byte(value: u8) -> bool {
    if value >= 65_u8 {
        if value <= 90_u8 {
            ret true
        }
    }
    if value >= 97_u8 {
        if value <= 122_u8 {
            ret true
        }
    }
    ret false
}

fn is_alnum_byte(value: u8) -> bool {
    if is_alpha_byte(value) {
        ret true
    }
    ret is_digit_byte(value)
}

fn is_identifier_start_byte(value: u8) -> bool {
    if is_alpha_byte(value) {
        ret true
    }
    ret value == 95_u8
}

#attr(test)
fn lexer_accepts_windows_line_endings() -> bool {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize("fn main() -> u32 {\r\n\tret 0_u32\r\n}\r\n")
    for token in tokens {
        if token.type == TokenType::UNKNOWN {
            ret false
        }
    }
    ret true
}

#attr(test)
fn lexer_tracks_token_positions() -> bool {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize("fn main() {\n    /* first\n       second */ ret 0_u32\n}\n")
    let mut saw_main = false
    let mut saw_ret = false
    for token in tokens {
        if token.value == "main" {
            if token.line != 0_usize || token.column != 3_usize {
                ret false
            }
            saw_main = true
        }
        if token.value == "ret" {
            if token.line != 2_usize || token.column != 17_usize {
                ret false
            }
            saw_ret = true
        }
    }
    ret saw_main && saw_ret
}
