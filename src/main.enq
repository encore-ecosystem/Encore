//! Provides the `main` module.

import argparse::{CommandSpec, OptionSpec, ParseOutcome, parse, process_arg_count, process_arg, process_args}
import core::option::Option
import refrain::modes
import refrain::version::compiler_release_version
import rich::Console
import std::io::print
import std::io::println
import std::string::String

fn main() -> u32 {
    let console = Console::new()

    let mut mode = ""
    match argv(1_usize) {
        Option::Some(m) => {
            mode = m
        }
        Option::None => {
            print_global_help()
            ret 0_u32
        }
    }

    if mode == "--help" || mode == "-h" {
        print_global_help()
        ret 0_u32
    }
    if mode == "__codegen" {
        ret modes::run_codegen_worker()
    }
    if mode == "__self_update_apply" {
        ret modes::run_self_update_apply()
    }
    if mode == "help" {
        match argv(2_usize) {
            Option::Some(command) => {
                ret print_command_help(command, console)
            }
            Option::None => {
                print_global_help() ret 0_u32
            }
        }
    }
    if mode == "--version" || mode == "-V" {
        console.println("encore " + compiler_release_version())
        ret 0_u32
    }
    match argv(2_usize) {
        Option::Some(arg) => {
            if arg == "--help" || arg == "-h" {
                ret print_command_help(mode, console)
            }
        }
        Option::None => {
        }
    }
    if !validate_command_args(mode, console) {
        ret 2_u32
    }

    match mode {
        "run" => {
            ret modes::run_run()
        }
        "build" => {
            ret modes::run_build()
        }
        "add" => {
            ret modes::run_add()
        }
        "sync" => {
            ret modes::run_sync()
        }
        "update" => {
            ret modes::run_update()
        }
        "test" => {
            ret modes::run_test()
        }
        "check" => {
            ret modes::run_check()
        }
        "lint" => {
            ret modes::run_lint()
        }
        "format" => {
            ret modes::run_format()
        }
        "analyze" => {
            ret modes::run_analyze()
        }
        "init" => {
            ret modes::run_init()
        }
        "install" => {
            ret modes::run_install()
        }
        "publish" => {
            ret modes::run_publish()
        }
        "target" => {
            ret modes::run_target()
        }
        "self" => {
            ret modes::run_self()
        }
        _ => {
            console.error("Unknown command: " + mode)
            console.error("Run 'encore --help' for usage.")
        }
    }
    ret 1
}

fn print_global_help() ->() {
    println("Encore native compiler")
    println("")
    println("Usage: encore <command> [options]")
    println("")
    println("Commands:")
    println("  build      Compile the current project")
    println("  run        Compile and run the current project")
    println("  test       Run project tests")
    println("  check      Type-check source without compiling it")
    println("  lint       Run configurable source analysis")
    println("  format     Format Encore source")
    println("  analyze    Deprecated alias for lint")
    println("  init       Initialize a project")
    println("  add        Add a dependency")
    println("  sync       Resolve project dependencies")
    println("  update     Update project dependencies")
    println("  install    Build and install a binary")
    println("  publish    Publish a package through the reviewed index")
    println("  target     Inspect compilation targets")
    println("  self       Manage the Encore compiler installation")
    println("  help       Show command help")
    println("")
    println("Options:")
    println("  -h, --help       Show help")
    println("  -V, --version    Show compiler version")
    ret()
}

fn print_command_help(command: str, console: Console) -> u32 {
    match command {
        "build" => {
            println("Compile the current project")
            println("")
            println("Usage: encore build [options]")
            print_build_options()
        }
        "run" => {
            println("Compile and run the current project")
            println("")
            println("Usage: encore run [build options] [-- <args>...]")
            print_build_options()
        }
        "test" => {
            println("Run unit and standalone tests")
            println("")
            println("Usage: encore test [options]")
            println("")
            println("Options:")
            println("      --filter <text>    Run tests whose full name contains text")
            println("      --list             List selected tests without running them")
            println("      --jobs <count>     Maximum parallel test jobs")
            println("      --format <kind>    Listing format: full or json")
            println("      --report <path>    Write a machine-readable JSON test report")
            println("  -h, --help             Show help")
        }
        "analyze" => {
            println("Warning: 'encore analyze' is deprecated; use 'encore lint'")
            println("")
            println("Deprecated alias for 'encore lint'")
            println("")
            println("Usage: encore analyze [options] [path]")
            println("")
            println("Options:")
            println("      --allow <rule>    Disable a rule")
            println("      --warn <rule>     Report a rule as a warning")
            println("      --deny <rule>     Report a rule as an error")
            println("      --forbid <rule>   Report an error that later options cannot lower")
            println("      --format <kind>   full or json")
            println("  -h, --help            Show help")
        }
        "check" => {
            println("Type-check a project or Encore source file without code generation")
            println("")
            println("Usage: encore check [options] [path]")
            println("")
            println("Options:")
            println("      --format <kind>   full or json")
            println("  -h, --help            Show help")
        }
        "lint" => {
            println("Lint a project or Encore source file")
            println("")
            println("Usage: encore lint [options] [path]")
            println("")
            println("Options:")
            println("      --allow <rule>    Disable a rule")
            println("      --warn <rule>     Report a rule as a warning")
            println("      --deny <rule>     Report a rule as an error")
            println("      --forbid <rule>   Report an error that later options cannot lower")
            println("      --fix             Apply safe automatic fixes")
            println("      --format <kind>   full or json")
            println("  -h, --help            Show help")
        }
        "format" => {
            println("Format a project or Encore source file")
            println("")
            println("Usage: encore format [options] [path]")
            println("")
            println("Options:")
            println("      --check           Report files that would change")
            println("  -h, --help            Show help")
        }
        "init" => {
            println("Initialize an Encore project in the current directory")
            println("")
            println("Usage: encore init [--name <name>]")
        }
        "add" => {
            println("Add and lock a project dependency")
            println("")
            println("Usage: encore add <name|index@name|workspace@name|git@url|path@path>")
            println("")
            println("A bare name is resolved from the official package index.")
            println("Use --features name,other or package[name,other] to enable package features.")
        }
        "sync" => {
            println("Restore locked dependencies and write encore.lock")
            println("")
            println("Usage: encore sync [--update]")
            println("")
            println("Options:")
            println("      --update    Refresh index and Git dependencies")
        }
        "update" => {
            println("Refresh dependencies and rewrite encore.lock")
            println("")
            println("Usage: encore update")
        }
        "install" => {
            println("Build and install an Encore binary")
            println("")
            println("Usage: encore install [package] [options]")
            println("")
            println("Options:")
            println("      --path <path>       Install a local project")
            println("      --root <path>       Install under <path>/bin")
            println("      --bin-dir <path>    Install directly into path")
            println("      --name <name>       Override installed binary name")
            println("      --profile <name>    dev (fast O0), debug, release, or extreme (ThinLTO)")
            println("      --update            Update a package before building")
            println("      --force             Replace an existing binary")
            println("  -h, --help              Show help")
        }
        "publish" => {
            println("Publish the current package through GitHub and the reviewed index")
            println("")
            println("Usage: encore publish [--dry-run] [--release-only] [--release-name <name>]")
            println("")
            println("Options:")
            println("      --dry-run    Validate and create the exact archive without remote changes")
            println("      --release-only  Publish the immutable artifact without opening an index PR")
            println("      --release-name <name>  Set the release nametag (defaults to the compiler name)")
            println("  -h, --help       Show help")
        }
        "target" => {
            println("Inspect and install compiler-managed targets")
            println("")
            println("Usage: encore target <list|show <triple>|install <triple>>")
        }
        "self" => {
            println("Manage the Encore compiler installation")
            println("")
            println("Usage: encore self <command> [options]")
            println("")
            println("Commands:")
            println("  update                 Update from the selected release channel")
            println("  channel [name]         Show or select stable, beta, or nightly")
            println("  install <version>      Install an exact Encore version")
            println("")
            println("Update options:")
            println("      --check             Check without installing")
            println("      --channel <name>    Update once from a specific channel")
            println("      --version <version> Install an exact version")
            println("      --force             Reinstall the selected version")
            println("  -h, --help              Show help")
        }
        _ => {
            console.error("Unknown command: " + command)
            console.error("Run 'encore --help' for available commands.")
            ret 1_u32
        }
    }
    ret 0_u32
}

fn print_build_options() ->() {
    println("")
    println("Options:")
    println("      --profile <name>          dev (fast O0), debug, release, or extreme (ThinLTO)")
    println("      --manifest-path <path>    Build the project described by encore.toml")
    println("      --target <triple>         Select an LLVM target")
    println("      --emit <kind>             ehir, llvm-ir, object, or binary")
    println("      --jobs <count>            Maximum parallel compilation jobs")
    println("  -h, --help                    Show help")
    ret()
}

fn validate_command_args(command: str, console: Console) -> bool {
    if command == "build" {
        ret validate_build_args(command, false, console)
    }
    if command == "run" {
        ret validate_build_args(command, true, console)
    }
    if command == "test" {
        ret validate_test_args(console)
    }
    if command == "check" {
        ret validate_check_args(console)
    }
    if command == "lint" {
        ret validate_rule_args("lint", true, console)
    }
    if command == "format" {
        ret validate_format_args(console)
    }
    if command == "analyze" {
        ret validate_rule_args("analyze", false, console)
    }
    if command == "init" {
        ret validate_value_only_args(command, "--name", console)
    }
    if command == "add" {
        ret validate_add_args(console)
    }
    if command == "sync" {
        ret validate_switch_only_args(command, "--update", console)
    }
    if command == "update" {
        ret validate_positional_args(command, 0_usize, 0_usize, console)
    }
    if command == "install" {
        ret validate_install_args(console)
    }
    if command == "publish" {
        ret validate_publish_args(console)
    }
    if command == "target" {
        ret validate_target_args(console)
    }
    if command == "self" {
        ret validate_self_args(console)
    }
    ret true
}

fn validate_self_args(console: Console) -> bool {
    if argc() < 3_usize {
        ret argument_error("self", "missing required command", console)
    }
    let action = argument(2_usize)
    if action == "channel" {
        if argc() > 4_usize {
            ret argument_error("self", "unexpected argument '" + argument(4_usize) + "'", console)
        }
        if argc() == 4_usize {
            let channel = argument(3_usize)
            if channel != "stable" && channel != "beta" && channel != "nightly" {
                ret argument_error("self", "channel must be stable, beta, or nightly", console)
            }
        }
        ret true
    }
    if action == "install" {
        if argc() < 4_usize {
            ret argument_error("self", "missing required version", console)
        }
        if starts_with(argument(3_usize), "-") {
            ret argument_error("self", "missing required version", console)
        }
        let mut index = 4_usize
        while index < argc() {
            if argument(index) != "--force" {
                ret unknown_argument("self", argument(index), console)
            }
            index += 1_usize
        }
        ret true
    }
    if action == "update" {
        let mut index = 3_usize
        while index < argc() {
            let arg = argument(index)
            if arg == "--check" || arg == "--force" {
            } elif arg == "--channel" || arg == "--version" {
                if index + 1_usize >= argc() {
                    ret argument_error("self", "option '" + arg + "' requires a value", console)
                }
                index += 1_usize
                if arg == "--channel" {
                    let channel = argument(index)
                    if channel != "stable" && channel != "beta" && channel != "nightly" {
                        ret argument_error("self", "channel must be stable, beta, or nightly", console)
                    }
                }
            } else {
                ret unknown_argument("self", arg, console)
            }
            index += 1_usize
        }
        ret true
    }
    ret argument_error("self", "unknown command '" + action + "'", console)
}

fn validate_add_args(console: Console) -> bool {
    let mut positional = 0_usize
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--features" {
            if index + 1_usize >= argc() {
                ret argument_error("add", "option '--features' requires a value", console)
            }
            index = index + 1_usize
        } elif starts_with(arg, "-") {
            ret unknown_argument("add", arg, console)
        } else {
            positional = positional + 1_usize
        }
        index = index + 1_usize
    }
    if positional == 0_usize {
        ret argument_error("add", "missing required argument", console)
    }
    if positional > 1_usize {
        ret argument_error("add", "unexpected argument", console)
    }
    ret true
}

fn validate_target_args(console: Console) -> bool {
    let count = if argc() > 2_usize {
        argc() - 2_usize
    } else {
        0_usize
    }
    if count <= 1_usize {
        ret true
    }
    if count == 2_usize &&(argument(2_usize) == "show" || argument(2_usize) == "install") {
        ret true
    }
    ret argument_error("target", "unexpected argument '" + argument(3_usize) + "'", console)
}

fn validate_build_args(command: str, allow_program_args: bool, console: Console) -> bool {
    let spec = build_command_spec(command, allow_program_args)
    match parse(spec, process_args(2_usize)) {
        ParseOutcome::Ok(_) => {
        }
        ParseOutcome::Err(error) => {
            ret argument_error(command, error, console)
        }
    }
    let jobs = requested_argument_value("--jobs")
    if jobs != "" && !is_positive_decimal(jobs) {
        ret argument_error(command, "option '--jobs' requires a positive integer", console)
    }
    ret true
}

fn build_command_spec(command: str, allow_program_args: bool) -> CommandSpec {
    let mut spec = CommandSpec::new(command)
    .option(OptionSpec::value("--profile", "", "name", "optimization profile"))
    .option(OptionSpec::value("--manifest-path", "", "path", "project manifest"))
    .option(OptionSpec::value("--target", "", "triple", "target triple"))
    .option(OptionSpec::value("--emit", "", "kind", "output kind"))
    .option(OptionSpec::value("--jobs", "", "count", "parallel jobs"))
    .option(OptionSpec::value("--_pipeline-start-ms", "", "timestamp", "internal continuation").hidden())
    .positionals(0_usize, 0_usize)
    if allow_program_args {
        spec = spec.rest(true)
    }
    ret spec
}

fn requested_argument_value(name: str) -> str {
    let mut index = 2_usize
    while index + 1_usize < argc() {
        match argv(index) {
            Some(arg) => {
                if arg == name {
                    match argv(index + 1_usize) {
                        Some(value) => {
                            ret value
                        }
                        None => {
                        }
                    }
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret ""
}

fn is_positive_decimal(value: str) -> bool {
    if value.len() == 0_usize {
        ret false
    }
    let mut nonzero = false
    let mut index = 0_usize
    while index < value.len() {
        let byte = value.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 {
            ret false
        }
        if byte != 48_u8 {
            nonzero = true
        }
        index = index + 1_usize
    }
    ret nonzero
}

fn validate_test_args(console: Console) -> bool {
    let spec = CommandSpec::new("test")
    .option(OptionSpec::value("--filter", "", "text", "test name filter"))
    .option(OptionSpec::flag("--list", "", "list tests"))
    .option(OptionSpec::value("--jobs", "", "count", "parallel jobs"))
    .option(OptionSpec::value("--format", "", "kind", "output format"))
    .option(OptionSpec::value("--report", "", "path", "report path"))
    .option(OptionSpec::value("--_worker-standalone", "", "path", "internal worker").hidden())
    .option(OptionSpec::value("--_worker-unit", "", "path", "internal worker").hidden())
    .positionals(0_usize, 0_usize)
    match parse(spec, process_args(2_usize)) {
        ParseOutcome::Ok(_) => {
        }
        ParseOutcome::Err(error) => {
            ret argument_error("test", error, console)
        }
    }
    let jobs = requested_argument_value("--jobs")
    if jobs != "" && !is_positive_decimal(jobs) {
        ret argument_error("test", "option '--jobs' requires a positive integer", console)
    }
    let format = requested_argument_value("--format")
    if format != "" && format != "full" && format != "json" {
        ret argument_error("test", "--format must be full or json", console)
    }
    if format == "json" && !has_argument("--list") {
        ret argument_error("test", "--format json currently requires --list", console)
    }
    ret true
}

fn has_argument(name: str) -> bool {
    let mut index = 2_usize
    while index < argc() {
        match argv(index) {
            Some(value) => {
                if value == name {
                    ret true
                }
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn validate_rule_args(command: str, allow_fix: bool, console: Console) -> bool {
    let mut positional = 0_usize
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--allow" || arg == "--warn" || arg == "--deny" || arg == "--forbid" || arg == "--format" {
            if index + 1_usize >= argc() {
                ret argument_error(command, "option '" + arg + "' requires a value", console)
            }
            index += 1_usize
        } elif allow_fix && arg == "--fix" {
        } elif starts_with(arg, "-") {
            ret unknown_argument(command, arg, console)
        } else {
            positional += 1_usize
            if positional > 1_usize {
                ret argument_error(command, "unexpected argument '" + arg + "'", console)
            }
        }
        index += 1_usize
    }
    ret true
}

fn validate_check_args(console: Console) -> bool {
    let mut positional = 0_usize
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--format" {
            if index + 1_usize >= argc() {
                ret argument_error("check", "option '--format' requires a value", console)
            }
            let value = argument(index + 1_usize)
            if value != "full" && value != "json" {
                ret argument_error("check", "--format must be full or json", console)
            }
            index += 1_usize
        } elif starts_with(arg, "-") {
            ret unknown_argument("check", arg, console)
        } else {
            positional += 1_usize
            if positional > 1_usize {
                ret argument_error("check", "unexpected argument '" + arg + "'", console)
            }
        }
        index += 1_usize
    }
    ret true
}

fn validate_format_args(console: Console) -> bool {
    let mut positional = 0_usize
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--check" {
        } elif starts_with(arg, "-") {
            ret unknown_argument("format", arg, console)
        } else {
            positional += 1_usize
            if positional > 1_usize {
                ret argument_error("format", "unexpected argument '" + arg + "'", console)
            }
        }
        index += 1_usize
    }
    ret true
}

fn validate_value_only_args(command: str, option: str, console: Console) -> bool {
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg != option {
            ret unknown_argument(command, arg, console)
        }
        if index + 1_usize >= argc() {
            ret argument_error(command, "option '" + arg + "' requires a value", console)
        }
        index = index + 2_usize
    }
    ret true
}

fn validate_switch_only_args(command: str, option: str, console: Console) -> bool {
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg != option {
            ret unknown_argument(command, arg, console)
        }
        index = index + 1_usize
    }
    ret true
}

fn validate_publish_args(console: Console) -> bool {
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--dry-run" || arg == "--release-only" {
            index += 1_usize
        } elif arg == "--release-name" {
            if index + 1_usize >= argc() {
                ret argument_error("publish", "option '--release-name' requires a value", console)
            }
            index += 2_usize
        } else {
            ret unknown_argument("publish", arg, console)
        }
    }
    ret true
}

fn validate_positional_args(command: str, minimum: usize, maximum: usize, console: Console) -> bool {
    let count = if argc() > 2_usize {
        argc() - 2_usize
    } else {
        0_usize
    }
    if count < minimum {
        ret argument_error(command, "missing required argument", console)
    }
    if count > maximum {
        ret argument_error(command, "unexpected argument '" + argument(2_usize + maximum) + "'", console)
    }
    if count > 0_usize && starts_with(argument(2_usize), "-") {
        ret unknown_argument(command, argument(2_usize), console)
    }
    ret true
}

fn validate_install_args(console: Console) -> bool {
    let mut positional = 0_usize
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--force" || arg == "--update" {
        } elif arg == "--path" || arg == "--root" || arg == "--bin-dir" || arg == "--name" || arg == "--profile" || arg == "--_pipeline-start-ms" {
            if index + 1_usize >= argc() {
                ret argument_error("install", "option '" + arg + "' requires a value", console)
            }
            index = index + 1_usize
        } elif starts_with(arg, "-") {
            ret unknown_argument("install", arg, console)
        } else {
            positional = positional + 1_usize
            if positional > 1_usize {
                ret argument_error("install", "unexpected argument '" + arg + "'", console)
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn unknown_argument(command: str, arg: str, console: Console) -> bool {
    let kind = if starts_with(arg, "-") {
        "option"
    } else {
        "argument"
    }
    ret argument_error(command, "unknown " + kind + " '" + arg + "'", console)
}

fn argument_error(command: str, message: str, console: Console) -> bool {
    console.error("Error: " + message)
    console.error("Run 'encore " + command + " --help' for usage.")
    ret false
}

fn argument(index: usize) -> str {
    match argv(index) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
            ret ""
        }
    }
}

fn argc() -> usize {
    ret process_arg_count()
}

fn argv(index: usize) -> Option[str] {
    ret process_arg(index)
}

fn starts_with(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}
