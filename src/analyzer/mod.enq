//! Provides the shared rule engine used by Encore tooling.

import core::option::Option
import refrain::frontend::parser::Documentation
import refrain::frontend::tooling_tokens_from_tokens
import refrain::frontend::{DiagnosticLabelKind, Expr, FrontendDocument, FrontendDiagnostic, Lexer, MatchArmBody, Statement, SuggestionApplicability, Token, TokenType}
import std::vec::Vec

/// Selects whether a rule is disabled, emits a warning, or emits an error.
pub enum RuleLevel {
    Allow Warn Deny Forbid
}

struct RuleSetting {
    code: str level: RuleLevel
}

/// Stores normalized lint policy for one invocation.
pub struct AnalyzerConfig {
    settings: Vec[RuleSetting]
    default_level: RuleLevel
    dependency_level: RuleLevel
    cap_level: RuleLevel
}

/// Describes one configurable analyzer finding.
pub struct AnalyzerDiagnostic {
    path: str
    severity: RuleLevel
    code: str
    message: str
    line: usize
    column: usize
    length: usize
}

/// Returns whether a selector names a built-in rule or rule group.
pub fn rule_is_known(code: str) -> bool {
    ret code == "all" || code == "unused" || code == "style" ||
    code == "missing-module-docstring" || code == "missing-public-docstring" ||
    code == "trailing-whitespace" || code == "unused-imports" ||
    code == "unused-variables" || code == "unused-mut" ||
    code == "unreachable-code" || code == "dead-code" ||
    code == "redundant-condition" || code == "unreachable-patterns"
}

impl for AnalyzerConfig {
    /// Creates the standard lint configuration.
    ///
    /// Public API documentation is opt-in because applications commonly expose
    /// implementation-facing symbols. Projects which publish a library can
    /// enable it explicitly in `encore.toml` or on the command line.
    pub fn new() -> Self {
        let mut settings = Vec[RuleSetting]::new()
        settings.push(RuleSetting {
                "missing-module-docstring", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "missing-public-docstring", RuleLevel::Allow
            }
            ,
        )
        settings.push(RuleSetting {
                "trailing-whitespace", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "unused-imports", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "unused-variables", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "unused-mut", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "unreachable-code", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "dead-code", RuleLevel::Allow
            }
            ,
        )
        settings.push(RuleSetting {
                "redundant-condition", RuleLevel::Warn
            }
            ,
        )
        settings.push(RuleSetting {
                "unreachable-patterns", RuleLevel::Warn
            }
            ,
        )
        ret Self {
            settings, RuleLevel::Warn, RuleLevel::Allow, RuleLevel::Forbid
        }
    }

    /// Overrides the level of a named rule or all known rules.
    pub fn set_level(self: mut Self, code: str, level: RuleLevel) ->() {
        if code == "all" {
            let mut updated = Vec[RuleSetting]::new()
            for setting in self.settings {
                updated.push(RuleSetting {
                        setting.code, level
                    }
                    ,
                )
            }
            self.settings = updated
            ret()
        }
        if code == "unused" {
            self.set_level("unused-imports", level)
            self.set_level("unused-variables", level)
            self.set_level("unused-mut", level)
            ret()
        }
        if code == "style" {
            self.set_level("trailing-whitespace", level)
            self.set_level("redundant-condition", level)
            ret()
        }
        let mut updated = Vec[RuleSetting]::new()
        let mut replaced = false
        for setting in self.settings {
            if setting.code == code {
                if setting.level == RuleLevel::Forbid && level != RuleLevel::Forbid {
                    updated.push(setting)
                } else {
                    updated.push(RuleSetting {
                            code, level
                        }
                        ,
                    )
                }
                replaced = true
            } else {
                updated.push(setting)
            }
        }
        if !replaced {
            updated.push(RuleSetting {
                    code, level
                }
                ,
            )
        }
        self.settings = updated
        ret()
    }

    /// Returns the configured level, disabling unknown rules.
    pub fn level(self: Self, code: str) -> RuleLevel {
        for setting in self.settings {
            if setting.code == code {
                ret capped_level(setting.level, self.cap_level)
            }
        }
        ret capped_level(self.default_level, self.cap_level)
    }

    pub fn set_default_level(self: mut Self, level: RuleLevel) ->() {
        self.default_level = level
        let mut updated = Vec[RuleSetting]::new()
        for setting in self.settings {
            updated.push(RuleSetting {
                    setting.code, level
                }
                ,
            )
        }
        self.settings = updated
        ret()
    }
    pub fn set_dependency_level(self: mut Self, level: RuleLevel) ->() {
        self.dependency_level = level ret()
    }
    pub fn set_cap_level(self: mut Self, level: RuleLevel) ->() {
        self.cap_level = level ret()
    }
    pub fn dependency_rule_level(self: Self) -> RuleLevel {
        ret capped_level(self.dependency_level, self.cap_level)
    }
    pub fn dependencies_are_enabled(self: Self) -> bool {
        match self.dependency_rule_level() {
            RuleLevel::Allow => {
                ret false
            }
            _ => {
                ret true
            }
        }
        ret false
    }
    pub fn for_dependency(self: Self) -> Self {
        let level = self.dependency_rule_level()
        let mut settings = Vec[RuleSetting]::new()
        for setting in self.settings {
            settings.push(RuleSetting {
                    setting.code, level
                }
                ,
            )
        }
        ret Self {
            settings, level, level, self.cap_level
        }
    }
}

/// Runs all enabled rules over an already parsed frontend document.
pub fn analyze_document(path: str, document: FrontendDocument, config: AnalyzerConfig) -> Vec[AnalyzerDiagnostic]
{
    ret analyze_source_document(path, "", document, config)
}

/// Runs all enabled rules with access to the exact source representation.
pub fn analyze_source_document(path: str, source: str, document: FrontendDocument, config: AnalyzerConfig)
-> Vec[AnalyzerDiagnostic] {
    let mut out = Vec[AnalyzerDiagnostic]::new()
    emit_module_docstring(path, document, config, out)
    emit_public_docstrings(path, document, config, out)
    if source != "" {
        emit_trailing_whitespace(path, source, config, out)
    }
    let usage_tokens = tooling_tokens_from_tokens(document.tokens)
    emit_unused_imports(path, document, usage_tokens, config, out)
    emit_unused_variables(path, document, usage_tokens, config, out)
    emit_unused_mut(path, document, config, out)
    emit_unreachable_code(path, document, config, out)
    emit_dead_code(path, document, usage_tokens, config, out)
    emit_redundant_conditions(path, document, config, out)
    emit_unreachable_patterns(path, document, config, out)
    ret out
}

/// Runs lint rules and includes fatal frontend diagnostics in the same stream.
pub fn lint_source_document(path: str, source: str, document: FrontendDocument, config: AnalyzerConfig)
-> Vec[AnalyzerDiagnostic] {
    let mut out = Vec[AnalyzerDiagnostic]::new()
    for diagnostic in document.diagnostics {
        out.push(AnalyzerDiagnostic {
                path, RuleLevel::Deny, diagnostic.code, diagnostic.message, diagnostic.line, diagnostic.column,
                diagnostic.length
            }
            ,
        )
    }
    out.extend(analyze_source_document(path, source, document, config))
    ret out
}

/// Applies all enabled, semantics-preserving analyzer fixes.
pub fn fix_source(source: str, config: AnalyzerConfig) -> str {
    if config.level("trailing-whitespace") == RuleLevel::Allow {
        ret source
    }
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize_lossless(source)
    let mut out = ""
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type != TokenType::WHITESPACE || !trivia_run_ends_line(tokens, index) {
                    out += token.value
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

/// Converts analyzer findings for consumers that use frontend diagnostics.
pub fn analyzer_frontend_diagnostics(diagnostics: Vec[AnalyzerDiagnostic]) -> Vec[FrontendDiagnostic]
{
    let mut out = Vec[FrontendDiagnostic]::new()
    for diagnostic in diagnostics {
        if diagnostic.severity != RuleLevel::Allow {
            out.push(analyzer_diagnostic_to_frontend(diagnostic))
        }
    }
    ret out
}

/// Converts one lint finding into the structured diagnostic shared by CLI,
/// LSP and IDE clients.
pub fn analyzer_diagnostic_to_frontend(diagnostic: AnalyzerDiagnostic) -> FrontendDiagnostic {
    let severity = match diagnostic.severity {
        RuleLevel::Allow => 3_usize RuleLevel::Warn => 2_usize RuleLevel::Deny => 1_usize RuleLevel::Forbid
        => 1_usize
    }
    let mut out = FrontendDiagnostic::new(severity, diagnostic.code, diagnostic.message, diagnostic.line,
        diagnostic.column, diagnostic.length,)
    .with_label(diagnostic.path, diagnostic.line, diagnostic.column, diagnostic.length, DiagnosticLabelKind::Primary,
        lint_label(diagnostic.code),)
    .with_note("lint level is configurable with [lint.rules]." + diagnostic.code + " in encore.toml")
    let help = lint_help(diagnostic.code)
    if help != "" {
        out = out.with_help(help)
    }
    if diagnostic.code == "trailing-whitespace" {
        out = out.with_suggestion(diagnostic.path, diagnostic.line, diagnostic.column, diagnostic.length,
            "", "remove the trailing whitespace", SuggestionApplicability::MachineApplicable,)
    }
    ret out
}

fn lint_label(code: str) -> str {
    if code == "unused-imports" {
        ret "this import is never used"
    }
    if code == "unused-variables" {
        ret "this binding is never read"
    }
    if code == "unused-mut" {
        ret "mutable access is never required"
    }
    if code == "unreachable-code" {
        ret "this statement cannot be reached"
    }
    if code == "dead-code" {
        ret "this declaration is never used"
    }
    if code == "redundant-condition" {
        ret "this condition has a constant value"
    }
    if code == "unreachable-patterns" {
        ret "an earlier pattern already matches these values"
    }
    if code == "missing-module-docstring" || code == "missing-public-docstring" {
        ret "documentation is required here"
    }
    ret "reported by `" + code + "`"
}

fn lint_help(code: str) -> str {
    if code == "unused-imports" {
        ret "remove the import or use one of the imported names"
    }
    if code == "unused-variables" {
        ret "remove the binding or prefix its name with `_` when it is intentionally unused"
    }
    if code == "unused-mut" {
        ret "remove `mut` from this binding"
    }
    if code == "unreachable-code" {
        ret "remove the statement or change the preceding control flow"
    }
    if code == "dead-code" {
        ret "remove the declaration, make it public, or reference it"
    }
    if code == "redundant-condition" {
        ret "simplify the branch using the known condition value"
    }
    if code == "unreachable-patterns" {
        ret "remove or reorder this match arm"
    }
    if code == "missing-module-docstring" {
        ret "add a `//!` module docstring before the first item"
    }
    if code == "missing-public-docstring" {
        ret "add a `///` docstring describing the public API"
    }
    ret ""
}

fn emit_module_docstring(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("missing-module-docstring")
    if level == RuleLevel::Allow {
        ret()
    }
    match document.module_documentation {
        Option[Documentation]::Some(doc) => {
            if doc.text != "" {
                ret()
            }
        }
        Option[Documentation]::None => {
        }
    }
    let location = first_location(document.tokens)
    out.push(AnalyzerDiagnostic {
            path, level, "missing-module-docstring", "module has no //! documentation", location.0, location.1,
            location.2
        }
        ,
    )
    ret()
}

fn emit_public_docstrings(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("missing-public-docstring")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                if item.is_public && !has_documentation(item.documentation) {
                    push_missing(path, level, "function", item.name, item.line, item.column, item.name.len(),
                        out,)
                }
            }
            Statement::Import(item) => {
                if item.is_public && !has_documentation(item.documentation) {
                    let location = named_location(document.tokens, item.path, TokenType::KW_IMPORT)
                    push_missing(path, level, "public import", item.path, location.0, location.1, location.2,
                        out,)
                }
            }
            Statement::Struct(item) => {
                if item.is_public {
                    let location = named_location(document.tokens, item.name, TokenType::KW_STRUCT)
                    if !has_documentation(item.documentation) {
                        push_missing(path, level, "struct", item.name, location.0, location.1, location.2,
                            out,)
                    }
                    for field in item.named_fields {
                        if !has_documentation(field.documentation) {
                            let field_location = named_location(document.tokens, field.name, TokenType::IDENTIFIER)
                            push_missing(path, level, "field", field.name, field_location.0, field_location.1,
                                field_location.2, out,)
                        }
                    }
                }
            }
            Statement::EnumItem(item) => {
                if item.is_public {
                    let location = named_location(document.tokens, item.name, TokenType::KW_ENUM)
                    if !has_documentation(item.documentation) {
                        push_missing(path, level, "enum", item.name, location.0, location.1, location.2,
                            out,)
                    }
                    for variant in item.variants {
                        if !has_documentation(variant.documentation) {
                            let variant_location = named_location(document.tokens, variant.name, TokenType::IDENTIFIER)
                            push_missing(path, level, "enum variant", variant.name, variant_location.0,
                                variant_location.1, variant_location.2, out,)
                        }
                        for field in variant.named_fields {
                            if !has_documentation(field.documentation) {
                                let field_location = named_location(document.tokens, field.name, TokenType::IDENTIFIER)
                                push_missing(path, level, "variant field", field.name, field_location.0,
                                    field_location.1, field_location.2, out,)
                            }
                        }
                    }
                }
            }
            Statement::Trait(item) => {
                if item.is_public {
                    if !has_documentation(item.documentation) {
                        push_missing(path, level, "trait", item.name, item.line, item.column, item.name.len(),
                            out,)
                    }
                    for method in item.methods {
                        if !has_documentation(method.documentation) {
                            push_missing(path, level, "trait method", method.name, method.line, method.column,
                                method.name.len(), out,)
                        }
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    if method.is_public && !has_documentation(method.documentation) {
                        push_missing(path, level, "method", method.name, method.line, method.column,
                            method.name.len(), out,)
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_trailing_whitespace(path: str, source: str, config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("trailing-whitespace")
    if level == RuleLevel::Allow {
        ret()
    }
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize_lossless(source)
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::WHITESPACE && trivia_run_ends_line(tokens, index) && !previous_is_whitespace(tokens,
                    index,) {
                    let length = whitespace_run_length(tokens, index)
                    out.push(AnalyzerDiagnostic {
                            path, level, "trailing-whitespace", "trailing whitespace", token.line, token.column,
                            length
                        }
                        ,
                    )
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn trivia_run_ends_line(tokens: Vec[Token], start: usize) -> bool {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::WHITESPACE {
                    index += 1_usize continue
                }
                ret token.type == TokenType::NEWLINE
            }
            Option[Token]::None => {
            }
        }
        ret true
    }
    ret true
}

fn previous_is_whitespace(tokens: Vec[Token], index: usize) -> bool {
    if index == 0_usize {
        ret false
    }
    match tokens.get(index - 1_usize) {
        Option[Token]::Some(token) => {
            ret token.type == TokenType::WHITESPACE
        }
        Option[Token]::None => {
        }
    }
    ret false
}

fn whitespace_run_length(tokens: Vec[Token], start: usize) -> usize {
    let mut index = start
    let mut length = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type != TokenType::WHITESPACE {
                    break
                }
                length += token.value.char_len()
            }
            Option[Token]::None => {
                break
            }
        }
        index += 1_usize
    }
    ret length
}

fn has_documentation(documentation: Option[Documentation]) -> bool {
    ret match documentation {
        Option[Documentation]::Some(doc) => doc.text != "" Option[Documentation]::None => false
    }
}

fn push_missing(path: str, level: RuleLevel, kind: str, name: str, line: usize, column: usize, length:
    usize, out: mut Vec[AnalyzerDiagnostic],) ->() {
    out.push(AnalyzerDiagnostic {
            path, level, "missing-public-docstring", "public " + kind + " '" + name + "' has no /// documentation",
            line, column, length
        }
        ,
    )
    ret()
}

fn first_location(tokens: Vec[Token]) ->(usize, usize, usize) {
    match tokens.get(0_usize) {
        Option[Token]::Some(token) => {
            ret(token.line, token.column, token.value.len())
        }
        Option[Token]::None => {
        }
    }
    ret(0_usize, 0_usize, 1_usize)
}

fn named_location(tokens: Vec[Token], name: str, fallback: TokenType) ->(usize, usize, usize) {
    for token in tokens {
        if token.value == name {
            ret(token.line, token.column, token.value.len())
        }
    }
    for token in tokens {
        if token.type == fallback {
            ret(token.line, token.column, token.value.len())
        }
    }
    ret first_location(tokens)
}

fn emit_unused_imports(path: str, document: FrontendDocument, usage_tokens: Vec[Token], config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("unused-imports")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Import(item) => {
                for name in imported_names(item.path) {
                    if identifier_occurrences(usage_tokens, name) <= 1_usize {
                        let location = named_location(document.tokens, name, TokenType::KW_IMPORT)
                        out.push(AnalyzerDiagnostic {
                                path, level, "unused-imports", "unused import '" + name + "'", location.0,
                                location.1, location.2
                            }
                            ,
                        )
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unused_variables(path: str, document: FrontendDocument, usage_tokens: Vec[Token], config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("unused-variables")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Option::Some(body) => {
                        emit_unused_in_statements(path, body.statements, usage_tokens, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    match method.body {
                        Option::Some(body) => {
                            emit_unused_in_statements(path, body.statements, usage_tokens, level,
                                out,)
                        }
                        Option::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unused_in_statements(path: str, statements: Vec[Statement], tokens: Vec[Token], level: RuleLevel,
    out: mut Vec[AnalyzerDiagnostic],) ->() {
    for statement in statements {
        match statement {
            Statement::Let(item) => {
                if !starts_with_text(item.name, "_") && identifier_occurrences(tokens, item.name) <=
                1_usize {
                    let location = named_location(tokens, item.name, TokenType::KW_LET)
                    out.push(AnalyzerDiagnostic {
                            path, level, "unused-variables", "unused variable '" + item.name + "'", location.0,
                            location.1, location.2
                        }
                        ,
                    )
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    emit_unused_in_statements(path, branch.body.statements, tokens, level, out)
                }
                match item.else_body {
                    Option::Some(body) => {
                        emit_unused_in_statements(path, body.statements, tokens, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::While(item) => {
                emit_unused_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::Loop(item) => {
                emit_unused_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::DoWhile(item) => {
                emit_unused_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::For(item) => {
                emit_unused_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::With(item) => {
                emit_unused_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::Unsafe(body) => {
                emit_unused_in_statements(path, body.statements, tokens, level, out)
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unused_mut(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("unused-mut")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Option::Some(body) => {
                        emit_unused_mut_in_statements(path, body.statements, document.tokens, level,
                            out,)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    match method.body {
                        Option::Some(body) => {
                            emit_unused_mut_in_statements(path, body.statements, document.tokens, level,
                                out,)
                        }
                        Option::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unused_mut_in_statements(path: str, statements: Vec[Statement], tokens: Vec[Token], level: RuleLevel,
    out: mut Vec[AnalyzerDiagnostic],) ->() {
    for statement in statements {
        match statement {
            Statement::Let(item) => {
                if item.is_mut && !statements_require_mutable_name(statements, item.name) {
                    let location = named_location(tokens, item.name, TokenType::KW_LET)
                    out.push(AnalyzerDiagnostic {
                            path, level, "unused-mut", "variable '" + item.name + "' does not need to be mutable",
                            location.0, location.1, location.2
                        }
                        ,
                    )
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    emit_unused_mut_in_statements(path, branch.body.statements, tokens, level, out)
                }
                match item.else_body {
                    Option::Some(body) => {
                        emit_unused_mut_in_statements(path, body.statements, tokens, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::While(item) => {
                emit_unused_mut_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::Loop(item) => {
                emit_unused_mut_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::DoWhile(item) => {
                emit_unused_mut_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::For(item) => {
                emit_unused_mut_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::With(item) => {
                emit_unused_mut_in_statements(path, item.body.statements, tokens, level, out)
            }
            Statement::Unsafe(body) => {
                emit_unused_mut_in_statements(path, body.statements, tokens, level, out)
            }
            _ => {
            }
        }
    }
    ret()
}

fn statements_require_mutable_name(statements: Vec[Statement], name: str) -> bool {
    for statement in statements {
        match statement {
            Statement::Assignment(item) => {
                match item.target.value {
                    Expr::Path(target) => {
                        if target == name {
                            ret true
                        }
                    }
                    _ => {
                    }
                }
            }
            // Method receiver mutability is resolved during lowering. At lint
            // time it is safer to retain `mut` for a receiver call than to
            // offer a machine-applicable change which may stop compiling.
            Statement::Expr(expr) => {
                match expr.value {
                    Expr::MethodCall(call) => {
                        match call.receiver.value {
                            Expr::Path(receiver) => {
                                if receiver == name {
                                    ret true
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    if statements_require_mutable_name(branch.body.statements, name) {
                        ret true
                    }
                }
                match item.else_body {
                    Option::Some(body) => {
                        if statements_require_mutable_name(body.statements, name) {
                            ret true
                        }
                    }
                    Option::None => {
                    }
                }
            }
            Statement::While(item) => {
                if statements_require_mutable_name(item.body.statements, name) {
                    ret true
                }
            }
            Statement::Loop(item) => {
                if statements_require_mutable_name(item.body.statements, name) {
                    ret true
                }
            }
            Statement::DoWhile(item) => {
                if statements_require_mutable_name(item.body.statements, name) {
                    ret true
                }
            }
            Statement::For(item) => {
                if statements_require_mutable_name(item.body.statements, name) {
                    ret true
                }
            }
            Statement::With(item) => {
                if statements_require_mutable_name(item.body.statements, name) {
                    ret true
                }
            }
            Statement::Unsafe(body) => {
                if statements_require_mutable_name(body.statements, name) {
                    ret true
                }
            }
            _ => {
            }
        }
    }
    ret false
}

fn emit_dead_code(path: str, document: FrontendDocument, usage_tokens: Vec[Token], config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("dead-code")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                if !item.is_public && item.name != "main" && !function_is_test(item.attrs) && identifier_occurrences(usage_tokens,
                    item.name,) <= 1_usize {
                    out.push(AnalyzerDiagnostic {
                            path, level, "dead-code", "function '" + item.name + "' is never used", item.line,
                            item.column, item.name.len()
                        }
                        ,
                    )
                }
            }
            Statement::Struct(item) => {
                if !item.is_public && identifier_occurrences(usage_tokens, item.name) <= 1_usize {
                    let location = named_location(document.tokens, item.name, TokenType::KW_STRUCT)
                    out.push(AnalyzerDiagnostic {
                            path, level, "dead-code", "struct '" + item.name + "' is never used", location.0,
                            location.1, location.2
                        }
                        ,
                    )
                }
            }
            Statement::EnumItem(item) => {
                if !item.is_public && identifier_occurrences(usage_tokens, item.name) <= 1_usize {
                    let location = named_location(document.tokens, item.name, TokenType::KW_ENUM)
                    out.push(AnalyzerDiagnostic {
                            path, level, "dead-code", "enum '" + item.name + "' is never used", location.0,
                            location.1, location.2
                        }
                        ,
                    )
                }
            }
            Statement::Trait(item) => {
                if !item.is_public && identifier_occurrences(usage_tokens, item.name) <= 1_usize {
                    out.push(AnalyzerDiagnostic {
                            path, level, "dead-code", "trait '" + item.name + "' is never used", item.line,
                            item.column, item.name.len()
                        }
                        ,
                    )
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn function_is_test(attrs: Vec[str]) -> bool {
    for attr in attrs {
        if attr == "test" || attr == "attr:test" || find_substring(attr, "test") < attr.len() {
            ret true
        }
    }
    ret false
}

fn emit_redundant_conditions(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut
    Vec[AnalyzerDiagnostic],) ->() {
    let level = config.level("redundant-condition")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Option::Some(body) => {
                        emit_redundant_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    match method.body {
                        Option::Some(body) => {
                            emit_redundant_in_statements(path, body.statements, level, out)
                        }
                        Option::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_redundant_in_statements(path: str, statements: Vec[Statement], level: RuleLevel, out: mut Vec[AnalyzerDiagnostic])
->() {
    for statement in statements {
        match statement {
            Statement::If(item) => {
                for branch in item.branches {
                    match branch.condition.value {
                        Expr::Boolean(value) => {
                            out.push(AnalyzerDiagnostic {
                                    path, level, "redundant-condition", "condition is always " + if value
                                    {
                                        "true"
                                    } else {
                                        "false"
                                    }
                                    , branch.condition.line, branch.condition.column, branch.condition.length
                                }
                                ,
                            )
                        }
                        _ => {
                        }
                    }
                    emit_redundant_in_statements(path, branch.body.statements, level, out)
                }
                match item.else_body {
                    Option::Some(body) => {
                        emit_redundant_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::While(item) => {
                match item.condition.value {
                    Expr::Boolean(value) => {
                        out.push(AnalyzerDiagnostic {
                                path, level, "redundant-condition", "loop condition is always " + if
                                value {
                                    "true"
                                } else {
                                    "false"
                                }
                                , item.condition.line, item.condition.column, item.condition.length
                            }
                            ,
                        )
                    }
                    _ => {
                    }
                }
                emit_redundant_in_statements(path, item.body.statements, level, out)
            }
            Statement::Loop(item) => {
                emit_redundant_in_statements(path, item.body.statements, level, out)
            }
            Statement::DoWhile(item) => {
                emit_redundant_in_statements(path, item.body.statements, level, out)
            }
            Statement::For(item) => {
                emit_redundant_in_statements(path, item.body.statements, level, out)
            }
            Statement::With(item) => {
                emit_redundant_in_statements(path, item.body.statements, level, out)
            }
            Statement::Unsafe(body) => {
                emit_redundant_in_statements(path, body.statements, level, out)
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unreachable_patterns(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut
    Vec[AnalyzerDiagnostic],) ->() {
    let level = config.level("unreachable-patterns")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Option::Some(body) => {
                        emit_unreachable_patterns_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    match method.body {
                        Option::Some(body) => {
                            emit_unreachable_patterns_in_statements(path, body.statements, level, out)
                        }
                        Option::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unreachable_patterns_in_statements(path: str, statements: Vec[Statement], level: RuleLevel, out:
    mut Vec[AnalyzerDiagnostic],) ->() {
    for statement in statements {
        match statement {
            Statement::Match(item) => {
                let mut seen = Vec[str]::new()
                let mut wildcard_seen = false
                for arm in item.arms {
                    let key = arm.pattern.kind + ":" + arm.pattern.value.unwrap_or("")
                    if wildcard_seen || contains_string_text(seen, key) {
                        out.push(AnalyzerDiagnostic {
                                path, level, "unreachable-patterns", "unreachable match pattern '" +
                                key + "'", item.expr.line, item.expr.column, item.expr.length
                            }
                            ,
                        )
                    }
                    if arm.pattern.kind == "wildcard" {
                        wildcard_seen = true
                    }
                    seen.push(key)
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            emit_unreachable_patterns_in_statements(path, body.statements, level, out)
                        }
                        _ => {
                        }
                    }
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    emit_unreachable_patterns_in_statements(path, branch.body.statements, level, out)
                }
                match item.else_body {
                    Option::Some(body) => {
                        emit_unreachable_patterns_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn contains_string_text(values: Vec[str], needle: str) -> bool {
    for value in values {
        if value == needle {
            ret true
        }
    }
    ret false
}

fn emit_unreachable_code(path: str, document: FrontendDocument, config: AnalyzerConfig, out: mut Vec[AnalyzerDiagnostic])
->() {
    let level = config.level("unreachable-code")
    if level == RuleLevel::Allow {
        ret()
    }
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Option::Some(body) => {
                        emit_unreachable_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    match method.body {
                        Option::Some(body) => {
                            emit_unreachable_in_statements(path, body.statements, level, out)
                        }
                        Option::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret()
}

fn emit_unreachable_in_statements(path: str, statements: Vec[Statement], level: RuleLevel, out: mut Vec[AnalyzerDiagnostic])
->() {
    let mut terminated = false
    for statement in statements {
        if terminated {
            let location = statement_location(statement)
            out.push(AnalyzerDiagnostic {
                    path, level, "unreachable-code", "unreachable statement", location.0, location.1,
                    location.2
                }
                ,
            )
            continue
        }
        match statement {
            Statement::Ret(expr) => {
                terminated = true let _expr = expr
            }
            Statement::Break(label) => {
                terminated = true let _label = label
            }
            Statement::Continue(label) => {
                terminated = true let _label = label
            }
            Statement::If(item) => {
                for branch in item.branches {
                    emit_unreachable_in_statements(path, branch.body.statements, level, out)
                }
                match item.else_body {
                    Option::Some(body) => {
                        emit_unreachable_in_statements(path, body.statements, level, out)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::While(item) => {
                emit_unreachable_in_statements(path, item.body.statements, level, out)
            }
            Statement::Loop(item) => {
                emit_unreachable_in_statements(path, item.body.statements, level, out)
            }
            Statement::DoWhile(item) => {
                emit_unreachable_in_statements(path, item.body.statements, level, out)
            }
            Statement::For(item) => {
                emit_unreachable_in_statements(path, item.body.statements, level, out)
            }
            Statement::With(item) => {
                emit_unreachable_in_statements(path, item.body.statements, level, out)
            }
            Statement::Unsafe(body) => {
                emit_unreachable_in_statements(path, body.statements, level, out)
            }
            _ => {
            }
        }
    }
    ret()
}

fn statement_location(statement: Statement) ->(usize, usize, usize) {
    match statement {
        Statement::Let(item) => {
            ret(item.expr.line, item.expr.column, item.expr.length)
        }
        Statement::Ret(expr) => {
            ret(expr.line, expr.column, expr.length)
        }
        Statement::Expr(expr) => {
            ret(expr.line, expr.column, expr.length)
        }
        Statement::Assignment(item) => {
            ret(item.target.line, item.target.column, item.target.length)
        }
        Statement::While(item) => {
            ret(item.condition.line, item.condition.column, item.condition.length)
        }
        Statement::DoWhile(item) => {
            ret(item.condition.line, item.condition.column, item.condition.length)
        }
        Statement::For(item) => {
            ret(item.iterable.line, item.iterable.column, item.iterable.length)
        }
        Statement::With(item) => {
            ret(item.expr.line, item.expr.column, item.expr.length)
        }
        _ => {
        }
    }
    ret(0_usize, 0_usize, 1_usize)
}

fn imported_names(path: str) -> Vec[str] {
    let mut names = Vec[str]::new()
    let open = find_char(path, "{")
    if open < path.len() {
        let close = find_char_after(path, "}", open + 1_usize)
        let inner = if close < path.len() {
            path.slice(open + 1_usize, close - open - 1_usize)
        } else {
            path.slice(open + 1_usize, path.len() - open - 1_usize)
        }
        for item in split_csv(inner) {
            let name = import_alias_or_last(item)
            if name != "" && name != "*" {
                names.push(name)
            }
        }
        ret names
    }
    let name = import_alias_or_last(path)
    if name != "" && name != "*" {
        names.push(name)
    }
    ret names
}

fn import_alias_or_last(value: str) -> str {
    let alias = find_substring(value, " as ")
    if alias < value.len() {
        ret trim(value.slice(alias + 4_usize, value.len() - alias - 4_usize))
    }
    let mut last = value
    let mut index = 0_usize
    while index + 1_usize < value.len() {
        if value.slice(index, 2_usize) == "::" {
            last = value.slice(index + 2_usize, value.len() - index - 2_usize) index += 2_usize continue
        }
        index += 1_usize
    }
    ret trim(last)
}

fn identifier_occurrences(tokens: Vec[Token], name: str) -> usize {
    let mut count = 0_usize
    for token in tokens {
        if token.type == TokenType::IDENTIFIER && token.value == name {
            count += 1_usize
        }
    }
    ret count
}

fn split_csv(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "," {
            out.push(trim(current)) current = ""
        } else {
            current += ch
        }
        index += 1_usize
    }
    if trim(current) != "" {
        out.push(trim(current))
    }
    ret out
}

fn find_char(value: str, needle: str) -> usize {
    ret find_char_after(value, needle, 0_usize)
}

fn find_char_after(value: str, needle: str, start: usize) -> usize {
    let mut index = start
    while index < value.len() {
        if value.slice(index, 1_usize) == needle {
            ret index
        }
        index += 1_usize
    }
    ret value.len()
}

fn find_substring(value: str, needle: str) -> usize {
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret index
        }
        index += 1_usize
    }
    ret value.len()
}

fn trim(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.len()
    while start < end &&(value.slice(start, 1_usize) == " " || value.slice(start, 1_usize) == "\t") {
        start += 1_usize
    }
    while end > start &&(value.slice(end - 1_usize, 1_usize) == " " || value.slice(end - 1_usize, 1_usize)
        == "\t") {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn starts_with_text(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}

fn capped_level(level: RuleLevel, cap: RuleLevel) -> RuleLevel {
    if level_rank(level) <= level_rank(cap) {
        ret level
    }
    ret cap
}

fn level_rank(level: RuleLevel) -> usize {
    match level {
        RuleLevel::Allow => {
            ret 0_usize
        }
        RuleLevel::Warn => {
            ret 1_usize
        }
        RuleLevel::Deny => {
            ret 2_usize
        }
        RuleLevel::Forbid => {
            ret 3_usize
        }
    }
    ret 0_usize
}

#attr(test)
pub fn analyzer_dependency_policy_contract() -> bool {
    let mut config = AnalyzerConfig::new()
    if config.dependencies_are_enabled() {
        ret false
    }
    config.set_dependency_level(RuleLevel::Warn)
    if !config.dependencies_are_enabled() {
        ret false
    }
    let dependency = config.for_dependency()
    match dependency.level("unused-imports") {
        RuleLevel::Warn => {
        }
        _ => {
            ret false
        }
    }
    config.set_dependency_level(RuleLevel::Forbid)
    config.set_cap_level(RuleLevel::Deny)
    match config.for_dependency().level("dead-code") {
        RuleLevel::Deny => {
            ret true
        }
        _ => {
            ret false
        }
    }
    ret false
}
