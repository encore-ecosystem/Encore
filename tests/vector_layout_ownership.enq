import core::option::Option
import core::vec::Vec

struct Pair {
    left: u32
    right: u64
}

struct Named {
    label: str
    code: u32
}

fn equals(opt: Option[u8], expected: u8) -> bool {
    ret match opt {
        Some(value) => value == expected
        None => false
    }
}

fn equals_pair(opt: Option[Pair], left: u32, right: u64) -> bool {
    ret match opt {
        Some(value) => value.left == left && value.right == right
        None => false
    }
}

fn equals_named(opt: Option[Named], label: str, code: u32) -> bool {
    ret match opt {
        Some(value) => value.label == label && value.code == code
        None => false
    }
}

fn copy_string(value: str) -> bool {
    let copy = value
    ret copy == value
}

fn copy_named(value: Named) -> bool {
    let copy = value
    ret copy.label == value.label && copy.code == value.code
}

fn branch_copy(value: str, choose_first: bool) -> bool {
    let copy = value
    if choose_first {
        ret copy == value
    }
    ret value == copy
}

fn reassign_string(value: str, replacement: str) -> bool {
    let mut current = value
    current = replacement
    ret current == replacement
}

fn reassign_field(replacement: str) -> bool {
    let mut value = Named{"old", 37_u32}
    value.label = replacement
    ret value.label == replacement
}

fn scoped_copy(choose_first: bool) -> bool {
    if choose_first {
        let inside = "inside"
        ret inside == "inside"
    }
    let outside = "outside"
    ret outside == "outside"
}

fn loop_scope() -> bool {
    loop {
        let iteration = "iteration"
        if iteration == "iteration" {
            break
        }
    }
    ret true
}

fn match_scope(value: Option[str]) -> bool {
    match value {
        Some(inner) => {
            let copy = inner
            ret copy == inner
        }
        None => { ret false }
    }
    ret false
}

fn for_scope() -> bool {
    let mut values: Vec[str] = Vec[str]::new()
    values.push("looped")
    let mut valid = false
    for item in values {
        if item == "looped" {
            valid = true
        }
    }
    values.free()
    ret valid
}

fn main() -> usize {
    let mut vec: Vec[u8] = Vec[u8]::new()
    vec.push(5_u8)
    vec.push(7_u8)

    let valid = equals(vec.get(0_usize), 5_u8) && equals(vec.get(1_usize), 7_u8)
    vec.free()

    let mut pairs: Vec[Pair] = Vec[Pair]::new()
    pairs.push(Pair{11_u32, 13_u64})
    pairs.push(Pair{17_u32, 19_u64})
    let pairs_valid = equals_pair(pairs.get(0_usize), 11_u32, 13_u64) && equals_pair(pairs.get(1_usize), 17_u32, 19_u64)
    pairs.free()

    let mut names: Vec[Named] = Vec[Named]::new()
    names.push(Named{"alpha", 23_u32})
    names.push(Named{"beta", 29_u32})
    let names_valid = equals_named(names.get(0_usize), "alpha", 23_u32) && equals_named(names.get(1_usize), "beta", 29_u32)
    names.free()

    let mut optional_names: Vec[Option[str]] = Vec[Option[str]]::new()
    optional_names.push(Option[str]::Some("gamma"))
    optional_names.push(Option[str]::None)
    optional_names.free()

    let ownership_valid = copy_string("copy") && copy_named(Named{"owned", 31_u32}) && branch_copy("branch", true) && reassign_string("before", "after") && reassign_field("field") && scoped_copy(true) && scoped_copy(false) && loop_scope() && match_scope(Option[str]::Some("matched"))
    let for_valid = for_scope()

    if !valid { ret 1_usize }
    if !pairs_valid { ret 2_usize }
    if !names_valid { ret 3_usize }
    if !ownership_valid { ret 4_usize }
    if !for_valid { ret 5_usize }
    ret 0_usize
}
